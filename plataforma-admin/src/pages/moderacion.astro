---
import AdminLteLayout from '../layouts/AdminLteLayout.astro';

const apiBaseUrl = import.meta.env.PUBLIC_PLATAFORMA_API_BASE_URL || "http://localhost:8001";
---

<AdminLteLayout 
  title="Moderación de Catálogo | Plataforma Admin"
  activeNav="moderacion"
  breadcrumb={[{ label: "Inicio", url: "/plataforma/" }, { label: "Moderación de Catálogo" }]}
>
  <div class="space-y-6" data-api-base={apiBaseUrl}>
    
    <!-- CABECERA -->
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-stone-200/80 pb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-black tracking-tight text-stone-900 flex items-center gap-2">
          <span>🛡️</span>
          <span>Moderación de Catálogo</span>
        </h1>
        <p class="mt-1 text-xs text-stone-500 max-w-2xl">
          Filtra y oculta productos que no son café (poleras, imanes, relojes, tazas, vajilla, suscripciones, accesorios) para que no ensucien las búsquedas ni el comparador público.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          type="button"
          id="btn-bulk-hide-suspected"
          class="inline-flex items-center gap-1.5 rounded-xl bg-rose-600 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-rose-700 transition focus:outline-none focus:ring-2 focus:ring-rose-500"
        >
          <span>🚫</span>
          <span>Ocultar Sospechosos Filtrados</span>
        </button>
      </div>
    </div>

    <!-- BANNER DE FILTRADO ACTIVO POR TIENDA -->
    <div 
      id="banner-store-filter" 
      class="hidden items-center justify-between rounded-2xl border border-indigo-200 bg-gradient-to-r from-indigo-50/90 via-sky-50/50 to-white p-4 shadow-xs mb-6"
    >
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-100 text-indigo-700 text-xl shrink-0">
          🏪
        </span>
        <div class="min-w-0">
          <p class="text-xs font-bold text-indigo-950 flex items-center gap-1.5 flex-wrap">
            <span>Filtrando catálogo exclusivo de:</span>
            <span id="banner-store-name" class="font-black text-indigo-900 underline underline-offset-2"></span>
            <span class="rounded-full bg-indigo-200/80 text-indigo-800 text-[10px] font-extrabold px-2 py-0.5">Filtro activo</span>
          </p>
          <p class="text-[11px] text-indigo-700/80 mt-0.5">
            Los KPIs superiores (sospechosos, ocultos, visibles) y la grilla muestran únicamente los productos de esta tienda.
          </p>
        </div>
      </div>
      <button
        type="button"
        id="btn-clear-store-filter"
        class="inline-flex items-center gap-1.5 rounded-xl border border-indigo-300 bg-white px-3.5 py-2 text-xs font-bold text-indigo-900 shadow-2xs hover:bg-indigo-50 hover:border-indigo-400 transition shrink-0 focus:outline-none focus:ring-2 focus:ring-indigo-500"
      >
        <span>✕</span>
        <span>Ver productos de todas las tiendas</span>
      </button>
    </div>

    <!-- KPIS Y RESUMEN DE MODERACIÓN -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl border border-rose-200 bg-rose-50/50 p-5 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-wider text-rose-800">Sospechosos No-Café</p>
        <p id="kpi-suspected" class="mt-2 text-3xl font-extrabold text-rose-900">0</p>
        <p class="mt-1 text-[11px] text-rose-700">Poleras, imanes, relojes, tazas y accesorios detectados.</p>
      </div>
      <div class="rounded-2xl border border-sky-200 bg-sky-50/50 p-5 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-wider text-sky-800">Confirmados como Café</p>
        <p id="kpi-confirmed" class="mt-2 text-3xl font-extrabold text-sky-900">0</p>
        <p class="mt-1 text-[11px] text-sky-700">Sospechas descartadas manualmente por el administrador.</p>
      </div>
      <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-wider text-amber-800">Ocultos del Catálogo</p>
        <p id="kpi-hidden" class="mt-2 text-3xl font-extrabold text-amber-900">0</p>
        <p class="mt-1 text-[11px] text-amber-700">Productos deshabilitados para no aparecer en comparador ni filtros.</p>
      </div>
      <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-5 shadow-xs">
        <p class="text-xs font-bold uppercase tracking-wider text-emerald-800">Cafés Legítimos Visibles</p>
        <p id="kpi-visible" class="mt-2 text-3xl font-extrabold text-emerald-900">0</p>
        <p class="mt-1 text-[11px] text-emerald-700">Productos de café activos en la vista pública.</p>
      </div>
    </div>

    <!-- FILTROS Y BÚSQUEDA -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex flex-wrap rounded-xl bg-stone-100 p-1 text-xs font-semibold gap-1">
            <button type="button" class="mod-filter-btn active rounded-lg bg-stone-900 px-3 py-1.5 text-white" data-mode="suspected">
              🛡️ Sospechosos
            </button>
            <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="confirmed">
              ☕ Confirmados
            </button>
            <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="hidden">
              🚫 Ocultos
            </button>
            <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="visible">
              👁️ Visibles
            </button>
            <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="all">
              Todos
            </button>
          </div>

          <select
            id="mod-store-filter"
            class="rounded-xl border border-stone-300 px-3 py-1.5 text-xs text-stone-800 focus:border-emerald-600 focus:outline-none"
          >
            <option value="">Todas las tiendas</option>
          </select>

          <input
            type="text"
            id="mod-search-input"
            placeholder="Buscar por nombre..."
            class="rounded-xl border border-stone-300 px-3.5 py-1.5 text-xs text-stone-800 focus:border-emerald-600 focus:outline-none"
          />
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="btn-bulk-confirm-coffee"
            class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-900 hover:bg-emerald-100 transition shadow-2xs"
            title="Confirmar todos los productos sospechosos del listado actual como café"
          >
            <span>☕</span>
            <span>Confirmar Filtrados como Café</span>
          </button>
          <button
            type="button"
            id="btn-bulk-hide-suspected"
            class="inline-flex items-center gap-1.5 rounded-xl border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-bold text-rose-900 hover:bg-rose-100 transition shadow-2xs"
            title="Ocultar masivamente los sospechosos de este listado"
          >
            <span>🚫</span>
            <span>Ocultar Sospechosos</span>
          </button>
          <span class="text-xs text-stone-500 pl-2" id="mod-items-count">
            Cargando productos...
          </span>
        </div>
      </div>

      <!-- TABLA DE PRODUCTOS PARA MODERACIÓN -->
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-left text-xs text-stone-600">
          <thead class="bg-stone-100 text-stone-800 font-bold uppercase tracking-wider">
            <tr>
              <th class="px-4 py-3">Producto</th>
              <th class="px-4 py-3">Tienda</th>
              <th class="px-4 py-3">Precio / Kilo</th>
              <th class="px-4 py-3">Motivo de Sospecha</th>
              <th class="px-4 py-3 text-center">Estado</th>
              <th class="px-4 py-3 text-center">Acción</th>
            </tr>
          </thead>
          <tbody id="moderation-table-body" class="divide-y divide-stone-100 font-medium">
            <tr>
              <td colspan="6" class="py-8 text-center text-stone-400">Cargando productos de moderación...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script is:inline>
    (function initModerationPage() {
      const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || window.location.hostname.endsWith('.local');
      if (!isLocalhost) {
        window.location.replace('/');
        return;
      }

      const API_BASE = document.querySelector('[data-api-base]')?.dataset.apiBase || 'http://localhost:8001';

      const fetchWithEnv = (url, opts = {}) => {
        if (window.plataformaState && typeof window.plataformaState.fetchWithEnv === 'function') {
          return window.plataformaState.fetchWithEnv(url, opts);
        }
        const headers = new Headers(opts.headers || {});
        headers.set('X-Target-Environment', localStorage.getItem('plataforma_active_env') || 'local');
        return fetch(url, { ...opts, headers });
      };

      const urlParams = new URLSearchParams(window.location.search);
      let currentModMode = urlParams.get('mode') || 'suspected';
      let currentModStore = urlParams.get('tienda') || urlParams.get('store_name') || '';
      let currentModSearch = urlParams.get('q') || '';
      let cachedModerationItems = [];

      function updateStoreFilterBanner() {
        const banner = document.getElementById('banner-store-filter');
        const bannerName = document.getElementById('banner-store-name');
        const modStoreFilter = document.getElementById('mod-store-filter');
        if (!banner) return;

        if (currentModStore && currentModStore.trim()) {
          if (bannerName) bannerName.textContent = currentModStore;
          banner.classList.remove('hidden');
          banner.classList.add('flex');
          if (modStoreFilter && modStoreFilter.value !== currentModStore) {
            modStoreFilter.value = currentModStore;
          }
        } else {
          banner.classList.add('hidden');
          banner.classList.remove('flex');
          if (modStoreFilter && modStoreFilter.value !== '') {
            modStoreFilter.value = '';
          }
        }
      }

      function clearStoreFilter() {
        currentModStore = '';
        const url = new URL(window.location.href);
        url.searchParams.delete('tienda');
        url.searchParams.delete('store_name');
        window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
        updateStoreFilterBanner();
        loadModerationProducts();
      }

      // Cargar opciones del selector de tiendas
      async function loadStoresFilter() {
        const modStoreFilter = document.getElementById('mod-store-filter');
        if (!modStoreFilter) return;
        try {
          const res = await fetchWithEnv(`${API_BASE}/api/v1/admin/stores`);
          if (res.ok) {
            const data = await res.json();
            const tiendas = data.tiendas || [];
            const currentVal = modStoreFilter.value;
            modStoreFilter.innerHTML = '<option value="">Todas las tiendas</option>' + 
              tiendas.map((t) => `<option value="${t.nombre}">${t.nombre}</option>`).join('');
            if (currentModStore) {
              modStoreFilter.value = currentModStore;
            } else {
              modStoreFilter.value = currentVal;
            }
            updateStoreFilterBanner();
          }
        } catch (e) {
          console.error("Error al cargar tiendas para filtro de moderación:", e);
        }
      }

      // Cargar productos de moderación
      async function loadModerationProducts() {
        const tbody = document.getElementById('moderation-table-body');
        const countEl = document.getElementById('mod-items-count');
        if (!tbody) return;

        try {
          const params = new URLSearchParams({
            mode: currentModMode,
            limit: '300',
          });
          if (currentModStore) params.set('store_name', currentModStore);
          if (currentModSearch) params.set('q', currentModSearch);

          const res = await fetchWithEnv(`${API_BASE}/api/v1/admin/products/moderation?${params.toString()}`);
          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.detail || `Error HTTP ${res.status} al cargar productos`);
          }
          const data = await res.json();
          cachedModerationItems = data.items || [];

          // Actualizar KPIs
          const kpiSuspected = document.getElementById('kpi-suspected');
          const kpiConfirmed = document.getElementById('kpi-confirmed');
          const kpiHidden = document.getElementById('kpi-hidden');
          const kpiVisible = document.getElementById('kpi-visible');
          if (kpiSuspected) kpiSuspected.textContent = data.total_sospechosos || 0;
          if (kpiConfirmed) kpiConfirmed.textContent = data.total_confirmados_cafe || 0;
          if (kpiHidden) kpiHidden.textContent = data.total_ocultos || 0;
          if (kpiVisible) kpiVisible.textContent = data.total_visibles_cafe || 0;
          if (countEl) countEl.textContent = `Mostrando ${cachedModerationItems.length} productos`;

          if (!cachedModerationItems.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-stone-400">No se encontraron productos bajo el criterio seleccionado.</td></tr>';
            return;
          }

          tbody.innerHTML = cachedModerationItems.map((item) => {
            const isConfirmed = Boolean(item.es_cafe_confirmado);
            return `
            <tr class="hover:bg-stone-50/60 transition ${item.oculto_catalogo ? 'bg-stone-50/80 opacity-70' : ''}">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  ${item.imagen 
                    ? `<img src="${item.imagen}" alt="${item.nombre}" referrerpolicy="no-referrer" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';" class="h-10 w-10 rounded-lg object-contain bg-[#F4F3ED] border border-stone-200 p-0.5" />` 
                    : '<div class="h-10 w-10 rounded-lg bg-stone-200 flex items-center justify-center text-xs">☕</div>'}
                  <div>
                    <a href="${item.url_detalle}" target="_blank" rel="noopener noreferrer" class="font-bold text-stone-900 hover:text-emerald-700 transition">
                      ${item.nombre}
                    </a>
                    <span class="block text-[11px] text-stone-400">ID: #${item.id}</span>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 font-semibold text-stone-700">${item.tienda}</td>
              <td class="px-4 py-3">
                <span class="font-bold text-stone-900">$${(item.precio_clp || 0).toLocaleString('es-CL')}</span>
                <span class="block text-[10px] text-stone-400">$${(item.precio_por_kilo || 0).toLocaleString('es-CL')}/kg</span>
              </td>
              <td class="px-4 py-3">
                ${isConfirmed
                  ? `<span class="inline-flex items-center gap-1 rounded-md bg-emerald-100 px-2 py-0.5 text-[11px] font-bold text-emerald-800" title="Confirmado manualmente por el administrador">✓ Café Confirmado</span>`
                  : (item.es_sospechoso 
                      ? `<span class="rounded-md bg-rose-100 px-2 py-0.5 text-[11px] font-bold text-rose-800">${item.motivo_sospecha || 'Posible no-café'}</span>`
                      : '<span class="text-[11px] text-stone-400">Sin sospecha</span>')}
              </td>
              <td class="px-4 py-3 text-center">
                ${item.oculto_catalogo
                  ? '<span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-[10px] font-bold text-rose-900">Oculto</span>'
                  : '<span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold text-emerald-900">Visible</span>'}
              </td>
              <td class="px-4 py-3 text-center">
                <div class="inline-flex items-center justify-center gap-1.5">
                  <button
                    type="button"
                    class="btn-toggle-confirm rounded-lg px-2.5 py-1 text-xs font-bold transition ${isConfirmed ? 'bg-stone-100 text-stone-600 hover:bg-stone-200 border border-stone-200' : 'bg-emerald-600 text-white hover:bg-emerald-700 shadow-2xs'}"
                    data-id="${item.id}"
                    data-confirmed="${isConfirmed}"
                    title="${isConfirmed ? 'Deshacer confirmación y restaurar sospecha' : 'Confirmar que es café de especialidad legítimo'}"
                  >
                    ${isConfirmed ? '↩ Deshacer' : '☕ Es Café'}
                  </button>
                  <button
                    type="button"
                    class="btn-toggle-visibility rounded-lg px-2 py-1 text-xs font-bold transition ${item.oculto_catalogo ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-rose-100 text-rose-800 hover:bg-rose-200'}"
                    data-id="${item.id}"
                    data-current="${item.oculto_catalogo}"
                    title="${item.oculto_catalogo ? 'Restaurar visibilidad en catálogo público' : 'Ocultar producto del catálogo público'}"
                  >
                    ${item.oculto_catalogo ? '👁️' : '🚫'}
                  </button>
                </div>
              </td>
            </tr>
          `;
          }).join('');

          // Enlazar botones de confirmación como café
          document.querySelectorAll('.btn-toggle-confirm').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const isConfirmed = btn.getAttribute('data-confirmed') === 'true';
              btn.disabled = true;
              const originalHtml = btn.innerHTML;
              btn.innerHTML = '<span class="inline-block animate-spin text-[10px]">⏳</span>';

              try {
                const patchRes = await fetchWithEnv(`${API_BASE}/api/v1/admin/products/${id}/confirm-coffee`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ confirmado: !isConfirmed }),
                });
                if (!patchRes.ok) {
                  const errData = await patchRes.json().catch(() => ({}));
                  throw new Error(errData.detail || `Error HTTP ${patchRes.status} al confirmar producto`);
                }
                if (window.plataformaNotify) {
                  window.plataformaNotify(
                    !isConfirmed
                      ? 'Producto confirmado como café de especialidad legítimo.'
                      : 'Confirmación deshecha. El producto vuelve a su clasificación original.',
                    'success'
                  );
                }
                loadModerationProducts();
              } catch (err) {
                if (window.plataformaNotify) {
                  window.plataformaNotify(`Error: ${err.message}`, 'error');
                } else {
                  console.error('Error al confirmar café:', err);
                }
                btn.disabled = false;
                btn.innerHTML = originalHtml;
              }
            });
          });

          // Enlazar botones toggle
          document.querySelectorAll('.btn-toggle-visibility').forEach((btn) => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const current = btn.getAttribute('data-current') === 'true';
              btn.disabled = true;
              try {
                const patchRes = await fetchWithEnv(`${API_BASE}/api/v1/admin/products/${id}/visibility`, {
                  method: 'PATCH',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ oculto_catalogo: !current }),
                });
                if (!patchRes.ok) {
                  const errData = await patchRes.json().catch(() => ({}));
                  throw new Error(errData.detail || `Error HTTP ${patchRes.status} al actualizar visibilidad`);
                }
                if (window.plataformaNotify) {
                  window.plataformaNotify(
                    !current ? 'Producto ocultado del catálogo público.' : 'Producto marcado como visible en el catálogo.',
                    'success'
                  );
                }
                loadModerationProducts();
              } catch (err) {
                if (window.plataformaNotify) {
                  window.plataformaNotify(`Error: ${err.message}`, 'error');
                } else {
                  console.error('Error al actualizar visibilidad:', err);
                }
                btn.disabled = false;
              }
            });
          });

        } catch (err) {
          if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-rose-600">Error: ${err.message}</td></tr>`;
        }
      }

      // Filtros de modo (sospechosos, ocultos, visibles, todos)
      document.querySelectorAll('.mod-filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.mod-filter-btn').forEach((b) => {
            b.className = b === btn
              ? 'mod-filter-btn active rounded-lg bg-stone-900 px-3 py-1.5 text-white'
              : 'mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900';
          });
          currentModMode = btn.getAttribute('data-mode') || 'suspected';
          loadModerationProducts();
        });
      });

      document.getElementById('mod-store-filter')?.addEventListener('change', (e) => {
        currentModStore = e.target.value;
        const url = new URL(window.location.href);
        if (currentModStore) {
          url.searchParams.set('tienda', currentModStore);
        } else {
          url.searchParams.delete('tienda');
          url.searchParams.delete('store_name');
        }
        window.history.replaceState({}, '', url.pathname + (url.search ? url.search : ''));
        updateStoreFilterBanner();
        loadModerationProducts();
      });

      document.getElementById('btn-clear-store-filter')?.addEventListener('click', () => {
        clearStoreFilter();
      });

      document.getElementById('mod-search-input')?.addEventListener('input', (e) => {
        currentModSearch = (e.target.value || '').trim();
        loadModerationProducts();
      });

      // Confirmar masivamente los sospechosos filtrados como café
      document.getElementById('btn-bulk-confirm-coffee')?.addEventListener('click', async () => {
        const unconfirmedIds = cachedModerationItems
          .filter((i) => !i.es_cafe_confirmado && (i.es_sospechoso || currentModMode === 'suspected'))
          .map((i) => i.id);

        if (!unconfirmedIds.length) {
          if (window.plataformaNotify) {
            window.plataformaNotify('No hay productos sospechosos pendientes de confirmar en esta vista.', 'warning');
          }
          return;
        }

        const ejecutarConfirmacionMasiva = async () => {
          try {
            const res = await fetchWithEnv(`${API_BASE}/api/v1/admin/products/bulk-confirm-coffee`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ product_ids: unconfirmedIds, confirmado: true }),
            });
            if (!res.ok) {
              const errData = await res.json().catch(() => ({}));
              throw new Error(errData.detail || `Error HTTP ${res.status} al confirmar en lote`);
            }
            if (window.plataformaNotify) {
              window.plataformaNotify(`${unconfirmedIds.length} productos confirmados como café de especialidad con éxito.`, 'success');
            }
            loadModerationProducts();
          } catch (err) {
            if (window.plataformaNotify) {
              window.plataformaNotify(`Error: ${err.message}`, 'error');
            } else {
              console.error('Error en bulk confirm coffee:', err);
            }
          }
        };

        if (window.plataformaState && typeof window.plataformaState.confirmAction === 'function') {
          window.plataformaState.confirmAction({
            title: 'Confirmar Cafés en Lote',
            message: `¿Deseas confirmar ${unconfirmedIds.length} productos como café de especialidad legítimo? Dejarán de aparecer como sospechosos.`,
            onProceed: ejecutarConfirmacionMasiva
          });
        } else {
          await ejecutarConfirmacionMasiva();
        }
      });

      // Ocultar masivamente los sospechosos visibles
      document.getElementById('btn-bulk-hide-suspected')?.addEventListener('click', async () => {
        const suspectedVisibleIds = cachedModerationItems
          .filter((i) => i.es_sospechoso && !i.oculto_catalogo)
          .map((i) => i.id);

        if (!suspectedVisibleIds.length) {
          if (window.plataformaNotify) {
            window.plataformaNotify('No hay productos sospechosos visibles en este listado para ocultar.', 'warning');
          } else {
            console.warn('No hay productos sospechosos visibles para ocultar.');
          }
          return;
        }

        const ejecutarOcultamientoMasivo = async () => {
          try {
            const res = await fetchWithEnv(`${API_BASE}/api/v1/admin/products/bulk-visibility`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ product_ids: suspectedVisibleIds, oculto_catalogo: true }),
            });
            if (!res.ok) {
              const errData = await res.json().catch(() => ({}));
              throw new Error(errData.detail || `Error HTTP ${res.status} al ocultar en lote`);
            }
            if (window.plataformaNotify) {
              window.plataformaNotify(`${suspectedVisibleIds.length} productos sospechosos ocultados del catálogo con éxito.`, 'success');
            } else {
              console.log(`${suspectedVisibleIds.length} productos sospechosos ocultados.`);
            }
            loadModerationProducts();
          } catch (err) {
            if (window.plataformaNotify) {
              window.plataformaNotify(`Error: ${err.message}`, 'error');
            } else {
              console.error('Error en bulk hide:', err);
            }
          }
        };

        if (window.plataformaState && typeof window.plataformaState.confirmAction === 'function') {
          window.plataformaState.confirmAction({
            title: 'Ocultar Productos Sospechosos',
            message: `¿Deseas ocultar ${suspectedVisibleIds.length} productos sospechosos del catálogo general?`,
            onProceed: ejecutarOcultamientoMasivo
          });
        } else {
          await ejecutarOcultamientoMasivo();
        }
      });

      // Recargar al cambiar ambiente (localhost <-> supabase)
      window.addEventListener('plataforma:env-changed', () => {
        loadStoresFilter();
        loadModerationProducts();
      });

      // Sincronizar estado visual de pestañas según currentModMode inicial
      document.querySelectorAll('.mod-filter-btn').forEach((b) => {
        const mode = b.getAttribute('data-mode');
        if (mode === currentModMode) {
          b.className = 'mod-filter-btn active rounded-lg bg-stone-900 px-3 py-1.5 text-white';
        } else {
          b.className = 'mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900';
        }
      });

      // Inicialización
      updateStoreFilterBanner();
      loadStoresFilter();
      loadModerationProducts();
    })();
  </script>
</AdminLteLayout>

