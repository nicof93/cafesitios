---
import AdminLteLayout from '../layouts/AdminLteLayout.astro';
---

<AdminLteLayout 
  title="Dashboard Principal | Plataforma Admin Cafesitios"
  activeNav="dashboard"
  breadcrumb={[{ label: "Inicio", url: "/plataforma/" }, { label: "Dashboard" }]}
>
  <!-- BANNER DE MODERACIÓN DE CATÁLOGO (CONDICIONAL DINÁMICO) -->
  <div id="banner-moderacion" class="hidden mb-6 rounded-2xl border border-amber-300 bg-amber-50/90 p-4 sm:p-5 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-start gap-3.5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-200 text-amber-900 text-xl font-bold">
          🛡️
        </span>
        <div>
          <h3 class="text-sm font-bold text-amber-950 flex items-center gap-2">
            <span>Atención: Productos Pendientes de Moderación</span>
            <span class="rounded-full bg-rose-600 text-white text-[11px] font-black px-2 py-0.5" id="banner-moderacion-badge">0</span>
          </h3>
          <p class="text-xs text-amber-800 mt-0.5">
            Se han detectado productos sospechosos de no ser café de especialidad (accesorios, cursos o ítems no clasificados) visibles en el catálogo.
          </p>
        </div>
      </div>
      <a 
        href="/plataforma/moderacion" 
        class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold rounded-xl bg-amber-900 hover:bg-amber-950 text-white shadow-xs transition shrink-0"
      >
        <span>Revisar y Moderar Catálogo ➔</span>
      </a>
    </div>
  </div>

  <!-- ENCABEZADO DE PÁGINA -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h2 class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight flex items-center gap-2">
        <span>📊</span>
        <span>Panel de Control de la Plataforma</span>
      </h2>
      <p class="text-xs text-stone-500 mt-1">
        Monitoreo de sincronizaciones de tiendas, catálogo de cafés y auditoría de ingesta.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <a 
        href="/plataforma/ambientes" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg border border-stone-200 bg-white text-stone-700 hover:bg-stone-50 shadow-2xs transition"
      >
        <span>⚙️</span>
        <span>Ambientes</span>
      </a>
      <a 
        href="/plataforma/tiendas" 
        class="btn-admin-primary shadow-xs"
      >
        <span>🏪</span>
        <span>Gestionar Tiendas</span>
      </a>
    </div>
  </div>

  <!-- SECCIÓN 1 (AL INICIO): MÓDULOS DE LA PLATAFORMA -->
  <div class="admin-card mb-6">
    <div class="admin-card-header">
      <div>
        <h3 class="admin-card-title flex items-center gap-2">
          <span>⚡</span>
          <span>Módulos de la Plataforma</span>
        </h3>
        <p class="text-xs text-stone-400 mt-0.5">
          Accesos directos operacionales con métricas en tiempo real.
        </p>
      </div>
      <div class="admin-card-tools">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-stone-100 text-stone-600 border border-stone-200" id="badge-ambiente-activo">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Modo Localhost</span>
        </span>
      </div>
    </div>

    <div class="admin-card-body">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        
        <!-- Módulo 1: Tiendas y Sucursales -->
        <a 
          href="/plataforma/tiendas" 
          class="group block p-4 rounded-2xl border border-stone-200/80 bg-stone-50/50 hover:bg-emerald-50/40 hover:border-emerald-300 shadow-2xs hover:shadow-xs transition duration-200"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-2xl font-bold group-hover:scale-105 transition shrink-0">
              🏪
            </span>
            <span class="text-[11px] font-bold text-stone-400 group-hover:text-emerald-700 transition">
              Entrar ➔
            </span>
          </div>
          <div class="mt-3">
            <h4 class="text-sm font-bold text-stone-900 group-hover:text-emerald-950 transition">
              Tiendas y Sucursales
            </h4>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black text-stone-900 tracking-tight" id="mod-tiendas-count">--</span>
              <span class="text-xs font-semibold text-stone-500">tiendas</span>
            </div>
            <p class="text-xs text-stone-600 mt-1 flex items-center gap-1 font-medium">
              <span>📍</span>
              <span><strong id="mod-sucursales-count" class="text-emerald-800 font-bold">--</strong> sucursales registradas</span>
            </p>
          </div>
        </a>

        <!-- Módulo 2: Moderación de Catálogo -->
        <a 
          href="/plataforma/moderacion" 
          class="group block p-4 rounded-2xl border border-stone-200/80 bg-stone-50/50 hover:bg-rose-50/40 hover:border-rose-300 shadow-2xs hover:shadow-xs transition duration-200"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-rose-100 text-rose-800 text-2xl font-bold group-hover:scale-105 transition shrink-0">
              🛡️
            </span>
            <span class="text-[11px] font-bold text-stone-400 group-hover:text-rose-700 transition">
              Moderar ➔
            </span>
          </div>
          <div class="mt-3">
            <h4 class="text-sm font-bold text-stone-900 group-hover:text-rose-950 transition">
              Moderación de Catálogo
            </h4>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black text-stone-900 tracking-tight" id="mod-mod-prods">--</span>
              <span class="text-xs font-semibold text-stone-500">registrados</span>
            </div>
            <div class="mt-1 flex items-center gap-1.5">
              <span id="mod-sospechosos-badge" class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
                <span>⚠️</span>
                <span><strong id="mod-sospechosos-count">0</strong> sospechosos no café</span>
              </span>
            </div>
          </div>
        </a>

        <!-- Módulo 3: Productos y Cafés -->
        <a 
          href="/plataforma/moderacion" 
          class="group block p-4 rounded-2xl border border-stone-200/80 bg-stone-50/50 hover:bg-amber-50/40 hover:border-amber-300 shadow-2xs hover:shadow-xs transition duration-200"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-100 text-amber-800 text-2xl font-bold group-hover:scale-105 transition shrink-0">
              ☕
            </span>
            <span class="text-[11px] font-bold text-stone-400 group-hover:text-amber-700 transition">
              Catálogo ➔
            </span>
          </div>
          <div class="mt-3">
            <h4 class="text-sm font-bold text-stone-900 group-hover:text-amber-950 transition">
              Productos y Cafés
            </h4>
            <div class="mt-2 flex items-baseline gap-2">
              <span class="text-2xl font-black text-stone-900 tracking-tight" id="mod-total-prods">--</span>
              <span class="text-xs font-semibold text-stone-500">productos</span>
            </div>
            <p class="text-xs text-stone-600 mt-1 flex items-center gap-1 font-medium">
              <span>☕</span>
              <span><strong id="mod-cafes-count" class="text-amber-900 font-bold">--</strong> de ellos son cafés</span>
            </p>
          </div>
        </a>

        <!-- Módulo 4: Sincronización y Analítica -->
        <a 
          href="/plataforma/sincronizaciones" 
          class="group block p-4 rounded-2xl border border-stone-200/80 bg-stone-50/50 hover:bg-purple-50/40 hover:border-purple-300 shadow-2xs hover:shadow-xs transition duration-200"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-100 text-purple-800 text-2xl font-bold group-hover:scale-105 transition shrink-0">
              ⚡
            </span>
            <span class="text-[11px] font-bold text-stone-400 group-hover:text-purple-700 transition">
              Métricas ➔
            </span>
          </div>
          <div class="mt-3">
            <h4 class="text-sm font-bold text-stone-900 group-hover:text-purple-950 transition">
              Sincronización y Analítica
            </h4>
            <div class="mt-2">
              <span class="text-sm font-black text-stone-900 block truncate" id="mod-sync-fecha">Consultando...</span>
            </div>
            <p class="text-[11px] text-stone-500 mt-1 truncate" id="mod-sync-hora">
              Fecha de última sincronización
            </p>
          </div>
        </a>

      </div>
    </div>
  </div>

  <!-- SECCIÓN 2: INFO BOXES DE CLIENTES, PROSPECTOS Y RESUMEN GENERAL -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    
    <!-- Info Box 1: Clientes Activos -->
    <div class="info-box">
      <div class="info-box-icon bg-emerald-50 text-emerald-800">
        🏪
      </div>
      <div class="info-box-content">
        <span class="info-box-text">Clientes Activos</span>
        <span class="info-box-number" id="kpi-clientes">--</span>
        <span class="text-[11px] text-stone-400 mt-0.5 block">Tiendas con catálogo y plan</span>
      </div>
    </div>

    <!-- Info Box 2: Prospectos Registrados -->
    <div class="info-box">
      <div class="info-box-icon bg-sky-50 text-sky-800">
        🎯
      </div>
      <div class="info-box-content">
        <span class="info-box-text">Prospectos Registrados</span>
        <span class="info-box-number" id="kpi-prospectos">--</span>
        <span class="text-[11px] text-stone-400 mt-0.5 block">Potenciales clientes en seguimiento</span>
      </div>
    </div>

    <!-- Info Box 3: Sucursales Físicas -->
    <div class="info-box">
      <div class="info-box-icon bg-amber-50 text-amber-800">
        📍
      </div>
      <div class="info-box-content">
        <span class="info-box-text">Sucursales Físicas</span>
        <span class="info-box-number" id="kpi-sucursales">--</span>
        <span class="text-[11px] text-stone-400 mt-0.5 block">Puntos de venta georreferenciados</span>
      </div>
    </div>

    <!-- Info Box 4: Cafés Especiales -->
    <div class="info-box">
      <div class="info-box-icon bg-purple-50 text-purple-800">
        ☕
      </div>
      <div class="info-box-content">
        <span class="info-box-text">Cafés Especiales</span>
        <span class="info-box-number" id="kpi-cafes">--</span>
        <span class="text-[11px] text-stone-400 mt-0.5 block">Variedades activas en comparador</span>
      </div>
    </div>

  </div>

  <!-- SECCIÓN 3: GRÁFICOS DEL DASHBOARD (PLATAFORMAS Y ESTADO DE SINCRONIZACIÓN) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    
    <!-- Gráfico 1: Tiendas según Plataforma -->
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <h3 class="admin-card-title flex items-center gap-2">
            <span>🛒</span>
            <span>Tiendas según Plataforma</span>
          </h3>
          <p class="text-xs text-stone-400 mt-0.5">
            Distribución de tiendas por software de e-commerce o prospección.
          </p>
        </div>
        <div class="admin-card-tools">
          <span class="text-xs font-bold text-stone-600 bg-stone-100 px-2.5 py-1 rounded-lg" id="chart-plataformas-total">
            0 tiendas
          </span>
        </div>
      </div>

      <div class="admin-card-body">
        <!-- Barra de Distribución Segmentada Superior -->
        <div class="mb-5">
          <div class="h-3 w-full rounded-full bg-stone-100 overflow-hidden flex shadow-inner" id="chart-plataformas-bar-segmented">
            <!-- Segmentos dinámicos vía JS -->
          </div>
        </div>

        <!-- Lista detallada de plataformas con barras de progreso -->
        <div class="space-y-3" id="chart-plataformas-list">
          <div class="text-center py-6 text-xs text-stone-400">
            <span class="animate-spin inline-block mr-1">⏳</span> Cargando plataformas...
          </div>
        </div>
      </div>
    </div>

    <!-- Gráfico 2: Estado de Sincronización de Tiendas -->
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <h3 class="admin-card-title flex items-center gap-2">
            <span>🔄</span>
            <span>Estado de Sincronización</span>
          </h3>
          <p class="text-xs text-stone-400 mt-0.5">
            Resultado de la última sincronización ejecutada por tienda.
          </p>
        </div>
        <div class="admin-card-tools">
          <span class="text-xs font-bold text-stone-600 bg-stone-100 px-2.5 py-1 rounded-lg" id="chart-sync-total">
            0 tiendas
          </span>
        </div>
      </div>

      <div class="admin-card-body">
        <!-- Barra de Salud del Pipeline Superior -->
        <div class="mb-5">
          <div class="h-3 w-full rounded-full bg-stone-100 overflow-hidden flex shadow-inner" id="chart-sync-bar-segmented">
            <!-- Segmentos dinámicos vía JS -->
          </div>
        </div>

        <!-- Tarjetas de desglose de estado -->
        <div class="space-y-3" id="chart-sync-list">
          <div class="text-center py-6 text-xs text-stone-400">
            <span class="animate-spin inline-block mr-1">⏳</span> Cargando estado de sincronizaciones...
          </div>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    (async function initDashboard() {
      const API_BASE = document.querySelector('[data-api-base]')?.dataset.apiBase || 'http://localhost:8001';

      const fetchWithEnv = (url, opts = {}) => {
        if (window.plataformaState && typeof window.plataformaState.fetchWithEnv === 'function') {
          return window.plataformaState.fetchWithEnv(url, opts);
        }
        const headers = new Headers(opts.headers || {});
        headers.set('X-Target-Environment', localStorage.getItem('plataforma_active_env') || 'local');
        return fetch(url, { ...opts, headers });
      };

      // Paleta de colores para plataformas
      const PLATFORM_COLORS = {
        'Shopify': { bg: 'bg-emerald-500', text: 'text-emerald-700', badge: 'bg-emerald-50 text-emerald-800 border-emerald-200', icon: '🛍️' },
        'WooCommerce': { bg: 'bg-purple-500', text: 'text-purple-700', badge: 'bg-purple-50 text-purple-800 border-purple-200', icon: '🟣' },
        'Jumpseller': { bg: 'bg-amber-500', text: 'text-amber-700', badge: 'bg-amber-50 text-amber-800 border-amber-200', icon: '⚡' },
        'PrestaShop': { bg: 'bg-sky-500', text: 'text-sky-700', badge: 'bg-sky-50 text-sky-800 border-sky-200', icon: '🐧' },
        'Odoo': { bg: 'bg-indigo-500', text: 'text-indigo-700', badge: 'bg-indigo-50 text-indigo-800 border-indigo-200', icon: '💼' },
        'SumUp': { bg: 'bg-teal-500', text: 'text-teal-700', badge: 'bg-teal-50 text-teal-800 border-teal-200', icon: '💳' },
        'Prospecto': { bg: 'bg-blue-400', text: 'text-blue-700', badge: 'bg-blue-50 text-blue-800 border-blue-200', icon: '🎯' },
        'Otra': { bg: 'bg-stone-400', text: 'text-stone-700', badge: 'bg-stone-100 text-stone-700 border-stone-200', icon: '⚙️' },
      };

      function renderPlatformChart(conteoPlataformas, totalTiendas) {
        const listEl = document.getElementById('chart-plataformas-list');
        const barSegEl = document.getElementById('chart-plataformas-bar-segmented');
        const totalEl = document.getElementById('chart-plataformas-total');

        if (!listEl) return;
        if (totalEl) totalEl.textContent = `${totalTiendas} tiendas`;

        const entries = Object.entries(conteoPlataformas || {})
          .filter(([_, count]) => count > 0)
          .sort((a, b) => b[1] - a[1]);

        if (entries.length === 0) {
          listEl.innerHTML = '<div class="py-6 text-center text-xs text-stone-400">Sin datos de plataformas registradas.</div>';
          if (barSegEl) barSegEl.innerHTML = '';
          return;
        }

        // 1. Barra segmentada multicolor
        if (barSegEl) {
          barSegEl.innerHTML = entries.map(([plat, count]) => {
            const pct = totalTiendas > 0 ? Math.round((count / totalTiendas) * 100) : 0;
            const style = PLATFORM_COLORS[plat] || PLATFORM_COLORS['Otra'];
            return `<div class="${style.bg} h-full transition-all duration-500" style="width: ${pct}%;" title="${plat}: ${count} tiendas (${pct}%)"></div>`;
          }).join('');
        }

        // 2. Filas de progreso detalladas
        listEl.innerHTML = entries.map(([plat, count]) => {
          const pct = totalTiendas > 0 ? Math.round((count / totalTiendas) * 100) : 0;
          const style = PLATFORM_COLORS[plat] || PLATFORM_COLORS['Otra'];
          return `
            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-stone-800 flex items-center gap-1.5">
                  <span>${style.icon}</span>
                  <span>${plat}</span>
                </span>
                <span class="text-stone-500 font-semibold text-[11px]">
                  <strong>${count}</strong> tiendas <span class="text-stone-400 font-normal">(${pct}%)</span>
                </span>
              </div>
              <div class="h-2 w-full rounded-full bg-stone-100 overflow-hidden">
                <div class="${style.bg} h-full rounded-full transition-all duration-700" style="width: ${pct}%;"></div>
              </div>
            </div>
          `;
        }).join('');
      }

      function renderSyncChart(conteoSync, totalTiendas) {
        const listEl = document.getElementById('chart-sync-list');
        const barSegEl = document.getElementById('chart-sync-bar-segmented');
        const totalEl = document.getElementById('chart-sync-total');

        if (!listEl) return;
        if (totalEl) totalEl.textContent = `${totalTiendas} tiendas`;

        const exitoso = conteoSync?.exitoso || 0;
        const fallido = conteoSync?.fallido || 0;
        const pendiente = conteoSync?.pendiente || 0;

        const pctExitoso = totalTiendas > 0 ? Math.round((exitoso / totalTiendas) * 100) : 0;
        const pctFallido = totalTiendas > 0 ? Math.round((fallido / totalTiendas) * 100) : 0;
        const pctPendiente = totalTiendas > 0 ? Math.max(0, 100 - pctExitoso - pctFallido) : 0;

        // Barra segmentada superior
        if (barSegEl) {
          barSegEl.innerHTML = `
            <div class="bg-emerald-500 h-full transition-all duration-500" style="width: ${pctExitoso}%;" title="Exitosas: ${exitoso} (${pctExitoso}%)"></div>
            <div class="bg-rose-500 h-full transition-all duration-500" style="width: ${pctFallido}%;" title="Con Error: ${fallido} (${pctFallido}%)"></div>
            <div class="bg-stone-300 h-full transition-all duration-500" style="width: ${pctPendiente}%;" title="Pendientes: ${pendiente} (${pctPendiente}%)"></div>
          `;
        }

        // Tarjetas y barras detalladas
        listEl.innerHTML = `
          <!-- Exitosas -->
          <div class="p-3 rounded-xl border border-emerald-200/80 bg-emerald-50/40 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-emerald-950 flex items-center gap-1.5">
                <span>✅</span>
                <span>Sincronizadas Exitosamente</span>
              </span>
              <span class="text-emerald-800 font-bold text-xs">
                ${exitoso} tiendas <span class="text-emerald-600 font-normal">(${pctExitoso}%)</span>
              </span>
            </div>
            <div class="h-2 w-full rounded-full bg-emerald-100 overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full transition-all duration-700" style="width: ${pctExitoso}%;"></div>
            </div>
          </div>

          <!-- Con Error -->
          <div class="p-3 rounded-xl border ${fallido > 0 ? 'border-rose-300 bg-rose-50/70 shadow-2xs' : 'border-stone-200 bg-stone-50/40'} space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold ${fallido > 0 ? 'text-rose-950' : 'text-stone-700'} flex items-center gap-1.5">
                <span>❌</span>
                <span>Con Error de Conexión</span>
              </span>
              <span class="${fallido > 0 ? 'text-rose-800 font-black' : 'text-stone-500 font-semibold'} text-xs">
                ${fallido} tiendas <span class="font-normal opacity-80">(${pctFallido}%)</span>
              </span>
            </div>
            <div class="h-2 w-full rounded-full bg-stone-200 overflow-hidden">
              <div class="bg-rose-500 h-full rounded-full transition-all duration-700" style="width: ${pctFallido}%;"></div>
            </div>
          </div>

          <!-- Pendientes / Nunca -->
          <div class="p-3 rounded-xl border border-stone-200/80 bg-stone-50/50 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-stone-700 flex items-center gap-1.5">
                <span>⏳</span>
                <span>Pendientes / Nunca Sincronizadas</span>
              </span>
              <span class="text-stone-600 font-bold text-xs">
                ${pendiente} tiendas <span class="text-stone-400 font-normal">(${pctPendiente}%)</span>
              </span>
            </div>
            <div class="h-2 w-full rounded-full bg-stone-200 overflow-hidden">
              <div class="bg-stone-400 h-full rounded-full transition-all duration-700" style="width: ${pctPendiente}%;"></div>
            </div>
          </div>
        `;
      }

      // Cargar KPIs, Módulos y Gráficos del ambiente activo
      async function loadMetrics() {
        try {
          const res = await fetchWithEnv(`${API_BASE}/api/v1/administracion/estado`);
          if (res.ok) {
            const data = await res.json();
            
            // Total tiendas, productos, sucursales, prospectos, clientes
            const totalTiendas = data.total_tiendas ?? 0;
            const totalProductos = data.total_productos ?? 0;
            const totalSucursales = data.total_sucursales ?? 0;
            const totalProspectos = data.total_prospectos ?? 0;
            const totalClientes = data.total_clientes ?? (totalTiendas - totalProspectos);
            const totalCafes = data.total_cafes ?? totalProductos;
            const sinModerar = data.productos_sin_moderar ?? 0;

            // 1. Asignar valores en sección "Módulos de la Plataforma" al inicio
            const modTiendasCount = document.getElementById('mod-tiendas-count');
            const modSucursalesCount = document.getElementById('mod-sucursales-count');
            const modModProds = document.getElementById('mod-mod-prods');
            const modSospechososCount = document.getElementById('mod-sospechosos-count');
            const modSospechososBadge = document.getElementById('mod-sospechosos-badge');
            const modTotalProds = document.getElementById('mod-total-prods');
            const modCafesCount = document.getElementById('mod-cafes-count');
            const modSyncFecha = document.getElementById('mod-sync-fecha');
            const modSyncHora = document.getElementById('mod-sync-hora');

            if (modTiendasCount) modTiendasCount.textContent = totalTiendas;
            if (modSucursalesCount) modSucursalesCount.textContent = totalSucursales;
            if (modModProds) modModProds.textContent = totalProductos;
            if (modSospechososCount) modSospechososCount.textContent = sinModerar;
            if (modSospechososBadge) {
              if (sinModerar > 0) {
                modSospechososBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300';
              } else {
                modSospechososBadge.className = 'inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-bold bg-emerald-100 text-emerald-900 border border-emerald-300';
                modSospechososBadge.innerHTML = '<span>✅</span><span>0 sospechosos (al día)</span>';
              }
            }

            if (modTotalProds) modTotalProds.textContent = totalProductos;
            if (modCafesCount) modCafesCount.textContent = totalCafes;

            // Fecha última sincronización
            if (data.ultima_sincronizacion) {
              const d = new Date(data.ultima_sincronizacion);
              if (!isNaN(d.getTime())) {
                const fecha = d.toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const hora = d.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' }) + ' hrs';
                if (modSyncFecha) modSyncFecha.textContent = fecha;
                if (modSyncHora) modSyncHora.textContent = `${hora} · Ejecución global`;
              } else {
                if (modSyncFecha) modSyncFecha.textContent = data.ultima_sincronizacion;
                if (modSyncHora) modSyncHora.textContent = 'Ejecución global';
              }
            } else {
              if (modSyncFecha) modSyncFecha.textContent = 'Sin registros';
              if (modSyncHora) modSyncHora.textContent = 'Nunca ejecutado';
            }

            // 2. Asignar valores en sección de InfoBoxes (Clientes, Prospectos, Sucursales, Cafés)
            const kpiClientes = document.getElementById('kpi-clientes');
            const kpiProspectos = document.getElementById('kpi-prospectos');
            const kpiSucursales = document.getElementById('kpi-sucursales');
            const kpiCafes = document.getElementById('kpi-cafes');

            if (kpiClientes) kpiClientes.textContent = totalClientes;
            if (kpiProspectos) kpiProspectos.textContent = totalProspectos;
            if (kpiSucursales) kpiSucursales.textContent = totalSucursales;
            if (kpiCafes) kpiCafes.textContent = totalCafes;

            // Banner superior de alerta de moderación
            const bannerMod = document.getElementById('banner-moderacion');
            const bannerBadge = document.getElementById('banner-moderacion-badge');
            if (sinModerar > 0) {
              if (bannerMod) bannerMod.classList.remove('hidden');
              if (bannerBadge) bannerBadge.textContent = sinModerar;
            } else {
              if (bannerMod) bannerMod.classList.add('hidden');
            }

            const cachedStores = data.tiendas_resumen || [];

            // 3. Renderizar Gráfico de Plataformas
            const plataformas = data.conteo_plataformas || {};
            if (Object.keys(plataformas).length === 0 && cachedStores.length > 0) {
              cachedStores.forEach(s => {
                let plat = (s.plataforma || 'desconocida').trim();
                if (s.es_prospecto) plat = 'Prospecto';
                else if (plat.toLowerCase() === 'shopify') plat = 'Shopify';
                else if (plat.toLowerCase().includes('woo')) plat = 'WooCommerce';
                else if (plat.toLowerCase() === 'jumpseller') plat = 'Jumpseller';
                else if (plat.toLowerCase() === 'prestashop') plat = 'PrestaShop';
                else if (plat.toLowerCase() === 'odoo') plat = 'Odoo';
                else if (plat.toLowerCase() === 'sumup') plat = 'SumUp';
                else plat = plat ? (plat.charAt(0).toUpperCase() + plat.slice(1)) : 'Otra';
                plataformas[plat] = (plataformas[plat] || 0) + 1;
              });
            }
            renderPlatformChart(plataformas, totalTiendas || cachedStores.length);

            // 4. Renderizar Gráfico de Estados de Sincronización
            const conteoSync = data.conteo_estados_sync || {
              exitoso: cachedStores.filter(s => s.estado_ultimo === 'exitoso').length,
              fallido: cachedStores.filter(s => s.estado_ultimo === 'fallido').length,
              pendiente: cachedStores.filter(s => s.estado_ultimo === 'nunca').length,
            };
            renderSyncChart(conteoSync, totalTiendas || cachedStores.length);
          }
        } catch (e) {
          console.warn('Error al cargar métricas de administración', e);
        }

        // Actualizar indicador de ambiente
        const activeEnv = localStorage.getItem('plataforma_active_env') || 'local';
        const badgeEnv = document.getElementById('badge-ambiente-activo');
        if (badgeEnv) {
          if (activeEnv === 'supabase') {
            badgeEnv.innerHTML = '<span class="h-2 w-2 rounded-full bg-emerald-500"></span><span>Ambiente: Supabase (Producción)</span>';
            badgeEnv.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-300';
          } else {
            badgeEnv.innerHTML = '<span class="h-2 w-2 rounded-full bg-sky-500 animate-pulse"></span><span>Ambiente: Localhost</span>';
            badgeEnv.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-stone-100 text-stone-600 border border-stone-200';
          }
        }
      }

      window.addEventListener('plataforma:env-changed', () => {
        loadMetrics();
      });

      setTimeout(() => {
        loadMetrics();
      }, 200);
    })();
  </script>
</AdminLteLayout>