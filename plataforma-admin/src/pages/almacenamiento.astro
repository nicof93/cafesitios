---
import AdminLteLayout from '../layouts/AdminLteLayout.astro';

const apiBaseUrl = import.meta.env.PUBLIC_PLATAFORMA_API_BASE_URL || "http://localhost:8001";
---

<AdminLteLayout 
  title="Auditoría de Almacenamiento y BD por Tienda | Plataforma Admin"
  activeNav="almacenamiento"
  breadcrumb={[{ label: "Inicio", url: "/plataforma/" }, { label: "Almacenamiento y BD" }]}
>
  <div class="space-y-6" data-api-base={apiBaseUrl}>
    
    <!-- CABECERA DE LA PÁGINA -->
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-stone-200/80 pb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-black tracking-tight text-stone-900 flex items-center gap-2">
          <span>💾</span>
          <span>Auditoría de Almacenamiento y Base de Datos</span>
        </h1>
        <p class="mt-1 text-xs text-stone-500 max-w-2xl">
          Monitoreo en tiempo real del uso de espacio en disco (fotos de cafés subidas frente a la cuota permitida) y estimación del tamaño de datos en PostgreSQL/SQLite por cada tostaduría en el sistema multi-tenant.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-refresh-storage"
          class="inline-flex items-center gap-2 rounded-xl border border-stone-200 bg-white px-3.5 py-2 text-xs font-semibold text-stone-700 shadow-xs hover:bg-stone-50 transition active:scale-95"
        >
          <span>🔄</span>
          <span>Actualizar Datos</span>
        </button>
      </div>
    </div>

    <!-- TARJETAS DE RESUMEN KPI -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs flex items-center gap-4">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700 text-2xl font-black shrink-0">
          🖼️
        </span>
        <div class="min-w-0">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Fotos en Disco</span>
          <h3 class="text-xl font-black text-stone-900 truncate" id="stat-total-img-mb">- MB</h3>
          <span class="text-[11px] text-stone-500 font-medium" id="stat-total-img-files">- archivos</span>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs flex items-center gap-4">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-700 text-2xl font-black shrink-0">
          🗄️
        </span>
        <div class="min-w-0">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Datos en Base de Datos</span>
          <h3 class="text-xl font-black text-stone-900 truncate" id="stat-total-bd-mb">- MB</h3>
          <span class="text-[11px] text-stone-500 font-medium" id="stat-total-bd-rows">- filas</span>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs flex items-center gap-4">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-800 text-2xl font-black shrink-0">
          ⚖️
        </span>
        <div class="min-w-0">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Total Plataforma</span>
          <h3 class="text-xl font-black text-stone-900 truncate" id="stat-total-combined-mb">- MB</h3>
          <span class="text-[11px] text-stone-500 font-medium">Fotos + Tablas Relacionales</span>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs flex items-center gap-4">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-rose-50 text-rose-700 text-2xl font-black shrink-0">
          ⚠️
        </span>
        <div class="min-w-0">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Alertas de Cuota</span>
          <h3 class="text-xl font-black text-stone-900 truncate" id="stat-alert-stores">0</h3>
          <span class="text-[11px] text-stone-500 font-medium" id="stat-alert-desc">Todas bajo el 80%</span>
        </div>
      </div>
    </div>

    <!-- TARJETAS DE MÁXIMOS CONSUMIDORES -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-amber-200/80 bg-amber-50/40 p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📸</span>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-amber-900">Mayor Consumo de Fotos</span>
            <h4 class="text-sm font-black text-stone-900" id="top-store-img-name">-</h4>
          </div>
        </div>
        <div class="text-right">
          <span class="text-sm font-black text-amber-900" id="top-store-img-val">- MB</span>
        </div>
      </div>

      <div class="rounded-2xl border border-blue-200/80 bg-blue-50/40 p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📊</span>
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-blue-900">Mayor Volumen en BD</span>
            <h4 class="text-sm font-black text-stone-900" id="top-store-bd-name">-</h4>
          </div>
        </div>
        <div class="text-right">
          <span class="text-sm font-black text-blue-900" id="top-store-bd-val">- MB</span>
        </div>
      </div>
    </div>

    <!-- FILTROS Y ORDENAMIENTO -->
    <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs">
      <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
        <div class="relative flex-1">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-400">
            🔍
          </span>
          <input
            type="text"
            id="input-search-store"
            placeholder="Buscar por nombre de tienda..."
            class="w-full rounded-xl border border-stone-200 bg-stone-50/50 pl-9 pr-4 py-2 text-xs font-medium text-stone-800 placeholder-stone-400 focus:bg-white focus:border-stone-400 focus:outline-hidden transition"
          />
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <div class="flex items-center gap-1.5">
            <label for="select-sort" class="text-xs font-semibold text-stone-500 whitespace-nowrap">Ordenar por:</label>
            <select
              id="select-sort"
              class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-xs font-semibold text-stone-700 shadow-xs focus:outline-hidden cursor-pointer"
            >
              <option value="total_desc">Mayor Peso Total (Fotos + BD)</option>
              <option value="img_desc">Mayor Peso de Fotos</option>
              <option value="bd_desc">Mayor Peso en Base de Datos</option>
              <option value="quota_desc">Mayor % de Cuota Usado</option>
              <option value="name_asc">Nombre de Tienda (A - Z)</option>
            </select>
          </div>

          <div class="flex items-center gap-1.5">
            <label for="select-quota-filter" class="text-xs font-semibold text-stone-500 whitespace-nowrap">Cuota:</label>
            <select
              id="select-quota-filter"
              class="rounded-xl border border-stone-200 bg-white px-3 py-2 text-xs font-semibold text-stone-700 shadow-xs focus:outline-hidden cursor-pointer"
            >
              <option value="all">Todas las tiendas</option>
              <option value="warning">En advertencia / Alerta (&ge;80%)</option>
              <option value="normal">Normal (&lt;80%)</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLA DE ALMACENAMIENTO POR TIENDA -->
    <div class="rounded-2xl border border-stone-200 bg-white shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-stone-200 bg-stone-50/80 text-[11px] font-bold uppercase tracking-wider text-stone-500">
              <th class="py-3 px-4">Tienda</th>
              <th class="py-3 px-4">Fotos Subidas</th>
              <th class="py-3 px-4">Uso de Cuota (Límite)</th>
              <th class="py-3 px-4">Registros BD</th>
              <th class="py-3 px-4">Peso BD</th>
              <th class="py-3 px-4">Peso Total</th>
              <th class="py-3 px-4 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="tbody-storage" class="divide-y divide-stone-100">
            <tr>
              <td colspan="7" class="py-12 text-center text-stone-400">
                <div class="flex flex-col items-center justify-center gap-2">
                  <span class="animate-spin text-2xl">⏳</span>
                  <span>Calculando almacenamiento y peso de base de datos...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="p-3 border-t border-stone-100 bg-stone-50/50 flex items-center justify-between text-xs text-stone-500 font-medium">
        <span id="label-table-count">Mostrando 0 tiendas</span>
        <span class="text-[11px] text-stone-400">Cálculo en vivo mediante funciones de disco y pg_column_size</span>
      </div>
    </div>

  </div>

  <!-- MODAL DE DESGLOSE TÉCNICO DE BD -->
  <dialog id="modal-db-breakdown" class="rounded-2xl border border-stone-200 bg-white p-0 shadow-2xl backdrop:bg-stone-900/40 max-w-xl w-full">
    <div class="p-5 border-b border-stone-200 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="text-2xl">🗄️</span>
        <div>
          <h3 class="text-sm font-black text-stone-900" id="modal-store-name">Desglose de Base de Datos</h3>
          <p class="text-[11px] text-stone-500" id="modal-store-totals">Estimación detallada de filas y tamaño por tabla</p>
        </div>
      </div>
      <button 
        type="button" 
        id="btn-close-modal" 
        class="h-8 w-8 rounded-lg flex items-center justify-center text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition"
      >
        ✕
      </button>
    </div>

    <div class="p-5 space-y-4">
      <div class="rounded-xl border border-stone-200 overflow-hidden">
        <table class="w-full text-left text-xs">
          <thead>
            <tr class="bg-stone-50 border-b border-stone-200 text-[11px] font-bold uppercase text-stone-500">
              <th class="py-2.5 px-3">Entidad / Tabla</th>
              <th class="py-2.5 px-3 text-right">Filas</th>
              <th class="py-2.5 px-3 text-right">Tamaño</th>
              <th class="py-2.5 px-3 text-right">% Relativo</th>
            </tr>
          </thead>
          <tbody id="modal-table-rows" class="divide-y divide-stone-100">
            <!-- Renderizado dinámico -->
          </tbody>
        </table>
      </div>
    </div>

    <div class="p-4 border-t border-stone-100 bg-stone-50/50 flex justify-end">
      <button
        type="button"
        id="btn-close-modal-bottom"
        class="rounded-xl bg-stone-800 px-4 py-2 text-xs font-semibold text-white hover:bg-stone-900 transition"
      >
        Cerrar
      </button>
    </div>
  </dialog>

  <script is:inline>
    (function initStorageDashboard() {
      let globalData = null;
      let currentFilter = 'all';
      let currentSearch = '';
      let currentSort = 'total_desc';

      const tbody = document.getElementById('tbody-storage');
      const labelCount = document.getElementById('label-table-count');
      const searchInput = document.getElementById('input-search-store');
      const sortSelect = document.getElementById('select-sort');
      const quotaFilterSelect = document.getElementById('select-quota-filter');
      const btnRefresh = document.getElementById('btn-refresh-storage');

      const modal = document.getElementById('modal-db-breakdown');
      const modalStoreName = document.getElementById('modal-store-name');
      const modalStoreTotals = document.getElementById('modal-store-totals');
      const modalTableRows = document.getElementById('modal-table-rows');
      const btnCloseModal = document.getElementById('btn-close-modal');
      const btnCloseModalBottom = document.getElementById('btn-close-modal-bottom');

      function formatBytes(bytes) {
        if (!bytes || bytes === 0) return '0 B';
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
      }

      function openBreakdownModal(store) {
        modalStoreName.textContent = store.nombre;
        modalStoreTotals.textContent = `${store.base_datos.total_filas.toLocaleString('es-CL')} filas totales · ${formatBytes(store.base_datos.peso_bytes)}`;

        const desglose = store.base_datos.desglose_tablas || {};
        const totalBytes = store.base_datos.peso_bytes || 1;

        const tableLabels = {
          productos: { name: 'Cafés y Productos', icon: '☕' },
          variantes: { name: 'Variantes y Gramajes', icon: '⚖️' },
          historial_precios: { name: 'Historial de Precios', icon: '📈' },
          auditoria_acciones: { name: 'Auditoría y Bitácora', icon: '📜' },
          recetas: { name: 'Guías y Recetas', icon: '📖' },
          sucursales: { name: 'Sucursales Físicas', icon: '📍' },
          sincronizaciones: { name: 'Logs de Sincronización', icon: '🔄' },
          otros: { name: 'Ofertas y Leads', icon: '🏷️' },
        };

        let html = '';
        for (const [key, meta] of Object.entries(tableLabels)) {
          const item = desglose[key] || { filas: 0, bytes: 0 };
          const pct = ((item.bytes / totalBytes) * 100).toFixed(1);
          html += `
            <tr class="hover:bg-stone-50/50 transition">
              <td class="py-2.5 px-3 flex items-center gap-2">
                <span>${meta.icon}</span>
                <span class="font-semibold text-stone-800">${meta.name}</span>
                <span class="text-[10px] text-stone-400 font-mono">(${key})</span>
              </td>
              <td class="py-2.5 px-3 text-right font-medium text-stone-700">
                ${item.filas.toLocaleString('es-CL')}
              </td>
              <td class="py-2.5 px-3 text-right font-mono font-semibold text-stone-900">
                ${formatBytes(item.bytes)}
              </td>
              <td class="py-2.5 px-3 text-right font-medium text-stone-500">
                <div class="flex items-center justify-end gap-1.5">
                  <div class="w-12 h-1.5 rounded-full bg-stone-200 overflow-hidden">
                    <div class="h-full bg-blue-600 rounded-full" style="width: ${pct}%"></div>
                  </div>
                  <span class="w-10 text-[11px]">${pct}%</span>
                </div>
              </td>
            </tr>
          `;
        }

        modalTableRows.innerHTML = html;
        if (modal.showModal) {
          modal.showModal();
        } else {
          modal.setAttribute('open', 'true');
        }
      }

      function closeModal() {
        if (modal.close) {
          modal.close();
        } else {
          modal.removeAttribute('open');
        }
      }

      btnCloseModal.addEventListener('click', closeModal);
      btnCloseModalBottom.addEventListener('click', closeModal);

      const API_BASE = document.querySelector('[data-api-base]')?.dataset.apiBase || 'http://localhost:8001';

      async function fetchStorageReport() {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="py-12 text-center text-stone-400">
              <div class="flex flex-col items-center justify-center gap-2">
                <span class="animate-spin text-2xl">⏳</span>
                <span>Calculando almacenamiento y peso de base de datos...</span>
              </div>
            </td>
          </tr>
        `;

        try {
          const endpointUrl = `${API_BASE}/api/v1/administracion/tiendas/almacenamiento`;
          const res = await (window.plataformaState && typeof window.plataformaState.fetchWithEnv === 'function'
            ? window.plataformaState.fetchWithEnv(endpointUrl)
            : fetch(endpointUrl));

          if (!res.ok) {
            throw new Error(`Error HTTP: ${res.status}`);
          }

          globalData = await res.json();
          renderDashboard();
        } catch (err) {
          if (window.plataformaNotify) {
            window.plataformaNotify(`Error al consultar almacenamiento: ${err.message}`, 'error');
          }
          tbody.innerHTML = `
            <tr>
              <td colspan="7" class="py-12 text-center text-rose-500">
                <div class="flex flex-col items-center justify-center gap-2">
                  <span class="text-2xl">⚠️</span>
                  <span class="font-bold">Error al consultar el almacenamiento</span>
                  <span class="text-xs text-stone-400">${err.message}</span>
                </div>
              </td>
            </tr>
          `;
        }
      }

      function renderDashboard() {
        if (!globalData) return;

        const resumen = globalData.resumen_global;
        document.getElementById('stat-total-img-mb').textContent = `${resumen.total_imagenes_mb.toLocaleString('es-CL')} MB`;
        document.getElementById('stat-total-img-files').textContent = `${resumen.total_imagenes.toLocaleString('es-CL')} archivos subidos`;

        document.getElementById('stat-total-bd-mb').textContent = `${resumen.total_bd_mb.toLocaleString('es-CL')} MB`;
        document.getElementById('stat-total-bd-rows').textContent = `${resumen.total_filas_bd.toLocaleString('es-CL')} filas en tablas`;

        document.getElementById('stat-total-combined-mb').textContent = `${resumen.total_combinado_mb.toLocaleString('es-CL')} MB`;

        // Tiendas en alerta (>80%)
        let alertCount = 0;
        globalData.tiendas.forEach(t => {
          if (t.imagenes.estado_cuota !== 'normal') alertCount++;
        });
        document.getElementById('stat-alert-stores').textContent = alertCount;
        document.getElementById('stat-alert-desc').textContent = alertCount === 0 
          ? 'Todas bajo el 80% de cuota' 
          : `${alertCount} tienda(s) en advertencia o cuota superada`;

        // Top tiendas
        if (resumen.tienda_mayor_consumo_imagenes) {
          document.getElementById('top-store-img-name').textContent = resumen.tienda_mayor_consumo_imagenes.nombre;
          document.getElementById('top-store-img-val').textContent = `${resumen.tienda_mayor_consumo_imagenes.peso_imagenes_mb} MB`;
        }
        if (resumen.tienda_mayor_consumo_bd) {
          document.getElementById('top-store-bd-name').textContent = resumen.tienda_mayor_consumo_bd.nombre;
          document.getElementById('top-store-bd-val').textContent = `${resumen.tienda_mayor_consumo_bd.peso_bd_mb} MB`;
        }

        renderTable();
      }

      function renderTable() {
        if (!globalData) return;

        let items = [...globalData.tiendas];

        // Filtro por búsqueda
        if (currentSearch.trim()) {
          const q = currentSearch.toLowerCase().trim();
          items = items.filter(t => t.nombre.toLowerCase().includes(q));
        }

        // Filtro por cuota
        if (currentFilter === 'warning') {
          items = items.filter(t => t.imagenes.estado_cuota !== 'normal');
        } else if (currentFilter === 'normal') {
          items = items.filter(t => t.imagenes.estado_cuota === 'normal');
        }

        // Ordenamiento
        items.sort((a, b) => {
          if (currentSort === 'total_desc') return b.peso_total_mb - a.peso_total_mb;
          if (currentSort === 'img_desc') return b.imagenes.peso_bytes - a.imagenes.peso_bytes;
          if (currentSort === 'bd_desc') return b.base_datos.peso_bytes - a.base_datos.peso_bytes;
          if (currentSort === 'quota_desc') return b.imagenes.porcentaje_usado - a.imagenes.porcentaje_usado;
          if (currentSort === 'name_asc') return a.nombre.localeCompare(b.nombre);
          return 0;
        });

        labelCount.textContent = `Mostrando ${items.length} de ${globalData.tiendas.length} tiendas`;

        if (items.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="7" class="py-12 text-center text-stone-400">
                <span>No se encontraron tiendas que coincidan con los filtros aplicados.</span>
              </td>
            </tr>
          `;
          return;
        }

        let html = '';
        items.forEach(store => {
          const img = store.imagenes;
          const bd = store.base_datos;
          const pct = Math.min(img.porcentaje_usado, 100);

          let quotaBadge = '';
          let barColor = 'bg-emerald-500';

          if (img.estado_cuota === 'superado') {
            quotaBadge = `<span class="inline-flex items-center gap-1 rounded-md bg-rose-50 px-2 py-0.5 text-[10px] font-bold text-rose-700 border border-rose-200">⚠️ Superado</span>`;
            barColor = 'bg-rose-500';
          } else if (img.estado_cuota === 'advertencia') {
            quotaBadge = `<span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-bold text-amber-700 border border-amber-200">⚡ Alerta (>80%)</span>`;
            barColor = 'bg-amber-500';
          } else {
            quotaBadge = `<span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200">✓ Normal</span>`;
          }

          const defaultLogo = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23666'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z'/%3E%3C/svg%3E";

          html += `
            <tr class="hover:bg-stone-50/60 transition group">
              <!-- Tienda -->
              <td class="py-3 px-4">
                <div class="flex items-center gap-3">
                  <img 
                    src="${store.logo_url || defaultLogo}" 
                    alt="${store.nombre}" 
                    class="h-8 w-8 rounded-lg object-contain bg-stone-100 p-0.5 border border-stone-200 shrink-0"
                    onerror="this.src='${defaultLogo}'"
                  />
                  <div>
                    <div class="font-bold text-stone-900 group-hover:text-emerald-900 transition flex items-center gap-1.5">
                      <span>${store.nombre}</span>
                      ${quotaBadge}
                    </div>
                    <div class="flex items-center gap-2 text-[10px] text-stone-400">
                      <span class="capitalize font-medium">${store.plataforma || 'web'}</span>
                      <span>·</span>
                      <span>ID #${store.tienda_id}</span>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Fotos subidas -->
              <td class="py-3 px-4">
                <div class="font-bold text-stone-900">${img.peso_mb} MB</div>
                <div class="text-[11px] text-stone-400 font-medium">${img.total_archivos} archivo(s)</div>
              </td>

              <!-- Uso de cuota -->
              <td class="py-3 px-4 w-44">
                <div class="flex items-center justify-between text-[11px] font-bold text-stone-700 mb-1">
                  <span>${pct}%</span>
                  <span class="text-stone-400 font-normal">de ${store.limite_almacenamiento_mb} MB</span>
                </div>
                <div class="w-full h-2 rounded-full bg-stone-200 overflow-hidden">
                  <div class="h-full ${barColor} rounded-full transition-all duration-300" style="width: ${pct}%"></div>
                </div>
              </td>

              <!-- Registros BD -->
              <td class="py-3 px-4">
                <div class="font-bold text-stone-900">${bd.total_filas.toLocaleString('es-CL')}</div>
                <div class="text-[11px] text-stone-400 font-medium">filas en BD</div>
              </td>

              <!-- Peso BD -->
              <td class="py-3 px-4">
                <div class="font-bold text-blue-700">${bd.peso_mb} MB</div>
                <div class="text-[11px] text-stone-400 font-mono">${bd.peso_kb} KB</div>
              </td>

              <!-- Peso Total -->
              <td class="py-3 px-4">
                <div class="font-black text-stone-900">${store.peso_total_mb} MB</div>
                <div class="text-[10px] text-stone-400">Fotos + BD</div>
              </td>

              <!-- Acciones -->
              <td class="py-3 px-4 text-right">
                <button
                  type="button"
                  data-store-id="${store.tienda_id}"
                  class="btn-open-breakdown inline-flex items-center gap-1.5 rounded-lg border border-stone-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-stone-700 shadow-xs hover:bg-stone-50 hover:text-blue-700 transition active:scale-95"
                  title="Ver desglose detallado de tablas"
                >
                  <span>🗄️</span>
                  <span>Desglose BD</span>
                </button>
              </td>
            </tr>
          `;
        });

        tbody.innerHTML = html;

        // Asignar listeners a los botones de desglose
        tbody.querySelectorAll('.btn-open-breakdown').forEach(btn => {
          btn.addEventListener('click', () => {
            const tId = parseInt(btn.getAttribute('data-store-id'), 10);
            const store = globalData.tiendas.find(t => t.tienda_id === tId);
            if (store) openBreakdownModal(store);
          });
        });
      }

      // Listeners
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value;
        renderTable();
      });

      sortSelect.addEventListener('change', (e) => {
        currentSort = e.target.value;
        renderTable();
      });

      quotaFilterSelect.addEventListener('change', (e) => {
        currentFilter = e.target.value;
        renderTable();
      });

      btnRefresh.addEventListener('click', () => {
        fetchStorageReport();
      });

      // Recargar al cambiar ambiente (localhost <-> supabase)
      window.addEventListener('plataforma:env-changed', () => {
        fetchStorageReport();
      });

      // Carga inicial
      fetchStorageReport();
    })();
  </script>
</AdminLteLayout>

