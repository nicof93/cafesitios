---
import AdminLteLayout from '../layouts/AdminLteLayout.astro';
---

<AdminLteLayout title="Buzón de Feedback | Plataforma Admin" activeNav="feedback">
  <div class="space-y-6">
    
    <!-- ENCABEZADO -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-xl sm:text-2xl font-black text-stone-900 tracking-tight">📬 Buzón de Feedback y Sugerencias</h1>
          <span class="rounded-full bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 font-bold">Comunidad</span>
        </div>
        <p class="text-xs text-stone-500 mt-1 max-w-2xl">
          Mensajes, sugerencias y reportes enviados por usuarios desde el pie de página ("Tu opinión nos ayuda a mejorar").
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-refresh-feedback"
          class="inline-flex items-center gap-2 rounded-xl border border-stone-200 bg-white px-4 py-2 text-xs font-bold text-stone-700 hover:bg-stone-50 transition shadow-2xs"
        >
          <span>🔄</span>
          <span>Actualizar</span>
        </button>
      </div>
    </div>

    <!-- TARJETAS KPIS -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
        <span class="text-[11px] font-bold text-stone-400 uppercase tracking-wider block mb-1">Total Mensajes</span>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-black text-stone-900" id="kpi-total-feedback">0</span>
          <span class="text-xs font-semibold text-stone-500">recibidos</span>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
        <span class="text-[11px] font-bold text-stone-400 uppercase tracking-wider block mb-1">Con Contacto Registrado</span>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl sm:text-3xl font-black text-emerald-700" id="kpi-con-contacto">0</span>
          <span class="text-xs font-semibold text-stone-500">emails o teléfonos</span>
        </div>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs">
        <span class="text-[11px] font-bold text-stone-400 uppercase tracking-wider block mb-1">Categoría Principal</span>
        <div class="flex items-baseline gap-2">
          <span class="text-lg sm:text-xl font-black text-stone-800 truncate" id="kpi-top-categoria">-</span>
        </div>
      </div>
    </div>

    <!-- FILTROS Y BÚSQUEDA -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-stone-200 shadow-xs">
      <div class="relative max-w-sm w-full">
        <input
          type="search"
          id="search-feedback"
          placeholder="Buscar en el mensaje o contacto..."
          class="w-full rounded-xl border border-stone-200 bg-stone-50/50 py-2 pl-9 pr-3 text-xs placeholder:text-stone-400 focus:border-emerald-600 focus:bg-white focus:ring-1 focus:ring-emerald-600 transition"
        />
        <span class="absolute left-3 top-2.5 text-stone-400 text-xs" aria-hidden="true">🔍</span>
      </div>

      <div class="flex items-center gap-2 text-xs text-stone-500 font-medium">
        <span>Filtrar categoría:</span>
        <select id="filter-categoria" class="rounded-xl border border-stone-200 bg-white px-3 py-1.5 text-xs text-stone-700 focus:outline-none focus:ring-1 focus:ring-emerald-600">
          <option value="">Todas las categorías</option>
          <option value="tienda_no_listada">🏪 Tienda no listada</option>
          <option value="correccion_datos">✏️ Corrección de datos</option>
          <option value="nueva_funcion">💡 Sugerencia de función</option>
          <option value="bug">🐛 Reporte de error</option>
          <option value="otro">💬 Otro</option>
        </select>
      </div>
    </div>

    <!-- TABLA DE MENSAJES -->
    <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-xs">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-stone-200 bg-stone-50/80 text-[11px] font-bold text-stone-600 uppercase tracking-wider">
              <th class="py-3 px-4 w-32">Fecha</th>
              <th class="py-3 px-4 w-44">Categoría</th>
              <th class="py-3 px-4">Mensaje / Sugerencia</th>
              <th class="py-3 px-4 w-52">Contacto Opcional</th>
              <th class="py-3 px-4 w-20 text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="tbody-feedback" class="divide-y divide-stone-100 text-stone-700">
            <tr>
              <td colspan="5" class="py-12 text-center text-stone-400">
                <span class="inline-block animate-spin mr-2">⏳</span> Cargando mensajes de feedback...
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- PAGINACIÓN -->
      <div class="p-4 border-t border-stone-200/80 bg-stone-50/50 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
        <span class="text-stone-500 font-medium" id="pagination-info">
          Página 1 de 1
        </span>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-prev-page"
            disabled
            class="rounded-xl border border-stone-200 bg-white px-3.5 py-1.5 text-xs font-bold text-stone-700 hover:bg-stone-50 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs"
          >
            ← Anterior
          </button>
          <button
            type="button"
            id="btn-next-page"
            disabled
            class="rounded-xl border border-stone-200 bg-white px-3.5 py-1.5 text-xs font-bold text-stone-700 hover:bg-stone-50 disabled:opacity-40 disabled:cursor-not-allowed transition shadow-2xs"
          >
            Siguiente →
          </button>
        </div>
      </div>
    </div>

  </div>
</AdminLteLayout>

<script is:inline>
  (function initFeedbackModule() {
    let currentPage = 1;
    let totalPages = 1;
    let currentCategory = '';
    let currentSearch = '';

    const tbody = document.getElementById('tbody-feedback');
    const searchInput = document.getElementById('search-feedback');
    const categorySelect = document.getElementById('filter-categoria');
    const btnRefresh = document.getElementById('btn-refresh-feedback');
    const btnPrev = document.getElementById('btn-prev-page');
    const btnNext = document.getElementById('btn-next-page');
    const paginationInfo = document.getElementById('pagination-info');

    const kpiTotal = document.getElementById('kpi-total-feedback');
    const kpiContacto = document.getElementById('kpi-con-contacto');
    const kpiTopCat = document.getElementById('kpi-top-categoria');

    function getCategoryBadge(cat) {
      switch (cat) {
        case 'tienda_no_listada':
          return '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-amber-50 text-amber-800 border border-amber-200">🏪 Tienda faltante</span>';
        case 'correccion_datos':
          return '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200">✏️ Corrección</span>';
        case 'nueva_funcion':
          return '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-purple-50 text-purple-800 border border-purple-200">💡 Sugerencia</span>';
        case 'bug':
          return '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-rose-50 text-rose-800 border border-rose-200">🐛 Error / Bug</span>';
        default:
          return `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-stone-100 text-stone-700 border border-stone-200">💬 ${cat || 'General'}</span>`;
      }
    }

    function formatDate(isoStr) {
      if (!isoStr) return '';
      try {
        const d = new Date(isoStr);
        return d.toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      } catch {
        return isoStr;
      }
    }

    async function cargarFeedback(page = 1) {
      currentPage = page;
      tbody.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-stone-400"><span class="inline-block animate-spin mr-2">⏳</span> Cargando mensajes...</td></tr>`;

      try {
        const params = new URLSearchParams({
          page: String(currentPage),
          limit: '15'
        });
        if (currentCategory) params.set('categoria', currentCategory);
        if (currentSearch) params.set('search', currentSearch);

        const res = await window.plataformaState.fetchWithEnv(`/api/v1/administracion/feedback?${params.toString()}`);
        if (!res.ok) {
          throw new Error('Error al consultar feedback de usuarios');
        }

        const data = await res.json();
        const items = data.items || [];
        totalPages = data.pages || 1;

        // Actualizar KPIs
        kpiTotal.textContent = data.total || 0;
        const conContacto = items.filter(x => x.contacto_opcional && x.contacto_opcional.trim()).length;
        kpiContacto.textContent = conContacto;

        const catCounts = {};
        items.forEach(x => { catCounts[x.categoria] = (catCounts[x.categoria] || 0) + 1; });
        let topCat = '-';
        let maxCount = 0;
        for (const [c, cnt] of Object.entries(catCounts)) {
          if (cnt > maxCount) {
            maxCount = cnt;
            topCat = c;
          }
        }
        kpiTopCat.textContent = topCat !== '-' ? topCat.replace(/_/g, ' ') : '-';

        paginationInfo.textContent = `Página ${data.page || 1} de ${totalPages} (${data.total || 0} mensajes)`;
        btnPrev.disabled = currentPage <= 1;
        btnNext.disabled = currentPage >= totalPages;

        if (items.length === 0) {
          tbody.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-stone-400">No se encontraron mensajes de feedback con los filtros actuales.</td></tr>`;
          return;
        }

        tbody.innerHTML = items.map(item => `
          <tr class="hover:bg-stone-50/70 transition">
            <td class="py-3 px-4 font-mono text-[11px] text-stone-500 whitespace-nowrap">
              ${formatDate(item.fecha_creacion)}
            </td>
            <td class="py-3 px-4 whitespace-nowrap">
              ${getCategoryBadge(item.categoria)}
            </td>
            <td class="py-3 px-4 text-stone-800 leading-relaxed font-normal">
              ${item.mensaje}
            </td>
            <td class="py-3 px-4 text-stone-600 font-mono text-[11px]">
              ${item.contacto_opcional ? `<span class="inline-flex items-center gap-1 text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-md font-semibold">📧 ${item.contacto_opcional}</span>` : '<span class="text-stone-300">Anónimo</span>'}
            </td>
            <td class="py-3 px-4 text-right whitespace-nowrap">
              <button
                type="button"
                data-delete-id="${item.id}"
                class="px-2 py-1 rounded-lg text-stone-400 hover:text-red-700 hover:bg-red-50 text-xs font-bold transition"
                title="Eliminar mensaje"
              >
                🗑️
              </button>
            </td>
          </tr>
        `).join('');

        // Eventos eliminar
        tbody.querySelectorAll('[data-delete-id]').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-delete-id');
            if (!confirm(`¿Eliminar definitivamente el mensaje #${id}?`)) return;

            try {
              const delRes = await window.plataformaState.fetchWithEnv(`/api/v1/administracion/feedback/${id}`, {
                method: 'DELETE'
              });
              if (delRes.ok) {
                cargarFeedback(currentPage);
              } else {
                alert('No se pudo eliminar el mensaje.');
              }
            } catch (err) {
              alert(`Error al eliminar: ${err.message}`);
            }
          });
        });

      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-12 text-center text-red-500">Error al cargar feedback: ${err.message}</td></tr>`;
      }
    }

    let searchTimeout;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        currentSearch = searchInput.value.trim();
        cargarFeedback(1);
      }, 300);
    });

    categorySelect?.addEventListener('change', () => {
      currentCategory = categorySelect.value;
      cargarFeedback(1);
    });

    btnRefresh?.addEventListener('click', () => cargarFeedback(currentPage));
    btnPrev?.addEventListener('click', () => {
      if (currentPage > 1) cargarFeedback(currentPage - 1);
    });
    btnNext?.addEventListener('click', () => {
      if (currentPage < totalPages) cargarFeedback(currentPage + 1);
    });

    cargarFeedback(1);
  })();
</script>

