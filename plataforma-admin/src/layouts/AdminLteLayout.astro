---
import '../styles/adminlte.css';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'administracion' | 'bitacora' | 'sincronizaciones' | 'ambientes';
  breadcrumb?: Array<{ label: string; url?: string }>;
}

const {
  title = "Plataforma de Administración y Bitácora | Cafesitios",
  activeNav = "dashboard",
  breadcrumb = [{ label: "Inicio", url: "/plataforma/" }]
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href="/plataforma/favicon.svg" />
</head>
<body class="bg-slate-100 text-slate-800 antialiased">

  <div class="app-wrapper">

    <!-- 1. SIDEBAR IZQUIERDO ESTILO ADMINLTE -->
    <aside id="main-sidebar" class="main-sidebar shadow-xl flex flex-col justify-between">
      <div>
        <!-- Brand Logo Header -->
        <div class="flex items-center gap-3 px-4 py-4 border-b border-stone-800 bg-stone-950/40">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-700 text-white font-bold text-lg shadow-sm">
            ☕
          </span>
          <div class="brand-text">
            <h1 class="text-sm font-bold tracking-tight text-white m-0">Plataforma Admin</h1>
            <p class="text-[10px] font-medium text-emerald-400 m-0">Cafesitios • Localhost</p>
          </div>
        </div>

        <!-- Perfil Breve / Loopback -->
        <div class="px-4 py-3 border-b border-stone-800/80 flex items-center justify-between text-xs text-stone-400">
          <span class="inline-flex items-center gap-1.5 font-medium">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>127.0.0.1 (Loopback)</span>
          </span>
          <span class="text-[10px] bg-stone-800 text-stone-300 px-1.5 py-0.5 rounded font-mono">v1.0</span>
        </div>

        <!-- Menú de Navegación Vertical -->
        <nav class="mt-3 px-2 space-y-1" aria-label="Navegación AdminLTE">
          <a 
            href="/plataforma/" 
            class={`nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition ${
              activeNav === 'dashboard' 
                ? 'bg-emerald-800 text-white shadow-sm' 
                : 'text-stone-300 hover:bg-stone-800 hover:text-white'
            }`}
          >
            <span class="text-base" aria-hidden="true">📊</span>
            <span class="nav-text">Panel Principal</span>
          </a>

          <a 
            href="/plataforma/administracion" 
            class={`nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition ${
              activeNav === 'administracion' 
                ? 'bg-emerald-800 text-white shadow-sm' 
                : 'text-stone-300 hover:bg-stone-800 hover:text-white'
            }`}
          >
            <span class="text-base" aria-hidden="true">🏪</span>
            <span class="nav-text">Tiendas y Moderación</span>
          </a>

          <a 
            href="/plataforma/sincronizaciones" 
            class={`nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition ${
              activeNav === 'sincronizaciones' 
                ? 'bg-emerald-800 text-white shadow-sm' 
                : 'text-stone-300 hover:bg-stone-800 hover:text-white'
            }`}
          >
            <span class="text-base" aria-hidden="true">📈</span>
            <span class="nav-text">Sincronización y Logs</span>
          </a>

          <div class="pt-3 border-t border-stone-800/80 my-2"></div>

          <a 
            href="/plataforma/ambientes" 
            class={`nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-xs font-semibold transition ${
              activeNav === 'ambientes' 
                ? 'bg-emerald-800 text-white shadow-sm' 
                : 'text-stone-300 hover:bg-stone-800 hover:text-white'
            }`}
          >
            <span class="text-base" aria-hidden="true">⚙️</span>
            <span class="nav-text">Gestión de Ambientes</span>
          </a>
        </nav>
      </div>

      <!-- Pie del Sidebar -->
      <div class="p-3 border-t border-stone-800 text-[11px] text-stone-500 flex items-center justify-between">
        <span>Café-sitios Platform</span>
        <a href="http://localhost:3000" target="_blank" class="text-emerald-400 hover:underline">Ver Web ➔</a>
      </div>
    </aside>

    <!-- 2. CONTENT WRAPPER -->
    <div class="content-wrapper flex flex-col min-h-screen">

      <!-- TOP NAVBAR -->
      <header class="h-14 border-b border-stone-200 bg-[#FCFBF7]/90 backdrop-blur-md px-4 flex items-center justify-between sticky top-0 z-30">
        
        <!-- Controles Izquierdos: Hamburguesa + Migas de Pan -->
        <div class="flex items-center gap-3">
          <button 
            type="button" 
            id="sidebar-toggle-btn" 
            class="h-8 w-8 inline-flex items-center justify-center rounded-lg border border-stone-200 bg-white text-stone-600 hover:bg-stone-100 hover:text-stone-900 shadow-2xs transition"
            title="Colapsar / Expandir Barra Lateral"
          >
            <span class="text-sm font-bold">☰</span>
          </button>

          <nav class="hidden sm:flex items-center gap-1.5 text-xs text-stone-500 font-medium" aria-label="Miga de pan">
            {breadcrumb.map((crumb, idx) => (
              <>
                {idx > 0 && <span class="text-stone-300">/</span>}
                {crumb.url ? (
                  <a href={crumb.url} class="hover:text-emerald-800 transition">{crumb.label}</a>
                ) : (
                  <span class="text-stone-800 font-semibold">{crumb.label}</span>
                )}
              </>
            ))}
          </nav>
        </div>

        <!-- Controles Derechos: Selector de Ambiente + Botón Ping -->
        <div class="flex items-center gap-2.5">
          
          <!-- Botón Ping de Latencia -->
          <button 
            type="button" 
            id="btn-test-env-latency" 
            class="hidden md:inline-flex items-center gap-1.5 text-[11px] font-semibold text-stone-600 hover:text-emerald-800 bg-stone-100 hover:bg-stone-200 px-2 py-1 rounded-md border border-stone-200 transition"
            title="Probar conexión con el ambiente activo"
          >
            <span id="env-ping-indicator" class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span id="env-latency-label">Ping DB</span>
          </button>

          <!-- SELECTOR DE AMBIENTE DINÁMICO (Dropdown con Badge de Estado) -->
          <div class="relative inline-block text-left" id="env-dropdown-wrapper">
            <button 
              type="button" 
              id="env-switcher-btn"
              class="inline-flex items-center gap-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-900 shadow-2xs hover:bg-amber-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span id="active-env-dot" class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
              <span id="active-env-name">Cargando ambiente...</span>
              <span class="text-[10px] text-amber-700">▼</span>
            </button>

            <!-- Menú Desplegable de Ambientes -->
            <div 
              id="env-switcher-menu" 
              class="hidden absolute right-0 mt-1 w-64 origin-top-right rounded-xl border border-stone-200 bg-white p-1.5 shadow-xl ring-1 ring-black ring-opacity-5 z-50 text-xs"
              role="menu"
            >
              <div class="px-2.5 py-1.5 font-bold text-[10px] uppercase tracking-wider text-stone-400 border-b border-stone-100">
                Cambiar Ambiente Activo
              </div>
              <div id="env-list-container" class="py-1 space-y-0.5">
                <!-- Se pobla dinámicamente vía API -->
                <div class="p-2 text-stone-400 text-center">Cargando ambientes...</div>
              </div>
              <div class="border-t border-stone-100 pt-1">
                <a 
                  href="/plataforma/ambientes" 
                  class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-emerald-800 font-bold hover:bg-emerald-50 transition"
                >
                  <span>⚙️</span>
                  <span>Gestionar Ambientes (+ Nuevo)</span>
                </a>
              </div>
            </div>
          </div>

        </div>

      </header>

      <!-- CONTENIDO PRINCIPAL -->
      <main class="flex-1 p-4 sm:p-6 lg:p-8">
        <slot />
      </main>

      <!-- FOOTER -->
      <footer class="border-t border-stone-200 bg-white px-6 py-3 text-xs text-stone-500 flex flex-wrap items-center justify-between">
        <div>
          <strong class="text-stone-700">Cafésitios Plataforma Local</strong> &copy; 2026. Todos los derechos reservados.
        </div>
        <div class="text-[11px] text-stone-400">
          Modo Administrador Multi-Ambiente • No publicado en Vercel
        </div>
      </footer>

    </div>

  </div>

  <!-- 3. MODAL DE CAMBIOS SIN CONFIRMAR ANTES DE CAMBIAR DE AMBIENTE -->
  <dialog 
    id="dirty-env-dialog" 
    class="fixed inset-0 z-50 m-auto w-[90%] max-w-md rounded-2xl bg-white p-6 shadow-2xl border border-stone-200 backdrop:bg-stone-950/60 backdrop:backdrop-blur-xs"
  >
    <div class="flex items-start gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800 text-xl font-bold">
        ⚠️
      </span>
      <div>
        <h3 class="text-base font-bold text-stone-900">Cambios pendientes sin guardar</h3>
        <p class="text-xs text-stone-600 mt-1">
          Tienes modificaciones sin guardar en el ambiente actual (<strong id="dirty-modal-current-env"></strong>).
        </p>
        <p class="text-xs text-stone-500 mt-2">
          Si cambias a <strong id="dirty-modal-target-env"></strong> sin guardar, se perderán las ediciones pendientes. ¿Qué deseas hacer?
        </p>
      </div>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-end gap-2 text-xs">
      <button 
        type="button" 
        id="btn-dirty-cancel" 
        class="w-full sm:w-auto px-3.5 py-2 rounded-lg border border-stone-200 text-stone-700 hover:bg-stone-50 font-semibold transition"
      >
        Cancelar
      </button>
      <button 
        type="button" 
        id="btn-dirty-discard" 
        class="w-full sm:w-auto px-3.5 py-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 hover:bg-rose-100 font-semibold transition"
      >
        Descartar y Cambiar
      </button>
      <button 
        type="button" 
        id="btn-dirty-save" 
        class="w-full sm:w-auto px-3.5 py-2 rounded-lg bg-emerald-800 text-white hover:bg-emerald-700 font-bold transition shadow-xs"
      >
        Guardar y Cambiar
      </button>
    </div>
  </dialog>

  <!-- 4. MODAL GLOBAL DE CONFIRMACIÓN PREVIO A GUARDAR EN BASE DE DATOS -->
  <dialog 
    id="confirm-action-dialog" 
    class="fixed inset-0 z-50 m-auto w-[90%] max-w-lg rounded-2xl bg-white p-6 shadow-2xl border border-stone-200 backdrop:bg-stone-950/60 backdrop:backdrop-blur-xs"
  >
    <div class="flex items-start gap-3.5">
      <span id="confirm-modal-icon" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800 text-2xl font-bold">
        ⚠️
      </span>
      <div class="flex-1">
        <h3 id="confirm-modal-title" class="text-base font-bold text-stone-900">
          Confirmación de Acción en Base de Datos
        </h3>
        
        <!-- Pill de Ambiente Destino -->
        <div class="mt-2.5 p-3 rounded-xl border border-stone-200 bg-stone-50 flex items-center justify-between text-xs">
          <div>
            <span class="block text-[10px] uppercase font-bold text-stone-400">Ambiente Destino:</span>
            <span id="confirm-modal-env-name" class="font-extrabold text-stone-900 text-sm">PostgreSQL Local</span>
          </div>
          <span id="confirm-modal-env-badge" class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-100 text-amber-900 border border-amber-300">
            LOCAL
          </span>
        </div>

        <p id="confirm-modal-message" class="text-xs text-stone-600 mt-3 leading-relaxed">
          ¿Estás seguro de guardar estos cambios?
        </p>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-2 text-xs">
      <button 
        type="button" 
        id="btn-confirm-action-cancel" 
        class="px-4 py-2 rounded-lg border border-stone-200 text-stone-700 hover:bg-stone-50 font-semibold transition"
      >
        Cancelar
      </button>
      <button 
        type="button" 
        id="btn-confirm-action-proceed" 
        class="px-4 py-2 rounded-lg bg-emerald-800 text-white hover:bg-emerald-700 font-bold transition shadow-xs"
      >
        Sí, Proceder y Guardar
      </button>
    </div>
  </dialog>

  <!-- SCRIPT GLOBAL DEL ADMINISTRADOR MULTI-AMBIENTE -->
  <script is:inline>
    (function initPlataformaEngine() {
      const STORAGE_ENV_KEY = 'plataforma_active_env';
      const API_BASE = 'http://localhost:8000';

      // Estado Global
      window.plataformaState = {
        activeEnvId: localStorage.getItem(STORAGE_ENV_KEY) || 'local',
        environments: [],
        isDirty: false,
        pendingEnvChange: null,
        onSaveCallback: null,

        markDirty(dirty = true) {
          this.isDirty = Boolean(dirty);
        },

        getActiveEnv() {
          return this.environments.find(e => e.id === this.activeEnvId) || {
            id: 'local',
            nombre: 'PostgreSQL Local',
            tipo: 'postgres',
            color_badge: 'amber',
            es_protegido: false
          };
        },

        async fetchWithEnv(url, options = {}) {
          const headers = new Headers(options.headers || {});
          headers.set('X-Target-Environment', this.activeEnvId);
          return fetch(url, { ...options, headers });
        },

        confirmAction({ title, message, onProceed }) {
          const dialog = document.getElementById('confirm-action-dialog');
          const titleEl = document.getElementById('confirm-modal-title');
          const msgEl = document.getElementById('confirm-modal-message');
          const envNameEl = document.getElementById('confirm-modal-env-name');
          const envBadgeEl = document.getElementById('confirm-modal-env-badge');
          const iconEl = document.getElementById('confirm-modal-icon');
          const proceedBtn = document.getElementById('btn-confirm-action-proceed');

          const env = this.getActiveEnv();
          if (titleEl) titleEl.textContent = title || 'Confirmar Acción';
          if (msgEl) msgEl.textContent = message || '¿Deseas aplicar estos cambios en la base de datos?';
          if (envNameEl) envNameEl.textContent = env.nombre;
          
          if (envBadgeEl) {
            envBadgeEl.textContent = env.tipo.toUpperCase();
            envBadgeEl.className = `px-2.5 py-1 rounded-md text-[11px] font-bold badge-env-${env.color_badge || 'amber'}`;
          }

          if (iconEl) {
            iconEl.className = `flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-2xl font-bold ${
              env.es_protegido ? 'bg-red-100 text-red-800' : 'bg-amber-100 text-amber-800'
            }`;
          }

          proceedBtn.onclick = () => {
            dialog.close();
            if (typeof onProceed === 'function') onProceed();
          };

          dialog.showModal();
        }
      };

      // Toggle Sidebar
      const toggleBtn = document.getElementById('sidebar-toggle-btn');
      const sidebar = document.getElementById('main-sidebar');
      if (toggleBtn && sidebar) {
        toggleBtn.addEventListener('click', () => {
          sidebar.classList.toggle('sidebar-collapsed');
        });
      }

      // Dropdown de Ambientes
      const envBtn = document.getElementById('env-switcher-btn');
      const envMenu = document.getElementById('env-switcher-menu');
      if (envBtn && envMenu) {
        envBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          envMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!envMenu.contains(e.target) && !envBtn.contains(e.target)) {
            envMenu.classList.add('hidden');
          }
        });
      }

      // Cargar Ambientes vía API
      async function loadEnvironments() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/administracion/ambientes`);
          if (res.ok) {
            const data = await res.json();
            window.plataformaState.environments = data;
            renderEnvironmentSwitcher();
          }
        } catch (err) {
          console.warn('Backend API no disponible para ambientes, usando fallback local.', err);
          window.plataformaState.environments = [
            { id: 'local', nombre: 'PostgreSQL Local', tipo: 'postgres', color_badge: 'amber', activo: true, es_protegido: false },
            { id: 'supabase', nombre: 'Supabase Producción', tipo: 'supabase', color_badge: 'red', activo: true, es_protegido: true }
          ];
          renderEnvironmentSwitcher();
        }
      }

      function renderEnvironmentSwitcher() {
        const activeEnv = window.plataformaState.getActiveEnv();
        const activeNameEl = document.getElementById('active-env-name');
        const activeDotEl = document.getElementById('active-env-dot');
        const btnEl = document.getElementById('env-switcher-btn');
        const listEl = document.getElementById('env-list-container');

        if (activeNameEl) activeNameEl.textContent = activeEnv.nombre;
        
        // Estilos de badge según color
        if (btnEl) {
          btnEl.className = `inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 text-xs font-bold shadow-2xs transition focus:outline-none focus:ring-2 badge-env-${activeEnv.color_badge || 'amber'}`;
        }

        if (listEl) {
          listEl.innerHTML = '';
          window.plataformaState.environments.filter(e => e.activo).forEach(env => {
            const isSelected = env.id === activeEnv.id;
            const item = document.createElement('button');
            item.type = 'button';
            item.className = `w-full text-left px-2.5 py-2 rounded-lg flex items-center justify-between transition ${
              isSelected ? 'bg-emerald-50 text-emerald-900 font-bold' : 'hover:bg-stone-50 text-stone-700'
            }`;
            item.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full ${env.color_badge === 'red' ? 'bg-red-500' : env.color_badge === 'amber' ? 'bg-amber-500' : 'bg-emerald-500'}"></span>
                <span>${env.nombre}</span>
              </div>
              <span class="text-[10px] uppercase font-mono text-stone-400">${env.tipo}</span>
            `;

            item.addEventListener('click', () => {
              envMenu.classList.add('hidden');
              attemptEnvSwitch(env.id);
            });

            listEl.appendChild(item);
          });
        }
      }

      function attemptEnvSwitch(targetEnvId) {
        if (targetEnvId === window.plataformaState.activeEnvId) return;

        const currentEnv = window.plataformaState.getActiveEnv();
        const targetEnv = window.plataformaState.environments.find(e => e.id === targetEnvId) || { nombre: targetEnvId };

        if (!window.plataformaState.isDirty) {
          switchEnvironmentNow(targetEnvId);
          return;
        }

        // Mostrar Modal de Dirty State
        window.plataformaState.pendingEnvChange = targetEnvId;
        const dialog = document.getElementById('dirty-env-dialog');
        document.getElementById('dirty-modal-current-env').textContent = currentEnv.nombre;
        document.getElementById('dirty-modal-target-env').textContent = targetEnv.nombre;
        dialog.showModal();
      }

      function switchEnvironmentNow(newEnvId) {
        window.plataformaState.activeEnvId = newEnvId;
        localStorage.setItem(STORAGE_ENV_KEY, newEnvId);
        window.plataformaState.isDirty = false;
        renderEnvironmentSwitcher();
        // Recargar la página o disparar evento custom para refrescar datos
        window.dispatchEvent(new CustomEvent('plataforma:env-changed', { detail: { envId: newEnvId } }));
        window.location.reload();
      }

      // Eventos del Modal Dirty State
      const dirtyCancelBtn = document.getElementById('btn-dirty-cancel');
      const dirtyDiscardBtn = document.getElementById('btn-dirty-discard');
      const dirtySaveBtn = document.getElementById('btn-dirty-save');
      const dirtyDialog = document.getElementById('dirty-env-dialog');

      if (dirtyCancelBtn) {
        dirtyCancelBtn.addEventListener('click', () => {
          dirtyDialog.close();
          window.plataformaState.pendingEnvChange = null;
        });
      }

      if (dirtyDiscardBtn) {
        dirtyDiscardBtn.addEventListener('click', () => {
          dirtyDialog.close();
          if (window.plataformaState.pendingEnvChange) {
            switchEnvironmentNow(window.plataformaState.pendingEnvChange);
          }
        });
      }

      if (dirtySaveBtn) {
        dirtySaveBtn.addEventListener('click', () => {
          dirtyDialog.close();
          if (typeof window.plataformaState.onSaveCallback === 'function') {
            window.plataformaState.onSaveCallback(() => {
              if (window.plataformaState.pendingEnvChange) {
                switchEnvironmentNow(window.plataformaState.pendingEnvChange);
              }
            });
          } else {
            alert('Por favor guarda los cambios con el botón de guardar del formulario activo.');
          }
        });
      }

      // Botón Ping / Latencia
      const pingBtn = document.getElementById('btn-test-env-latency');
      const pingLabel = document.getElementById('env-latency-label');
      if (pingBtn && pingLabel) {
        pingBtn.addEventListener('click', async () => {
          pingLabel.textContent = 'Probando...';
          try {
            const res = await fetch(`${API_BASE}/api/v1/administracion/ambientes/${window.plataformaState.activeEnvId}/probar`, {
              method: 'POST'
            });
            const data = await res.json();
            if (data.success) {
              pingLabel.textContent = `${data.latency_ms} ms`;
            } else {
              pingLabel.textContent = 'Error';
              alert(`Error al conectar con ${window.plataformaState.getActiveEnv().nombre}: ${data.error}`);
            }
          } catch (e) {
            pingLabel.textContent = 'Sin conexión';
          }
        });
      }

      // Inicializar
      loadEnvironments();
    })();
  </script>

</body>
</html>

