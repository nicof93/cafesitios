---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlavorWheel from '../../components/product/FlavorWheel.astro';
import { GetProductDetailUseCase } from '../../core/application/GetProductDetail';
import type { CoffeeProduct } from '../../core/domain/models/CoffeeProduct';

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const detailUseCase = new GetProductDetailUseCase();
let product: CoffeeProduct | null = null;
let matches: CoffeeProduct[] = [];

try {
  const result = await detailUseCase.execute(id);
  product = result.product;
  matches = result.matches;
} catch (error) {
  console.error(`Error cargando producto ${id}:`, error);
}

if (!product) {
  return Astro.redirect('/404');
}

const bestVariant = product.getBestVariant(true) || product.getBestVariant(false);
const variantsJson = JSON.stringify(product.variantes);
const currentPrice = bestVariant?.precio_clp || 0;
const currentPriceKilo = bestVariant?.precio_por_kilo || 0;

// Calcular métricas de precio histórico si existen
const historicalPrices = bestVariant?.historial_precios?.map(h => h.precio_clp) || [currentPrice];
const minHistorical = historicalPrices.length > 0 ? Math.min(...historicalPrices) : currentPrice;
const avgHistorical = historicalPrices.length > 0 ? Math.round(historicalPrices.reduce((a, b) => a + b, 0) / historicalPrices.length) : currentPrice;

// Agrupar variantes por precio para evitar tablas largas repetitivas
interface GroupedVariant {
  formato_gramos: number;
  precio_clp: number;
  precio_original_clp: number;
  precio_por_kilo: number;
  en_oferta: boolean;
  es_estimado: boolean;
  disponible: boolean;
  presentaciones: string[];
}

const groupedVariantsMap = new Map<string, GroupedVariant>();

product.variantes.forEach(v => {
  const key = `${v.formato_gramos}_${v.precio_clp}`;
  if (!groupedVariantsMap.has(key)) {
    groupedVariantsMap.set(key, {
      formato_gramos: v.formato_gramos,
      precio_clp: v.precio_clp,
      precio_original_clp: v.precio_original_clp,
      precio_por_kilo: v.precio_por_kilo,
      en_oferta: v.en_oferta,
      es_estimado: v.es_estimado,
      disponible: v.disponible,
      presentaciones: [v.opcion]
    });
  } else {
    const existing = groupedVariantsMap.get(key)!;
    if (v.opcion && !existing.presentaciones.includes(v.opcion)) {
      existing.presentaciones.push(v.opcion);
    }
    if (v.disponible) existing.disponible = true;
  }
});

const groupedVariants = Array.from(groupedVariantsMap.values()).sort((a, b) => a.precio_por_kilo - b.precio_por_kilo);
---

<BaseLayout 
  title={`${product.nombre} - ${product.tienda} | Comparador Cafesitios`}
  description={`Ficha técnica y comparativa de precios para ${product.nombre} en ${product.tienda}. ${product.origen ? `Origen: ${product.origen}. ` : ''}Precio por kilo: $${currentPriceKilo.toLocaleString('es-CL')}/kg.`}
  ogImage={product.imagen}
>
  <div class="space-y-10 pb-24">
    
    <!-- BREADCRUMB / RETORNO RÁPIDO -->
    <nav class="flex items-center gap-2 text-xs text-stone-500" aria-label="Ruta de navegación">
      <a href="/" class="hover:text-emerald-800 transition flex items-center gap-1">
        <span>←</span>
        <span>Volver al Catálogo</span>
      </a>
      <span class="text-stone-300">/</span>
      <span class="text-stone-400 font-medium">{product.tienda}</span>
      <span class="text-stone-300">/</span>
      <span class="font-semibold text-stone-800 truncate max-w-sm">{product.nombre}</span>
    </nav>

    <!-- HERO DE PRODUCTO EN DOS COLUMNAS -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-2xs">
      
      <!-- COLUMNA IZQUIERDA: MARCO DE IMAGEN DESTACADO -->
      <div class="lg:col-span-5 relative flex items-center justify-center bg-[#F4F3ED] rounded-2xl p-6 sm:p-10 border border-stone-100 min-h-[380px] group overflow-hidden">
        <img 
          src={product.imagen} 
          alt={product.nombre} 
          referrerpolicy="no-referrer"
          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';"
          class="max-h-[340px] w-auto object-contain drop-shadow-md transition-transform duration-300 group-hover:scale-105"
        />
        
        <!-- PILL TIENDA Y BADGES SUPERIORES -->
        <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-xs text-stone-800 text-xs font-bold px-3 py-1 rounded-full shadow-2xs border border-stone-200/60">
          {product.tienda}
        </span>

        {product.puntuacion_sca && (
          <span class="absolute top-4 right-4 bg-amber-500/90 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-2xs">
            ★ {product.puntuacion_sca} SCA
          </span>
        )}
      </div>

      <!-- COLUMNA DERECHA: PANEL DE ESPECIFICACIONES Y CONVERSIÓN -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        
        <div class="space-y-4">
          <!-- BADGES SUPERIORES -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-3 py-0.5 rounded-full">
              {product.tienda}
            </span>
            {bestVariant?.es_estimado && (
              <span class="text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full" title="Gramaje estimado por fallback de 250g (RN-02)">
                ⚠️ Gramaje Estimado (250g)
              </span>
            )}
          </div>

          <!-- TÍTULO PRINCIPAL -->
          <h1 class="text-2xl sm:text-3xl font-extrabold text-stone-900 leading-tight tracking-tight">
            {product.nombre}
          </h1>

          <!-- PUNTUACIÓN SCA DESTACADA MUY VISTOSA (CALIFICACIÓN Q-GRADER OFICIAL) -->
          {product.puntuacion_sca && (
            <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-gradient-to-r from-amber-500/15 via-amber-400/10 to-amber-50 border-2 border-amber-400/90 shadow-xs">
              <div class="flex items-center justify-center w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-500 to-amber-600 text-white font-extrabold text-xl shadow-sm">
                ★
              </div>
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-extrabold uppercase tracking-wider text-amber-950">
                    Puntuación Oficial de Catación:
                  </span>
                  <span class="text-base sm:text-lg font-black text-amber-950 bg-amber-200/90 border border-amber-300 px-2.5 py-0.5 rounded-xl shadow-2xs">
                    {product.puntuacion_sca} SCA
                  </span>
                </div>
                <p class="text-xs font-semibold text-amber-900/90">
                  {product.puntuacion_sca >= 90 ? '🏆 Calidad Excepcional / Super Specialty (Gourmet Exclusivo)' : product.puntuacion_sca >= 85 ? '✨ Calidad Excelente (Especialidad Alta)' : '☕ Café de Especialidad Calificado por Catador Q-Grader'}
                </p>
              </div>
            </div>
          )}

          <!-- NOTAS DE CATA EN TONOS CÁLIDOS/ÁMBAR -->
          {product.notas_cata && product.notas_cata.length > 0 && (
            <div class="space-y-1.5 pt-1">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400">
                Perfil Sensorial & Notas de Cata
              </span>
              <div class="flex flex-wrap gap-1.5">
                {product.notas_cata.map(nota => {
                  const label = typeof nota === 'object' && nota !== null 
                    ? ((nota as any).nombre || (nota as any).clave_normalizada || '') 
                    : String(nota);
                  return (
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200/80 text-amber-900 px-3 py-1 text-xs font-semibold shadow-2xs">
                      <span>☕</span>
                      <span>{label}</span>
                    </span>
                  );
                })}
              </div>
            </div>
          )}

          <!-- GRILLA ESTRUCTURADA DE ESPECIFICACIONES TÉCNICAS (CON TONO SUAVE PARA VALORES NO IDENTIFICADOS) -->
          <div class="pt-2">
            <span class="block text-[11px] font-bold uppercase tracking-wider text-stone-400 mb-2">
              Ficha Técnica de Origen
            </span>
            <div class="grid grid-cols-2 gap-2.5 text-xs">
              
              <!-- PAÍS / ORIGEN -->
              <div class={`flex items-center gap-2.5 p-3 rounded-xl border transition-all ${
                product.origen 
                  ? 'bg-stone-50/80 border-stone-100 shadow-2xs' 
                  : 'bg-stone-50/30 border-dashed border-stone-200/60 opacity-40 grayscale-[50%]'
              }`}>
                <span class="text-base">🌍</span>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-stone-400">País / Origen</span>
                  {product.origen ? (
                    <span class="font-bold text-stone-900">{product.origen}</span>
                  ) : (
                    <span class="italic text-stone-400 font-normal text-[11px]">No especificado</span>
                  )}
                </div>
              </div>

              <!-- PROCESO -->
              <div class={`flex items-center gap-2.5 p-3 rounded-xl border transition-all ${
                product.proceso 
                  ? 'bg-stone-50/80 border-stone-100 shadow-2xs' 
                  : 'bg-stone-50/30 border-dashed border-stone-200/60 opacity-40 grayscale-[50%]'
              }`}>
                <span class="text-base">⚙️</span>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Proceso</span>
                  {product.proceso ? (
                    <span class="font-bold text-stone-900">{product.proceso}</span>
                  ) : (
                    <span class="italic text-stone-400 font-normal text-[11px]">No especificado</span>
                  )}
                </div>
              </div>

              <!-- VARIEDAD -->
              <div class={`flex items-center gap-2.5 p-3 rounded-xl border transition-all ${
                product.variedad 
                  ? 'bg-stone-50/80 border-stone-100 shadow-2xs' 
                  : 'bg-stone-50/30 border-dashed border-stone-200/60 opacity-40 grayscale-[50%]'
              }`}>
                <span class="text-base">🌱</span>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Variedad</span>
                  {product.variedad ? (
                    <span class="font-bold text-stone-900">{product.variedad}</span>
                  ) : (
                    <span class="italic text-stone-400 font-normal text-[11px]">No especificado</span>
                  )}
                </div>
              </div>

              <!-- ALTITUD -->
              <div class={`flex items-center gap-2.5 p-3 rounded-xl border transition-all ${
                product.altura_msnm 
                  ? 'bg-stone-50/80 border-stone-100 shadow-2xs' 
                  : 'bg-stone-50/30 border-dashed border-stone-200/60 opacity-40 grayscale-[50%]'
              }`}>
                <span class="text-base">⛰️</span>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Altitud</span>
                  {product.altura_msnm ? (
                    <span class="font-bold text-stone-900">{product.altura_msnm}</span>
                  ) : (
                    <span class="italic text-stone-400 font-normal text-[11px]">No registrada</span>
                  )}
                </div>
              </div>

              <!-- TUESTE Y ESCALA AGTRON -->
              <div class={`flex items-center gap-2.5 p-3 rounded-xl border col-span-2 sm:col-span-1 transition-all ${
                (product.tueste || product.escala_agtron) 
                  ? 'bg-stone-50/80 border-stone-100 shadow-2xs' 
                  : 'bg-stone-50/30 border-dashed border-stone-200/60 opacity-40 grayscale-[50%]'
              }`}>
                <span class="text-base">🔥</span>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Tueste / Escala Agtron</span>
                  {(product.tueste || product.escala_agtron) ? (
                    <span class="font-bold text-stone-900 flex items-center gap-1.5 flex-wrap">
                      <span>{product.tueste || 'Medio'}</span>
                      {product.escala_agtron && (
                        <span class="text-[10px] font-extrabold text-emerald-800 bg-emerald-50 border border-emerald-200 px-1.5 py-0.2 rounded-md" title="Nivel en la escala de tueste colorimétrico Agtron SCAA">
                          Agtron #{product.escala_agtron}
                        </span>
                      )}
                    </span>
                  ) : (
                    <span class="italic text-stone-400 font-normal text-[11px]">No especificado</span>
                  )}
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- SECCIÓN DE PRECIO DESTACADO Y SELECCIÓN DE VARIANTE -->
        <div class="space-y-4 border-t border-stone-100 pt-5">
          
          <div class="flex items-baseline justify-between bg-stone-50/80 p-4 rounded-2xl border border-stone-200/60">
            <div>
              <span class="block text-[10px] uppercase font-bold tracking-wider text-stone-400">
                Precio Formato Seleccionado
              </span>
              <p id="display-unit-price" class="text-2xl sm:text-3xl font-extrabold text-stone-900 tracking-tight">
                ${currentPrice.toLocaleString('es-CL')} <span class="text-xs font-semibold text-stone-500">CLP</span>
              </p>
            </div>
            <div class="text-right">
              <span class="block text-[10px] uppercase font-bold tracking-wider text-stone-400">
                Referencia ($/kg)
              </span>
              <p id="display-kilo-price" class="text-sm sm:text-base font-bold text-emerald-800">
                ${currentPriceKilo.toLocaleString('es-CL')} <span class="text-[10px] font-semibold text-emerald-600">/kg</span>
              </p>
            </div>
          </div>

          <!-- SELECTOR DE FORMATO SI TIENE MÚLTIPLES -->
          {product.variantes.length > 1 && (
            <div>
              <label for="variant-selector" class="block text-xs font-bold text-stone-600 mb-1.5">
                Selecciona Formato y Molienda:
              </label>
              <select 
                id="variant-selector" 
                class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2.5 text-xs font-medium text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-600 shadow-2xs"
              >
                {product.variantes.map((v, i) => (
                  <option value={i} selected={v.id === bestVariant?.id}>
                    {v.formato_gramos}g · {v.opcion} — ${v.precio_clp.toLocaleString('es-CL')} (${v.precio_por_kilo.toLocaleString('es-CL')}/kg)
                  </option>
                ))}
              </select>
            </div>
          )}

          <!-- BOTÓN DIRECTO DE COMPRA -->
          <a 
            id="btn-main-outbound-store"
            href={product.url_detalle} 
            target="_blank" 
            rel="noopener noreferrer"
            data-track-outbound="true"
            data-store={product.tienda}
            data-product-name={product.nombre}
            data-price={currentPrice}
            class="flex items-center justify-center gap-2 w-full bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-center py-3.5 px-6 rounded-2xl shadow-sm transition duration-150 hover:shadow-md"
          >
            <span>Ir a comprar en {product.tienda}</span>
            <span aria-hidden="true">↗</span>
          </a>

        </div>

      </div>
    </section>

    <!-- CU-07: RUEDA DE SABORES SCA Y PERFIL DE COORDENADAS POLARES (RADAR PRIMERO) -->
    <FlavorWheel product={product} />

    <!-- TABLA ESTRUCTURADA DE FORMATOS Y PRECIOS TRANSPARENTADOS (AGRUPADA POR PRECIO) -->
    <section class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-2xs space-y-4">
      <div>
        <h2 class="text-base font-bold text-stone-900">
          Formatos y Precios Transparentados
        </h2>
        <p class="text-xs text-stone-400">
          Cálculo exacto del costo por kilo agrupado por valor para facilitar la comparación rápida
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-stone-200 text-stone-400 uppercase text-[10px] font-bold">
              <th class="py-3 px-3">Gramaje</th>
              <th class="py-3 px-3">Moliendas / Presentaciones</th>
              <th class="py-3 px-3">Precio Bolsa</th>
              <th class="py-3 px-3">Precio por Kilo ($/kg)</th>
              <th class="py-3 px-3 text-right">Disponibilidad</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {groupedVariants.map(group => (
              <tr class={group.disponible ? "hover:bg-stone-50/60 transition-colors" : "opacity-50 bg-stone-50/50"}>
                <td class="py-3.5 px-3 font-extrabold text-stone-900 text-sm align-top">
                  {group.formato_gramos}g
                </td>
                <td class="py-3.5 px-3 align-top">
                  <div class="flex flex-wrap gap-1.5 max-w-md">
                    {group.presentaciones.map(p => (
                      <span class="inline-flex items-center text-[11px] font-semibold bg-stone-100 text-stone-700 px-2.5 py-0.5 rounded-lg border border-stone-200/70 shadow-2xs">
                        {p}
                      </span>
                    ))}
                  </div>
                </td>
                <td class="py-3.5 px-3 font-bold text-stone-900 text-sm align-top whitespace-nowrap">
                  ${group.precio_clp.toLocaleString('es-CL')}
                  {group.en_oferta && (
                    <span class="block text-[10px] line-through text-stone-400 font-normal">
                      ${group.precio_original_clp.toLocaleString('es-CL')}
                    </span>
                  )}
                </td>
                <td class="py-3.5 px-3 align-top whitespace-nowrap">
                  <span class="inline-flex items-center gap-1 font-extrabold text-emerald-800 bg-emerald-50 border border-emerald-100 px-2.5 py-1 rounded-lg">
                    ${group.precio_por_kilo.toLocaleString('es-CL')}/kg
                    {group.es_estimado && (
                      <span class="rounded bg-amber-100 text-amber-800 px-1 py-0.2 text-[8px] font-bold">Est.</span>
                    )}
                  </span>
                </td>
                <td class="py-3.5 px-3 text-right align-top whitespace-nowrap">
                  <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-bold ${
                    group.disponible ? 'bg-emerald-50 text-emerald-800' : 'bg-stone-100 text-stone-500'
                  }`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${group.disponible ? 'bg-emerald-500' : 'bg-stone-400'}`}></span>
                    {group.disponible ? 'Disponible' : 'Agotado'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- CU-06: HISTÓRICO Y GRÁFICO DE PRECIOS CON MÉTRICAS SUPERIORES -->
    <section class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-2xs space-y-6">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-100 pb-4">
        <div>
          <h2 class="text-base font-bold text-stone-900">Histórico de Precios</h2>
          <p class="text-xs text-stone-400">Evolución de precios en el tiempo para identificar el mejor momento de compra</p>
        </div>

        <!-- TOGGLE MODO GRÁFICO -->
        <div class="inline-flex rounded-xl border border-stone-200 bg-stone-50 p-1 text-xs font-semibold">
          <button id="btn-chart-kilo" class="rounded-lg bg-white shadow-2xs px-3 py-1 text-emerald-800 font-bold transition">
            $/kg (Kilo)
          </button>
          <button id="btn-chart-unit" class="rounded-lg px-3 py-1 text-stone-500 hover:text-stone-800 transition">
            $ CLP (Bolsa)
          </button>
        </div>
      </div>

      <!-- MÉTRICAS CLAVE SUPERIORES -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4">
        <div class="bg-stone-50/70 p-3.5 rounded-2xl border border-stone-100">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-stone-400">Precio Actual</span>
          <p id="metric-current-price" class="text-sm sm:text-lg font-extrabold text-stone-900 mt-0.5">
            ${currentPrice.toLocaleString('es-CL')}
          </p>
        </div>
        <div class="bg-stone-50/70 p-3.5 rounded-2xl border border-stone-100">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-stone-400">Mínimo Histórico</span>
          <p id="metric-min-price" class="text-sm sm:text-lg font-extrabold text-emerald-700 mt-0.5">
            ${minHistorical.toLocaleString('es-CL')}
          </p>
        </div>
        <div class="bg-stone-50/70 p-3.5 rounded-2xl border border-stone-100">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-stone-400">Promedio</span>
          <p id="metric-avg-price" class="text-sm sm:text-lg font-extrabold text-stone-700 mt-0.5">
            ${avgHistorical.toLocaleString('es-CL')}
          </p>
        </div>
      </div>

      <!-- CONTENEDOR DEL GRÁFICO VECTORIAL INTERACTIVO -->
      <div class="relative w-full bg-stone-50/50 border border-stone-200/60 rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
        <div id="price-chart-svg-wrapper" class="w-full min-h-[170px] relative flex items-center justify-center">
          <!-- Renderizado dinámico vía SVG -->
        </div>
        <div class="flex items-center justify-between text-[11px] text-stone-400 border-t border-stone-100/80 pt-2.5 mt-2">
          <span class="flex items-center gap-1.5 font-medium text-emerald-800">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Monitoreo en tiempo real
          </span>
          <span id="chart-legend-label" class="font-semibold text-stone-500">
            Mostrando: Precio por Kilo ($/kg)
          </span>
        </div>
      </div>
    </section>

    <!-- CU-04: CARRUSEL / GRILLA DE CAFÉS RELACIONADOS (SUSTITUTOS DIRECTOS) -->
    {matches.length > 0 && (
      <section class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-2xs space-y-4">
        <div>
          <h2 class="text-base font-bold text-stone-900 flex items-center gap-2">
            <span>🔄</span> Cafés Relacionados en Otras Tiendas (Sustitutos directos)
          </h2>
          <p class="text-xs text-stone-400">
            Mismo origen y proceso en otros tostadores ordenados por conveniencia ($/kg)
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {matches.map(m => {
            const mVar = m.getBestVariant(true) || m.getBestVariant(false);
            return (
              <a 
                href={`/product/${m.id}`}
                class="group flex items-center gap-3.5 p-3.5 rounded-2xl border border-stone-200/80 hover:border-emerald-300 hover:shadow-xs transition bg-white"
              >
                <img 
                  src={m.imagen} 
                  alt={m.nombre} 
                  referrerpolicy="no-referrer"
                  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';"
                  class="w-16 h-16 object-contain bg-[#F4F3ED] rounded-xl p-1.5 flex-shrink-0 group-hover:scale-105 transition-transform"
                />
                <div class="min-w-0 flex-1">
                  <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
                    {m.tienda}
                  </span>
                  <p class="text-xs font-bold text-stone-900 truncate mt-1 group-hover:text-emerald-800 transition">
                    {m.nombre}
                  </p>
                  <p class="text-xs font-extrabold text-emerald-800 mt-0.5">
                    ${(mVar?.precio_por_kilo || 0).toLocaleString('es-CL')}/kg
                    <span class="text-[10px] font-normal text-stone-400">(${mVar?.precio_clp.toLocaleString('es-CL')})</span>
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

  </div>

  <!-- STICKY BOTTOM BAR (BARRA DE COMPRA FLOTANTE CENTRADA) -->
  <aside 
    id="sticky-purchase-bar"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-30 w-[92%] max-w-3xl bg-white/95 backdrop-blur-md border border-stone-200/90 rounded-2xl p-3.5 shadow-xl flex items-center justify-between gap-4 transition-all duration-300"
    aria-label="Acción rápida de compra"
  >
    <div class="flex items-center gap-3 min-w-0">
      <img 
        src={product.imagen} 
        alt={product.nombre} 
        referrerpolicy="no-referrer"
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';"
        class="h-10 w-10 object-contain bg-[#F4F3ED] rounded-lg p-0.5 flex-shrink-0 hidden sm:block"
      />
      <div class="min-w-0">
        <p class="text-xs font-bold text-stone-900 truncate max-w-xs sm:max-w-md">
          {product.nombre}
        </p>
        <p class="text-[11px] font-semibold text-emerald-800">
          <span id="sticky-kilo-price">${currentPriceKilo.toLocaleString('es-CL')}/kg</span>
          <span class="text-stone-400 font-normal"> · {product.tienda}</span>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-3 flex-shrink-0">
      <a 
        id="btn-sticky-outbound"
        href={product.url_detalle} 
        target="_blank" 
        rel="noopener noreferrer"
        data-track-outbound="true"
        data-store={product.tienda}
        data-product-name={product.nombre}
        data-price={currentPrice}
        class="bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs py-2.5 px-4 rounded-xl shadow-sm transition"
      >
        <span>Comprar en {product.tienda} ↗</span>
      </a>
    </div>
  </aside>
</BaseLayout>

<script is:inline define:vars={{ variantsJson, product }}>
  // Guardar en Vistos Recientemente (CU-10)
  try {
    const raw = localStorage.getItem('cafesitios_vistos_recientemente_v1');
    const list = raw ? JSON.parse(raw) : [];
    const filtered = list.filter(item => item.id !== product.id);
    filtered.unshift({
      id: product.id,
      nombre: product.nombre,
      tienda: product.tienda,
      precio: product.variantes?.[0]?.precio_clp || 0,
      imagen: product.imagen
    });
    localStorage.setItem('cafesitios_vistos_recientemente_v1', JSON.stringify(filtered.slice(0, 5)));
  } catch (e) {
    console.error('Error registrando visto recientemente:', e);
  }
</script>

<script>
  // MANEJO INTERACTIVO DE VARIANTES Y GRÁFICO HISTÓRICO DE PRECIOS
  const selector = document.getElementById('variant-selector') as HTMLSelectElement | null;
  const displayKilo = document.getElementById('display-kilo-price');
  const displayUnit = document.getElementById('display-unit-price');
  const stickyKilo = document.getElementById('sticky-kilo-price');
  const mainOutbound = document.getElementById('btn-main-outbound-store') as HTMLAnchorElement | null;
  const stickyOutbound = document.getElementById('btn-sticky-outbound') as HTMLAnchorElement | null;
  
  const metricCurrent = document.getElementById('metric-current-price');
  const metricMin = document.getElementById('metric-min-price');
  const metricAvg = document.getElementById('metric-avg-price');

  const chartContainer = document.getElementById('price-chart-svg-wrapper');
  const chartLegendLabel = document.getElementById('chart-legend-label');
  const btnKilo = document.getElementById('btn-chart-kilo');
  const btnUnit = document.getElementById('btn-chart-unit');

  // Datos serializados de variantes inyectados
  const variantsRaw = (window as any).variantsJson ? JSON.parse((window as any).variantsJson) : [];
  let currentVarIndex = 0;
  let chartMode: 'kilo' | 'unit' = 'kilo';

  const formatClp = (num: number) => `$${Math.round(num).toLocaleString('es-CL')}`;

  function getActiveVariantData() {
    if (variantsRaw.length > 0 && variantsRaw[currentVarIndex]) {
      return variantsRaw[currentVarIndex];
    }
    return {
      precio_clp: 0,
      precio_por_kilo: 0,
      historial_precios: []
    };
  }

  function renderSvgChart() {
    if (!chartContainer) return;

    const variant = getActiveVariantData();
    const isKilo = chartMode === 'kilo';
    const currentVal = isKilo ? (variant.precio_por_kilo || 0) : (variant.precio_clp || 0);

    // Preparar serie de datos cronológicos
    let points: { label: string; value: number }[] = [];
    if (variant.historial_precios && variant.historial_precios.length > 1) {
      points = variant.historial_precios.map((h: any, idx: number) => ({
        label: h.fecha_registro ? new Date(h.fecha_registro).toLocaleDateString('es-CL', { day: '2-digit', month: 'short' }) : `P${idx + 1}`,
        value: isKilo ? (h.precio_por_kilo || currentVal) : (h.precio_clp || currentVal)
      }));
    } else {
      // Línea de estabilidad basada en fechas recientes
      points = [
        { label: 'Hace 30d', value: currentVal },
        { label: 'Hace 20d', value: currentVal },
        { label: 'Hace 10d', value: currentVal },
        { label: 'Hoy', value: currentVal },
      ];
    }

    const values = points.map(p => p.value);
    const minVal = Math.min(...values);
    const maxVal = Math.max(...values);
    const avgVal = Math.round(values.reduce((a, b) => a + b, 0) / values.length);

    // Actualizar métricas superiores
    if (metricCurrent) metricCurrent.textContent = isKilo ? `${formatClp(currentVal)}/kg` : formatClp(currentVal);
    if (metricMin) metricMin.textContent = isKilo ? `${formatClp(minVal)}/kg` : formatClp(minVal);
    if (metricAvg) metricAvg.textContent = isKilo ? `${formatClp(avgVal)}/kg` : formatClp(avgVal);

    if (chartLegendLabel) {
      chartLegendLabel.textContent = isKilo ? 'Mostrando: Precio por Kilo ($/kg)' : 'Mostrando: Precio por Bolsa ($ CLP)';
    }

    // Dimensiones SVG
    const width = 560;
    const height = 150;
    const padTop = 25;
    const padBottom = 25;
    const padLeft = 60;
    const padRight = 30;

    const effectiveHeight = height - padTop - padBottom;
    const effectiveWidth = width - padLeft - padRight;

    // Rango Y con margen del 10% para respiración visual
    let yMin = minVal * 0.92;
    let yMax = maxVal * 1.08;
    if (yMin === yMax || yMax - yMin < 10) {
      yMin = Math.max(0, currentVal * 0.85);
      yMax = currentVal * 1.15;
    }

    const getY = (val: number) => {
      const ratio = (val - yMin) / (yMax - yMin);
      return height - padBottom - (ratio * effectiveHeight);
    };

    const getX = (idx: number) => {
      if (points.length <= 1) return padLeft + (effectiveWidth / 2);
      return padLeft + (idx * (effectiveWidth / (points.length - 1)));
    };

    // Puntos calculados
    const coords = points.map((p, i) => ({
      x: getX(i),
      y: getY(p.value),
      label: p.label,
      val: p.value
    }));

    // Trazar línea y área
    const pathD = coords.reduce((acc, c, i) => `${acc} ${i === 0 ? 'M' : 'L'} ${c.x.toFixed(1)},${c.y.toFixed(1)}`, '');
    const areaD = `${pathD} L ${coords[coords.length - 1].x.toFixed(1)},${(height - padBottom).toFixed(1)} L ${coords[0].x.toFixed(1)},${(height - padBottom).toFixed(1)} Z`;

    // Grilla horizontal con 3 niveles
    const gridLevels = [yMin + (yMax - yMin) * 0.2, yMin + (yMax - yMin) * 0.5, yMin + (yMax - yMin) * 0.8];
    const gridLines = gridLevels.map(lvl => {
      const y = getY(lvl).toFixed(1);
      return `
        <line x1="${padLeft}" y1="${y}" x2="${width - padRight}" y2="${y}" stroke="#E7E5E4" stroke-dasharray="3 3" stroke-width="1" />
        <text x="${padLeft - 8}" y="${parseFloat(y) + 3}" text-anchor="end" font-size="9" fill="#A8A29E" font-weight="600">${formatClp(lvl)}</text>
      `;
    }).join('');

    const circles = coords.map(c => `
      <g class="cursor-pointer group">
        <circle cx="${c.x.toFixed(1)}" cy="${c.y.toFixed(1)}" r="4.5" fill="#047857" stroke="#ffffff" stroke-width="2" class="transition-all hover:r-6" />
        <text x="${c.x.toFixed(1)}" y="${c.y - 10}" text-anchor="middle" font-size="9" font-weight="700" fill="#064E3B">${formatClp(c.val)}</text>
        <text x="${c.x.toFixed(1)}" y="${height - 8}" text-anchor="middle" font-size="9" fill="#78716C" font-weight="500">${c.label}</text>
      </g>
    `).join('');

    chartContainer.innerHTML = `
      <svg viewBox="0 0 ${width} ${height}" class="w-full h-full overflow-visible" preserveAspectRatio="none">
        <defs>
          <linearGradient id="priceGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#059669" stop-opacity="0.0" />
          </linearGradient>
        </defs>
        ${gridLines}
        <path d="${areaD}" fill="url(#priceGrad)" />
        <path d="${pathD}" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        ${circles}
      </svg>
    `;
  }

  // Interacción del conmutador $/kg y $ CLP
  btnKilo?.addEventListener('click', () => {
    chartMode = 'kilo';
    btnKilo.className = 'rounded-lg bg-white shadow-2xs px-3 py-1 text-emerald-800 font-bold transition';
    btnUnit?.setAttribute('class', 'rounded-lg px-3 py-1 text-stone-500 hover:text-stone-800 transition');
    renderSvgChart();
  });

  btnUnit?.addEventListener('click', () => {
    chartMode = 'unit';
    btnUnit.className = 'rounded-lg bg-white shadow-2xs px-3 py-1 text-emerald-800 font-bold transition';
    btnKilo?.setAttribute('class', 'rounded-lg px-3 py-1 text-stone-500 hover:text-stone-800 transition');
    renderSvgChart();
  });

  // Selector de variantes reactivo
  if (selector) {
    selector.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      currentVarIndex = parseInt(target.value, 10) || 0;
      const v = getActiveVariantData();

      if (displayUnit) {
        displayUnit.innerHTML = `${formatClp(v.precio_clp)} <span class="text-xs font-semibold text-stone-500">CLP</span>`;
      }
      if (displayKilo) {
        displayKilo.innerHTML = `${formatClp(v.precio_por_kilo)} <span class="text-[10px] font-semibold text-emerald-600">/kg</span>`;
      }
      if (stickyKilo) {
        stickyKilo.textContent = `${formatClp(v.precio_por_kilo)}/kg`;
      }

      renderSvgChart();
    });
  }

  // Inicializar renderizado del gráfico
  renderSvgChart();
</script>
