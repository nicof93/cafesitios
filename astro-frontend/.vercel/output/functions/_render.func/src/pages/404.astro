---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada | Cafe-sitios">
  <div class="py-20 text-center max-w-md mx-auto space-y-4">
    <span class="text-5xl block">☕💨</span>
    <h1 class="text-2xl font-extrabold text-slate-800">404 - Café no encontrado</h1>
    <p class="text-xs text-slate-500">
      El café o página que buscas puede haberse agotado, cambiado de enlace o ya no estar disponible.
    </p>
    <div class="pt-4">
      <a 
        href="/"
        class="inline-block bg-emerald-800 hover:bg-emerald-900 text-white font-semibold text-xs px-5 py-3 rounded-2xl shadow transition"
      >
        Volver al catálogo principal
      </a>
    </div>
  </div>
</BaseLayout>

