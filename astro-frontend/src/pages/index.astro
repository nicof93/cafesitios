<script>
  // Event listeners para los botones de la Landing Page
  const quizTrigger = document.getElementById('hero-quiz-trigger');
  if (quizTrigger) {
    quizTrigger.addEventListener('click', () => {
      // Notifica mediante CustomEvent y además activa el botón de la barra de navegación
      window.dispatchEvent(new CustomEvent('cafesitios:open-quiz'));
      const headerQuizBtn = document.getElementById('btn-open-quiz');
      if (headerQuizBtn) headerQuizBtn.click();
    });
  }

  const feedbackTrigger = document.getElementById('btn-footer-feedback-trigger');
  if (feedbackTrigger) {
    feedbackTrigger.addEventListener('click', () => {
      const fbBtn = document.getElementById('btn-open-feedback');
      if (fbBtn) fbBtn.click();
    });
  }

  // =======================================================================
  // ROTACIÓN AUTOMÁTICA DEL PRODUCTO HERO CADA 3 SEGUNDOS
  // =======================================================================
  try {
    const rawCandidates = document.getElementById('hero-candidates-data')?.textContent;
    const heroCandidates = rawCandidates ? JSON.parse(rawCandidates) : [];

    if (Array.isArray(heroCandidates) && heroCandidates.length > 1) {
      let currentIdx = 0;
      const heroCard = document.getElementById('hero-card');
      const heroImg = document.getElementById('hero-img') as HTMLImageElement | null;
      const heroTienda = document.getElementById('hero-tienda');
      const heroKiloBadge = document.getElementById('hero-kilo-badge');
      const heroOrigen = document.getElementById('hero-origen');
      const heroProceso = document.getElementById('hero-proceso');
      const heroTitle = document.getElementById('hero-title');
      const heroNotas = document.getElementById('hero-notas');
      const heroFormatoLabel = document.getElementById('hero-formato-label');
      const heroPrecioBolsa = document.getElementById('hero-precio-bolsa');
      const heroDetailLink = document.getElementById('hero-detail-link') as HTMLAnchorElement | null;
      const heroPillText = document.getElementById('hero-pill-text');

      setInterval(() => {
        let nextIdx = Math.floor(Math.random() * heroCandidates.length);
        if (nextIdx === currentIdx && heroCandidates.length > 1) {
          nextIdx = (currentIdx + 1) % heroCandidates.length;
        }
        currentIdx = nextIdx;
        const item = heroCandidates[currentIdx];
        if (!item) return;

        if (heroCard) {
          heroCard.classList.add('opacity-40', 'scale-[0.98]');
          setTimeout(() => {
            if (heroImg) {
              heroImg.src = item.imagen;
              heroImg.alt = `${item.nombre} de ${item.tienda}`;
            }
            if (heroTienda) {
              heroTienda.textContent = item.tienda;
              heroTienda.title = item.tienda;
            }
            if (heroKiloBadge) {
              heroKiloBadge.textContent = `$${Number(item.precio_por_kilo || 0).toLocaleString('es-CL')} /kg`;
            }
            if (heroOrigen) heroOrigen.textContent = item.origen;
            if (heroProceso) heroProceso.textContent = item.proceso;
            if (heroTitle) {
              heroTitle.textContent = item.nombre;
              heroTitle.title = item.nombre;
            }
            if (heroNotas && Array.isArray(item.notas_cata)) {
              heroNotas.innerHTML = item.notas_cata.map((nota: string, i: number) => `
                <span class="rounded-md px-2 py-0.5 font-medium ${
                  i === 0 ? 'bg-emerald-50 text-emerald-800' :
                  i === 1 ? 'bg-amber-50 text-amber-800' :
                  'bg-stone-100 text-stone-700'
                }">
                  ${nota}
                </span>
              `).join('');
            }
            if (heroFormatoLabel) {
              heroFormatoLabel.textContent = `Precio Bolsa (${item.formato_gramos}g)`;
            }
            if (heroPrecioBolsa) {
              heroPrecioBolsa.innerHTML = `$${Number(item.precio_clp || 0).toLocaleString('es-CL')} <small class="text-xs font-semibold text-stone-500">CLP</small>`;
            }
            if (heroDetailLink) {
              heroDetailLink.href = item.url_detalle;
            }
            if (heroPillText) {
              heroPillText.innerHTML = `Un café de <strong>$${Number(item.precio_clp || 0).toLocaleString('es-CL')} (${item.formato_gramos}g)</strong> equivale a <strong>$${Number(item.precio_por_kilo || 0).toLocaleString('es-CL')}/kg</strong>. ¡Compara antes de comprar!`;
            }
            heroCard.classList.remove('opacity-40', 'scale-[0.98]');
          }, 200);
        }
      }, 6000);
    }
  } catch (err) {
    console.warn('Error iniciando rotación automática del Hero:', err);
  }
</script>
