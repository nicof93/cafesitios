---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GetStoresUseCase } from '../core/application/GetStores';

const url = new URL(Astro.request.url);
const sortBy = (url.searchParams.get('sort_by') as 'product_count_desc' | 'distance_asc' | 'name_asc') || 'product_count_desc';
const lat = url.searchParams.get('lat') ? Number(url.searchParams.get('lat')) : undefined;
const lon = url.searchParams.get('lon') ? Number(url.searchParams.get('lon')) : undefined;

const storesUseCase = new GetStoresUseCase();
let stores: any[] = [];

try {
  stores = await storesUseCase.execute({
    pageSize: 100,
    sortBy,
    lat,
    lon
  });
} catch (error) {
  console.error('Error cargando tiendas en SSR:', error);
}
---

<BaseLayout 
  title="Mapa y Directorio de Tostadurías de Café en Chile | Cafesitios"
  description="Mapa interactivo y directorio de tostadurías de café de especialidad integradas en Cafesitios. Ubica tostadores en Providencia, Santiago, Las Condes y regiones."
  canonicalUrl="https://cafesitios.cl/tiendas"
>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
      .leaflet-popup-content-wrapper {
        border-radius: 1rem;
        box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        padding: 0.25rem;
      }
      .leaflet-popup-content {
        margin: 0.75rem 1rem;
        line-height: 1.4;
      }
    </style>
  </Fragment>

  <div class="space-y-8">
    
    <!-- BREADCRUMB -->
    <nav class="flex items-center gap-2 text-xs text-stone-500">
      <a href="/" class="hover:text-emerald-800 transition">Catálogo</a>
      <span class="text-stone-300">/</span>
      <span class="font-semibold text-stone-800">Mapa y Directorio de Tiendas</span>
    </nav>

    <!-- HEADER DE SECCIÓN Y CONTROLES -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 sm:p-8 rounded-3xl border border-stone-200/80 shadow-2xs">
      <div class="space-y-1">
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-stone-900">
          Mapa de Tostadurías de Especialidad
        </h1>
        <p class="text-xs text-stone-500">
          Explora tostadurías físicas y marcas asociadas en Chile con monitoreo en tiempo real (<strong class="text-stone-800 font-semibold">{stores.length} tiendas</strong>).
        </p>
      </div>

      <!-- BOTONES DE ORDEN Y GPS -->
      <div class="flex flex-wrap items-center gap-2.5">
        <button 
          id="btn-detect-gps"
          type="button" 
          class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-200 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-emerald-800 hover:bg-emerald-100 transition shadow-2xs"
        >
          <span>📍</span> Centrar en mi ubicación GPS
        </button>
        <button 
          id="btn-toggle-map"
          type="button" 
          class="inline-flex items-center gap-1.5 rounded-xl border border-stone-200 bg-white px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-50 transition shadow-2xs"
        >
          <span>🗺️</span> <span id="toggle-map-text">Ocultar Mapa</span>
        </button>
      </div>
    </div>

    <!-- CONTENEDOR DEL MAPA INTERACTIVO (LEAFLET.JS) -->
    <div id="map-section" class="bg-white p-3.5 rounded-3xl border border-stone-200/80 shadow-2xs space-y-3">
      <div class="flex items-center justify-between px-2 pt-1 text-xs text-stone-500">
        <span class="font-semibold flex items-center gap-1.5 text-stone-800">
          <span>📍</span> Ubicación Geográfica de Tiendas y Tostadores
        </span>
        <span class="text-[11px] text-stone-400">
          Haz clic en cualquier pin para ver cafés disponibles y sitio web
        </span>
      </div>
      <div 
        id="stores-map" 
        class="h-80 sm:h-96 w-full rounded-2xl z-10 border border-stone-100"
        data-stores={JSON.stringify(stores)}
      ></div>
    </div>

    <!-- FILTRO RÁPIDO Y BUSCADOR DE TIENDAS -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-stone-200/80 shadow-2xs">
      <div class="relative w-full sm:w-72">
        <input 
          type="text" 
          id="store-search-filter" 
          placeholder="Filtrar por nombre o comuna..." 
          class="w-full bg-stone-50 border border-stone-200 rounded-xl pl-8 pr-3 py-2 text-xs text-stone-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-600/20 focus:border-emerald-600 transition"
        />
        <span class="absolute left-2.5 top-2.5 text-stone-400 text-xs pointer-events-none">🔍</span>
      </div>

      <div class="flex items-center gap-2 text-xs text-stone-400 w-full sm:w-auto justify-end">
        <span>Mostrando <strong id="store-count-display" class="text-stone-700 font-semibold">{stores.length}</strong> tostadurías</span>
      </div>
    </div>

    <!-- GRILLA DE TIENDAS -->
    <div id="stores-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {stores.map(tienda => (
        <article 
          class="store-card bg-white rounded-2xl border border-stone-200/80 p-5 shadow-2xs hover:border-emerald-300 hover:shadow-xs transition flex flex-col justify-between"
          data-name={tienda.nombre.toLowerCase()}
          data-comuna={(tienda.comuna || '').toLowerCase()}
          data-lat={tienda.latitud}
          data-lon={tienda.longitud}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <h2 class="text-sm font-bold text-stone-900">{tienda.nombre}</h2>
              <span class="bg-emerald-50 text-emerald-800 text-[10px] font-extrabold px-2 py-0.5 rounded-full border border-emerald-100">
                {tienda.cantidad_productos} cafés
              </span>
            </div>

            <div class="space-y-1.5 text-xs text-stone-500">
              {tienda.comuna && (
                <p class="flex items-center gap-1.5">
                  <span class="text-stone-400">📍</span>
                  <span class="font-medium text-stone-700">{tienda.comuna}</span>
                </p>
              )}
              {tienda.distancia_km !== undefined && tienda.distancia_km !== null && (
                <p class="font-bold text-emerald-700">
                  Cercanía estimada: ~{tienda.distancia_km} km
                </p>
              )}
              {tienda.plataforma && (
                <p class="text-[10px] text-stone-400">
                  Plataforma: {tienda.plataforma}
                </p>
              )}
            </div>
          </div>

          <div class="pt-4 mt-4 border-t border-stone-100 flex items-center justify-between gap-2">
            <a 
              href={`/catalogo?tienda=${encodeURIComponent(tienda.nombre)}`}
              class="text-xs font-semibold text-emerald-800 hover:underline"
            >
              Ver cafés disponibles →
            </a>
            {(tienda.sitio_oficial || tienda.url_web) && (
              <a 
                href={tienda.sitio_oficial || tienda.url_web} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs text-stone-400 hover:text-stone-600 transition"
              >
                Sitio oficial ↗
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>

<script>
  declare const L: any;

  // INICIALIZACIÓN DEL MAPA CON LEAFLET.JS
  const mapElement = document.getElementById('stores-map');
  const storesCards = document.querySelectorAll('.store-card');
  const searchInput = document.getElementById('store-search-filter') as HTMLInputElement | null;
  const countDisplay = document.getElementById('store-count-display');
  const gpsBtn = document.getElementById('btn-detect-gps');
  const toggleMapBtn = document.getElementById('btn-toggle-map');
  const mapSection = document.getElementById('map-section');
  const toggleMapText = document.getElementById('toggle-map-text');

  let map: any = null;
  const markers: any[] = [];

  if (mapElement && typeof L !== 'undefined') {
    const rawStores = mapElement.getAttribute('data-stores');
    const storesList = rawStores ? JSON.parse(rawStores) : [];

    // Coordenadas iniciales: Santiago, Chile
    const defaultCenter = [-33.4372, -70.6275];
    map = L.map('stores-map').setView(defaultCenter, 12);

    // Capa base oficial de OpenStreetMap (100% abierta, gratuita, sin API Key ni cuentas de pago)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      subdomains: ['a', 'b', 'c'],
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Icono personalizado sutil para tostadurías
    const coffeeIcon = L.divIcon({
      className: 'custom-coffee-pin',
      html: `
        <div style="background: #064E3B; color: white; width: 32px; height: 32px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2); border: 2px solid white; font-size: 14px;">
          ☕
        </div>
      `,
      iconSize: [32, 32],
      iconAnchor: [16, 16],
      popupAnchor: [0, -18]
    });

    const bounds = L.latLngBounds([]);

    storesList.forEach((store: any) => {
      if (store.latitud && store.longitud) {
        const marker = L.marker([store.latitud, store.longitud], { icon: coffeeIcon }).addTo(map);
        
        const storeWeb = store.sitio_oficial || store.url_web || '';
        const popupContent = `
          <div style="min-width: 170px; font-family: system-ui, -apple-system, sans-serif;">
            <p style="font-size: 13px; font-weight: 800; color: #1c1917; margin: 0 0 4px 0;">${store.nombre}</p>
            <p style="font-size: 11px; color: #78716c; margin: 0 0 8px 0;">📍 ${store.comuna || 'Chile'} &bull; ${store.cantidad_productos} cafés</p>
            <div style="display: flex; gap: 8px; font-size: 11px;">
              <a href="/catalogo?tienda=${encodeURIComponent(store.nombre)}" style="color: #065f46; font-weight: 700; text-decoration: none;">Ver cafés →</a>
              ${storeWeb ? `<a href="${storeWeb}" target="_blank" rel="noopener noreferrer" style="color: #a8a29e; text-decoration: none;">Web Oficial ↗</a>` : ''}
            </div>
          </div>
        `;
        marker.bindPopup(popupContent);
        markers.push({ marker, store });
        bounds.extend([store.latitud, store.longitud]);
      }
    });

    if (markers.length > 0) {
      map.fitBounds(bounds, { padding: [40, 40] });
    }
  }

  // BUSCADOR RÁPIDO EN CLIENTE PARA FILTRAR TIENDAS Y MAPA
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    let visibleCount = 0;

    storesCards.forEach(card => {
      const el = card as HTMLElement;
      const name = el.getAttribute('data-name') || '';
      const comuna = el.getAttribute('data-comuna') || '';
      const matches = !query || name.includes(query) || comuna.includes(query);

      el.style.display = matches ? 'flex' : 'none';
      if (matches) visibleCount++;
    });

    if (countDisplay) {
      countDisplay.textContent = String(visibleCount);
    }
  });

  // BOTÓN TOGGLE MAPA
  toggleMapBtn?.addEventListener('click', () => {
    if (!mapSection) return;
    const isHidden = mapSection.classList.toggle('hidden');
    if (toggleMapText) {
      toggleMapText.textContent = isHidden ? 'Mostrar Mapa' : 'Ocultar Mapa';
    }
    if (!isHidden && map) {
      setTimeout(() => map.invalidateSize(), 150);
    }
  });

  // BOTÓN GPS
  gpsBtn?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      alert('La geolocalización no está soportada en tu navegador.');
      return;
    }

    gpsBtn.textContent = 'Obteniendo ubicación...';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        if (map && typeof L !== 'undefined') {
          map.setView([latitude, longitude], 13);
          const userIcon = L.divIcon({
            html: '<div style="background: #2563EB; width: 16px; height: 16px; border-radius: 9999px; border: 3px solid white; box-shadow: 0 0 10px rgba(37,99,235,0.6);"></div>',
            iconSize: [16, 16],
            iconAnchor: [8, 8]
          });
          L.marker([latitude, longitude], { icon: userIcon }).addTo(map).bindPopup('<b>Tu ubicación actual</b>').openPopup();
          gpsBtn.textContent = '📍 Ubicación detectada';
        } else {
          const currentUrl = new URL(window.location.href);
          currentUrl.searchParams.set('sort_by', 'distance_asc');
          currentUrl.searchParams.set('lat', latitude.toFixed(4));
          currentUrl.searchParams.set('lon', longitude.toFixed(4));
          window.location.href = currentUrl.toString();
        }
      },
      (err) => {
        alert('No pudimos acceder a tu ubicación.');
        gpsBtn.textContent = '📍 Centrar en mi ubicación GPS';
      }
    );
  });
</script>

