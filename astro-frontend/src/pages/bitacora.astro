---
import BaseLayout from '../layouts/BaseLayout.astro';

// Datos estructurados JSON-LD (Schema.org) para la Bitácora
const jsonLdBitacora = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Bitácora Barista de Recetas | Cafesitios",
  "description": "Registra, calcula ratios y califica tus preparaciones de café de especialidad con planilla de catación Q-Grader SCA.",
  "url": "https://cafesitios.cl/bitacora",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Cafesitios",
    "url": "https://cafesitios.cl"
  }
};
---

<BaseLayout
  title="Bitácora Barista de Recetas | Cafesitios - Registro de Extracciones y Catación SCA"
  description="Registra, calcula ratios y califica tus preparaciones de café de especialidad. Incluye planilla de catación Q-Grader SCA de 10 indicadores."
  canonicalUrl="https://cafesitios.cl/bitacora"
  jsonLd={jsonLdBitacora}
>
  <div class="space-y-8 py-2">

    <!-- BREADCRUMBS Y CABECERA DE PÁGINA -->
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs text-stone-500 font-medium" aria-label="Miga de pan">
        <a href="/" class="hover:text-emerald-800 transition">Inicio</a>
        <span>/</span>
        <span class="text-stone-800 font-bold" aria-current="page">Bitácora Barista</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-stone-200/80 pb-6">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-lg shadow-2xs">
              📖
            </span>
            <h1 class="text-2xl sm:text-4xl font-black text-stone-900 tracking-tight">
              Bitácora Barista
            </h1>
          </div>
          <p class="text-xs sm:text-sm text-stone-500 mt-1 max-w-2xl leading-relaxed">
            Tus extracciones, parámetros de molienda, ratios y cataciones Q-Grader SCA guardados de forma local-first en este dispositivo.
          </p>
        </div>

        <!-- ACCIONES SUPERIORES -->
        <div class="flex items-center gap-3">
          <button 
            type="button" 
            id="btn-sync-cloud-page"
            class="inline-flex items-center gap-1.5 rounded-2xl border border-sky-200 bg-sky-50 hover:bg-sky-100 px-4 py-2.5 text-xs font-bold text-sky-800 transition shadow-2xs"
            title="Sincronizar tus recetas con la nube"
          >
            <span>☁️</span>
            <span class="hidden sm:inline">Respaldar en la Nube</span>
            <span class="sm:hidden">Respaldar</span>
          </button>

          <button 
            type="button" 
            id="btn-open-drawer"
            class="inline-flex items-center gap-2 rounded-2xl bg-stone-900 hover:bg-emerald-900 text-white px-5 py-2.5 text-xs font-bold transition shadow-md hover:shadow-lg hover:-translate-y-0.5"
          >
            <span>+</span>
            <span>Nueva Receta</span>
            <span>☕</span>
          </button>
        </div>
      </div>

      <!-- BARRA DE ESTADO / CONTADOR -->
      <div class="flex items-center justify-between text-xs font-medium text-stone-500">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span id="recipes-counter-text">Cargando recetas...</span>
        </div>
        <span class="text-[11px] text-stone-400">Almacenamiento local seguro</span>
      </div>
    </header>

    <!-- LISTADO DE RECETAS O EMPTY STATE -->
    <main>
      <!-- CONTENEDOR EMPTY STATE -->
      <section 
        id="recipes-empty-state" 
        class="hidden rounded-3xl border-2 border-dashed border-stone-200 bg-gradient-to-b from-[#FAF8F2] to-white p-10 sm:p-16 text-center max-w-2xl mx-auto space-y-6 shadow-2xs"
      >
        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-3xl bg-amber-100/60 border border-amber-200 text-4xl shadow-inner animate-pulse">
          ☕
        </div>

        <div class="space-y-2">
          <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900 tracking-tight">
            Tu bitácora barista aún está vacía
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 max-w-md mx-auto leading-relaxed">
            Comienza a registrar tus métodos de preparación favoritos (V60, Aeropress, Espresso), molienda, ratios de agua y café, y la planilla de catación Q-Grader SCA.
          </p>
        </div>

        <div class="pt-2">
          <button 
            type="button" 
            id="btn-empty-create"
            class="inline-flex items-center gap-2 rounded-2xl bg-stone-900 hover:bg-emerald-900 text-white font-bold text-sm px-7 py-3.5 transition shadow-md hover:shadow-lg hover:-translate-y-0.5"
          >
            <span>Registrar mi primera receta</span>
            <span class="text-emerald-400">☕ →</span>
          </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-stone-200/70 text-left">
          <div class="p-3 bg-white rounded-2xl border border-stone-200/80">
            <span class="text-base">⚖️</span>
            <h3 class="font-bold text-stone-800 text-xs mt-1">Cálculo de Ratio</h3>
            <p class="text-[11px] text-stone-500">Relación exacta café/agua calculada al instante.</p>
          </div>
          <div class="p-3 bg-white rounded-2xl border border-stone-200/80">
            <span class="text-base">🏆</span>
            <h3 class="font-bold text-stone-800 text-xs mt-1">Planilla SCA</h3>
            <p class="text-[11px] text-stone-500">10 indicadores oficiales de catación Q-Grader.</p>
          </div>
          <div class="p-3 bg-white rounded-2xl border border-stone-200/80">
            <span class="text-base">🔒</span>
            <h3 class="font-bold text-stone-800 text-xs mt-1">Local-First</h3>
            <p class="text-[11px] text-stone-500">Tus datos son privados y nunca se pierden.</p>
          </div>
        </div>
      </section>

      <!-- GRILLA DE RECETAS -->
      <section 
        id="recipes-grid" 
        class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
      >
        <!-- Las recetas se inyectan dinámicamente con JavaScript -->
      </section>
    </main>

  </div>

  <!-- ======================================================================= -->
  <!-- SLIDE-OVER DRAWER (Componente deslizable de derecha a izquierda - Estilo Apple) -->
  <!-- ======================================================================= -->
  <div 
    id="recipe-drawer-backdrop" 
    class="fixed inset-0 z-40 bg-stone-950/40 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"
    aria-hidden="true"
  ></div>

  <aside 
    id="recipe-slide-drawer" 
    role="dialog"
    aria-modal="true"
    aria-labelledby="drawer-title"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-lg bg-white shadow-2xl flex flex-col transform transition-transform duration-300 ease-in-out translate-x-full border-l border-stone-200"
  >
    <!-- CABECERA DEL SLIDE-OVER -->
    <div class="flex items-center justify-between p-5 border-b border-stone-200/80 bg-[#FAF8F2]/80 backdrop-blur-md">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-base font-bold shadow-2xs">
          ☕
        </span>
        <div>
          <h2 id="drawer-title" class="text-base font-bold text-stone-900 tracking-tight">
            Registrar Nueva Receta
          </h2>
          <p class="text-xs text-stone-500">
            Parámetros de extracción barista y cata sensorial
          </p>
        </div>
      </div>

      <button 
        type="button" 
        id="btn-close-drawer"
        class="h-8 w-8 flex items-center justify-center rounded-full text-stone-400 hover:text-stone-800 hover:bg-stone-200/60 transition text-lg font-bold"
        aria-label="Cerrar panel de receta"
      >
        ✕
      </button>
    </div>

    <!-- CUERPO SCROLLEABLE DEL FORMULARIO -->
    <form id="drawer-recipe-form" class="flex-1 overflow-y-auto p-6 space-y-6">
      
      <!-- Sección 1: Café y Método -->
      <div class="space-y-4">
        <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">1. Datos del Café & Método</span>
        
        <div>
          <label for="input-rec-cafe" class="block text-xs font-bold text-stone-700 mb-1">
            Nombre del Café o Lote <span class="text-rose-500">*</span>
          </label>
          <input 
            id="input-rec-cafe" 
            type="text" 
            required 
            placeholder="Ej. Geisha Lavado Finca La Esperanza" 
            class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="select-rec-metodo" class="block text-xs font-bold text-stone-700 mb-1">
              Método de Preparación <span class="text-rose-500">*</span>
            </label>
            <select 
              id="select-rec-metodo" 
              required 
              class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
              <option value="V60">💧 V60</option>
              <option value="Aeropress">🧪 Aeropress</option>
              <option value="Espresso">☕ Espresso</option>
              <option value="Chemex">⏳ Chemex</option>
              <option value="French Press">🫖 Prensa Francesa</option>
              <option value="Moka">🔥 Cafetera Moka / Italiana</option>
              <option value="Cold Brew">🧊 Cold Brew</option>
              <option value="Kalita Wave">🌊 Kalita Wave</option>
              <option value="Origami">🌸 Origami</option>
              <option value="Otro">✨ Otro Método</option>
            </select>
          </div>

          <div>
            <label for="select-rec-calificacion" class="block text-xs font-bold text-stone-700 mb-1">
              Calificación Personal
            </label>
            <select 
              id="select-rec-calificacion" 
              class="w-full bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-xs font-bold text-amber-600 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
              <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
              <option value="4">⭐⭐⭐⭐ (4/5)</option>
              <option value="3">⭐⭐⭐ (3/5)</option>
              <option value="2">⭐⭐ (2/5)</option>
              <option value="1">⭐ (1/5)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Sección 2: Ratios y Variables Barista -->
      <div class="space-y-4 pt-4 border-t border-stone-100">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-stone-400">2. Ratios & Parámetros</span>
          <span id="preview-ratio" class="rounded-full bg-emerald-100 text-emerald-800 text-[11px] font-extrabold px-3 py-0.5 border border-emerald-300">
            Ratio 1:16.7
          </span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="input-rec-gramos-cafe" class="block text-xs font-bold text-stone-700 mb-1">
              Café molido (g) <span class="text-rose-500">*</span>
            </label>
            <input 
              id="input-rec-gramos-cafe" 
              type="number" 
              step="0.1" 
              min="1" 
              required 
              value="15"
              placeholder="15" 
              class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs font-bold text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
          </div>

          <div>
            <label for="input-rec-gramos-agua" class="block text-xs font-bold text-stone-700 mb-1">
              Agua total (g / ml) <span class="text-rose-500">*</span>
            </label>
            <input 
              id="input-rec-gramos-agua" 
              type="number" 
              step="1" 
              min="10" 
              required 
              value="250"
              placeholder="250" 
              class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs font-bold text-stone-800 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
          </div>

          <div>
            <label for="input-rec-molienda" class="block text-xs font-bold text-stone-700 mb-1">
              Molienda
            </label>
            <input 
              id="input-rec-molienda" 
              type="text" 
              placeholder="Media-fina (18 clics)" 
              class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
          </div>

          <div>
            <label for="input-rec-tiempo" class="block text-xs font-bold text-stone-700 mb-1">
              Tiempo de Infusión
            </label>
            <input 
              id="input-rec-tiempo" 
              type="text" 
              placeholder="2:45 min" 
              class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
            >
          </div>
        </div>

        <div>
          <label for="textarea-rec-notas" class="block text-xs font-bold text-stone-700 mb-1">
            Notas sensoriales / Comentarios
          </label>
          <textarea 
            id="textarea-rec-notas" 
            rows="2" 
            placeholder="Notas a durazno blanco, acidez málica sedosa, buen cuerpo y final limpio..." 
            class="w-full bg-white border border-stone-200 rounded-xl p-3 text-xs text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 transition"
          ></textarea>
        </div>
      </div>

      <!-- Sección 3: Planilla de Catación Q-Grader (10 Indicadores SCA) -->
      <div class="pt-2">
        <details id="details-sca-cupping" class="group rounded-2xl border border-amber-200/90 bg-amber-50/50 p-4 text-xs transition">
          <summary class="font-bold text-amber-950 cursor-pointer flex items-center justify-between list-none select-none">
            <span class="flex items-center gap-2">
              <span class="text-base">🏆</span>
              <span>Planilla Q-Grader SCA (10 Indicadores Opcionales)</span>
            </span>
            <span class="text-[10px] bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded-full group-open:hidden">
              + Calificar
            </span>
            <span class="text-[10px] text-amber-700 hidden group-open:inline">▲ Ocultar</span>
          </summary>

          <div class="mt-3 pt-3 border-t border-amber-200/70 space-y-3">
            <p class="text-[11px] text-amber-900/80 leading-relaxed">
              Puntúa de 1 a 10 cada indicador de la Specialty Coffee Association. La suma calculará la calificación oficial en taza (máx. 100 pts).
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-[10px]">
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">1. Aroma</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-aroma" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">2. Sabor</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-sabor" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">3. Retrogusto</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-retrogusto" placeholder="8.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">4. Acidez</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-acidez" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">5. Cuerpo</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-cuerpo" placeholder="8.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">6. Balance</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-balance" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">7. Uniformidad</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-uniformidad" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">8. Taza Limpia</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-taza-limpia" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">9. Dulzor</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-dulzor" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
              <div>
                <label class="block font-bold text-stone-700 mb-0.5">10. Global</label>
                <input type="number" min="1" max="10" step="0.25" id="input-sca-global" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
              </div>
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-amber-200/60">
              <span class="text-xs font-semibold text-amber-900">Puntaje Total SCA:</span>
              <span id="label-sca-total" class="font-extrabold text-amber-950 bg-amber-100 border border-amber-300 px-3 py-1 rounded-lg text-xs shadow-2xs">
                Sin calificar
              </span>
            </div>
          </div>
        </details>
      </div>

      <!-- BOTONES DE ACCIÓN DEL FORMULARIO -->
      <div class="pt-4 border-t border-stone-200 flex items-center justify-end gap-3 sticky bottom-0 bg-white/95 backdrop-blur-xs py-3">
        <button 
          type="button" 
          id="btn-cancel-drawer"
          class="rounded-xl px-4 py-2.5 text-xs font-bold text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition"
        >
          Cancelar
        </button>

        <button 
          type="submit" 
          class="rounded-xl bg-stone-900 hover:bg-emerald-900 text-white text-xs font-bold px-6 py-2.5 transition shadow-sm hover:shadow"
        >
          Guardar Receta en Bitácora ☕
        </button>
      </div>

    </form>
  </aside>
</BaseLayout>

<script>
  import { ManageRecipesUseCase } from '../core/application/ManageRecipes';
  import { AnalyticsTracker } from '../core/infrastructure/analytics/AnalyticsTracker';

  const recipesUseCase = new ManageRecipesUseCase();

  // Elementos DOM
  const drawerContainer = document.getElementById('recipe-slide-drawer');
  const drawerBackdrop = document.getElementById('recipe-drawer-backdrop');
  const btnOpenDrawer = document.getElementById('btn-open-drawer');
  const btnEmptyCreate = document.getElementById('btn-empty-create');
  const btnCloseDrawer = document.getElementById('btn-close-drawer');
  const btnCancelDrawer = document.getElementById('btn-cancel-drawer');
  const form = document.getElementById('drawer-recipe-form') as HTMLFormElement | null;
  const syncBtn = document.getElementById('btn-sync-cloud-page');

  const emptyState = document.getElementById('recipes-empty-state');
  const recipesGrid = document.getElementById('recipes-grid');
  const counterText = document.getElementById('recipes-counter-text');

  const inputGramosCafe = document.getElementById('input-rec-gramos-cafe') as HTMLInputElement | null;
  const inputGramosAgua = document.getElementById('input-rec-gramos-agua') as HTMLInputElement | null;
  const previewRatio = document.getElementById('preview-ratio');
  const labelScaTotal = document.getElementById('label-sca-total');

  // Control del Drawer Deslizable (Slide-Over estilo macOS/Apple)
  function openDrawer() {
    drawerBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
    drawerBackdrop?.classList.add('opacity-100', 'pointer-events-auto');

    drawerContainer?.classList.remove('translate-x-full');
    drawerContainer?.classList.add('translate-x-0');

    document.body.classList.add('overflow-hidden');
    (document.getElementById('input-rec-cafe') as HTMLInputElement)?.focus();
  }

  function closeDrawer() {
    drawerBackdrop?.classList.remove('opacity-100', 'pointer-events-auto');
    drawerBackdrop?.classList.add('opacity-0', 'pointer-events-none');

    drawerContainer?.classList.remove('translate-x-0');
    drawerContainer?.classList.add('translate-x-full');

    document.body.classList.remove('overflow-hidden');
  }

  btnOpenDrawer?.addEventListener('click', openDrawer);
  btnEmptyCreate?.addEventListener('click', openDrawer);
  btnCloseDrawer?.addEventListener('click', closeDrawer);
  btnCancelDrawer?.addEventListener('click', closeDrawer);
  drawerBackdrop?.addEventListener('click', closeDrawer);

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawerContainer?.classList.contains('translate-x-full')) {
      closeDrawer();
    }
  });

  // Cálculo dinámico de Ratio
  function updateRatio() {
    if (!inputGramosCafe || !inputGramosAgua || !previewRatio) return;
    const cafe = parseFloat(inputGramosCafe.value);
    const agua = parseFloat(inputGramosAgua.value);

    if (cafe > 0 && agua > 0) {
      const ratio = (agua / cafe).toFixed(1);
      previewRatio.textContent = `Ratio 1:${ratio}`;
    } else {
      previewRatio.textContent = 'Ratio --:--';
    }
  }

  inputGramosCafe?.addEventListener('input', updateRatio);
  inputGramosAgua?.addEventListener('input', updateRatio);

  // Cálculo de puntaje SCA
  function calculateScaTotal(): number | null {
    const inputs = document.querySelectorAll('.input-sca-attr') as NodeListOf<HTMLInputElement>;
    let sum = 0;
    let count = 0;
    inputs.forEach(inp => {
      const val = parseFloat(inp.value);
      if (!isNaN(val) && val > 0) {
        sum += val;
        count++;
      }
    });

    if (count > 0 && labelScaTotal) {
      labelScaTotal.textContent = `★ ${sum.toFixed(2)} / 100 pts SCA (${count}/10 atributos)`;
      return parseFloat(sum.toFixed(2));
    } else if (labelScaTotal) {
      labelScaTotal.textContent = 'Sin calificar';
    }
    return null;
  }

  document.querySelectorAll('.input-sca-attr').forEach(inp => {
    inp.addEventListener('input', calculateScaTotal);
  });

  // Renderizado de Recetas
  function renderRecipes() {
    const recipes = recipesUseCase.getLocalRecipes();

    if (counterText) {
      counterText.textContent = `${recipes.length} receta${recipes.length === 1 ? '' : 's'} registrada${recipes.length === 1 ? '' : 's'}`;
    }

    if (recipes.length === 0) {
      emptyState?.classList.remove('hidden');
      recipesGrid?.classList.add('hidden');
      if (recipesGrid) recipesGrid.innerHTML = '';
      return;
    }

    emptyState?.classList.add('hidden');
    recipesGrid?.classList.remove('hidden');

    if (!recipesGrid) return;

    recipesGrid.innerHTML = recipes.map(r => {
      const formattedDate = r.fecha ? new Date(r.fecha).toLocaleDateString('es-CL', {
        day: '2-digit',
        month: 'short',
        year: 'numeric'
      }) : 'Hoy';

      return `
        <article class="group rounded-3xl border border-stone-200/90 bg-white p-5 shadow-2xs hover:shadow-md hover:border-emerald-200 transition-all duration-200 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <!-- Header de Tarjeta -->
            <div class="flex items-start justify-between gap-2">
              <div class="space-y-1">
                <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider text-emerald-800 bg-emerald-50 border border-emerald-200/60 rounded-full px-2.5 py-0.5">
                  ${r.metodo}
                </span>
                <h3 class="text-base font-bold text-stone-900 group-hover:text-emerald-950 transition line-clamp-2">
                  ${r.cafe}
                </h3>
              </div>
              <span class="text-amber-500 text-xs shrink-0 font-bold" title="${r.calificacion} de 5 estrellas">
                ${'⭐'.repeat(r.calificacion)}
              </span>
            </div>

            <!-- Badge SCA si existe -->
            ${r.puntuacion_sca_total ? `
              <div class="inline-flex items-center gap-1.5 rounded-xl bg-amber-50 border border-amber-200 px-2.5 py-1 text-xs font-black text-amber-900 shadow-2xs">
                <span>★</span>
                <span>${r.puntuacion_sca_total} pts SCA</span>
                <span class="text-[10px] font-normal text-amber-700">(${Object.keys(r.catacion_sca || {}).length} atributos)</span>
              </div>
            ` : ''}

            <!-- Parámetros de Extracción -->
            <div class="grid grid-cols-2 gap-2 text-xs bg-stone-50/80 rounded-2xl p-3 border border-stone-100">
              <div>
                <span class="block text-[10px] uppercase font-bold text-stone-400">Ratio</span>
                <span class="font-extrabold text-stone-800">${r.getRatio()}</span>
              </div>
              <div>
                <span class="block text-[10px] uppercase font-bold text-stone-400">Dosis / Agua</span>
                <span class="font-semibold text-stone-700">${r.gramos_cafe}g / ${r.gramos_agua}g</span>
              </div>
              ${r.molienda ? `
                <div class="col-span-2 pt-1 border-t border-stone-200/40">
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Molienda</span>
                  <span class="text-stone-700 truncate block">${r.molienda}</span>
                </div>
              ` : ''}
              ${r.tiempo ? `
                <div class="col-span-2">
                  <span class="block text-[10px] uppercase font-bold text-stone-400">Tiempo</span>
                  <span class="text-stone-700">${r.tiempo}</span>
                </div>
              ` : ''}
            </div>

            <!-- Notas de cata -->
            ${r.notas ? `
              <div class="text-xs text-stone-600 bg-stone-50/50 p-2.5 rounded-xl border border-stone-100/80 italic">
                "${r.notas}"
              </div>
            ` : ''}
          </div>

          <!-- Footer con Fecha y Borrar -->
          <div class="pt-3 border-t border-stone-100 flex items-center justify-between text-[11px] text-stone-400">
            <span>📅 ${formattedDate}</span>
            <button 
              type="button" 
              class="btn-delete-recipe text-stone-400 hover:text-rose-600 hover:bg-rose-50 p-1.5 rounded-lg transition"
              data-recipe-id="${r.id}"
              title="Eliminar receta de la bitácora"
            >
              🗑️
            </button>
          </div>
        </article>
      `;
    }).join('');

    // Listeners de eliminar receta
    document.querySelectorAll('.btn-delete-recipe').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-recipe-id');
        if (!id) return;
        if (confirm('¿Deseas eliminar esta receta de tu bitácora?')) {
          recipesUseCase.deleteLocalRecipe(id);
          renderRecipes();
        }
      });
    });
  }

  // Envío del Formulario
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const cafe = (document.getElementById('input-rec-cafe') as HTMLInputElement).value.trim();
    const metodo = (document.getElementById('select-rec-metodo') as HTMLSelectElement).value;
    const gramosCafe = parseFloat((document.getElementById('input-rec-gramos-cafe') as HTMLInputElement).value);
    const gramosAgua = parseFloat((document.getElementById('input-rec-gramos-agua') as HTMLInputElement).value);
    const molienda = (document.getElementById('input-rec-molienda') as HTMLInputElement).value.trim();
    const tiempo = (document.getElementById('input-rec-tiempo') as HTMLInputElement).value.trim();
    const calificacion = parseInt((document.getElementById('select-rec-calificacion') as HTMLSelectElement).value, 10);
    const notas = (document.getElementById('textarea-rec-notas') as HTMLTextAreaElement).value.trim();

    // Recolectar atributos SCA
    const scaAroma = parseFloat((document.getElementById('input-sca-aroma') as HTMLInputElement)?.value);
    const scaSabor = parseFloat((document.getElementById('input-sca-sabor') as HTMLInputElement)?.value);
    const scaRetro = parseFloat((document.getElementById('input-sca-retrogusto') as HTMLInputElement)?.value);
    const scaAcidez = parseFloat((document.getElementById('input-sca-acidez') as HTMLInputElement)?.value);
    const scaCuerpo = parseFloat((document.getElementById('input-sca-cuerpo') as HTMLInputElement)?.value);
    const scaBalance = parseFloat((document.getElementById('input-sca-balance') as HTMLInputElement)?.value);
    const scaUniformidad = parseFloat((document.getElementById('input-sca-uniformidad') as HTMLInputElement)?.value);
    const scaTazaLimpia = parseFloat((document.getElementById('input-sca-taza-limpia') as HTMLInputElement)?.value);
    const scaDulzor = parseFloat((document.getElementById('input-sca-dulzor') as HTMLInputElement)?.value);
    const scaGlobal = parseFloat((document.getElementById('input-sca-global') as HTMLInputElement)?.value);

    const catacionSca: Record<string, number> = {};
    if (!isNaN(scaAroma)) catacionSca['fragancia_aroma'] = scaAroma;
    if (!isNaN(scaSabor)) catacionSca['sabor'] = scaSabor;
    if (!isNaN(scaRetro)) catacionSca['retrogusto'] = scaRetro;
    if (!isNaN(scaAcidez)) catacionSca['acidez'] = scaAcidez;
    if (!isNaN(scaCuerpo)) catacionSca['cuerpo'] = scaCuerpo;
    if (!isNaN(scaBalance)) catacionSca['balance'] = scaBalance;
    if (!isNaN(scaUniformidad)) catacionSca['uniformidad'] = scaUniformidad;
    if (!isNaN(scaTazaLimpia)) catacionSca['taza_limpia'] = scaTazaLimpia;
    if (!isNaN(scaDulzor)) catacionSca['dulzor'] = scaDulzor;
    if (!isNaN(scaGlobal)) catacionSca['puntaje_global'] = scaGlobal;

    const puntuacionScaTotal = calculateScaTotal();

    recipesUseCase.saveLocalRecipe({
      id: `rec-${Date.now()}`,
      cafe,
      metodo,
      gramos_cafe: gramosCafe,
      gramos_agua: gramosAgua,
      molienda,
      tiempo,
      calificacion,
      notas,
      catacion_sca: Object.keys(catacionSca).length > 0 ? catacionSca : undefined,
      puntuacion_sca_total: puntuacionScaTotal || undefined,
      fecha: new Date().toISOString()
    });

    form.reset();
    if (labelScaTotal) labelScaTotal.textContent = 'Sin calificar';
    updateRatio();
    closeDrawer();
    renderRecipes();

    AnalyticsTracker.trackRecipeSaved(metodo, cafe, calificacion);
  });

  // Sincronización en la Nube
  syncBtn?.addEventListener('click', async () => {
    try {
      const res = await recipesUseCase.syncToCloud();
      if (res.success) {
        alert('☁️ ' + res.message);
        AnalyticsTracker.trackRecipeCloudSynced(res.count);
      } else {
        alert(res.message);
      }
    } catch {
      alert('Modo sin conexión: Tus recetas siguen guardadas en este dispositivo.');
    }
  });

  // Inicialización al cargar la página
  renderRecipes();
  updateRatio();
</script>

