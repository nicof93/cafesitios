---
import { Environment } from '../../core/infrastructure/config/Environment';
import '../../styles/global.css';

const apiBase = Environment.getApiBaseUrl();
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-stone-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Acceso Administrador de Tienda | Cafesitios</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
</head>
<body class="h-full flex items-center justify-center p-4 text-stone-100 antialiased font-sans" data-api-base={apiBase}>
  <div class="w-full max-w-md space-y-6">
    <!-- Header de Bienvenida -->
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-emerald-600 text-white font-black text-2xl shadow-lg shadow-emerald-900/50">
        ☕
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Portal de Tostadurías</h1>
      <p class="text-xs text-stone-400">Ingreso exclusivo para administradores de tiendas registradas</p>
    </div>

    <!-- Tarjeta de Login -->
    <div class="rounded-2xl border border-stone-800 bg-stone-800/80 backdrop-blur-md p-6 sm:p-8 shadow-2xl space-y-6">
      <!-- Alerta de Bloqueo Temporal (Anti-Fuerza Bruta) -->
      <div id="alert-lockout" class="hidden rounded-xl border border-rose-500/50 bg-rose-950/60 p-4 text-xs text-rose-200 space-y-1">
        <div class="flex items-center gap-2 font-bold text-rose-400">
          <span>🛑</span>
          <span>Acceso Temporalmente Bloqueado</span>
        </div>
        <p id="lockout-message">Demasiados intentos fallidos. Intenta nuevamente en <span id="lockout-timer" class="font-mono font-bold text-white">15:00</span>.</p>
      </div>

      <!-- Alerta de Error General -->
      <div id="alert-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-900/40 p-3 text-xs text-rose-300">
        <!-- Error inyectado por JS -->
      </div>

      <!-- Botones de Acceso OAuth -->
      <div class="space-y-2.5">
        <button
          type="button"
          id="btn-oauth-google"
          class="w-full flex items-center justify-center gap-3 rounded-xl border border-stone-700 bg-stone-900/80 hover:bg-stone-700/80 px-4 py-2.5 text-xs font-bold text-stone-200 hover:text-white transition shadow-xs"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Continuar con Google</span>
        </button>

        <button
          type="button"
          id="btn-oauth-github"
          class="w-full flex items-center justify-center gap-3 rounded-xl border border-stone-700 bg-stone-900/80 hover:bg-stone-700/80 px-4 py-2.5 text-xs font-bold text-stone-200 hover:text-white transition shadow-xs"
        >
          <svg class="h-4 w-4 fill-current text-white" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>Continuar con GitHub</span>
        </button>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="border-t border-stone-700 w-full"></div>
        <span class="bg-stone-800 px-3 text-[11px] font-semibold uppercase tracking-wider text-stone-400">O con credenciales</span>
      </div>

      <!-- Formulario Directo -->
      <form id="form-login" class="space-y-4">
        <div>
          <label for="input-email" class="block text-xs font-semibold text-stone-300 mb-1">Correo Electrónico o ID de Usuario</label>
          <input
            type="text"
            id="input-email"
            required
            placeholder="admin@tostaduria.cl o usuario-uuid"
            class="w-full rounded-xl border border-stone-700 bg-stone-900/90 px-3.5 py-2 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>

        <div>
          <label for="input-password" class="block text-xs font-semibold text-stone-300 mb-1">Contraseña o Clave Secreta</label>
          <input
            type="password"
            id="input-password"
            required
            placeholder="••••••••••••"
            class="w-full rounded-xl border border-stone-700 bg-stone-900/90 px-3.5 py-2 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>

        <!-- Verificación Anti-Bot (Turnstile) -->
        <div class="rounded-xl border border-stone-700 bg-stone-900/60 p-3 flex items-center justify-between text-xs text-stone-400">
          <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" id="check-anti-bot" checked class="h-4 w-4 rounded border-stone-600 bg-stone-800 text-emerald-600 focus:ring-emerald-500" />
            <span class="text-[11px] font-semibold text-stone-300">Verificación humana (Anti-Bot Turnstile)</span>
          </label>
          <span class="text-[10px] text-emerald-400 font-bold">🛡️ Protegido</span>
        </div>

        <button
          type="submit"
          id="btn-submit-login"
          class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-50"
        >
          Iniciar Sesión
        </button>
      </form>
    </div>

    <!-- Modal Primer Ingreso: Cambio de Contraseña -->
    <div id="modal-first-change-password" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm">
      <div class="w-full max-w-sm rounded-2xl border border-stone-700 bg-stone-900 p-6 shadow-2xl space-y-4">
        <div class="text-center space-y-1">
          <div class="text-3xl">🔑</div>
          <h2 class="text-base font-bold text-white">Primer Ingreso a la Plataforma</h2>
          <p class="text-xs text-stone-400">Por seguridad, puedes establecer tu propia clave de acceso definitiva.</p>
        </div>

        <div id="alert-change-pass-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-900/40 p-2.5 text-xs text-rose-300"></div>

        <form id="form-first-change-password" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-stone-300 mb-1">Nueva Contraseña</label>
            <input
              type="password"
              id="input-new-pass"
              required
              minlength="6"
              placeholder="Mínimo 6 caracteres"
              class="w-full rounded-xl border border-stone-700 bg-stone-800 px-3.5 py-2 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-stone-300 mb-1">Confirmar Nueva Contraseña</label>
            <input
              type="password"
              id="input-confirm-pass"
              required
              minlength="6"
              placeholder="Repite la nueva contraseña"
              class="w-full rounded-xl border border-stone-700 bg-stone-800 px-3.5 py-2 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none"
            />
          </div>

          <div class="pt-2 space-y-2">
            <button
              type="submit"
              id="btn-submit-change-pass"
              class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-600 px-4 py-2 text-xs font-bold text-white transition shadow-sm"
            >
              Guardar Contraseña y Continuar
            </button>
            <button
              type="button"
              id="btn-skip-change-pass"
              class="w-full rounded-xl border border-stone-700 bg-stone-800 hover:bg-stone-700 px-4 py-2 text-xs font-semibold text-stone-300 transition"
            >
              Omitir por ahora y entrar al Dashboard
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Footer Seguro -->
    <div class="text-center text-[11px] text-stone-500 space-y-1">
      <p>🛡️ Conexión cifrada TLS 1.3 con Rate Limiting estricto y protección anti-fuerza bruta.</p>
      <a href="/" class="text-emerald-400 hover:underline">← Volver al catálogo público</a>
    </div>
  </div>

  <script is:inline>
    (function initLoginPage() {
      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      // Si ya hay token válido, redirigir a dashboard
      const existingToken = localStorage.getItem('store_admin_token');
      if (existingToken) {
        window.location.replace('/admin-tienda/dashboard');
        return;
      }

      const formLogin = document.getElementById('form-login');
      const inputEmail = document.getElementById('input-email');
      const inputPassword = document.getElementById('input-password');
      const checkAntiBot = document.getElementById('check-anti-bot');
      const btnSubmit = document.getElementById('btn-submit-login');
      const alertError = document.getElementById('alert-error');
      const alertLockout = document.getElementById('alert-lockout');
      const lockoutTimer = document.getElementById('lockout-timer');

      const modalFirstPass = document.getElementById('modal-first-change-password');
      const formFirstPass = document.getElementById('form-first-change-password');
      const inputNewPass = document.getElementById('input-new-pass');
      const inputConfirmPass = document.getElementById('input-confirm-pass');
      const btnSubmitChangePass = document.getElementById('btn-submit-change-pass');
      const btnSkipChangePass = document.getElementById('btn-skip-change-pass');
      const alertChangePassError = document.getElementById('alert-change-pass-error');

      let currentPassVal = '';
      let pendingAuthData = null;

      let lockoutCountdownInterval = null;

      function startLockoutTimer(seconds) {
        if (alertLockout) alertLockout.classList.remove('hidden');
        if (btnSubmit) btnSubmit.disabled = true;

        let rem = seconds;
        function updateDisplay() {
          const m = Math.floor(rem / 60);
          const s = rem % 60;
          if (lockoutTimer) {
            lockoutTimer.textContent = `${m}:${s < 10 ? '0' : ''}${s}`;
          }
          if (rem <= 0) {
            clearInterval(lockoutCountdownInterval);
            if (alertLockout) alertLockout.classList.add('hidden');
            if (btnSubmit) btnSubmit.disabled = false;
          }
          rem -= 1;
        }
        updateDisplay();
        clearInterval(lockoutCountdownInterval);
        lockoutCountdownInterval = setInterval(updateDisplay, 1000);
      }

      function showError(msg) {
        if (alertError) {
          alertError.textContent = msg;
          alertError.classList.remove('hidden');
        }
      }

      function hideError() {
        if (alertError) alertError.classList.add('hidden');
      }

      async function doLogin(emailVal, passVal, oauthProvider = null) {
        hideError();
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = 'Verificando credenciales...';
        }

        const turnstileToken = checkAntiBot?.checked ? 'turnstile_valid' : null;

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: emailVal,
              password: passVal,
              oauth_provider: oauthProvider,
              turnstile_token: turnstileToken,
            }),
          });

          if (res.status === 429) {
            const data = await res.json().catch(() => ({}));
            const retryAfter = parseInt(res.headers.get('Retry-After') || '900', 10);
            startLockoutTimer(retryAfter);
            showError(data.detail || 'Cuenta bloqueada temporalmente por intentos fallidos.');
            return;
          }

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            showError(data.detail || `Error al iniciar sesión (${res.status})`);
            return;
          }

          const authData = await res.json();
          localStorage.setItem('store_admin_token', authData.token);
          localStorage.setItem('store_admin_profile', JSON.stringify(authData));

          // Si debe cambiar contraseña en su primer ingreso, mostrar modal interactivo
          if (authData.debe_cambiar_password) {
            currentPassVal = passVal || '';
            pendingAuthData = authData;
            if (modalFirstPass) modalFirstPass.classList.remove('hidden');
            return;
          }

          // Redirigir al dashboard
          window.location.replace('/admin-tienda/dashboard');
        } catch (err) {
          showError(`Error de red o conexión: ${err.message}`);
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.textContent = 'Iniciar Sesión';
          }
        }
      }

      // Omitir cambio de clave
      btnSkipChangePass?.addEventListener('click', () => {
        window.location.replace('/admin-tienda/dashboard');
      });

      // Procesar nuevo password en modal
      formFirstPass?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (alertChangePassError) alertChangePassError.classList.add('hidden');

        const newPass = inputNewPass?.value || '';
        const confirmPass = inputConfirmPass?.value || '';

        if (newPass.length < 6) {
          if (alertChangePassError) {
            alertChangePassError.textContent = 'La nueva contraseña debe tener al menos 6 caracteres.';
            alertChangePassError.classList.remove('hidden');
          }
          return;
        }

        if (newPass !== confirmPass) {
          if (alertChangePassError) {
            alertChangePassError.textContent = 'Las contraseñas no coinciden.';
            alertChangePassError.classList.remove('hidden');
          }
          return;
        }

        if (btnSubmitChangePass) {
          btnSubmitChangePass.disabled = true;
          btnSubmitChangePass.textContent = 'Guardando nueva clave...';
        }

        try {
          const changeRes = await fetch(`${API_BASE}/api/v1/admin/tienda/auth/cambiar-password`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${pendingAuthData?.token || localStorage.getItem('store_admin_token')}`,
            },
            body: JSON.stringify({
              password_actual: currentPassVal || null,
              password_nuevo: newPass,
            }),
          });

          if (!changeRes.ok) {
            const errData = await changeRes.json().catch(() => ({}));
            throw new Error(errData.detail || 'Error al cambiar contraseña.');
          }

          if (pendingAuthData) {
            pendingAuthData.debe_cambiar_password = false;
            localStorage.setItem('store_admin_profile', JSON.stringify(pendingAuthData));
          }

          window.location.replace('/admin-tienda/dashboard');
        } catch (err) {
          if (alertChangePassError) {
            alertChangePassError.textContent = err.message;
            alertChangePassError.classList.remove('hidden');
          }
        } finally {
          if (btnSubmitChangePass) {
            btnSubmitChangePass.disabled = false;
            btnSubmitChangePass.textContent = 'Guardar Contraseña y Continuar';
          }
        }
      });

      formLogin?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = inputEmail?.value.trim();
        const pass = inputPassword?.value;
        if (!email) return;
        doLogin(email, pass);
      });

      document.getElementById('btn-oauth-google')?.addEventListener('click', () => {
        const demoEmail = prompt('Ingresa el correo Google autorizado para tu tostaduría:', 'admin@tostaduria.cl');
        if (demoEmail) doLogin(demoEmail, 'oauth-google-session', 'google');
      });

      document.getElementById('btn-oauth-github')?.addEventListener('click', () => {
        const demoEmail = prompt('Ingresa el usuario/correo GitHub autorizado:', 'admin@tostaduria.cl');
        if (demoEmail) doLogin(demoEmail, 'oauth-github-session', 'github');
      });
    })();
  </script>
</body>
</html>
