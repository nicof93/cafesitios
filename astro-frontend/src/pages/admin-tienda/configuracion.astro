---
import StoreAdminLayout from '../../layouts/StoreAdminLayout.astro';
import SlideOverDrawer from '../../components/admin/SlideOverDrawer.astro';
---

<StoreAdminLayout title="Configuración de Tostaduría | Cafesitios Admin" activeNav="configuracion">
  <div class="space-y-8">
    <!-- Header de la Sección -->
    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">⚙️</span>
          <h1 class="text-xl sm:text-2xl font-black text-stone-900">Configuración de Marca & Sucursales</h1>
        </div>
        <p class="text-xs text-stone-500 mt-1">
          Ajusta tu perfil público, geolocaliza tus cafeterías físicas y administra tus fuentes automáticas de catálogo (Shopify / WooCommerce).
        </p>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-stone-100 text-stone-800 text-xs font-bold px-3 py-1">
          <span>☕</span> Tostaduría de Especialidad
        </span>
      </div>
    </div>

    <!-- BARRA DE NAVEGACIÓN LOCAL POR PESTAÑAS (REDUCCIÓN DE SCROLL) -->
    <div class="flex items-center gap-1 border-b border-stone-200 bg-white px-2 pt-2 rounded-t-2xl shadow-2xs overflow-x-auto">
      <button
        type="button"
        data-config-tab="tab-perfil"
        class="tab-btn active px-4 py-2.5 text-xs font-bold border-b-2 border-emerald-700 text-stone-900 flex items-center gap-2 bg-emerald-50/50 rounded-t-xl"
      >
        <span>🏢</span>
        <span>Perfil Comercial & Logística</span>
      </button>
      <button
        type="button"
        data-config-tab="sec-sucursales"
        class="tab-btn px-4 py-2.5 text-xs font-semibold text-stone-500 hover:text-stone-900 border-b-2 border-transparent flex items-center gap-2 hover:bg-stone-50 rounded-t-xl transition-colors"
      >
        <span>📍</span>
        <span>Sucursales Físicas</span>
      </button>
      <button
        type="button"
        data-config-tab="seccion-sincronizacion"
        class="tab-btn px-4 py-2.5 text-xs font-semibold text-stone-500 hover:text-stone-900 border-b-2 border-transparent flex items-center gap-2 hover:bg-stone-50 rounded-t-xl transition-colors"
      >
        <span>🔄</span>
        <span>Fuentes de Catálogo & Scraping</span>
      </button>
    </div>

    <!-- 1. PERFIL DE MARCA, DESPACHO, SERVICIOS Y VITRINA DIGITAL -->
    <div id="tab-perfil" class="config-tab-pane rounded-b-2xl border border-t-0 border-stone-200 bg-white p-6 shadow-xs space-y-6">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <h3 class="text-base font-bold text-stone-900">Perfil Comercial, Servicios y Vitrina Digital</h3>
          <p class="text-xs text-stone-500 mt-0.5">Administra tu presencia en Cafésitios, servicios presenciales, menú en PDF y enlace oficial para tus clientes.</p>
        </div>
        <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
          Sincronizado
        </span>
      </div>

      <!-- Vitrina Digital Exclusiva (Link en Bio) -->
      <div class="rounded-2xl border border-amber-200 bg-linear-to-br from-amber-50/70 via-stone-50 to-white p-5 shadow-xs">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center text-base font-bold">
              🌐
            </div>
            <div>
              <h4 class="text-xs font-bold text-stone-900">Tu Vitrina Digital Exclusiva (Link en Bio)</h4>
              <p class="text-[11px] text-stone-500">Página oficial en Cafesitios con solo tus productos, menú y sucursales. Ideal para compartir en Instagram y WhatsApp.</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              id="btn-copy-vitrina"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-stone-700 bg-white hover:bg-stone-50 border border-stone-200 rounded-xl transition shadow-xs cursor-pointer"
            >
              <span id="copy-icon">📋</span>
              <span id="copy-text">Copiar Link</span>
            </button>
            <a
              id="link-open-vitrina"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-amber-900 bg-amber-100 hover:bg-amber-200 rounded-xl transition shadow-xs"
            >
              Ver mi Vitrina ↗
            </a>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-stone-500 shrink-0">cafesitios.cl/tienda/</span>
          <input
            type="text"
            id="prof-slug"
            form="form-brand-profile"
            placeholder="mi-tostaduria"
            class="flex-1 rounded-xl border border-amber-300 bg-white px-3 py-2 text-xs font-bold text-stone-900 focus:outline-none focus:ring-2 focus:ring-amber-500 font-mono"
          />
        </div>
        <p class="text-[10px] text-stone-400 mt-1.5">Solo letras minúsculas, números y guiones. También disponible en su formato corto <strong>cafesitios.cl/t/&#123;slug&#125;</strong>.</p>
      </div>

      <form id="form-brand-profile" class="space-y-6">
        <!-- Datos de Marca -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold text-stone-700 mb-1">Nombre Comercial de la Tostaduría</label>
            <input
              type="text"
              id="prof-name"
              disabled
              class="w-full rounded-xl border border-stone-200 bg-stone-100 px-3 py-2 text-xs font-bold text-stone-600 cursor-not-allowed"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-stone-700 mb-1">Sitio Web Oficial</label>
            <input
              type="url"
              id="prof-url"
              placeholder="https://mitostaduria.cl"
              class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-stone-700 mb-1">Instagram (@usuario o URL)</label>
            <input
              type="text"
              id="prof-instagram"
              placeholder="https://instagram.com/mitostaduria"
              class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-stone-700 mb-1">Descripción / Biografía de la Tostaduría</label>
          <textarea
            id="prof-description"
            rows="2"
            placeholder="Breve reseña sobre la filosofía de tueste, fincas aliadas y propuesta de valor..."
            class="w-full rounded-xl border border-stone-300 p-3 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
          ></textarea>
        </div>

        <!-- Servicios de Cafetería & Experiencia -->
        <div class="border-t border-stone-100 pt-5">
          <div class="mb-3">
            <h4 class="text-xs font-bold text-stone-900">Servicios e Instalaciones en Cafetería</h4>
            <p class="text-[11px] text-stone-500">Selecciona los servicios que ofreces a los clientes que visitan tus locales.</p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5" id="services-checklist">
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="cafeteria_especialidad" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>☕ Cafetería de Especialidad</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="filtrados" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>⚗️ Métodos de Filtrado</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="pasteleria" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🥐 Pastelería & Comida</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="wifi" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>📶 WiFi para Trabajar</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="pet_friendly" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🐾 Pet Friendly</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="terraza" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>☀️ Terraza al Aire Libre</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="grano_molido" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🛍️ Grano & Molido</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="tueste_propio" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🔥 Tueste en el Local</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="talleres_catas" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🎓 Talleres & Catas</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="estacionamiento" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>🚗 Estacionamiento</span>
            </label>
            <label class="flex items-center gap-2 p-2.5 rounded-xl border border-stone-200 bg-stone-50/50 hover:bg-stone-50 cursor-pointer transition text-xs font-medium text-stone-800">
              <input type="checkbox" name="servicios" value="accesible" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span>♿ Accesible</span>
            </label>
          </div>
        </div>

        <!-- Carta de Comida y Menú en PDF -->
        <div class="border-t border-stone-100 pt-5">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h4 class="text-xs font-bold text-stone-900">Carta de Comida y Menú (Documento PDF)</h4>
              <p class="text-[11px] text-stone-500">Tus clientes podrán ver y descargar tu carta directamente desde su celular.</p>
            </div>
            <div id="menu-pdf-status-badge" class="hidden">
              <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200 flex items-center gap-1.5">
                <span>📄</span> Carta activa (<span id="menu-pdf-size">0 KB</span>)
              </span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl border border-stone-200 bg-stone-50">
            <div class="flex items-center gap-3">
              <input
                type="file"
                id="input-menu-pdf"
                accept=".pdf,application/pdf"
                class="block w-full text-xs text-stone-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-stone-900 file:text-white hover:file:bg-stone-800 file:cursor-pointer"
              />
            </div>
            <div class="flex items-center gap-2 shrink-0" id="menu-pdf-actions">
              <a
                id="link-view-menu-pdf"
                href="#"
                target="_blank"
                rel="noopener noreferrer"
                class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-emerald-800 bg-white hover:bg-emerald-50 border border-emerald-200 rounded-xl transition shadow-xs"
              >
                Ver Carta Actual ↗
              </a>
              <button
                type="button"
                id="btn-delete-menu-pdf"
                class="hidden inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-xl transition cursor-pointer"
              >
                Eliminar Carta
              </button>
            </div>
          </div>
        </div>

        <!-- Despacho y Días de Tueste -->
        <div class="border-t border-stone-100 pt-5">
          <div class="mb-3">
            <h4 class="text-xs font-bold text-stone-900">Políticas de Despacho y Tueste</h4>
            <p class="text-[11px] text-stone-500">Incentiva las compras informando tus políticas de despacho gratis y fechas de tueste fresco.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">Envío Gratis desde (CLP)</label>
              <input
                type="number"
                id="prof-envio-gratis"
                placeholder="30000"
                class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">Días de Tueste Semanal</label>
              <input
                type="text"
                id="prof-dias-tueste"
                placeholder="Ej: Martes y Jueves"
                class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-stone-700 mb-1">Última Fecha de Tueste</label>
              <input
                type="date"
                id="prof-fecha-tueste"
                class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              />
            </div>

            <div class="flex items-center gap-2 pt-6">
              <input
                type="checkbox"
                id="prof-retiro-tienda"
                class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500 cursor-pointer"
              />
              <label for="prof-retiro-tienda" class="text-xs font-bold text-stone-800 cursor-pointer">
                Permite Retiro en Tienda / Barra
              </label>
            </div>
          </div>
        </div>

        <div class="flex justify-end pt-3 border-t border-stone-100">
          <button
            type="submit"
            id="btn-save-profile"
            class="rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2 px-5 transition shadow-xs cursor-pointer"
          >
            Guardar Cambios de Perfil
          </button>
        </div>
      </form>
    </div>

    <!-- 2. SUCURSALES Y CAFETERÍAS FÍSICAS -->
    <div id="sec-sucursales" class="config-tab-pane hidden rounded-b-2xl border border-t-0 border-stone-200 bg-white p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <div class="flex items-center gap-2 text-base font-bold text-stone-900">
            <span>📍</span>
            <span>Sucursales y Barras de Café Físicas</span>
          </div>
          <p class="text-xs text-stone-500 mt-0.5">Tus locales aparecerán en el mapa de tostadurías de Cafésitios.</p>
        </div>
        <button
          type="button"
          id="btn-new-branch"
          class="rounded-xl bg-stone-900 hover:bg-stone-800 text-white text-xs font-bold px-3.5 py-1.5 transition shadow-xs"
        >
          + Agregar Sucursal
        </button>
      </div>

      <div id="branches-list-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="text-xs text-stone-400 py-4 text-center col-span-2">Cargando sucursales...</div>
      </div>
    </div>

    <!-- 3. CONEXIÓN DE CATÁLOGOS AUTOMÁTICOS & SINCRONIZACIÓN -->
    <div id="seccion-sincronizacion" class="config-tab-pane hidden rounded-b-2xl border border-t-0 border-stone-200 bg-white p-6 shadow-xs space-y-6 scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-100 pb-4">
        <div>
          <div class="flex items-center gap-2 text-base font-bold text-stone-900">
            <span>🔄</span>
            <span>Fuentes de Sincronización Automática (Scraping)</span>
          </div>
          <p class="text-xs text-stone-500 mt-0.5">URLs de colecciones de Shopify, WooCommerce o Jumpseller vinculadas a tu tostaduría.</p>
        </div>
        <div class="flex items-center gap-2">
          <!-- Botón directo de Sincronización con Cooldown -->
          <button
            type="button"
            id="btn-sync-catalog-config"
            class="inline-flex items-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 text-xs font-bold transition shadow-xs disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            title="Descargar y actualizar productos ahora"
          >
            <span id="sync-icon-config">🔄</span>
            <span id="sync-btn-text-config">Sincronizar Catálogo Ahora</span>
          </button>
        </div>
      </div>

      <!-- Alerta o estado de cooldown -->
      <div id="sync-cooldown-notice" class="hidden rounded-xl bg-amber-50 border border-amber-200 p-3 text-xs text-amber-900 font-medium flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span>⏱️</span>
          <span id="sync-cooldown-text-config">Cooldown activo: disponible en 30m</span>
        </div>
        <span class="text-[11px] text-amber-800">1 sync cada 30 min</span>
      </div>

      <!-- Formulario para agregar y probar nueva URL -->
      <div class="p-4 rounded-xl bg-stone-50 border border-stone-200 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Conectar Nueva Colección o URL</h4>
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
          <div class="sm:col-span-6">
            <input
              type="url"
              id="input-new-catalog-url"
              placeholder="https://mitostaduria.cl/collections/cafe-de-especialidad"
              class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white"
            />
          </div>
          <div class="sm:col-span-3">
            <input
              type="text"
              id="input-new-catalog-label"
              placeholder="Etiqueta (ej: Granos)"
              class="w-full rounded-xl border border-stone-300 px-3 py-2 text-xs text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white"
            />
          </div>
          <div class="sm:col-span-3 flex items-center gap-2">
            <button
              type="button"
              id="btn-test-catalog-url"
              class="flex-1 rounded-xl border border-stone-300 hover:bg-stone-200 text-stone-700 font-bold text-xs py-2 px-3 transition shadow-2xs"
            >
              🧪 Probar
            </button>
            <button
              type="button"
              id="btn-add-catalog-url"
              class="flex-1 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2 px-3 transition shadow-xs"
            >
              + Agregar
            </button>
          </div>
        </div>
      </div>

      <!-- Lista de URLs registradas -->
      <div class="space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Colecciones Conectadas</h4>
        <div id="catalogs-list-container" class="space-y-2">
          <div class="text-xs text-stone-400 py-2">Cargando catálogos conectados...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- SLIDE-OVER DRAWER DE PROBADOR DE CATÁLOGO (DRY-RUN) -->
  <SlideOverDrawer
    id="drawer-catalog-test"
    title="Resultado de Prueba en Seco (Dry-Run)"
    subtitle="Inspección en vivo de productos detectados sin alterar la base de datos"
    icon="🧪"
    maxWidth="max-w-xl"
  >
    <div id="catalog-test-content" class="space-y-3">
      <!-- Inyectado dinámicamente -->
    </div>

    <Fragment slot="footer">
      <button
        type="button"
        id="btn-close-test-drawer-footer"
        class="rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs px-5 py-2 transition shadow-xs"
      >
        Entendido
      </button>
    </Fragment>
  </SlideOverDrawer>

  <!-- SLIDE-OVER DRAWER PARA CREAR SUCURSAL (CERO POPUPS) -->
  <SlideOverDrawer
    id="drawer-branch"
    title="Nueva Sucursal o Cafetería"
    subtitle="Registra las coordenadas físicas de tu sede para el comparador geográfico"
    icon="📍"
    maxWidth="max-w-lg"
  >
    <form id="form-branch" class="space-y-4">
      <div>
        <label for="branch-name" class="block font-bold text-stone-700 mb-1">Nombre de la Sucursal *</label>
        <input type="text" id="branch-name" required placeholder="Ej: Barra Providencia" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
      </div>

      <div>
        <label for="branch-address" class="block font-bold text-stone-700 mb-1">Dirección Completa *</label>
        <input type="text" id="branch-address" required placeholder="Av. Providencia 1234" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
      </div>

      <div>
        <label for="branch-commune" class="block font-bold text-stone-700 mb-1">Comuna / Ciudad *</label>
        <input type="text" id="branch-commune" required placeholder="Providencia, Santiago" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="branch-lat" class="block font-bold text-stone-700 mb-1">Latitud</label>
          <input type="number" step="any" id="branch-lat" placeholder="-33.425" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
        </div>
        <div>
          <label for="branch-lng" class="block font-bold text-stone-700 mb-1">Longitud</label>
          <input type="number" step="any" id="branch-lng" placeholder="-70.615" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
        </div>
      </div>

      <div>
        <label for="branch-hours" class="block font-bold text-stone-700 mb-1">Horario de Atención</label>
        <input type="text" id="branch-hours" placeholder="Lun a Vie 8:00 - 19:00" class="w-full rounded-xl border border-stone-300 px-3.5 py-2 text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600 bg-white" />
      </div>
    </form>

    <Fragment slot="footer">
      <button
        type="button"
        id="btn-cancel-branch"
        class="rounded-xl border border-stone-300 bg-white px-4 py-2 font-bold text-xs text-stone-700 hover:bg-stone-100 transition"
      >
        Cancelar
      </button>
      <button
        type="submit"
        form="form-branch"
        id="btn-save-branch"
        class="rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2 font-bold text-xs transition shadow-xs focus:ring-2 focus:ring-emerald-600"
      >
        Guardar Sucursal
      </button>
    </Fragment>
  </SlideOverDrawer>

  <script is:inline>
    (function initStoreConfiguracion() {
      const token = localStorage.getItem('store_admin_token');

      // Sistema de Pestañas Locales (Tabs) para Reducción de Scroll
      const configTabs = {
        'tab-perfil': document.getElementById('tab-perfil'),
        'sec-sucursales': document.getElementById('sec-sucursales'),
        'seccion-sincronizacion': document.getElementById('seccion-sincronizacion')
      };
      const tabButtons = document.querySelectorAll('[data-config-tab]');

      function switchConfigTab(targetId) {
        const activeKey = configTabs[targetId] ? targetId : 'tab-perfil';
        Object.keys(configTabs).forEach(key => {
          const pane = configTabs[key];
          if (!pane) return;
          if (key === activeKey) {
            pane.classList.remove('hidden');
          } else {
            pane.classList.add('hidden');
          }
        });
        tabButtons.forEach(btn => {
          const isTarget = btn.getAttribute('data-config-tab') === activeKey;
          if (isTarget) {
            btn.className = 'tab-btn active px-4 py-2.5 text-xs font-bold border-b-2 border-emerald-700 text-stone-900 flex items-center gap-2 bg-emerald-50/50 rounded-t-xl';
          } else {
            btn.className = 'tab-btn px-4 py-2.5 text-xs font-semibold text-stone-500 hover:text-stone-900 border-b-2 border-transparent flex items-center gap-2 hover:bg-stone-50 rounded-t-xl transition-colors';
          }
        });
      }

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-config-tab');
          if (target) {
            switchConfigTab(target);
            history.replaceState(null, '', `#${target}`);
          }
        });
      });

      const initialHash = (window.location.hash || '').replace('#', '');
      if (initialHash && configTabs[initialHash]) {
        switchConfigTab(initialHash);
      }
      window.addEventListener('hashchange', () => {
        const hash = (window.location.hash || '').replace('#', '');
        if (hash && configTabs[hash]) switchConfigTab(hash);
      });

      if (!token) {
        window.location.replace('/admin-tienda/login');
        return;
      }

      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      // Perfil
      const formProfile = document.getElementById('form-brand-profile');
      const profName = document.getElementById('prof-name');
      const profSlug = document.getElementById('prof-slug');
      const profUrl = document.getElementById('prof-url');
      const profInstagram = document.getElementById('prof-instagram');
      const profDescription = document.getElementById('prof-description');
      const profEnvioGratis = document.getElementById('prof-envio-gratis');
      const profRetiroTienda = document.getElementById('prof-retiro-tienda');
      const profDiasTueste = document.getElementById('prof-dias-tueste');
      const profFechaTueste = document.getElementById('prof-fecha-tueste');

      // Vitrina y Carta PDF
      const btnCopyVitrina = document.getElementById('btn-copy-vitrina');
      const linkOpenVitrina = document.getElementById('link-open-vitrina');
      const copyText = document.getElementById('copy-text');
      const copyIcon = document.getElementById('copy-icon');
      const servicesCheckboxes = document.querySelectorAll('input[name="servicios"]');
      const inputMenuPdf = document.getElementById('input-menu-pdf');
      const menuPdfStatusBadge = document.getElementById('menu-pdf-status-badge');
      const menuPdfSize = document.getElementById('menu-pdf-size');
      const linkViewMenuPdf = document.getElementById('link-view-menu-pdf');
      const btnDeleteMenuPdf = document.getElementById('btn-delete-menu-pdf');

      function updateVitrinaLinks(slug) {
        const cleanSlug = (slug || '').trim().toLowerCase();
        const origin = window.location.origin;
        const vitrinaUrl = cleanSlug ? `${origin}/tienda/${cleanSlug}` : '#';
        if (linkOpenVitrina) {
          linkOpenVitrina.href = vitrinaUrl;
          if (!cleanSlug) {
            linkOpenVitrina.classList.add('pointer-events-none', 'opacity-50');
          } else {
            linkOpenVitrina.classList.remove('pointer-events-none', 'opacity-50');
          }
        }
      }

      profSlug?.addEventListener('input', (e) => {
        updateVitrinaLinks(e.target.value);
      });

      btnCopyVitrina?.addEventListener('click', async () => {
        const slug = (profSlug?.value || '').trim();
        if (!slug) return;
        const vitrinaUrl = `${window.location.origin}/tienda/${slug}`;
        try {
          await navigator.clipboard.writeText(vitrinaUrl);
          if (copyText) copyText.textContent = '¡Copiado!';
          if (copyIcon) copyIcon.textContent = '✅';
          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copiar Link';
            if (copyIcon) copyIcon.textContent = '📋';
          }, 2000);
        } catch (_) {}
      });

      inputMenuPdf?.addEventListener('change', async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
          window.cafesitiosAlert('Archivo No Válido', 'Solo se admiten documentos en formato PDF (.pdf).', 'error');
          inputMenuPdf.value = '';
          return;
        }
        if (file.size > 10 * 1024 * 1024) {
          window.cafesitiosAlert('Archivo Muy Grande', 'La carta de comida no puede exceder los 10 MB.', 'error');
          inputMenuPdf.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = async () => {
          const base64 = reader.result;
          try {
            const res = await fetch(`${API_BASE}/api/v1/admin/tienda/tienda/carta-comida`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${token}`
              },
              body: JSON.stringify({ pdf_base64: base64, nombre_archivo: file.name })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.detail || 'Error al subir la carta de comida.');
            window.cafesitiosAlert('Carta Subida', 'La carta de comida en PDF se guardó exitosamente.', 'success');
            inputMenuPdf.value = '';
            loadProfile();
          } catch (err) {
            window.cafesitiosAlert('Error', err.message, 'error');
          }
        };
        reader.readAsDataURL(file);
      });

      btnDeleteMenuPdf?.addEventListener('click', async () => {
        if (!confirm('¿Estás seguro de que deseas eliminar la carta de comida en PDF?')) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/tienda/carta-comida`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al eliminar la carta de comida.');
          window.cafesitiosAlert('Carta Eliminada', 'La carta de comida fue eliminada.', 'success');
          loadProfile();
        } catch (err) {
          window.cafesitiosAlert('Error', err.message, 'error');
        }
      });

      // Catálogos y Prueba en Seco (Slide-Over Drawer)
      const catalogsContainer = document.getElementById('catalogs-list-container');
      const inputCatalogUrl = document.getElementById('input-new-catalog-url');
      const inputCatalogLabel = document.getElementById('input-new-catalog-label');
      const btnTestCatalog = document.getElementById('btn-test-catalog-url');
      const btnAddCatalog = document.getElementById('btn-add-catalog-url');
      const drawerTest = document.getElementById('drawer-catalog-test');
      const drawerTestBackdrop = document.getElementById('drawer-catalog-test-backdrop');
      const testContent = document.getElementById('catalog-test-content');
      const btnCloseTest = document.getElementById('drawer-catalog-test-close-btn');
      const btnCloseTestFooter = document.getElementById('btn-close-test-drawer-footer');

      function openTestDrawer() {
        if (!drawerTest) return;
        drawerTest.classList.remove('translate-x-full');
        if (drawerTestBackdrop) {
          drawerTestBackdrop.classList.remove('opacity-0', 'pointer-events-none');
          drawerTestBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        }
      }

      function closeTestDrawer() {
        if (!drawerTest) return;
        drawerTest.classList.add('translate-x-full');
        if (drawerTestBackdrop) {
          drawerTestBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
          drawerTestBackdrop.classList.add('opacity-0', 'pointer-events-none');
        }
      }

      btnCloseTest?.addEventListener('click', closeTestDrawer);
      btnCloseTestFooter?.addEventListener('click', closeTestDrawer);
      drawerTestBackdrop?.addEventListener('click', closeTestDrawer);

      // Sucursales (Slide-Over Drawer)
      const branchesContainer = document.getElementById('branches-list-container');
      const btnNewBranch = document.getElementById('btn-new-branch');
      const drawerBranch = document.getElementById('drawer-branch');
      const drawerBranchBackdrop = document.getElementById('drawer-branch-backdrop');
      const formBranch = document.getElementById('form-branch');
      const btnCloseBranch = document.getElementById('drawer-branch-close-btn');
      const btnCancelBranch = document.getElementById('btn-cancel-branch');

      function openBranchDrawer() {
        if (!drawerBranch) return;
        if (formBranch) formBranch.reset();
        drawerBranch.classList.remove('invisible'); requestAnimationFrame(() => { drawerBranch.classList.remove('translate-x-full'); });
        if (drawerBranchBackdrop) {
          drawerBranchBackdrop.classList.remove('opacity-0', 'pointer-events-none');
          drawerBranchBackdrop.classList.add('opacity-100', 'pointer-events-auto');
        }
      }

      function closeBranchDrawer() {
        if (!drawerBranch) return;
        drawerBranch.classList.add('translate-x-full', 'invisible');
        if (drawerBranchBackdrop) {
          drawerBranchBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
          drawerBranchBackdrop.classList.add('opacity-0', 'pointer-events-none');
        }
        if (formBranch) formBranch.reset();
      }

      btnNewBranch?.addEventListener('click', openBranchDrawer);
      btnCloseBranch?.addEventListener('click', closeBranchDrawer);
      btnCancelBranch?.addEventListener('click', closeBranchDrawer);
      drawerBranchBackdrop?.addEventListener('click', closeBranchDrawer);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (drawerTest && !drawerTest.classList.contains('translate-x-full')) closeTestDrawer();
          if (drawerBranch && !drawerBranch.classList.contains('translate-x-full')) closeBranchDrawer();
        }
      });

      // Sincronización Voluntaria Bajo Demanda con Cooldown
      const btnSyncConfig = document.getElementById('btn-sync-catalog-config');
      const syncBtnTextConfig = document.getElementById('sync-btn-text-config');
      const syncIconConfig = document.getElementById('sync-icon-config');
      const syncCooldownNotice = document.getElementById('sync-cooldown-notice');
      const syncCooldownTextConfig = document.getElementById('sync-cooldown-text-config');
      let syncCooldownInterval = null;

      function startSyncCooldownTimer(seconds) {
        if (!btnSyncConfig) return;
        btnSyncConfig.disabled = true;
        if (syncCooldownNotice) syncCooldownNotice.classList.remove('hidden');
        let rem = seconds;

        function tick() {
          const m = Math.floor(rem / 60);
          const s = rem % 60;
          const timeStr = `${m}:${s < 10 ? '0' : ''}${s}`;
          if (syncBtnTextConfig) syncBtnTextConfig.textContent = `⏳ Cooldown (${timeStr})`;
          if (syncCooldownTextConfig) syncCooldownTextConfig.textContent = `Cooldown activo: disponible en ${m}m ${s}s`;

          if (rem <= 0) {
            clearInterval(syncCooldownInterval);
            btnSyncConfig.disabled = false;
            if (syncBtnTextConfig) syncBtnTextConfig.textContent = 'Sincronizar Catálogo Ahora';
            if (syncCooldownNotice) syncCooldownNotice.classList.add('hidden');
          }
          rem -= 1;
        }

        tick();
        clearInterval(syncCooldownInterval);
        syncCooldownInterval = setInterval(tick, 1000);
      }

      btnSyncConfig?.addEventListener('click', async () => {
        btnSyncConfig.disabled = true;
        if (syncIconConfig) syncIconConfig.textContent = '⏳';
        if (syncBtnTextConfig) syncBtnTextConfig.textContent = 'Sincronizando catálogo...';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sincronizar`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Fallo al iniciar sincronización.');

          window.cafesitiosAlert(
            'Catálogo Sincronizado',
            `Se actualizaron ${data.productos_actualizados || 0} productos y se detectaron ${data.productos_nuevos || 0} nuevos cafés.\nDuración: ${data.duracion_segundos || 0}s`,
            'success'
          );
          startSyncCooldownTimer(data.cooldown_restante_segundos || 1800);
          loadProfile();
        } catch (err) {
          window.cafesitiosAlert('Error de Sincronización', err.message, 'error');
          if (syncIconConfig) syncIconConfig.textContent = '🔄';
          if (syncBtnTextConfig) syncBtnTextConfig.textContent = 'Sincronizar Catálogo Ahora';
          btnSyncConfig.disabled = false;
        }
      });

      async function loadProfile() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/perfil`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();

          if (profName) profName.value = data.tienda_nombre || '';
          if (profSlug) {
            profSlug.value = data.slug || '';
            updateVitrinaLinks(data.slug);
          }
          if (profUrl) profUrl.value = data.tienda_url || '';
          if (profInstagram) profInstagram.value = data.instagram_url || '';
          if (profDescription) profDescription.value = data.descripcion || '';
          if (profEnvioGratis) profEnvioGratis.value = data.envio_gratis_monto || '';
          if (profRetiroTienda) profRetiroTienda.checked = Boolean(data.retiro_en_tienda);
          if (profDiasTueste) profDiasTueste.value = data.dias_tueste || '';
          if (profFechaTueste) profFechaTueste.value = data.fecha_ultimo_tueste || '';

          // Servicios
          if (servicesCheckboxes && data.servicios) {
            const activeSet = new Set(data.servicios || []);
            servicesCheckboxes.forEach(cb => {
              cb.checked = activeSet.has(cb.value);
            });
          }

          // Carta en PDF
          if (data.carta_comida_url) {
            if (menuPdfStatusBadge) menuPdfStatusBadge.classList.remove('hidden');
            const kb = Math.round((data.carta_comida_tamano_bytes || 0) / 1024);
            if (menuPdfSize) menuPdfSize.textContent = kb > 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${kb} KB`;
            if (linkViewMenuPdf) {
              const fullPdfUrl = data.carta_comida_url.startsWith('http') ? data.carta_comida_url : `${API_BASE}${data.carta_comida_url}`;
              linkViewMenuPdf.href = fullPdfUrl;
              linkViewMenuPdf.classList.remove('hidden');
            }
            if (btnDeleteMenuPdf) btnDeleteMenuPdf.classList.remove('hidden');
          } else {
            if (menuPdfStatusBadge) menuPdfStatusBadge.classList.add('hidden');
            if (linkViewMenuPdf) linkViewMenuPdf.classList.add('hidden');
            if (btnDeleteMenuPdf) btnDeleteMenuPdf.classList.add('hidden');
          }
        } catch (_) {}
      }

      formProfile?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const selectedServices = Array.from(servicesCheckboxes || [])
          .filter(cb => cb.checked)
          .map(cb => cb.value);

        const payload = {
          slug: profSlug?.value.trim().toLowerCase() || null,
          url_oficial: profUrl?.value.trim() || null,
          instagram_url: profInstagram?.value.trim() || null,
          descripcion: profDescription?.value.trim() || null,
          servicios: selectedServices,
          envio_gratis_monto: profEnvioGratis?.value ? parseInt(profEnvioGratis.value, 10) : null,
          retiro_en_tienda: profRetiroTienda?.checked ?? false,
          dias_tueste: profDiasTueste?.value.trim() || null,
          fecha_ultimo_tueste: profFechaTueste?.value || null,
        };

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/perfil`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload)
          });
          const resData = await res.json();
          if (!res.ok) throw new Error(resData.detail || 'Error al actualizar perfil de marca.');
          window.cafesitiosAlert('Perfil Actualizado', 'Los datos comerciales y servicios se guardaron exitosamente.', 'success');
          loadProfile();
        } catch (err) {
          window.cafesitiosAlert('Error', err.message, 'error');
        }
      });

      // Catálogos
      async function loadCatalogs() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const list = await res.json();

          if (!list.length) {
            catalogsContainer.innerHTML = '<p class="text-stone-400 italic">No hay URLs adicionales configuradas.</p>';
            return;
          }

          catalogsContainer.innerHTML = list.map(c => `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-white gap-2">
              <div class="min-w-0">
                <div class="font-bold text-stone-800 truncate">${c.url_catalogo}</div>
                <div class="text-[10px] text-stone-400">${c.etiqueta || 'Colección'} &bull; ${c.activa ? 'Activa' : 'Pausada'}</div>
              </div>
              <button type="button" class="btn-del-cat text-rose-600 hover:text-rose-800 text-xs font-bold px-2 py-1" data-id="${c.id}">
                Eliminar
              </button>
            </div>
          `).join('');

          catalogsContainer.querySelectorAll('.btn-del-cat').forEach(b => {
            b.addEventListener('click', async () => {
              const id = b.getAttribute('data-id');
              const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
              });
              if (res.ok) loadCatalogs();
            });
          });
        } catch (_) {}
      }

      btnAddCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        const label = inputCatalogLabel?.value.trim();
        if (!url) return;

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url, etiqueta: label || null })
          });
          if (!res.ok) throw new Error('Error al agregar catálogo.');
          inputCatalogUrl.value = '';
          inputCatalogLabel.value = '';
          loadCatalogs();
        } catch (err) {
          window.cafesitiosAlert('Error Catálogo', err.message, 'error');
        }
      });

      btnTestCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        if (!url) {
          window.cafesitiosAlert('Atención', 'Ingresa una URL antes de probar.', 'warning');
          return;
        }

        openTestDrawer();
        if (testContent) testContent.innerHTML = '<p class="text-stone-500 py-6 text-center">Ejecutando prueba en seco (Dry-run)...</p>';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/probar`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Fallo en la prueba.');

          testContent.innerHTML = `
            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 font-bold">
              ✓ Driver detectado: ${data.driver_detectado} &bull; ${data.total_encontrados} productos encontrados
            </div>
            <div class="space-y-1.5 max-h-60 overflow-y-auto">
              ${(data.muestra_productos || []).map(p => `
                <div class="p-2 rounded-lg bg-stone-50 border border-stone-200 flex justify-between">
                  <span class="font-bold text-stone-800">${p.nombre}</span>
                  <span class="text-emerald-700 font-bold">$${(p.precio_clp || 0).toLocaleString('es-CL')}</span>
                </div>
              `).join('')}
            </div>
          `;
        } catch (err) {
          testContent.innerHTML = `<div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 font-bold">Error: ${err.message}</div>`;
        }
      });

      // Sucursales
      async function loadBranches() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const list = await res.json();

          if (!list.length) {
            branchesContainer.innerHTML = '<div class="text-stone-400 italic col-span-2 text-center py-4">No tienes sucursales físicas registradas aún.</div>';
            return;
          }

          branchesContainer.innerHTML = list.map(b => `
            <div class="p-4 rounded-xl border border-stone-200 bg-stone-50/50 space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-stone-900 text-xs">${b.nombre}</span>
                <button type="button" class="btn-del-branch text-rose-600 hover:text-rose-800 text-[11px] font-bold" data-id="${b.id}">Eliminar</button>
              </div>
              <div class="text-[11px] text-stone-600">${b.direccion}, ${b.comuna || ''}</div>
              ${b.horario_atencion ? `<div class="text-[10px] text-stone-400">🕒 ${b.horario_atencion}</div>` : ''}
            </div>
          `).join('');

          branchesContainer.querySelectorAll('.btn-del-branch').forEach(b => {
            b.addEventListener('click', async () => {
              const id = b.getAttribute('data-id');
              await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales/${id}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${token}` }
              });
              loadBranches();
            });
          });
        } catch (_) {}
      }

      formBranch?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          nombre: document.getElementById('branch-name')?.value.trim(),
          direccion: document.getElementById('branch-address')?.value.trim(),
          comuna: document.getElementById('branch-commune')?.value.trim(),
          latitud: document.getElementById('branch-lat')?.value ? parseFloat(document.getElementById('branch-lat').value) : null,
          longitud: document.getElementById('branch-lng')?.value ? parseFloat(document.getElementById('branch-lng').value) : null,
          horario_atencion: document.getElementById('branch-hours')?.value.trim() || null,
        };

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload)
          });
          if (!res.ok) throw new Error('Error al crear sucursal.');
          closeBranchDrawer();
          loadBranches();
        } catch (err) {
          window.cafesitiosAlert('Error Sucursal', err.message, 'error');
        }
      });

      loadProfile();
      loadCatalogs();
      loadBranches();
    })();
  </script>
</StoreAdminLayout>

