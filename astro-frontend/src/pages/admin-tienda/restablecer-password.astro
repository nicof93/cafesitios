---
import { Environment } from '../../core/infrastructure/config/Environment';
import '../../styles/global.css';

const apiBase = Environment.getApiBaseUrl();
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-stone-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Restablecer Contraseña | Cafésitios Admin</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
</head>
<body class="h-full text-stone-100 antialiased font-sans bg-stone-900 flex items-center justify-center p-4">

  <div class="w-full max-w-md space-y-6">
    <!-- Header Brand -->
    <div class="text-center space-y-2">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-700 text-white font-black text-2xl shadow-lg">
        ☕
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Nueva Contraseña</h1>
      <p class="text-xs text-stone-400">Ingresa tu nueva clave de acceso para tu tostaduría.</p>
    </div>

    <!-- Card Principal -->
    <div class="rounded-2xl border border-stone-800 bg-stone-850/90 p-6 sm:p-8 shadow-xl backdrop-blur-md space-y-5">
      <div id="alert-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-950/60 p-3 text-xs text-rose-300"></div>

      <div id="alert-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-950/60 p-4 text-xs text-emerald-300 space-y-3 text-center">
        <span class="text-3xl block">🎉</span>
        <div class="font-bold text-sm text-emerald-200">¡Contraseña restablecida con éxito!</div>
        <p class="text-stone-300 leading-relaxed text-xs">
          Tu clave de acceso ha sido actualizada. Ya puedes iniciar sesión con tus nuevas credenciales.
        </p>
        <a
          href="/admin-tienda/login"
          class="inline-block mt-2 rounded-xl bg-emerald-700 hover:bg-emerald-600 px-5 py-2 text-xs font-bold text-white transition shadow-sm"
        >
          Ir al Inicio de Sesión ➔
        </a>
      </div>

      <!-- Formulario para ingresar nueva clave -->
      <form id="form-reset" class="space-y-4">
        <div>
          <label for="input-new-pass" class="block text-xs font-semibold text-stone-300 mb-1">
            Nueva Contraseña (mínimo 6 caracteres)
          </label>
          <div class="relative flex items-center">
            <input
              type="password"
              id="input-new-pass"
              required
              minlength="6"
              placeholder="••••••••••••"
              class="w-full rounded-xl border border-stone-700 bg-stone-900/90 pl-3.5 pr-10 py-2.5 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
            />
            <button
              type="button"
              id="btn-toggle-new-pass"
              class="absolute right-2 text-stone-400 hover:text-stone-200 p-1.5 text-xs transition select-none"
              title="Mostrar u ocultar contraseña"
            >
              👁️
            </button>
          </div>
        </div>

        <div>
          <label for="input-confirm-pass" class="block text-xs font-semibold text-stone-300 mb-1">
            Confirmar Nueva Contraseña
          </label>
          <input
            type="password"
            id="input-confirm-pass"
            required
            minlength="6"
            placeholder="••••••••••••"
            class="w-full rounded-xl border border-stone-700 bg-stone-900/90 px-3.5 py-2.5 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>

        <button
          type="submit"
          id="btn-submit-reset"
          class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-50"
        >
          Guardar Nueva Contraseña
        </button>
      </form>

      <div class="border-t border-stone-800 pt-4 text-center">
        <a href="/admin-tienda/login" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 transition">
          ← Volver al inicio de sesión
        </a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBase }}>
    (function initPasswordReset() {
      const form = document.getElementById('form-reset');
      const inputNewPass = document.getElementById('input-new-pass');
      const inputConfirmPass = document.getElementById('input-confirm-pass');
      const btnToggle = document.getElementById('btn-toggle-new-pass');
      const btnSubmit = document.getElementById('btn-submit-reset');
      const alertError = document.getElementById('alert-error');
      const alertSuccess = document.getElementById('alert-success');

      let API_BASE = apiBase || `http://${window.location.hostname}:8000`;
      if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      // Obtener token de la URL
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');

      if (!token) {
        alertError.textContent = 'Enlace de recuperación inválido o incompleto. Por favor solicita uno nuevo.';
        alertError.classList.remove('hidden');
        if (form) form.classList.add('hidden');
        return;
      }

      btnToggle?.addEventListener('click', () => {
        if (!inputNewPass) return;
        const isPwd = inputNewPass.type === 'password';
        inputNewPass.type = isPwd ? 'text' : 'password';
        btnToggle.textContent = isPwd ? '🙈' : '👁️';
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        alertError.classList.add('hidden');

        const newPass = inputNewPass?.value || '';
        const confirmPass = inputConfirmPass?.value || '';

        if (newPass.length < 6) {
          alertError.textContent = 'La nueva contraseña debe tener al menos 6 caracteres.';
          alertError.classList.remove('hidden');
          return;
        }

        if (newPass !== confirmPass) {
          alertError.textContent = 'Las contraseñas no coinciden.';
          alertError.classList.remove('hidden');
          return;
        }

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = 'Restableciendo contraseña...';
        }

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/auth/restablecer-password`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              token,
              nueva_password: newPass,
            }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.detail || 'Error al restablecer la contraseña.');
          }

          form.classList.add('hidden');
          alertSuccess.classList.remove('hidden');
        } catch (err) {
          alertError.textContent = err.message || 'Error de conexión o token inválido.';
          alertError.classList.remove('hidden');
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.textContent = 'Guardar Nueva Contraseña';
          }
        }
      });
    })();
  </script>
</body>
</html>

