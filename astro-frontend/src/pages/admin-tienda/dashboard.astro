---
import StoreAdminLayout from '../../layouts/StoreAdminLayout.astro';
---

<StoreAdminLayout title="Dashboard de Tostaduría | Cafesitios Admin" activeNav="dashboard">
  <div class="space-y-8">
    <!-- Header de Bienvenida y Acción de Sincronización -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <div>
        <div class="flex items-center gap-3">
          <img 
            id="dash-store-logo" 
            src="" 
            alt="Logo de tostaduría" 
            class="h-9 w-9 rounded-xl object-contain bg-stone-50 border border-stone-200 p-1 hidden shrink-0"
          />
          <span id="dash-store-logo-placeholder" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-base font-bold">
            ☕
          </span>
          <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-black text-stone-900" id="dash-store-title">Mi Tostaduría</h1>
            <span class="rounded-full bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 font-bold" id="dash-store-status">Activa</span>
          </div>
        </div>
        <p class="text-xs text-stone-500 mt-1">Panel de control de catálogo, sincronización y auditoría (Favicon automático de solo lectura).</p>
      </div>

      <!-- BOTÓN DE SINCRONIZACIÓN VOLUNTARIA BAJO DEMANDA -->
      <div class="flex flex-col sm:items-end gap-1.5">
        <button
          type="button"
          id="btn-sync-catalog"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 px-5 py-2.5 text-xs font-bold text-white transition shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="sync-spinner" class="hidden animate-spin">⏳</span>
          <span id="sync-icon">🔄</span>
          <span id="sync-btn-text">Sincronizar catálogo ahora</span>
        </button>
        <span class="text-[11px] text-stone-400" id="sync-cooldown-text">Máximo 1 sincronización cada 30 min</span>
      </div>
    </div>

    <!-- TARJETAS DE KPIS PRINCIPALES -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Total Productos</span>
        <div class="text-3xl font-black text-stone-900" id="kpi-total-products">0</div>
        <span class="text-[11px] text-emerald-700 font-semibold">En catálogo público</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Plataforma</span>
        <div class="text-xl font-black text-stone-900 uppercase" id="kpi-platform">WooCommerce</div>
        <span class="text-[11px] text-stone-500">Driver nativo configurado</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Última Sincronización</span>
        <div class="text-sm font-black text-stone-900 truncate" id="kpi-last-sync-date">Sin registros</div>
        <span class="text-[11px] font-semibold" id="kpi-sync-result">Estado: N/A</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Rol de Usuario</span>
        <div class="text-sm font-black text-emerald-800" id="kpi-user-role">STORE_ADMIN</div>
        <span class="text-[11px] text-stone-500">Aislamiento por tienda activo</span>
      </div>
    </div>

    <!-- FASE 3: TELEMETRÍA COMERCIAL E INTENCIÓN DE COMPRA (2.2) -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-6">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div>
          <div class="flex items-center gap-2 text-base font-bold text-stone-900">
            <span>📈</span>
            <span>Telemetría Comercial e Intención de Compra</span>
          </div>
          <p class="text-xs text-stone-500 mt-0.5">Demanda real derivada desde Cafesitios hacia tu e-commerce.</p>
        </div>
        <span class="rounded-full bg-purple-100 text-purple-900 px-2.5 py-0.5 text-xs font-bold">Tiempo Real</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl bg-purple-50/50 border border-purple-200/60 space-y-1">
          <span class="text-[10px] uppercase font-bold text-purple-700">Clics Salientes a tu Tienda</span>
          <div class="text-2xl font-black text-purple-950" id="telem-outbound-clicks">0</div>
          <p class="text-[11px] text-purple-800/80">Usuarios derivados a comprar</p>
        </div>

        <div class="p-4 rounded-xl bg-rose-50/50 border border-rose-200/60 space-y-1">
          <span class="text-[10px] uppercase font-bold text-rose-700">Cafés en Favoritos</span>
          <div class="text-2xl font-black text-rose-950" id="telem-favorites">0</div>
          <p class="text-[11px] text-rose-800/80">Guardados por compradores</p>
        </div>

        <div class="p-4 rounded-xl bg-teal-50/50 border border-teal-200/60 space-y-1">
          <span class="text-[10px] uppercase font-bold text-teal-700">En Matriz Comparativa</span>
          <div class="text-2xl font-black text-teal-950" id="telem-compare">0</div>
          <p class="text-[11px] text-teal-800/80">Apariciones cara a cara</p>
        </div>
      </div>

      <!-- Top Cafés con Mayor Demanda -->
      <div class="space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Top 3 Cafés con Mayor Interés</h4>
        <div id="telem-top-cafes-container" class="space-y-2">
          <div class="text-xs text-stone-400 italic">Cargando métricas de interés...</div>
        </div>
      </div>
    </div>

    <!-- SECCIÓN WHATSAPP COMMERCE: CONTACTO, MÉTRICAS Y PROYECCIÓN FINANCIERA -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Configuración WhatsApp de Ventas -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
        <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
          <span>💬</span>
          <span>WhatsApp Comercial de Ventas</span>
        </div>
        <p class="text-xs text-stone-500">
          Los clientes de Cafesitios te enviarán sus pedidos directamente a este número con el detalle armado.
        </p>

        <form id="form-whatsapp-config" class="space-y-3">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
              Número de WhatsApp
            </label>
            <div class="flex items-center gap-1.5">
              <span class="px-2.5 py-2 rounded-xl bg-stone-100 border border-stone-300 text-xs font-bold text-stone-700 select-none">
                🇨🇱 +56
              </span>
              <input
                type="tel"
                id="input-whatsapp-phone"
                placeholder="912345678"
                class="flex-1 rounded-xl border border-stone-300 px-3 py-2 text-xs font-semibold text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              />
            </div>
            <p class="text-[10px] text-stone-400 mt-1">Ingresa los 9 dígitos móviles (ej: 912345678).</p>
          </div>

          <button
            type="submit"
            id="btn-save-whatsapp"
            class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2 px-4 transition shadow-xs"
          >
            Guardar WhatsApp de Ventas
          </button>
          <p id="msg-whatsapp-status" class="text-[11px] text-center hidden font-semibold"></p>
        </form>
      </div>

      <!-- Métricas de WhatsApp y Proyección Financiera (KPI 1 & KPI 2) -->
      <div class="lg:col-span-2 rounded-2xl border-2 border-emerald-500/20 bg-gradient-to-br from-emerald-50/50 via-white to-amber-50/30 p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-bold uppercase tracking-wider">
              <span>📈</span> Módulo de Proyección Comercial
            </span>
            <span class="text-[11px] text-stone-400 font-medium">Últimos 30 días</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
            <!-- KPI 1 -->
            <div class="p-4 rounded-xl bg-white border border-emerald-100 shadow-2xs space-y-1">
              <span class="text-[10px] uppercase font-bold text-stone-400">Ventas Solicitadas vía WhatsApp</span>
              <div class="text-2xl font-black text-emerald-900" id="kpi-whatsapp-sales">$0 CLP</div>
              <p class="text-[11px] text-stone-500 font-medium" id="kpi-whatsapp-orders-count">0 pedidos recibidos</p>
            </div>

            <!-- Proyección Pasarela +18% -->
            <div class="p-4 rounded-xl bg-white border border-amber-200/80 shadow-2xs space-y-1">
              <span class="text-[10px] uppercase font-bold text-amber-800">Crecimiento Estimado Pasarela (+18%)</span>
              <div class="text-2xl font-black text-amber-900" id="kpi-whatsapp-boost">+$0 CLP</div>
              <p class="text-[11px] text-stone-500 font-medium">Incremento estimado con pago integrado</p>
            </div>
          </div>

          <!-- Cuadro Analítico Destacado KPI 2 -->
          <div class="mt-4 p-4 rounded-xl bg-white/90 border border-stone-200 text-xs text-stone-700 leading-relaxed shadow-2xs">
            <div class="flex items-start gap-2.5">
              <span class="text-lg mt-0.5">💡</span>
              <p id="kpi-whatsapp-projection-text">
                Tus clientes han solicitado $0 CLP en pedidos por WhatsApp este mes. Si gestionaras los pagos directamente en la plataforma con la futura pasarela Cafesitios, podrías aumentar tu tasa de conversión en un 18% estimado y automatizar la confirmación de inventario.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLA DE HISTORIAL DE PEDIDOS RECIBIDOS POR WHATSAPP -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-stone-100 pb-4">
        <div>
          <h2 class="text-sm font-bold text-stone-900 flex items-center gap-2">
            <span>🛒</span> Pedidos Recibidos vía WhatsApp
          </h2>
          <p class="text-xs text-stone-500">Historial de encargos generados por usuarios desde Cafesitios.</p>
        </div>
        <span class="text-xs font-bold text-stone-500" id="whatsapp-orders-count-badge">0 pedidos</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-stone-600">
          <thead class="bg-stone-50 text-[10px] uppercase tracking-wider text-stone-400 font-bold border-y border-stone-200">
            <tr>
              <th class="py-2.5 px-3">Fecha y Hora</th>
              <th class="py-2.5 px-3">Detalle de Ítems</th>
              <th class="py-2.5 px-3 text-right">Monto Estimado</th>
              <th class="py-2.5 px-3 text-center">Estado</th>
            </tr>
          </thead>
          <tbody id="tbody-whatsapp-orders" class="divide-y divide-stone-100">
            <tr>
              <td colspan="4" class="py-6 text-center text-stone-400">Cargando pedidos recibidos...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ACCESOS RÁPIDOS Y RESUMEN -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Tarjeta Gestión de Catálogo -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
            <span>📦</span>
            <span>Gestión de Catálogo y Precios</span>
          </div>
          <p class="text-xs text-stone-500 mt-2">
            Revisa los cafés detectados en tu tienda, actualiza precios, orígenes, procesos o añade manualmente nuevas variedades exclusivas.
          </p>
        </div>
        <div>
          <a
            href="/admin-tienda/productos"
            class="inline-flex items-center gap-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-white px-4 py-2 text-xs font-bold transition shadow-xs"
          >
            <span>Ver Mis Productos</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Tarjeta Auditoría -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
            <span>🛡️</span>
            <span>Registro de Auditoría de Acciones</span>
          </div>
          <p class="text-xs text-stone-500 mt-2">
            Monitorea el historial cronológico de altas, ediciones y sincronizaciones ejecutadas por los administradores de tu tienda.
          </p>
        </div>
        <div>
          <a
            href="/admin-tienda/auditoria"
            class="inline-flex items-center gap-2 rounded-xl border border-stone-300 hover:bg-stone-100 text-stone-800 px-4 py-2 text-xs font-bold transition shadow-xs"
          >
            <span>Ver Registro de Auditoría</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FASE 2: GESTIÓN DE COLECCIONES DE SCRAPING Y PROBADOR EN SECO -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-100 pb-4">
        <div>
          <div class="flex items-center gap-2 text-base font-bold text-stone-900">
            <span>🛒</span>
            <span>URLs de Catálogo y Colecciones de Scraping</span>
          </div>
          <p class="text-xs text-stone-500 mt-1">
            Administra los enlaces de tu e-commerce que el motor de Cafesitios escanea automáticamente (ej. /collections/grano, /cafe-kilo).
          </p>
        </div>
      </div>

      <!-- Formulario para agregar y probar nueva URL -->
      <div class="bg-stone-50 p-4 rounded-xl border border-stone-200/80 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Añadir o Probar Nueva Colección</h4>
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end">
          <div class="sm:col-span-7 space-y-1">
            <label class="block text-[11px] font-semibold text-stone-600">URL del Catálogo o Colección *</label>
            <input
              type="url"
              id="input-new-catalog-url"
              placeholder="https://mitienda.cl/collections/cafe-de-especialidad"
              class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-xs text-stone-800 placeholder-stone-400 focus:border-emerald-600 focus:outline-none"
            />
          </div>
          <div class="sm:col-span-3 space-y-1">
            <label class="block text-[11px] font-semibold text-stone-600">Etiqueta (opcional)</label>
            <input
              type="text"
              id="input-new-catalog-label"
              placeholder="Línea Filtros"
              class="w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-xs text-stone-800 placeholder-stone-400 focus:border-emerald-600 focus:outline-none"
            />
          </div>
          <div class="sm:col-span-2 flex gap-2">
            <button
              type="button"
              id="btn-test-catalog-url"
              class="flex-1 inline-flex items-center justify-center gap-1 rounded-xl border border-purple-300 bg-purple-50 hover:bg-purple-100 px-3 py-2 text-xs font-bold text-purple-900 transition shadow-xs"
              title="Probar en seco si la URL es legible antes de guardarla"
            >
              <span>🧪</span>
              <span>Probar</span>
            </button>
            <button
              type="button"
              id="btn-add-catalog-url"
              class="flex-1 inline-flex items-center justify-center gap-1 rounded-xl bg-emerald-700 hover:bg-emerald-800 px-3 py-2 text-xs font-bold text-white transition shadow-xs"
              title="Guardar URL de colección"
            >
              <span>+</span>
              <span>Guardar</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Lista de URLs registradas -->
      <div id="catalogs-list-container" class="space-y-2">
        <div class="text-xs text-stone-400 italic">Cargando colecciones registradas...</div>
      </div>
    </div>

    <!-- FASE 2: PERFIL DE MARCA Y CAFETERÍAS / SUCURSALES FÍSICAS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

      <!-- Formulario de Perfil de Marca -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
        <div class="border-b border-stone-100 pb-3">
          <div class="flex items-center gap-2 text-base font-bold text-stone-900">
            <span>🏷️</span>
            <span>Perfil de Marca y Ubicación Principal</span>
          </div>
          <p class="text-xs text-stone-500 mt-1">Configuración visible en el directorio público y fichas de producto.</p>
        </div>

        <form id="form-store-profile" class="space-y-3 text-xs">
          <div>
            <label class="block font-semibold text-stone-700 mb-1">Dirección Matriz / Tostaduría</label>
            <input type="text" id="prof-direccion" placeholder="Av. Providencia 1234" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Comuna</label>
              <input type="text" id="prof-comuna" placeholder="Providencia" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">WhatsApp de Ventas (+56)</label>
              <input type="text" id="prof-whatsapp" placeholder="+56912345678" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>
          <div>
            <label class="block font-semibold text-stone-700 mb-1">URL de Logotipo (PNG/SVG transparente)</label>
            <input type="url" id="prof-logo-url" placeholder="https://mitienda.cl/logo.png" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Monto Mínimo Envío Gratis ($)</label>
              <input type="number" id="prof-envio-gratis" placeholder="Ej. 30000" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div class="flex items-center pt-5">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" id="prof-retiro-tienda" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
                <span class="font-semibold text-stone-700">Ofrece Retiro en Tienda</span>
              </label>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Días de Tueste Habitual</label>
              <input type="text" id="prof-dias-tueste" placeholder="Ej. Martes y Jueves" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Fecha Último Tueste</label>
              <input type="date" id="prof-fecha-tueste" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>
          <div class="flex justify-end pt-2">
            <button type="submit" id="btn-save-profile" class="inline-flex items-center gap-1.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 px-4 py-2 text-xs font-bold text-white transition shadow-xs">
              <span>💾</span>
              <span>Guardar Perfil</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Sucursales y Cafeterías Físicas (Geolocalización) -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
        <div class="flex items-center justify-between border-b border-stone-100 pb-3">
          <div>
            <div class="flex items-center gap-2 text-base font-bold text-stone-900">
              <span>📍</span>
              <span>Cafeterías y Puntos de Retiro</span>
            </div>
            <p class="text-xs text-stone-500 mt-1">Alimenta el ordenamiento por cercanía GPS en el directorio de tiendas.</p>
          </div>
          <button
            type="button"
            id="btn-open-branch-modal"
            class="inline-flex items-center gap-1 rounded-xl border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-900 hover:bg-emerald-100 transition shadow-xs"
          >
            <span>+</span>
            <span>Añadir Local</span>
          </button>
        </div>

        <div id="branches-list-container" class="space-y-2">
          <div class="text-xs text-stone-400 italic">Cargando sucursales...</div>
        </div>
      </div>

    </div>

    <!-- FASE 4: BANDEJA DE INCONSISTENCIAS DE SCRAPING -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <div class="flex items-center gap-2 text-base font-bold text-stone-900">
          <span>⚠️</span>
          <span>Bandeja de Inconsistencias de Scraping</span>
          <span id="inconsistencies-badge" class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-bold text-amber-900">0 detectadas</span>
        </div>
        <a href="/admin-tienda/productos" class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 hover:underline">
          Corregir en Catálogo →
        </a>
      </div>
      <p class="text-xs text-stone-500">
        Productos detectados con posibles anomalías (precios en $0, gramajes fuera de rango, ítems que no son café o falta de imagen).
