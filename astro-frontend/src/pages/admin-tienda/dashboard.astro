---
import StoreAdminLayout from '../../layouts/StoreAdminLayout.astro';
---

<StoreAdminLayout title="Dashboard de Tostaduría | Cafesitios Admin" activeNav="dashboard">
  <div class="space-y-8">
    <!-- Header de Bienvenida y Acción de Sincronización -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <div>
        <div class="flex items-center gap-3">
          <img 
            id="dash-store-logo" 
            src="" 
            alt="Logo de tostaduría" 
            class="h-9 w-9 rounded-xl object-contain bg-stone-50 border border-stone-200 p-1 hidden shrink-0"
          />
          <span id="dash-store-logo-placeholder" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-base font-bold">
            ☕
          </span>
          <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-black text-stone-900" id="dash-store-title">Mi Tostaduría</h1>
            <span class="rounded-full bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 font-bold" id="dash-store-status">Activa</span>
          </div>
        </div>
        <p class="text-xs text-stone-500 mt-1">Panel de control de catálogo, sincronización y auditoría (Favicon automático de solo lectura).</p>
      </div>

      <!-- BOTÓN DE SINCRONIZACIÓN VOLUNTARIA BAJO DEMANDA -->
      <div class="flex flex-col sm:items-end gap-1.5">
        <button
          type="button"
          id="btn-sync-catalog"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 px-5 py-2.5 text-xs font-bold text-white transition shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="sync-spinner" class="hidden animate-spin">⏳</span>
          <span id="sync-icon">🔄</span>
          <span id="sync-btn-text">Sincronizar catálogo ahora</span>
        </button>
        <span class="text-[11px] text-stone-400" id="sync-cooldown-text">Máximo 1 sincronización cada 30 min</span>
      </div>
    </div>

    <!-- TARJETAS DE KPIS PRINCIPALES -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Total Productos</span>
        <div class="text-3xl font-black text-stone-900" id="kpi-total-products">0</div>
        <span class="text-[11px] text-emerald-700 font-semibold">En catálogo público</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Plataforma</span>
        <div class="text-xl font-black text-stone-900 uppercase" id="kpi-platform">WooCommerce</div>
        <span class="text-[11px] text-stone-500">Driver nativo configurado</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Última Sincronización</span>
        <div class="text-sm font-black text-stone-900 truncate" id="kpi-last-sync-date">Sin registros</div>
        <span class="text-[11px] font-semibold" id="kpi-sync-result">Estado: N/A</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Rol de Usuario</span>
        <div class="text-sm font-black text-emerald-800" id="kpi-user-role">STORE_ADMIN</div>
        <span class="text-[11px] text-stone-500">Aislamiento por tienda activo</span>
      </div>
    </div>

    <!-- SECCIÓN WHATSAPP COMMERCE: CONTACTO, MÉTRICAS Y PROYECCIÓN FINANCIERA -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Configuración WhatsApp de Ventas -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
        <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
          <span>💬</span>
          <span>WhatsApp Comercial de Ventas</span>
        </div>
        <p class="text-xs text-stone-500">
          Los clientes de Cafesitios te enviarán sus pedidos directamente a este número con el detalle armado.
        </p>

        <form id="form-whatsapp-config" class="space-y-3">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-stone-500 mb-1">
              Número de WhatsApp
            </label>
            <div class="flex items-center gap-1.5">
              <span class="px-2.5 py-2 rounded-xl bg-stone-100 border border-stone-300 text-xs font-bold text-stone-700 select-none">
                🇨🇱 +56
              </span>
              <input
                type="tel"
                id="input-whatsapp-phone"
                placeholder="912345678"
                class="flex-1 rounded-xl border border-stone-300 px-3 py-2 text-xs font-semibold text-stone-900 focus:outline-none focus:ring-2 focus:ring-emerald-600"
              />
            </div>
            <p class="text-[10px] text-stone-400 mt-1">Ingresa los 9 dígitos móviles (ej: 912345678).</p>
          </div>

          <button
            type="submit"
            id="btn-save-whatsapp"
            class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2 px-4 transition shadow-xs"
          >
            Guardar WhatsApp de Ventas
          </button>
          <p id="msg-whatsapp-status" class="text-[11px] text-center hidden font-semibold"></p>
        </form>
      </div>

      <!-- Métricas de WhatsApp y Proyección Financiera (KPI 1 & KPI 2) -->
      <div class="lg:col-span-2 rounded-2xl border-2 border-emerald-500/20 bg-gradient-to-br from-emerald-50/50 via-white to-amber-50/30 p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-[10px] font-bold uppercase tracking-wider">
              <span>📈</span> Módulo de Proyección Comercial
            </span>
            <span class="text-[11px] text-stone-400 font-medium">Últimos 30 días</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
            <!-- KPI 1 -->
            <div class="p-4 rounded-xl bg-white border border-emerald-100 shadow-2xs space-y-1">
              <span class="text-[10px] uppercase font-bold text-stone-400">Ventas Solicitadas vía WhatsApp</span>
              <div class="text-2xl font-black text-emerald-900" id="kpi-whatsapp-sales">$0 CLP</div>
              <p class="text-[11px] text-stone-500 font-medium" id="kpi-whatsapp-orders-count">0 pedidos recibidos</p>
            </div>

            <!-- Proyección Pasarela +18% -->
            <div class="p-4 rounded-xl bg-white border border-amber-200/80 shadow-2xs space-y-1">
              <span class="text-[10px] uppercase font-bold text-amber-800">Crecimiento Estimado Pasarela (+18%)</span>
              <div class="text-2xl font-black text-amber-900" id="kpi-whatsapp-boost">+$0 CLP</div>
              <p class="text-[11px] text-stone-500 font-medium">Incremento estimado con pago integrado</p>
            </div>
          </div>

          <!-- Cuadro Analítico Destacado KPI 2 -->
          <div class="mt-4 p-4 rounded-xl bg-white/90 border border-stone-200 text-xs text-stone-700 leading-relaxed shadow-2xs">
            <div class="flex items-start gap-2.5">
              <span class="text-lg mt-0.5">💡</span>
              <p id="kpi-whatsapp-projection-text">
                Tus clientes han solicitado $0 CLP en pedidos por WhatsApp este mes. Si gestionaras los pagos directamente en la plataforma con la futura pasarela Cafesitios, podrías aumentar tu tasa de conversión en un 18% estimado y automatizar la confirmación de inventario.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLA DE HISTORIAL DE PEDIDOS RECIBIDOS POR WHATSAPP -->
    <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-stone-100 pb-4">
        <div>
          <h2 class="text-sm font-bold text-stone-900 flex items-center gap-2">
            <span>🛒</span> Pedidos Recibidos vía WhatsApp
          </h2>
          <p class="text-xs text-stone-500">Historial de encargos generados por usuarios desde Cafesitios.</p>
        </div>
        <span class="text-xs font-bold text-stone-500" id="whatsapp-orders-count-badge">0 pedidos</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-stone-600">
          <thead class="bg-stone-50 text-[10px] uppercase tracking-wider text-stone-400 font-bold border-y border-stone-200">
            <tr>
              <th class="py-2.5 px-3">Fecha y Hora</th>
              <th class="py-2.5 px-3">Detalle de Ítems</th>
              <th class="py-2.5 px-3 text-right">Monto Estimado</th>
              <th class="py-2.5 px-3 text-center">Estado</th>
            </tr>
          </thead>
          <tbody id="tbody-whatsapp-orders" class="divide-y divide-stone-100">
            <tr>
              <td colspan="4" class="py-6 text-center text-stone-400">Cargando pedidos recibidos...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ACCESOS RÁPIDOS Y RESUMEN -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Tarjeta Gestión de Catálogo -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
            <span>📦</span>
            <span>Gestión de Catálogo y Precios</span>
          </div>
          <p class="text-xs text-stone-500 mt-2">
            Revisa los cafés detectados en tu tienda, actualiza precios, orígenes, procesos o añade manualmente nuevas variedades exclusivas.
          </p>
        </div>
        <div>
          <a
            href="/admin-tienda/productos"
            class="inline-flex items-center gap-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-white px-4 py-2 text-xs font-bold transition shadow-xs"
          >
            <span>Ver Mis Productos</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Tarjeta Auditoría -->
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs flex flex-col justify-between space-y-4">
        <div>
          <div class="flex items-center gap-2 text-stone-900 font-bold text-base">
            <span>🛡️</span>
            <span>Registro de Auditoría de Acciones</span>
          </div>
          <p class="text-xs text-stone-500 mt-2">
            Monitorea el historial cronológico de altas, ediciones y sincronizaciones ejecutadas por los administradores de tu tienda.
          </p>
        </div>
        <div>
          <a
            href="/admin-tienda/auditoria"
            class="inline-flex items-center gap-2 rounded-xl border border-stone-300 hover:bg-stone-100 text-stone-800 px-4 py-2 text-xs font-bold transition shadow-xs"
          >
            <span>Ver Registro de Auditoría</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- MODAL DE RESULTADO DE SINCRONIZACIÓN -->
    <div id="modal-sync-feedback" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-stone-200 pb-3">
          <h3 class="text-base font-bold text-stone-900" id="sync-feedback-title">Sincronización de Catálogo</h3>
          <button type="button" id="btn-close-sync-feedback" class="text-stone-400 hover:text-stone-600 font-bold text-lg">✕</button>
        </div>
        <div id="sync-feedback-body" class="p-4 rounded-xl bg-stone-50 text-xs text-stone-700 space-y-2">
          <!-- Inyectado por JS -->
        </div>
        <div class="flex justify-end pt-2">
          <button
            type="button"
            id="btn-confirm-sync-feedback"
            class="rounded-xl bg-stone-900 px-5 py-2 text-xs font-bold text-white hover:bg-stone-800 transition"
          >
            Entendido
          </button>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    (function initStoreDashboard() {
      const token = localStorage.getItem('store_admin_token');
      if (!token) {
        window.location.replace('/admin-tienda/login');
        return;
      }

      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      const btnSync = document.getElementById('btn-sync-catalog');
      const syncBtnText = document.getElementById('sync-btn-text');
      const syncIcon = document.getElementById('sync-icon');
      const syncSpinner = document.getElementById('sync-spinner');
      const syncCooldownText = document.getElementById('sync-cooldown-text');
      const modalFeedback = document.getElementById('modal-sync-feedback');
      const feedbackTitle = document.getElementById('sync-feedback-title');
      const feedbackBody = document.getElementById('sync-feedback-body');

      let cooldownInterval = null;

      function startCooldownTimer(seconds) {
        if (!btnSync) return;
        btnSync.disabled = true;
        let rem = seconds;

        function tick() {
          const m = Math.floor(rem / 60);
          const s = rem % 60;
          if (syncBtnText) syncBtnText.textContent = `⏳ Cooldown (${m}:${s < 10 ? '0' : ''}${s})`;
          if (syncCooldownText) syncCooldownText.textContent = `Disponible en ${m}m ${s}s`;

          if (rem <= 0) {
            clearInterval(cooldownInterval);
            btnSync.disabled = false;
            if (syncBtnText) syncBtnText.textContent = 'Sincronizar catálogo ahora';
            if (syncCooldownText) syncCooldownText.textContent = 'Máximo 1 sincronización cada 30 min';
          }
          rem -= 1;
        }

        tick();
        clearInterval(cooldownInterval);
        cooldownInterval = setInterval(tick, 1000);
      }

      function showFeedbackModal(title, contentHtml) {
        if (feedbackTitle) feedbackTitle.textContent = title;
        if (feedbackBody) feedbackBody.innerHTML = contentHtml;
        if (modalFeedback) {
          modalFeedback.classList.remove('hidden');
          modalFeedback.classList.add('flex');
        }
      }

      function closeFeedbackModal() {
        if (modalFeedback) {
          modalFeedback.classList.add('hidden');
          modalFeedback.classList.remove('flex');
        }
      }

      document.getElementById('btn-close-sync-feedback')?.addEventListener('click', closeFeedbackModal);
      document.getElementById('btn-confirm-sync-feedback')?.addEventListener('click', closeFeedbackModal);

      async function loadProfile() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/perfil`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.status === 401 || res.status === 403) {
            localStorage.removeItem('store_admin_token');
            window.location.replace('/admin-tienda/login');
            return;
          }
          if (!res.ok) return;

          const data = await res.json();
          document.getElementById('dash-store-title').textContent = data.tienda_nombre;
          document.getElementById('kpi-total-products').textContent = data.total_productos;
          document.getElementById('kpi-platform').textContent = data.plataforma;
          document.getElementById('kpi-user-role').textContent = data.rol;

          const logoImg = document.getElementById('dash-store-logo');
          const logoPlaceholder = document.getElementById('dash-store-logo-placeholder');
          if (logoImg && data.logo_url) {
            logoImg.src = data.logo_url;
            logoImg.classList.remove('hidden');
            if (logoPlaceholder) logoPlaceholder.classList.add('hidden');
          }

          if (data.ultima_sincronizacion) {
            const dt = new Date(data.ultima_sincronizacion);
            document.getElementById('kpi-last-sync-date').textContent = dt.toLocaleString('es-CL');
          }

          const resEl = document.getElementById('kpi-sync-result');
          if (resEl) {
            resEl.textContent = `Resultado: ${data.estado_sincronizacion}`;
            resEl.className = data.estado_sincronizacion === 'exitoso' ? 'text-[11px] font-semibold text-emerald-700' : 'text-[11px] font-semibold text-rose-600';
          }

          if (data.cooldown_sync_segundos > 0) {
            startCooldownTimer(data.cooldown_sync_segundos);
          }

          // Pre-cargar número de WhatsApp en el formulario
          const inputPhone = document.getElementById('input-whatsapp-phone');
          if (inputPhone && data.telefono_whatsapp) {
            // Eliminar +56 si viene incluido
            let cleanPhone = String(data.telefono_whatsapp).replace(/^\+56/, '').trim();
            inputPhone.value = cleanPhone;
          }
        } catch (_) {}
      }

      async function loadWhatsAppMetrics() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/metricas`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          const salesEl = document.getElementById('kpi-whatsapp-sales');
          const countEl = document.getElementById('kpi-whatsapp-orders-count');
          const boostEl = document.getElementById('kpi-whatsapp-boost');
          const projTextEl = document.getElementById('kpi-whatsapp-projection-text');

          if (salesEl) salesEl.textContent = `$${(data.ventas_whatsapp_30d || 0).toLocaleString('es-CL')} CLP`;
          if (countEl) countEl.textContent = `${data.total_pedidos_30d || 0} pedidos recibidos`;
          if (boostEl) boostEl.textContent = `+$${(data.incremento_estimado_clp || 0).toLocaleString('es-CL')} CLP`;
          if (projTextEl && data.texto_proyeccion) projTextEl.textContent = data.texto_proyeccion;
        } catch (_) {}
      }

      async function loadWhatsAppOrders() {
        const tbody = document.getElementById('tbody-whatsapp-orders');
        const badge = document.getElementById('whatsapp-orders-count-badge');
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/pedidos`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) {
            if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-rose-500">Error al cargar pedidos.</td></tr>`;
            return;
          }
          const orders = await res.json();
          if (badge) badge.textContent = `${orders.length} pedidos`;

          if (!tbody) return;
          if (orders.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-stone-400">Aún no has recibido pedidos vía WhatsApp. Aparecerán aquí cuando los usuarios preparen su compra.</td></tr>`;
            return;
          }

          tbody.innerHTML = orders.map((order) => {
            const dt = new Date(order.fecha_creacion);
            const dateStr = dt.toLocaleString('es-CL');
            const items = Array.isArray(order.items) ? order.items : [];
            const itemsSummary = items.map(i => `${i.cantidad}x ${i.nombre} (${i.formato || '250g'})`).join(', ');

            return `
              <tr class="hover:bg-stone-50 transition">
                <td class="py-3 px-3 font-mono text-[11px] text-stone-600 whitespace-nowrap">${dateStr}</td>
                <td class="py-3 px-3">
                  <div class="font-semibold text-stone-900 max-w-md truncate" title="${itemsSummary}">${itemsSummary || 'Sin detalle'}</div>
                  <div class="text-[10px] text-stone-400 font-mono">Dispositivo: ${order.dispositivo_uuid ? order.dispositivo_uuid.substring(0, 16) + '...' : 'Anónimo'}</div>
                </td>
                <td class="py-3 px-3 text-right font-black text-stone-900 whitespace-nowrap">
                  $${(order.monto_total_clp || 0).toLocaleString('es-CL')} CLP
                </td>
                <td class="py-3 px-3 text-center whitespace-nowrap">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    order.estado === 'ENVIADO' ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-100 text-stone-700'
                  }">
                    ${order.estado || 'ENVIADO'}
                  </span>
                </td>
              </tr>
            `;
          }).join('');
        } catch (e) {
          if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-rose-500">Error de conexión al cargar pedidos.</td></tr>`;
        }
      }

      // Guardar formulario de configuración de WhatsApp
      const formWhatsApp = document.getElementById('form-whatsapp-config');
      const msgStatus = document.getElementById('msg-whatsapp-status');

      formWhatsApp?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const inputPhone = document.getElementById('input-whatsapp-phone');
        let raw = (inputPhone ? inputPhone.value : '').trim();
        let formatted = '';
        if (raw) {
          raw = raw.replace(/[^0-9]/g, '');
          if (raw.length === 9) {
            formatted = `+56${raw}`;
          } else if (raw.startsWith('56') && raw.length === 11) {
            formatted = `+${raw}`;
          } else {
            formatted = `+56${raw}`;
          }
        }

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/config`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`,
            },
            body: JSON.stringify({ telefono_whatsapp: formatted || null }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            if (msgStatus) {
              msgStatus.textContent = err.detail || 'Error al guardar WhatsApp.';
              msgStatus.className = 'text-[11px] text-center text-rose-600 block font-semibold';
            }
            return;
          }

          if (msgStatus) {
            msgStatus.textContent = '✅ WhatsApp comercial guardado correctamente.';
            msgStatus.className = 'text-[11px] text-center text-emerald-700 block font-semibold';
            setTimeout(() => msgStatus.classList.add('hidden'), 3000);
          }
        } catch (_) {
          if (msgStatus) {
            msgStatus.textContent = 'Error de conexión al guardar.';
            msgStatus.className = 'text-[11px] text-center text-rose-600 block font-semibold';
          }
        }
      });

      btnSync?.addEventListener('click', async () => {
        if (!confirm('¿Deseas iniciar la sincronización de tu catálogo ahora? El proceso consultará tu tienda y actualizará precios y productos.')) {
          return;
        }

        btnSync.disabled = true;
        syncSpinner?.classList.remove('hidden');
        syncIcon?.classList.add('hidden');
        if (syncBtnText) syncBtnText.textContent = 'Sincronizando catálogo...';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sincronizar`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`,
            },
          });

          if (res.status === 429) {
            const errData = await res.json().catch(() => ({}));
            const retryAfter = parseInt(res.headers.get('Retry-After') || '1800', 10);
            startCooldownTimer(retryAfter);
            showFeedbackModal('Enfriamiento Activo (Cooldown)', `<p class="text-rose-700">${errData.detail || 'Sincronización en cooldown.'}</p>`);
            return;
          }

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            showFeedbackModal('Error en Sincronización', `<p class="text-rose-700">${errData.detail || 'Error al ejecutar sincronización.'}</p>`);
            return;
          }

          const result = await res.json();
          const contentHtml = `
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold ${result.exito ? 'text-emerald-800' : 'text-rose-800'}">
                  ${result.exito ? '✅ Sincronización Exitosa' : '❌ Sincronización Fallida'}
                </span>
                <span class="font-mono text-stone-500">${result.duracion_segundos}s</span>
              </div>
              <p class="text-xs text-stone-700">${result.mensaje}</p>
              <div class="flex gap-4 pt-2 border-t border-stone-200 font-semibold text-[11px]">
                <span class="text-emerald-700">🌱 ${result.productos_nuevos} nuevos</span>
                <span class="text-sky-700">🔄 ${result.productos_actualizados} actualizados</span>
                <span class="text-stone-600">📦 ${result.total_productos} total</span>
              </div>
            </div>
          `;
          showFeedbackModal('Catálogo Sincronizado', contentHtml);
          startCooldownTimer(result.cooldown_activo_segundos || 1800);
          loadProfile();
        } catch (err) {
          showFeedbackModal('Error de Conexión', `<p class="text-rose-700">${err.message}</p>`);
        } finally {
          syncSpinner?.classList.add('hidden');
          syncIcon?.classList.remove('hidden');
        }
      });

      loadProfile();
      loadWhatsAppMetrics();
      loadWhatsAppOrders();
    })();
  </script>
</StoreAdminLayout>
