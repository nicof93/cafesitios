        <form id="form-branch" class="space-y-3 text-xs">
          <div>
            <label class="block font-semibold text-stone-700 mb-1">Nombre del Local *</label>
            <input type="text" id="branch-nombre" required placeholder="Cafetería Lastarria" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
          </div>
          <div>
            <label class="block font-semibold text-stone-700 mb-1">Dirección *</label>
            <input type="text" id="branch-direccion" required placeholder="José Victorino Lastarria 288" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Comuna *</label>
              <input type="text" id="branch-comuna" required placeholder="Santiago" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Región</label>
              <input type="text" id="branch-region" placeholder="Metropolitana" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>
          <div class="flex justify-end gap-2 pt-2">
            <button type="button" id="btn-cancel-branch" class="rounded-xl border border-stone-300 px-4 py-2 font-semibold text-stone-700 hover:bg-stone-100 transition">Cancelar</button>
            <button type="submit" class="rounded-xl bg-emerald-700 hover:bg-emerald-800 px-4 py-2 font-bold text-white transition shadow-xs">Guardar Local</button>
          </div>
