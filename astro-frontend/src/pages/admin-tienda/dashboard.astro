---
import StoreAdminLayout from '../../layouts/StoreAdminLayout.astro';
import SlideOverDrawer from '../../components/admin/SlideOverDrawer.astro';
---

<StoreAdminLayout title="Panel de Tostaduría | Cafesitios Admin" activeNav="dashboard">
  <div class="space-y-6">
    <!-- Header de Bienvenida y Acción de Sincronización -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-5 rounded-2xl border border-stone-200 shadow-xs">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-2xl">☕</span>
          <h1 class="text-xl sm:text-2xl font-black text-stone-900" id="welcome-title">Panel de Control</h1>
        </div>
        <p class="text-xs text-stone-500 mt-1">
          Visión panorámica de demanda, rendimiento en el mercado nacional y sincronización de catálogo.
        </p>
      </div>

      <div class="flex flex-col items-start sm:items-end gap-1.5 shrink-0">
        <!-- BOTÓN DE SINCRONIZACIÓN VOLUNTARIA BAJO DEMANDA -->
        <button
          type="button"
          id="btn-sync-catalog"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 text-xs font-bold transition shadow-xs disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          title="Descargar y actualizar productos ahora"
        >
          <span id="sync-icon">🔄</span>
          <span id="sync-btn-text">Sincronizar Catálogo Ahora</span>
        </button>
        <span class="text-[10px] text-stone-400" id="sync-cooldown-text">Máximo 1 sincronización cada 30 min</span>
      </div>
    </div>

    <!-- TARJETAS DE KPIS PRINCIPALES (GRID 4 COLS) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Total Productos</span>
        <div class="text-2xl sm:text-3xl font-black text-stone-900" id="kpi-total-products">0</div>
        <span class="text-[10px] text-emerald-700 font-semibold block">En catálogo público</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Plataforma</span>
        <div class="text-lg sm:text-xl font-black text-stone-900 uppercase" id="kpi-platform">WooCommerce</div>
        <span class="text-[10px] text-stone-500 block">Driver nativo configurado</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Última Sincronización</span>
        <div class="text-xs sm:text-sm font-black text-stone-900 truncate" id="kpi-last-sync-date">Sin registros</div>
        <span class="text-[10px] font-semibold block truncate" id="kpi-sync-result">Estado: N/A</span>
      </div>

      <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-xs space-y-1">
        <span class="text-[10px] uppercase font-bold tracking-wider text-stone-400">Rol de Acceso</span>
        <div class="text-xs sm:text-sm font-black text-emerald-800" id="kpi-user-role">STORE_ADMIN</div>
        <span class="text-[10px] text-stone-500 block">Multi-tenant activo</span>
      </div>
    </div>

    <!-- FILA 2: GRID MODULAR 2 COLUMNAS (TRACCIÓN & DEMANDA vs BENCHMARK & MERCADO) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- COLUMNA IZQUIERDA: TRACCIÓN COMERCIAL Y CANAL WHATSAPP (7 COLS) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- TELEMETRÍA COMERCIAL E INTENCIÓN DE COMPRA -->
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <div>
              <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
                <span>📈</span>
                <span>Telemetría Comercial e Intención de Compra</span>
              </div>
              <p class="text-[11px] text-stone-500 mt-0.5">Demanda real derivada desde Cafésitios hacia tu tienda.</p>
            </div>
            <span class="rounded-full bg-purple-100 text-purple-900 px-2.5 py-0.5 text-[10px] font-bold">Tiempo Real</span>
          </div>

          <div class="grid grid-cols-3 gap-2.5 sm:gap-3">
            <div class="p-3 rounded-xl bg-purple-50/50 border border-purple-200/60 space-y-0.5">
              <span class="text-[9px] uppercase font-bold text-purple-700 block">Clics Salientes</span>
              <div class="text-xl sm:text-2xl font-black text-purple-950" id="telem-outbound-clicks">0</div>
              <p class="text-[10px] text-purple-800/80 leading-tight">Visitas a tu web</p>
            </div>

            <div class="p-3 rounded-xl bg-rose-50/50 border border-rose-200/60 space-y-0.5">
              <span class="text-[9px] uppercase font-bold text-rose-700 block">En Favoritos</span>
              <div class="text-xl sm:text-2xl font-black text-rose-950" id="telem-favorites">0</div>
              <p class="text-[10px] text-rose-800/80 leading-tight">Guardados</p>
            </div>

            <div class="p-3 rounded-xl bg-teal-50/50 border border-teal-200/60 space-y-0.5">
              <span class="text-[9px] uppercase font-bold text-teal-700 block">Comparativas</span>
              <div class="text-xl sm:text-2xl font-black text-teal-950" id="telem-compare">0</div>
              <p class="text-[10px] text-teal-800/80 leading-tight">Cara a cara</p>
            </div>
          </div>

          <!-- Top Cafés con Mayor Demanda -->
          <div class="space-y-1.5 pt-1">
            <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500 block">Top 3 Cafés con Mayor Interés</span>
            <div id="telem-top-cafes-container" class="space-y-1.5">
              <div class="text-xs text-stone-400 italic py-1">Cargando métricas de interés...</div>
            </div>
          </div>
        </div>

        <!-- MÓDULO WHATSAPP COMMERCE Y PEDIDOS RECIBIDOS -->
        <div class="rounded-2xl border-2 border-emerald-500/20 bg-gradient-to-br from-emerald-50/40 via-white to-amber-50/20 p-5 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <div>
              <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
                <span>💬</span>
                <span>WhatsApp Comercial de Ventas</span>
              </div>
              <p class="text-[11px] text-stone-500 mt-0.5">Pedidos armados enviados directamente a tu chat sin comisión (0%).</p>
            </div>
            <a href="/admin-tienda/ventas" class="text-[11px] font-bold text-emerald-700 hover:text-emerald-900 hover:underline">
              Ver detalle en Ventas →
            </a>
          </div>

          <!-- Configuración rápida de WhatsApp y métricas compactas -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
            <form id="form-whatsapp-config" class="sm:col-span-6 flex items-center gap-1.5">
              <span class="px-2 py-1.5 rounded-lg bg-stone-100 border border-stone-300 text-xs font-bold text-stone-700 select-none">
                🇨🇱 +56
              </span>
              <input
                type="tel"
                id="input-whatsapp-phone"
                placeholder="912345678"
                class="flex-1 rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-xs text-stone-900 focus:outline-none focus:ring-1 focus:ring-emerald-600"
              />
              <button
                type="submit"
                id="btn-save-whatsapp"
                class="rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-1.5 px-3 transition shrink-0"
              >
                Guardar
              </button>
            </form>
            <p id="msg-whatsapp-status" class="text-[10px] hidden font-semibold col-span-12"></p>

            <div class="sm:col-span-6 grid grid-cols-2 gap-2 text-center">
              <div class="p-2 rounded-lg bg-white border border-emerald-100 shadow-2xs">
                <span class="text-[9px] uppercase font-bold text-stone-400 block">Ventas</span>
                <span class="text-sm font-black text-emerald-900" id="kpi-whatsapp-sales">$0 CLP</span>
                <p class="text-[10px] text-stone-500 font-medium" id="kpi-whatsapp-orders-count">0 pedidos recibidos</p>
              </div>
              <div class="p-2 rounded-lg bg-white border border-amber-200/80 shadow-2xs">
                <span class="text-[9px] uppercase font-bold text-amber-800 block">Proyección (+18%)</span>
                <span class="text-sm font-black text-amber-900" id="kpi-whatsapp-boost">+$0 CLP</span>
                <p class="text-[10px] text-stone-400 font-medium">Con pasarela</p>
              </div>
            </div>
          </div>

          <!-- Cuadro analítico de proyección visible -->
          <div class="p-2.5 rounded-lg bg-white/90 border border-stone-200 text-[11px] text-stone-600 leading-relaxed shadow-2xs flex items-start gap-2">
            <span class="text-sm shrink-0">💡</span>
            <p id="kpi-whatsapp-projection-text">
              Tus clientes han solicitado pedidos por WhatsApp este mes. Gestionar pagos automatizados puede acelerar tus conversiones.
            </p>
          </div>

          <!-- Tabla compacta de pedidos con scroll interno -->
          <div class="overflow-x-auto max-h-44 overflow-y-auto rounded-xl border border-stone-100 bg-white">
            <table class="w-full text-left text-[11px] text-stone-600">
              <thead class="sticky top-0 bg-stone-50 text-[9px] uppercase tracking-wider text-stone-400 font-bold border-b border-stone-200">
                <tr>
                  <th class="py-2 px-3">Fecha</th>
                  <th class="py-2 px-3">Detalle</th>
                  <th class="py-2 px-3 text-right">Total</th>
                  <th class="py-2 px-3 text-center">Estado</th>
                </tr>
              </thead>
              <tbody id="tbody-whatsapp-orders" class="divide-y divide-stone-100">
                <tr>
                  <td colspan="4" class="py-4 text-center text-stone-400 text-xs">Cargando pedidos recibidos...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- COLUMNA DERECHA: BENCHMARK PRIVADO Y OPORTUNIDADES (5 COLS) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- BENCHMARK PRIVADO DE PRECIOS -->
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-3">
          <div class="border-b border-stone-100 pb-2.5">
            <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
              <span>📊</span>
              <span>Benchmark Privado de Precios ($/kg)</span>
            </div>
            <p class="text-[11px] text-stone-500 mt-0.5">Comparativa anónima de tus precios frente al mercado.</p>
          </div>

          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl border border-stone-100 bg-stone-50/70 p-2.5">
              <span class="block text-[9px] font-bold uppercase text-stone-400">Tu Tostaduría</span>
              <span class="text-sm font-extrabold text-stone-900" id="bench-store-avg">$0/kg</span>
            </div>
            <div class="rounded-xl border border-stone-100 bg-stone-50/70 p-2.5">
              <span class="block text-[9px] font-bold uppercase text-stone-400">Promedio Mercado</span>
              <span class="text-sm font-extrabold text-stone-700" id="bench-market-avg">$0/kg</span>
            </div>
            <div class="rounded-xl border border-stone-100 bg-stone-50/70 p-2.5">
              <span class="block text-[9px] font-bold uppercase text-stone-400">Posicionamiento</span>
              <span class="text-[11px] font-bold text-emerald-800" id="bench-posicion">Analizando...</span>
            </div>
          </div>

          <div>
            <span class="text-[10px] font-bold text-stone-600 block mb-1">Desglose por Origen:</span>
            <div id="bench-origins-container" class="space-y-1 text-xs max-h-32 overflow-y-auto">
              <div class="text-stone-400 text-xs italic">Cargando desglose...</div>
            </div>
          </div>
        </div>

        <!-- DEMANDA INSATISFECHA Y OPORTUNIDADES DE CATÁLOGO -->
        <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-3">
          <div class="flex items-center justify-between border-b border-stone-100 pb-2.5">
            <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
              <span>🎯</span>
              <span>Oportunidades de Catálogo</span>
            </div>
            <span class="rounded-full bg-amber-100 text-amber-900 px-2 py-0.5 text-[9px] font-bold">Algoritmo</span>
          </div>

          <p class="text-[11px] text-stone-500">Orígenes más cotizados por usuarios que aún no comercializas:</p>
          <div id="demand-opportunities-container" class="flex flex-wrap gap-1.5 text-xs">
            <span class="text-stone-400 text-xs italic">Analizando mercado...</span>
          </div>

          <div class="pt-2 border-t border-stone-100 space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-bold text-stone-600">Top Orígenes más buscados:</span>
              <div class="inline-flex rounded-lg border border-stone-200 bg-stone-100 p-0.5 text-[9px] font-bold">
                <button type="button" id="btn-view-origins-bars" class="px-2 py-0.5 rounded-md bg-white text-stone-900 shadow-2xs transition">📊 Barras</button>
                <button type="button" id="btn-view-origins-list" class="px-2 py-0.5 rounded-md text-stone-500 hover:text-stone-900 transition">📋 Lista</button>
              </div>
            </div>
            <div id="demand-top-origins-container" class="space-y-1.5 text-xs pt-1 max-h-36 overflow-y-auto">
              <div class="text-stone-400 text-xs italic">Cargando orígenes...</div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- FILA 3: GRID 2 COLUMNAS (CALIDAD DE CATÁLOGO & WIDGET OFICIAL) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- BANDEJA DE INCONSISTENCIAS DE SCRAPING (6 COLS) -->
      <div class="lg:col-span-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between border-b border-stone-100 pb-2.5">
          <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
            <span>⚠️</span>
            <span>Bandeja de Inconsistencias de Scraping</span>
            <span id="inconsistencies-badge" class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-900">0 detectadas</span>
          </div>
          <a href="/admin-tienda/productos" class="text-[11px] font-semibold text-emerald-700 hover:text-emerald-900 hover:underline">
            Corregir en Catálogo →
          </a>
        </div>
        <p class="text-[11px] text-stone-500">
          Productos detectados con posibles anomalías (precios en $0, gramajes fuera de rango o falta de imagen).
        </p>
        <div id="inconsistencies-list-container" class="space-y-1.5 max-h-36 overflow-y-auto">
          <p class="text-xs text-stone-400 italic py-1">Sin inconsistencias detectadas. Catálogo óptimo.</p>
        </div>
      </div>

      <!-- WIDGET EMBEBIBLE "VERIFICADO EN CAFESITIOS" (6 COLS) -->
      <div class="lg:col-span-6 rounded-2xl border border-stone-200 bg-white p-5 shadow-xs space-y-3">
        <div class="flex items-center justify-between border-b border-stone-100 pb-2.5">
          <div class="flex items-center gap-2 text-sm font-bold text-stone-900">
            <span>✨</span>
            <span>Sello Oficial "Verificado en Cafesitios" (Widget)</span>
          </div>
          <span class="rounded-full bg-emerald-100 text-emerald-900 px-2 py-0.5 text-[9px] font-bold">Badge DTC</span>
        </div>
        <p class="text-[11px] text-stone-500">
          Inserta este badge en tu tienda online para generar confianza en tus clientes:
        </p>
        <div class="flex items-center gap-3 bg-stone-50 p-2.5 rounded-xl border border-stone-200">
          <div class="shrink-0 flex items-center justify-center p-2 bg-white rounded-lg border border-stone-200 shadow-2xs">
            <div style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;background:#1c1917;color:#fff;border-radius:8px;font-family:sans-serif;font-size:10px;font-weight:bold;">
              <span>☕</span>
              <span>Verificado en Cafesitios</span>
            </div>
          </div>
          <div class="flex-1 min-w-0 space-y-1">
            <textarea
              id="widget-embed-code"
              readonly
              rows="1"
              class="w-full font-mono text-[10px] bg-white border border-stone-300 rounded-lg p-1.5 text-stone-700 select-all focus:outline-none"
            >&lt;a href="https://cafesitios.cl" target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#1c1917;color:#fff;border-radius:10px;font-family:sans-serif;font-size:11px;font-weight:bold;text-decoration:none;"&gt;&lt;span&gt;☕&lt;/span&gt;&lt;span&gt;Verificado en Cafesitios&lt;/span&gt;&lt;/a&gt;</textarea>
            <button
              type="button"
              id="btn-copy-widget"
              class="inline-flex items-center gap-1.5 rounded-lg bg-stone-800 hover:bg-stone-900 text-white px-2.5 py-1 text-[11px] font-bold transition shadow-2xs"
            >
              <span>📋</span>
              <span id="btn-copy-widget-text">Copiar Código HTML</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- FILA 4: ACORDEÓN COLAPSABLE DE CONFIGURACIÓN RÁPIDA (DESPACHO, TUESTE, COLECCIONES Y SUCURSALES) -->
    <details class="group rounded-2xl border border-stone-200 bg-white p-5 shadow-xs transition-all">
      <summary class="flex items-center justify-between cursor-pointer list-none select-none">
        <div class="flex items-center gap-2.5 font-bold text-stone-900 text-sm">
          <span>⚙️</span>
          <span>Configuración Rápida de Tienda, Despacho y Sucursales Físicas</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs text-stone-400 group-open:hidden">Desplegar opciones rápidas ▼</span>
          <span class="text-xs text-stone-400 hidden group-open:inline">Plegar ▲</span>
        </div>
      </summary>

      <div class="pt-4 border-t border-stone-100 mt-4 space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- Formulario de Perfil de Marca -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Políticas de Despacho y Tueste</h4>
            <form id="form-store-profile" class="space-y-3 text-xs">
              <div>
                <label class="block font-semibold text-stone-700 mb-1">Dirección Matriz / Tostaduría</label>
                <input type="text" id="prof-direccion" placeholder="Av. Providencia 1234" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-semibold text-stone-700 mb-1">Comuna</label>
                  <input type="text" id="prof-comuna" placeholder="Providencia" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
                </div>
                <div>
                  <label class="block font-semibold text-stone-700 mb-1">WhatsApp (+56)</label>
                  <input type="text" id="prof-whatsapp" placeholder="+56912345678" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
                </div>
              </div>
              <div>
                <label class="block font-semibold text-stone-700 mb-1">URL de Logotipo</label>
                <input type="url" id="prof-logo-url" placeholder="https://mitienda.cl/logo.png" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-semibold text-stone-700 mb-1">Envío Gratis desde ($)</label>
                  <input type="number" id="prof-envio-gratis" placeholder="30000" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
                </div>
                <div class="flex items-center pt-5">
                  <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" id="prof-retiro-tienda" class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
                    <span class="font-semibold text-stone-700">Retiro en Tienda</span>
                  </label>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-semibold text-stone-700 mb-1">Días de Tueste</label>
                  <input type="text" id="prof-dias-tueste" placeholder="Ej. Martes y Jueves" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
                </div>
                <div>
                  <label class="block font-semibold text-stone-700 mb-1">Fecha Último Tueste</label>
                  <input type="date" id="prof-fecha-tueste" class="w-full rounded-xl border border-stone-300 px-3 py-2 text-stone-800 focus:border-emerald-600 focus:outline-none" />
                </div>
              </div>
              <div class="flex justify-end pt-2">
                <button type="submit" id="btn-save-profile" class="rounded-xl bg-emerald-700 hover:bg-emerald-800 px-4 py-2 text-xs font-bold text-white transition shadow-xs">
                  Guardar Cambios de Perfil
                </button>
              </div>
            </form>
          </div>

          <!-- Colecciones y Sucursales en Columna 2 del Acordeón -->
          <div class="space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Colecciones de Catálogo</h4>
                <a href="/admin-tienda/configuracion#seccion-sincronizacion" class="text-[11px] font-bold text-emerald-700 hover:underline">
                  Gestión Completa →
                </a>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-2">
                <input type="url" id="input-new-catalog-url" placeholder="https://mitienda.cl/collections/cafe" class="sm:col-span-8 rounded-lg border border-stone-300 px-2.5 py-1.5 text-xs text-stone-900" />
                <input type="text" id="input-new-catalog-label" placeholder="Etiqueta" class="sm:col-span-4 rounded-lg border border-stone-300 px-2.5 py-1.5 text-xs text-stone-900" />
              </div>
              <div class="flex gap-2 justify-end">
                <button type="button" id="btn-test-catalog-url" class="rounded-lg border border-purple-200 bg-purple-50 text-purple-900 px-3 py-1 text-xs font-bold">Probar</button>
                <button type="button" id="btn-add-catalog-url" class="rounded-lg bg-emerald-700 text-white px-3 py-1 text-xs font-bold">+ Agregar</button>
              </div>
              <div id="catalogs-list-container" class="space-y-1 text-xs max-h-28 overflow-y-auto pt-1">
                <div class="text-xs text-stone-400 italic">Cargando colecciones...</div>
              </div>
            </div>

            <div class="space-y-2 pt-2 border-t border-stone-100">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold uppercase tracking-wider text-stone-700">Sucursales Físicas</h4>
                <a href="/admin-tienda/configuracion#sec-sucursales" class="text-[11px] font-bold text-emerald-700 hover:underline">
                  Administrar Sedes →
                </a>
              </div>
              <div id="branches-list-container" class="space-y-1 text-xs max-h-28 overflow-y-auto">
                <div class="text-xs text-stone-400 italic">Cargando sucursales...</div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </details>

  </div>

  <!-- SLIDE-OVER DRAWER DE RESULTADO DE SINCRONIZACIÓN (CERO POPUPS) -->
  <SlideOverDrawer
    id="drawer-sync-result"
    title="Resultado de Sincronización"
    subtitle="Detalle de productos actualizados en tu catálogo"
    icon="🔄"
    maxWidth="max-w-md"
  >
    <div id="sync-feedback-body" class="space-y-3">
      <!-- Inyectado por JS -->
    </div>
    <Fragment slot="footer">
      <button
        type="button"
        id="btn-close-sync-drawer-footer"
        class="rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-bold text-xs px-5 py-2 transition shadow-xs"
      >
        Entendido
      </button>
    </Fragment>
  </SlideOverDrawer>


  <script is:inline>
    (function initStoreDashboard() {
      const token = localStorage.getItem('store_admin_token');
      if (!token) {
        window.location.replace('/admin-tienda/login');
        return;
      }

      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      const btnSync = document.getElementById('btn-sync-catalog');
      const syncBtnText = document.getElementById('sync-btn-text');
      const syncIcon = document.getElementById('sync-icon');
      const syncSpinner = document.getElementById('sync-spinner');
      const syncCooldownText = document.getElementById('sync-cooldown-text');
      const drawerFeedback = document.getElementById('drawer-sync-result');
      const drawerFeedbackBackdrop = document.getElementById('drawer-sync-result-backdrop');
      const feedbackBody = document.getElementById('sync-feedback-body');
      const btnCloseSyncDrawer = document.getElementById('drawer-sync-result-close-btn');
      const btnConfirmSyncDrawer = document.getElementById('btn-confirm-sync-drawer');

      let cooldownInterval = null;

      function startCooldownTimer(seconds) {
        if (!btnSync) return;
        btnSync.disabled = true;
        let rem = seconds;

        function tick() {
          const m = Math.floor(rem / 60);
          const s = rem % 60;
          if (syncBtnText) syncBtnText.textContent = `⏳ Cooldown (${m}:${s < 10 ? '0' : ''}${s})`;
          if (syncCooldownText) syncCooldownText.textContent = `Disponible en ${m}m ${s}s`;

          if (rem <= 0) {
            clearInterval(cooldownInterval);
            btnSync.disabled = false;
            if (syncBtnText) syncBtnText.textContent = 'Sincronizar catálogo ahora';
            if (syncCooldownText) syncCooldownText.textContent = 'Máximo 1 sincronización cada 30 min';
          }
          rem -= 1;
        }

        tick();
        clearInterval(cooldownInterval);
        cooldownInterval = setInterval(tick, 1000);
      }

      function showFeedbackModal(title, contentHtml) {
        if (feedbackBody) feedbackBody.innerHTML = contentHtml;
        if (drawerFeedback) {
          drawerFeedback.classList.remove('translate-x-full');
          if (drawerFeedbackBackdrop) {
            drawerFeedbackBackdrop.classList.remove('opacity-0', 'pointer-events-none');
            drawerFeedbackBackdrop.classList.add('opacity-100', 'pointer-events-auto');
          }
        }
      }

      function closeFeedbackDrawer() {
        if (drawerFeedback) {
          drawerFeedback.classList.add('translate-x-full');
          if (drawerFeedbackBackdrop) {
            drawerFeedbackBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
            drawerFeedbackBackdrop.classList.add('opacity-0', 'pointer-events-none');
          }
        }
      }

      btnCloseSyncDrawer?.addEventListener('click', closeFeedbackDrawer);
      btnConfirmSyncDrawer?.addEventListener('click', closeFeedbackDrawer);
      drawerFeedbackBackdrop?.addEventListener('click', closeFeedbackDrawer);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawerFeedback && !drawerFeedback.classList.contains('translate-x-full')) {
          closeFeedbackDrawer();
        }
      });


      // --- FASE 2: GESTIÓN DE CATÁLOGOS, PROBADOR Y SUCURSALES ---
      const catalogsContainer = document.getElementById('catalogs-list-container');
      const inputCatalogUrl = document.getElementById('input-new-catalog-url');
      const inputCatalogLabel = document.getElementById('input-new-catalog-label');
      const btnTestCatalog = document.getElementById('btn-test-catalog-url');
      const btnAddCatalog = document.getElementById('btn-add-catalog-url');
      const modalTestCatalog = document.getElementById('modal-test-catalog-result');
      const testCatalogBody = document.getElementById('test-catalog-result-body');
      const btnCloseTestCatalog = document.getElementById('btn-close-test-catalog');
      const btnConfirmTestCatalog = document.getElementById('btn-confirm-test-catalog');

      const branchesContainer = document.getElementById('branches-list-container');
      const btnOpenBranchModal = document.getElementById('btn-open-branch-modal');
      const modalBranch = document.getElementById('modal-branch');
      const btnCloseBranchModal = document.getElementById('btn-close-branch-modal');
      const btnCancelBranch = document.getElementById('btn-cancel-branch');
      const formBranch = document.getElementById('form-branch');

      const formProfile = document.getElementById('form-store-profile');
      const profDireccion = document.getElementById('prof-direccion');
      const profComuna = document.getElementById('prof-comuna');
      const profWhatsapp = document.getElementById('prof-whatsapp');
      const profLogoUrl = document.getElementById('prof-logo-url');
      const profEnvioGratis = document.getElementById('prof-envio-gratis');
      const profRetiroTienda = document.getElementById('prof-retiro-tienda');
      const profDiasTueste = document.getElementById('prof-dias-tueste');
      const profFechaTueste = document.getElementById('prof-fecha-tueste');

      async function loadCatalogs() {
        if (!catalogsContainer) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al cargar catálogos');
          const cats = await res.json();
          if (cats.length === 0) {
            catalogsContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-2">No hay colecciones adicionales configuradas. Se usa la URL base por defecto.</p>';
            return;
          }
          catalogsContainer.innerHTML = cats.map(c => `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50 text-xs">
              <div class="min-w-0 flex-1 pr-3">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-stone-800 truncate">${c.etiqueta || 'Colección'}</span>
                  <span class="bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.2 rounded font-semibold">Activa</span>
                </div>
                <p class="text-[11px] text-stone-500 font-mono truncate mt-0.5">${c.url_catalogo}</p>
              </div>
              <button
                type="button"
                class="btn-delete-catalog text-rose-600 hover:text-rose-800 font-bold text-xs p-1 rounded hover:bg-rose-50 transition"
                data-id="${c.id}"
                title="Eliminar URL"
              >
                🗑️
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-delete-catalog').forEach(btn => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const confirmed = await window.cafesitiosConfirm?.(
                'Eliminar Colección de Scraping',
                '¿Seguro que deseas eliminar esta URL de colección de escaneo automático?',
                { confirmText: 'Eliminar URL', cancelText: 'Conservar', type: 'error' }
              ) ?? confirm('¿Seguro que deseas eliminar esta URL de colección?');
              if (!confirmed) return;
              try {
                const delRes = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/${id}`, {
                  method: 'DELETE',
                  headers: { 'Authorization': `Bearer ${token}` }
                });
                if (delRes.ok) loadCatalogs();
              } catch (_) {
                await window.cafesitiosAlert?.('Error', 'No fue posible eliminar la colección.', 'error');
              }
            });
          });
        } catch (_) {
          catalogsContainer.innerHTML = '<p class="text-xs text-rose-500 py-2">Error al cargar catálogos.</p>';
        }
      }

      async function loadBranches() {
        if (!branchesContainer) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al cargar sucursales');
          const branches = await res.json();
          if (branches.length === 0) {
            branchesContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-2">No hay locales ni cafeterías físicas registradas.</p>';
            return;
          }
          branchesContainer.innerHTML = branches.map(b => `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50 text-xs">
              <div>
                <span class="font-bold text-stone-800">${b.nombre}</span>
                <p class="text-[11px] text-stone-500">📍 ${b.direccion || 'Sin dirección'}, ${b.comuna || ''}</p>
              </div>
              <button
                type="button"
                class="btn-delete-branch text-rose-600 hover:text-rose-800 font-bold text-xs p-1 rounded hover:bg-rose-50 transition"
                data-id="${b.id}"
                title="Eliminar local"
              >
                🗑️
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-delete-branch').forEach(btn => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const confirmed = await window.cafesitiosConfirm?.(
                'Eliminar Cafetería Física',
                '¿Seguro que deseas eliminar esta sucursal de tu lista de locales?',
                { confirmText: 'Eliminar Sucursal', cancelText: 'Conservar', type: 'error' }
              ) ?? confirm('¿Seguro que deseas eliminar esta cafetería física?');
              if (!confirmed) return;
              try {
                const delRes = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales/${id}`, {
                  method: 'DELETE',
                  headers: { 'Authorization': `Bearer ${token}` }
                });
                if (delRes.ok) loadBranches();
              } catch (_) {
                await window.cafesitiosAlert?.('Error', 'No fue posible eliminar la sucursal.', 'error');
              }
            });
          });
        } catch (_) {
          branchesContainer.innerHTML = '<p class="text-xs text-rose-500 py-2">Error al cargar sucursales.</p>';
        }
      }

      btnAddCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        const etiqueta = inputCatalogLabel?.value.trim();
        if (!url) {
          await window.cafesitiosAlert?.('URL Inválida', 'Por favor ingresa una URL válida con protocolo https://...', 'warning');
          return;
        }
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url, etiqueta: etiqueta || null })
          });
          if (!res.ok) throw new Error('Error al registrar catálogo');
          if (inputCatalogUrl) inputCatalogUrl.value = '';
          if (inputCatalogLabel) inputCatalogLabel.value = '';
          loadCatalogs();
        } catch (e) {
          await window.cafesitiosAlert?.('Error al Guardar', e.message, 'error');
        }
      });

      btnTestCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        if (!url) {
          await window.cafesitiosAlert?.('Probar Colección', 'Ingresa primero la URL que deseas probar.', 'warning');
          return;
        }
        btnTestCatalog.disabled = true;
        btnTestCatalog.innerHTML = '<span>⏳</span><span>Probando...</span>';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/probar`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url })
          });
          const data = await res.json();
          if (modalTestCatalog && testCatalogBody) {
            testCatalogBody.innerHTML = `
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="${data.legible ? 'text-emerald-700 font-bold' : 'text-rose-700 font-bold'}">
                    ${data.legible ? '✅ Catálogo Legible' : '❌ No Legible'}
                  </span>
                  <span class="text-stone-400 font-mono text-[11px]">Plataforma: ${data.plataforma_detectada || data.plataforma_solicitada}</span>
                </div>
                <p class="text-stone-700">${data.mensaje}</p>
                <div class="bg-white p-3 rounded-lg border border-stone-200 mt-2">
                  <span class="font-bold text-stone-800">Total productos detectados:</span> ${data.total_productos_detectados}
                  ${data.primer_producto ? `
                    <div class="mt-2 pt-2 border-t border-stone-100">
                      <span class="font-semibold text-stone-600">Muestra primer producto:</span>
                      <p class="font-bold text-stone-900">${data.primer_producto.nombre} - $${(data.primer_producto.precio_clp || 0).toLocaleString('es-CL')}</p>
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
            modalTestCatalog.classList.remove('hidden');
            modalTestCatalog.classList.add('flex');
          }
        } catch (_) {
          await window.cafesitiosAlert?.('Error al Probar Catálogo', 'No se pudo obtener respuesta del driver para la URL ingresada.', 'error');
        } finally {
          btnTestCatalog.disabled = false;
          btnTestCatalog.innerHTML = '<span>🧪</span><span>Probar</span>';
        }
      });

      btnCloseTestCatalog?.addEventListener('click', () => {
        modalTestCatalog?.classList.add('hidden');
        modalTestCatalog?.classList.remove('flex');
      });
      btnConfirmTestCatalog?.addEventListener('click', () => {
        modalTestCatalog?.classList.add('hidden');
        modalTestCatalog?.classList.remove('flex');
      });

      btnOpenBranchModal?.addEventListener('click', () => {
        modalBranch?.classList.remove('hidden');
        modalBranch?.classList.add('flex');
      });
      btnCloseBranchModal?.addEventListener('click', () => {
        modalBranch?.classList.add('hidden');
        modalBranch?.classList.remove('flex');
      });
      btnCancelBranch?.addEventListener('click', () => {
        modalBranch?.classList.add('hidden');
        modalBranch?.classList.remove('flex');
      });

      formBranch?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nombre = document.getElementById('branch-nombre')?.value.trim();
        const direccion = document.getElementById('branch-direccion')?.value.trim();
        const comuna = document.getElementById('branch-comuna')?.value.trim();
        const region = document.getElementById('branch-region')?.value.trim();

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ nombre, direccion, comuna, region, activo: true })
          });
          if (!res.ok) throw new Error('Error al registrar sucursal');
          formBranch.reset();
          modalBranch?.classList.add('hidden');
          modalBranch?.classList.remove('flex');
          loadBranches();
        } catch (err) {
          await window.cafesitiosAlert?.('Error al Registrar', err.message, 'error');
        }
      });

      formProfile?.addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/perfil`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({
              direccion: profDireccion?.value.trim() || null,
              comuna: profComuna?.value.trim() || null,
              telefono_whatsapp: profWhatsapp?.value.trim() || null,
              logo_url: profLogoUrl?.value.trim() || null,
              envio_gratis_monto: profEnvioGratis?.value ? parseInt(profEnvioGratis.value, 10) : null,
              retiro_en_tienda: profRetiroTienda?.checked || false,
              dias_tueste: profDiasTueste?.value.trim() || null,
              fecha_ultimo_tueste: profFechaTueste?.value || null,
            })
          });
          if (!res.ok) throw new Error('Error al actualizar perfil');
          await window.cafesitiosAlert?.('Perfil Actualizado', 'Los datos de tu tienda y despacho fueron guardados exitosamente.', 'success');
          loadProfile();
        } catch (err) {
          await window.cafesitiosAlert?.('Error al Actualizar Perfil', err.message, 'error');
        }
      });


      async function loadTelemetrySummary() {
        const outboundEl = document.getElementById('telem-outbound-clicks');
        const favEl = document.getElementById('telem-favorites');
        const compEl = document.getElementById('telem-compare');
        const topContainer = document.getElementById('telem-top-cafes-container');
        if (!outboundEl) return;

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/telemetria/resumen`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          outboundEl.textContent = data.clics_salientes_totales;
          if (favEl) favEl.textContent = data.total_favoritos_guardados;
          if (compEl) compEl.textContent = data.apariciones_comparador;

          if (topContainer) {
            if (data.top_cafes.length === 0) {
              topContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-1">Sin registros de interacción suficientes aún.</p>';
            } else {
              topContainer.innerHTML = data.top_cafes.map((c, i) => `
                <div class="flex items-center justify-between p-2.5 rounded-xl border border-stone-100 bg-stone-50 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-purple-100 text-purple-900 font-bold text-[10px]">${i + 1}</span>
                    <span class="font-bold text-stone-800">${c.nombre}</span>
                  </div>
                  <span class="text-purple-900 font-bold bg-purple-100/70 px-2 py-0.5 rounded text-[11px]">${c.total_clics} clics</span>
                </div>
              `).join('');
            }
          }
        } catch (_) {}
      }


      async function loadProfile() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/perfil`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.status === 401 || res.status === 403) {
            localStorage.removeItem('store_admin_token');
            window.location.replace('/admin-tienda/login');
            return;
          }
          if (!res.ok) return;

          const data = await res.json();
          const storeTitleEl = document.getElementById('dash-store-title');
          if (storeTitleEl && data.tienda_nombre) storeTitleEl.textContent = data.tienda_nombre;
          const kpiTotalEl = document.getElementById('kpi-total-products');
          if (kpiTotalEl && data.total_productos !== undefined) kpiTotalEl.textContent = data.total_productos;
          const kpiPlatEl = document.getElementById('kpi-platform');
          if (kpiPlatEl && data.plataforma) kpiPlatEl.textContent = data.plataforma;
          const kpiRoleEl = document.getElementById('kpi-user-role');
          if (kpiRoleEl && data.rol) kpiRoleEl.textContent = data.rol;

          const logoImg = document.getElementById('dash-store-logo');
          const logoPlaceholder = document.getElementById('dash-store-logo-placeholder');
          if (logoImg && data.logo_url) {
            logoImg.src = data.logo_url;
            logoImg.classList.remove('hidden');
            if (logoPlaceholder) logoPlaceholder.classList.add('hidden');
          }

          if (data.ultima_sincronizacion) {
            const dt = new Date(data.ultima_sincronizacion);
            const syncDateEl = document.getElementById('kpi-last-sync-date');
            if (syncDateEl) syncDateEl.textContent = dt.toLocaleString('es-CL');
          }

          const resEl = document.getElementById('kpi-sync-result');
          if (resEl && data.estado_sincronizacion) {
            resEl.textContent = `Resultado: ${data.estado_sincronizacion}`;
            resEl.className = data.estado_sincronizacion === 'exitoso' ? 'text-[11px] font-semibold text-emerald-700' : 'text-[11px] font-semibold text-rose-600';
          }

          // Pre-cargar número de WhatsApp en el formulario
          const inputPhone = document.getElementById('input-whatsapp-phone');
          if (inputPhone && data.telefono_whatsapp) {
            let cleanPhone = String(data.telefono_whatsapp).replace(/^\+56/, '').trim();
            inputPhone.value = cleanPhone;
          }

          if (profDireccion && data.direccion) profDireccion.value = data.direccion;
          if (profComuna && data.comuna) profComuna.value = data.comuna;
          if (profWhatsapp && data.telefono_whatsapp) profWhatsapp.value = data.telefono_whatsapp;
          if (profLogoUrl && data.logo_url) profLogoUrl.value = data.logo_url;
          if (profEnvioGratis && data.envio_gratis_monto) profEnvioGratis.value = data.envio_gratis_monto;
          if (profRetiroTienda) profRetiroTienda.checked = Boolean(data.retiro_en_tienda);
          if (profDiasTueste && data.dias_tueste) profDiasTueste.value = data.dias_tueste;
          if (profFechaTueste && data.fecha_ultimo_tueste) profFechaTueste.value = data.fecha_ultimo_tueste;

          if (data.cooldown_sync_segundos > 0) {
            startCooldownTimer(data.cooldown_sync_segundos);
          }

          loadCatalogs().catch(() => {});
          loadBranches().catch(() => {});
          loadTelemetrySummary().catch(() => {});
          loadInconsistencies().catch(() => {});
          loadBenchmark().catch(() => {});
          loadUnmetDemand().catch(() => {});
        } catch (_) {}
      }

      async function loadWhatsAppMetrics() {
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/metricas`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          const salesEl = document.getElementById('kpi-whatsapp-sales');
          const countEl = document.getElementById('kpi-whatsapp-orders-count');
          const boostEl = document.getElementById('kpi-whatsapp-boost');
          const projTextEl = document.getElementById('kpi-whatsapp-projection-text');

          if (salesEl) salesEl.textContent = `$${(data.ventas_whatsapp_30d || 0).toLocaleString('es-CL')} CLP`;
          if (countEl) countEl.textContent = `${data.total_pedidos_30d || 0} pedidos recibidos`;
          if (boostEl) boostEl.textContent = `+$${(data.incremento_estimado_clp || 0).toLocaleString('es-CL')} CLP`;
          if (projTextEl && data.texto_proyeccion) projTextEl.textContent = data.texto_proyeccion;
        } catch (_) {}
      }

      async function loadWhatsAppOrders() {
        const tbody = document.getElementById('tbody-whatsapp-orders');
        const badge = document.getElementById('whatsapp-orders-count-badge');
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/pedidos`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) {
            if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-rose-500">Error al cargar pedidos.</td></tr>`;
            return;
          }
          const orders = await res.json();
          if (badge) badge.textContent = `${orders.length} pedidos`;

          if (!tbody) return;
          if (orders.length === 0) {
            tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-stone-400">Aún no has recibido pedidos vía WhatsApp. Aparecerán aquí cuando los usuarios preparen su compra.</td></tr>`;
            return;
          }

          tbody.innerHTML = orders.map((order) => {
            const dt = new Date(order.fecha_creacion);
            const dateStr = dt.toLocaleString('es-CL');
            const items = Array.isArray(order.items) ? order.items : [];
            const itemsSummary = items.map(i => `${i.cantidad}x ${i.nombre} (${i.formato || '250g'})`).join(', ');

            return `
              <tr class="hover:bg-stone-50 transition">
                <td class="py-3 px-3 font-mono text-[11px] text-stone-600 whitespace-nowrap">${dateStr}</td>
                <td class="py-3 px-3">
                  <div class="font-semibold text-stone-900 max-w-md truncate" title="${itemsSummary}">${itemsSummary || 'Sin detalle'}</div>
                  <div class="text-[10px] text-stone-400 font-mono">Dispositivo: ${order.dispositivo_uuid ? order.dispositivo_uuid.substring(0, 16) + '...' : 'Anónimo'}</div>
                </td>
                <td class="py-3 px-3 text-right font-black text-stone-900 whitespace-nowrap">
                  $${(order.monto_total_clp || 0).toLocaleString('es-CL')} CLP
                </td>
                <td class="py-3 px-3 text-center whitespace-nowrap">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold ${
                    order.estado === 'ENVIADO' ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-100 text-stone-700'
                  }">
                    ${order.estado || 'ENVIADO'}
                  </span>
                </td>
              </tr>
            `;
          }).join('');
        } catch (e) {
          if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-rose-500">Error de conexión al cargar pedidos.</td></tr>`;
        }
      }

      // Guardar formulario de configuración de WhatsApp
      const formWhatsApp = document.getElementById('form-whatsapp-config');
      const msgStatus = document.getElementById('msg-whatsapp-status');

      formWhatsApp?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const inputPhone = document.getElementById('input-whatsapp-phone');
        let raw = (inputPhone ? inputPhone.value : '').trim();
        let formatted = '';
        if (raw) {
          raw = raw.replace(/[^0-9]/g, '');
          if (raw.length === 9) {
            formatted = `+56${raw}`;
          } else if (raw.startsWith('56') && raw.length === 11) {
            formatted = `+${raw}`;
          } else {
            formatted = `+56${raw}`;
          }
        }

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/whatsapp/config`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`,
            },
            body: JSON.stringify({ telefono_whatsapp: formatted || null }),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            if (msgStatus) {
              msgStatus.textContent = err.detail || 'Error al guardar WhatsApp.';
              msgStatus.className = 'text-[11px] text-center text-rose-600 block font-semibold';
            }
            return;
          }

          if (msgStatus) {
            msgStatus.textContent = '✅ WhatsApp comercial guardado correctamente.';
            msgStatus.className = 'text-[11px] text-center text-emerald-700 block font-semibold';
            setTimeout(() => msgStatus.classList.add('hidden'), 3000);
          }
        } catch (_) {
          if (msgStatus) {
            msgStatus.textContent = 'Error de conexión al guardar.';
            msgStatus.className = 'text-[11px] text-center text-rose-600 block font-semibold';
          }
        }
      });

      btnSync?.addEventListener('click', async () => {
        const confirmed = await window.cafesitiosConfirm?.(
          'Sincronizar Catálogo Ahora',
          '¿Deseas iniciar la sincronización de tu catálogo ahora? El proceso consultará tu tienda y actualizará precios y productos.',
          { confirmText: 'Sincronizar Ahora 🔄', cancelText: 'Cancelar', type: 'info' }
        ) ?? confirm('¿Deseas iniciar la sincronización de tu catálogo ahora?');
        if (!confirmed) {
          return;
        }

        btnSync.disabled = true;
        syncSpinner?.classList.remove('hidden');
        syncIcon?.classList.add('hidden');
        if (syncBtnText) syncBtnText.textContent = 'Sincronizando catálogo...';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sincronizar`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`,
            },
          });

          if (res.status === 429) {
            const errData = await res.json().catch(() => ({}));
            const retryAfter = parseInt(res.headers.get('Retry-After') || '1800', 10);
            startCooldownTimer(retryAfter);
            showFeedbackModal('Enfriamiento Activo (Cooldown)', `<p class="text-rose-700">${errData.detail || 'Sincronización en cooldown.'}</p>`);
            return;
          }

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            showFeedbackModal('Error en Sincronización', `<p class="text-rose-700">${errData.detail || 'Error al ejecutar sincronización.'}</p>`);
            return;
          }

          const result = await res.json();
          const contentHtml = `
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold ${result.exito ? 'text-emerald-800' : 'text-rose-800'}">
                  ${result.exito ? '✅ Sincronización Exitosa' : '❌ Sincronización Fallida'}
                </span>
                <span class="font-mono text-stone-500">${result.duracion_segundos}s</span>
              </div>
              <p class="text-xs text-stone-700">${result.mensaje}</p>
              <div class="flex gap-4 pt-2 border-t border-stone-200 font-semibold text-[11px]">
                <span class="text-emerald-700">🌱 ${result.productos_nuevos} nuevos</span>
                <span class="text-sky-700">🔄 ${result.productos_actualizados} actualizados</span>
                <span class="text-stone-600">📦 ${result.total_productos} total</span>
              </div>
            </div>
          `;
          showFeedbackModal('Catálogo Sincronizado', contentHtml);
          startCooldownTimer(result.cooldown_activo_segundos || 1800);
          loadProfile();
        } catch (err) {
          showFeedbackModal('Error de Conexión', `<p class="text-rose-700">${err.message}</p>`);
        } finally {
          syncSpinner?.classList.add('hidden');
          syncIcon?.classList.remove('hidden');
        }
      });


      async function loadInconsistencies() {
        const badge = document.getElementById('inconsistencies-badge');
        const container = document.getElementById('inconsistencies-list-container');
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/productos/inconsistencias`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          if (badge) badge.textContent = `${data.total_inconsistencias} detectada${data.total_inconsistencias !== 1 ? 's' : ''}`;
          if (container) {
            if (data.inconsistencias.length === 0) {
              container.innerHTML = '<p class="text-xs text-stone-400 italic py-2">Sin inconsistencias detectadas. Tu catálogo está en perfecto estado.</p>';
            } else {
              container.innerHTML = data.inconsistencias.map(inc => `
                <div class="flex items-center justify-between p-2.5 rounded-xl border border-amber-200 bg-amber-50/50 text-xs">
                  <div>
                    <span class="font-bold text-stone-900">${inc.nombre}</span>
                    <p class="text-[11px] text-amber-800">${inc.detalle}</p>
                  </div>
                  <span class="rounded bg-amber-200 text-amber-950 font-bold px-2 py-0.5 text-[10px] uppercase">${inc.tipo_inconsistencia}</span>
                </div>
              `).join('');
            }
          }
        } catch (_) {}
      }

      async function loadBenchmark() {
        const storeAvgEl = document.getElementById('bench-store-avg');
        const marketAvgEl = document.getElementById('bench-market-avg');
        const posEl = document.getElementById('bench-posicion');
        const originsContainer = document.getElementById('bench-origins-container');
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/analitica/benchmark`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          if (storeAvgEl) storeAvgEl.textContent = `$${Math.round(data.precio_kilo_promedio_tienda).toLocaleString('es-CL')}/kg`;
          if (marketAvgEl) marketAvgEl.textContent = `$${Math.round(data.precio_kilo_promedio_mercado).toLocaleString('es-CL')}/kg`;
          if (posEl) posEl.textContent = data.posicion_mercado;

          if (originsContainer) {
            if (data.desglose_por_origen.length === 0) {
              originsContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-1">Registra orígenes en tus cafés para ver la comparativa de mercado.</p>';
            } else {
              originsContainer.innerHTML = data.desglose_por_origen.map(o => `
                <div class="flex items-center justify-between p-2 rounded-lg bg-stone-50 border border-stone-100">
                  <span class="font-bold text-stone-800">${o.origen}</span>
                  <div class="flex items-center gap-2">
                    <span class="text-stone-600 font-semibold">$${Math.round(o.precio_kilo_promedio_tienda).toLocaleString('es-CL')}</span>
                    <span class="text-[10px] text-stone-400">vs $${Math.round(o.precio_kilo_promedio_mercado).toLocaleString('es-CL')}</span>
                    <span class="text-[10px] font-bold ${o.diferencia_porcentaje <= 0 ? 'text-emerald-700' : 'text-rose-700'}">${o.diferencia_porcentaje > 0 ? '+' : ''}${o.diferencia_porcentaje}%</span>
                  </div>
                </div>
              `).join('');
            }
          }
        } catch (_) {}
      }

      let cachedDemandData = null;
      let originsCurrentView = 'bars'; // 'bars' | 'list'

      function renderDemandOrigins() {
        const topContainer = document.getElementById('demand-top-origins-container');
        if (!topContainer || !cachedDemandData) return;

        const origenes = cachedDemandData.origenes_mas_buscados || [];
        const oportunidades = cachedDemandData.oportunidades_catalogo || [];

        if (origenes.length === 0) {
          topContainer.innerHTML = '<div class="text-stone-400 text-xs italic">No hay datos de demanda de orígenes disponibles aún.</div>';
          return;
        }

        const maxVariedades = Math.max(...origenes.map(o => o.productos_en_mercado), 1);

        if (originsCurrentView === 'bars') {
          topContainer.innerHTML = origenes.map(o => {
            const esOportunidad = oportunidades.includes(o.origen);
            const pct = Math.max(8, Math.round((o.productos_en_mercado / maxVariedades) * 100));
            const barBg = esOportunidad ? 'bg-amber-500' : 'bg-emerald-600';
            const badge = esOportunidad 
              ? '<span class="rounded bg-amber-100 text-amber-900 border border-amber-300 px-1.5 py-0.2 text-[9px] font-bold">🎯 Demanda a suplir</span>'
              : '<span class="rounded bg-emerald-100 text-emerald-800 border border-emerald-300 px-1.5 py-0.2 text-[9px] font-bold">✓ En tu catálogo</span>';

            return `
              <div class="space-y-1 bg-stone-50/60 p-2 rounded-xl border border-stone-100">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-stone-800 flex items-center gap-1.5 flex-wrap">
                    <span>🌍 ${o.origen}</span>
                    ${badge}
                  </span>
                  <span class="text-stone-600 font-bold text-[11px]">${o.productos_en_mercado} variedades</span>
                </div>
                <div class="w-full bg-stone-200/80 h-2 rounded-full overflow-hidden">
                  <div class="${barBg} h-full rounded-full transition-all duration-500" style="width: ${pct}%;"></div>
                </div>
              </div>
            `;
          }).join('');
        } else {
          topContainer.innerHTML = origenes.map(o => {
            const esOportunidad = oportunidades.includes(o.origen);
            const badge = esOportunidad 
              ? '<span class="rounded bg-amber-100 text-amber-900 border border-amber-300 px-1.5 py-0.2 text-[9px] font-bold">🎯 Demanda a suplir</span>'
              : '<span class="rounded bg-emerald-100 text-emerald-800 border border-emerald-300 px-1.5 py-0.2 text-[9px] font-bold">✓ En tu catálogo</span>';

            return `
              <div class="flex items-center justify-between p-2 rounded-lg bg-stone-50 border border-stone-100">
                <div class="flex items-center gap-1.5">
                  <span class="font-bold text-stone-800">🌍 ${o.origen}</span>
                  ${badge}
                </div>
                <span class="text-stone-500 font-semibold text-[11px]">${o.productos_en_mercado} variedades en mercado</span>
              </div>
            `;
          }).join('');
        }
      }

      const btnViewBars = document.getElementById('btn-view-origins-bars');
      const btnViewList = document.getElementById('btn-view-origins-list');

      btnViewBars?.addEventListener('click', () => {
        originsCurrentView = 'bars';
        btnViewBars.className = 'px-2 py-0.5 rounded-md bg-white text-stone-900 shadow-2xs transition';
        if (btnViewList) btnViewList.className = 'px-2 py-0.5 rounded-md text-stone-500 hover:text-stone-900 transition';
        renderDemandOrigins();
      });

      btnViewList?.addEventListener('click', () => {
        originsCurrentView = 'list';
        btnViewList.className = 'px-2 py-0.5 rounded-md bg-white text-stone-900 shadow-2xs transition';
        if (btnViewBars) btnViewBars.className = 'px-2 py-0.5 rounded-md text-stone-500 hover:text-stone-900 transition';
        renderDemandOrigins();
      });

      async function loadUnmetDemand() {
        const oppContainer = document.getElementById('demand-opportunities-container');
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/analitica/demanda`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) return;
          const data = await res.json();
          cachedDemandData = data;

          if (oppContainer) {
            if (data.oportunidades_catalogo.length === 0) {
              oppContainer.innerHTML = '<span class="text-xs text-emerald-700 font-bold">¡Tu tostaduría cubre los orígenes más solicitados!</span>';
            } else {
              oppContainer.innerHTML = data.oportunidades_catalogo.map(op => `
                <span class="rounded-full bg-emerald-100 text-emerald-900 border border-emerald-300 font-bold px-3 py-1 text-xs">
                  🌱 ${op}
                </span>
              `).join('');
            }
          }

          renderDemandOrigins();
        } catch (_) {}
      }

      // Copiar código del Widget
      document.getElementById('btn-copy-widget')?.addEventListener('click', () => {
        const textarea = document.getElementById('widget-embed-code');
        const btnText = document.getElementById('btn-copy-widget-text');
        if (textarea) {
          textarea.select();
          navigator.clipboard.writeText(textarea.value);
          if (btnText) {
            btnText.textContent = '¡Código Copiado!';
            setTimeout(() => { btnText.textContent = 'Copiar Código HTML'; }, 2500);
          }
        }
      });

      loadProfile();
      loadWhatsAppMetrics();
      loadWhatsAppOrders();
    })();
  </script>
</StoreAdminLayout>
