        <div>
          <span class="text-[11px] font-bold text-stone-600 block mb-1.5">Orígenes Recomendados para Incorporar:</span>
          <div id="demand-opportunities-container" class="flex flex-wrap gap-2 text-xs">
            <span class="text-stone-400 text-xs italic">Analizando mercado...</span>
          </div>
        </div>

        <div class="pt-2 border-t border-stone-100 space-y-2">
          <div class="flex items-center justify-between gap-2">
            <span class="text-[11px] font-bold text-stone-600">Top Orígenes más buscados en Chile:</span>
            <!-- Selector de Vista: Gráfico de Barras vs Lista -->
            <div class="inline-flex rounded-lg border border-stone-200 bg-stone-100 p-0.5 text-[10px] font-bold">
              <button 
                type="button" 
