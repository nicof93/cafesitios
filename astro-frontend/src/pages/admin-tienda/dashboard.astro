    <!-- MODAL DE RESULTADO DE SINCRONIZACIÓN -->
    <div id="modal-sync-feedback" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-lg rounded-2xl bg-white p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-stone-200 pb-3">
          <h3 class="text-base font-bold text-stone-900" id="sync-feedback-title">Sincronización de Catálogo</h3>
          <button type="button" id="btn-close-sync-feedback" class="text-stone-400 hover:text-stone-600 font-bold text-lg">✕</button>
        </div>
        <div id="sync-feedback-body" class="p-4 rounded-xl bg-stone-50 text-xs text-stone-700 space-y-2">
          <!-- Inyectado por JS -->
        </div>
        <div class="flex justify-end pt-2">
          <button
            type="button"
            id="btn-confirm-sync-feedback"
            class="rounded-xl bg-stone-900 px-5 py-2 text-xs font-bold text-white hover:bg-stone-800 transition"
          >
            Entendido
          </button>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    (function initStoreDashboard() {
      const token = localStorage.getItem('store_admin_token');
      if (!token) {
        window.location.replace('/admin-tienda/login');
        return;
      }

      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      const btnSync = document.getElementById('btn-sync-catalog');
      const syncBtnText = document.getElementById('sync-btn-text');
      const syncIcon = document.getElementById('sync-icon');
      const syncSpinner = document.getElementById('sync-spinner');
      const syncCooldownText = document.getElementById('sync-cooldown-text');
      const modalFeedback = document.getElementById('modal-sync-feedback');
      const feedbackTitle = document.getElementById('sync-feedback-title');
      const feedbackBody = document.getElementById('sync-feedback-body');

      let cooldownInterval = null;

      function startCooldownTimer(seconds) {
        if (!btnSync) return;
        btnSync.disabled = true;
        let rem = seconds;

        function tick() {
          const m = Math.floor(rem / 60);
          const s = rem % 60;
          if (syncBtnText) syncBtnText.textContent = `⏳ Cooldown (${m}:${s < 10 ? '0' : ''}${s})`;
          if (syncCooldownText) syncCooldownText.textContent = `Disponible en ${m}m ${s}s`;

          if (rem <= 0) {
            clearInterval(cooldownInterval);
            btnSync.disabled = false;
            if (syncBtnText) syncBtnText.textContent = 'Sincronizar catálogo ahora';
            if (syncCooldownText) syncCooldownText.textContent = 'Máximo 1 sincronización cada 30 min';
          }
          rem -= 1;
        }

        tick();
        clearInterval(cooldownInterval);
        cooldownInterval = setInterval(tick, 1000);
      }

      function showFeedbackModal(title, contentHtml) {
        if (feedbackTitle) feedbackTitle.textContent = title;
        if (feedbackBody) feedbackBody.innerHTML = contentHtml;
        if (modalFeedback) {
          modalFeedback.classList.remove('hidden');
          modalFeedback.classList.add('flex');
        }
      }

      function closeFeedbackModal() {
        if (modalFeedback) {
          modalFeedback.classList.add('hidden');
          modalFeedback.classList.remove('flex');
        }
      }

      document.getElementById('btn-close-sync-feedback')?.addEventListener('click', closeFeedbackModal);
      document.getElementById('btn-confirm-sync-feedback')?.addEventListener('click', closeFeedbackModal);


      // --- FASE 2: GESTIÓN DE CATÁLOGOS, PROBADOR Y SUCURSALES ---
      const catalogsContainer = document.getElementById('catalogs-list-container');
      const inputCatalogUrl = document.getElementById('input-new-catalog-url');
      const inputCatalogLabel = document.getElementById('input-new-catalog-label');
      const btnTestCatalog = document.getElementById('btn-test-catalog-url');
      const btnAddCatalog = document.getElementById('btn-add-catalog-url');
      const modalTestCatalog = document.getElementById('modal-test-catalog-result');
      const testCatalogBody = document.getElementById('test-catalog-result-body');
      const btnCloseTestCatalog = document.getElementById('btn-close-test-catalog');
      const btnConfirmTestCatalog = document.getElementById('btn-confirm-test-catalog');

      const branchesContainer = document.getElementById('branches-list-container');
      const btnOpenBranchModal = document.getElementById('btn-open-branch-modal');
      const modalBranch = document.getElementById('modal-branch');
      const btnCloseBranchModal = document.getElementById('btn-close-branch-modal');
      const btnCancelBranch = document.getElementById('btn-cancel-branch');
      const formBranch = document.getElementById('form-branch');

      const formProfile = document.getElementById('form-store-profile');
      const profDireccion = document.getElementById('prof-direccion');
      const profComuna = document.getElementById('prof-comuna');
      const profWhatsapp = document.getElementById('prof-whatsapp');
      const profLogoUrl = document.getElementById('prof-logo-url');
      const profEnvioGratis = document.getElementById('prof-envio-gratis');
      const profRetiroTienda = document.getElementById('prof-retiro-tienda');
      const profDiasTueste = document.getElementById('prof-dias-tueste');
      const profFechaTueste = document.getElementById('prof-fecha-tueste');

      async function loadCatalogs() {
        if (!catalogsContainer) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al cargar catálogos');
          const cats = await res.json();
          if (cats.length === 0) {
            catalogsContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-2">No hay colecciones adicionales configuradas. Se usa la URL base por defecto.</p>';
            return;
          }
          catalogsContainer.innerHTML = cats.map(c => `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50 text-xs">
              <div class="min-w-0 flex-1 pr-3">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-stone-800 truncate">${c.etiqueta || 'Colección'}</span>
                  <span class="bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.2 rounded font-semibold">Activa</span>
                </div>
                <p class="text-[11px] text-stone-500 font-mono truncate mt-0.5">${c.url_catalogo}</p>
              </div>
              <button
                type="button"
                class="btn-delete-catalog text-rose-600 hover:text-rose-800 font-bold text-xs p-1 rounded hover:bg-rose-50 transition"
                data-id="${c.id}"
                title="Eliminar URL"
              >
                🗑️
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-delete-catalog').forEach(btn => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const confirmed = await window.cafesitiosConfirm?.(
                'Eliminar Colección de Scraping',
                '¿Seguro que deseas eliminar esta URL de colección de escaneo automático?',
                { confirmText: 'Eliminar URL', cancelText: 'Conservar', type: 'error' }
              ) ?? confirm('¿Seguro que deseas eliminar esta URL de colección?');
              if (!confirmed) return;
              try {
                const delRes = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/${id}`, {
                  method: 'DELETE',
                  headers: { 'Authorization': `Bearer ${token}` }
                });
                if (delRes.ok) loadCatalogs();
              } catch (_) {
                await window.cafesitiosAlert?.('Error', 'No fue posible eliminar la colección.', 'error');
              }
            });
          });
        } catch (_) {
          catalogsContainer.innerHTML = '<p class="text-xs text-rose-500 py-2">Error al cargar catálogos.</p>';
        }
      }

      async function loadBranches() {
        if (!branchesContainer) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al cargar sucursales');
          const branches = await res.json();
          if (branches.length === 0) {
            branchesContainer.innerHTML = '<p class="text-xs text-stone-400 italic py-2">No hay locales ni cafeterías físicas registradas.</p>';
            return;
          }
          branchesContainer.innerHTML = branches.map(b => `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50 text-xs">
              <div>
                <span class="font-bold text-stone-800">${b.nombre}</span>
                <p class="text-[11px] text-stone-500">📍 ${b.direccion || 'Sin dirección'}, ${b.comuna || ''}</p>
              </div>
              <button
                type="button"
                class="btn-delete-branch text-rose-600 hover:text-rose-800 font-bold text-xs p-1 rounded hover:bg-rose-50 transition"
                data-id="${b.id}"
                title="Eliminar local"
              >
                🗑️
              </button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-delete-branch').forEach(btn => {
            btn.addEventListener('click', async () => {
              const id = btn.getAttribute('data-id');
              const confirmed = await window.cafesitiosConfirm?.(
                'Eliminar Cafetería Física',
                '¿Seguro que deseas eliminar esta sucursal de tu lista de locales?',
                { confirmText: 'Eliminar Sucursal', cancelText: 'Conservar', type: 'error' }
              ) ?? confirm('¿Seguro que deseas eliminar esta cafetería física?');
              if (!confirmed) return;
              try {
                const delRes = await fetch(`${API_BASE}/api/v1/admin/tienda/sucursales/${id}`, {
                  method: 'DELETE',
                  headers: { 'Authorization': `Bearer ${token}` }
                });
                if (delRes.ok) loadBranches();
              } catch (_) {
                await window.cafesitiosAlert?.('Error', 'No fue posible eliminar la sucursal.', 'error');
              }
            });
          });
        } catch (_) {
          branchesContainer.innerHTML = '<p class="text-xs text-rose-500 py-2">Error al cargar sucursales.</p>';
        }
      }

      btnAddCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        const etiqueta = inputCatalogLabel?.value.trim();
        if (!url) {
          await window.cafesitiosAlert?.('URL Inválida', 'Por favor ingresa una URL válida con protocolo https://...', 'warning');
          return;
        }
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url, etiqueta: etiqueta || null })
          });
          if (!res.ok) throw new Error('Error al registrar catálogo');
          if (inputCatalogUrl) inputCatalogUrl.value = '';
          if (inputCatalogLabel) inputCatalogLabel.value = '';
          loadCatalogs();
        } catch (e) {
          await window.cafesitiosAlert?.('Error al Guardar', e.message, 'error');
        }
      });

      btnTestCatalog?.addEventListener('click', async () => {
        const url = inputCatalogUrl?.value.trim();
        if (!url) {
          await window.cafesitiosAlert?.('Probar Colección', 'Ingresa primero la URL que deseas probar.', 'warning');
          return;
        }
        btnTestCatalog.disabled = true;
        btnTestCatalog.innerHTML = '<span>⏳</span><span>Probando...</span>';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/catalogos/probar`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ url_catalogo: url })
          });
          const data = await res.json();
          if (modalTestCatalog && testCatalogBody) {
            testCatalogBody.innerHTML = `
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="${data.legible ? 'text-emerald-700 font-bold' : 'text-rose-700 font-bold'}">
                    ${data.legible ? '✅ Catálogo Legible' : '❌ No Legible'}
                  </span>
