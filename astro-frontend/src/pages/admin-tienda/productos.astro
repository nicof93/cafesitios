---
import StoreAdminLayout from '../../layouts/StoreAdminLayout.astro';
---

<StoreAdminLayout title="Mis Productos | Cafesitios Admin" activeNav="productos">
  <div class="space-y-6">
    <!-- Header de Catálogo -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-stone-200 shadow-xs">
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-stone-900">Catálogo de Productos</h1>
        <p class="text-xs text-stone-500 mt-1">Gestiona los cafés publicados bajo tu tostaduría.</p>
      </div>
      <div>
        <button
          type="button"
          id="btn-new-product"
          class="inline-flex items-center gap-2 rounded-xl bg-emerald-700 hover:bg-emerald-800 px-4 py-2 text-xs font-bold text-white transition shadow-sm"
        >
          <span>➕</span>
          <span>Agregar Café Manual</span>
        </button>
      </div>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-xl border border-stone-200 text-xs">
      <div class="relative flex-1 max-w-md">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar por nombre, origen o proceso..."
          class="w-full rounded-lg border border-stone-300 pl-8 pr-3 py-1.5 text-xs text-stone-800 placeholder-stone-400 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
        />
        <span class="absolute left-2.5 top-2 text-stone-400">🔍</span>
      </div>

      <div class="flex items-center gap-2">
        <label class="text-stone-500 font-semibold text-xs">Mostrar:</label>
        <select id="filter-visibility" class="rounded-lg border border-stone-300 px-2.5 py-1 text-xs text-stone-800 focus:outline-none focus:ring-1 focus:ring-emerald-600">
          <option value="">Todos los productos</option>
          <option value="false">Solo Visibles</option>
          <option value="true">Solo Ocultos</option>
        </select>
      </div>
    </div>

    <!-- TABLA DE PRODUCTOS -->
    <div class="overflow-x-auto rounded-2xl border border-stone-200 bg-white shadow-xs">
      <table class="w-full text-left text-xs text-stone-700">
        <thead class="bg-stone-50/80 border-b border-stone-200 text-[11px] uppercase tracking-wider font-bold text-stone-500">
          <tr>
            <th class="px-4 py-3">Café</th>
            <th class="px-4 py-3">Origen / Finca</th>
            <th class="px-4 py-3">Proceso / Tueste</th>
            <th class="px-4 py-3">Formato & Precio</th>
            <th class="px-4 py-3 text-center">Estado Catálogo</th>
            <th class="px-4 py-3 text-center">Acciones</th>
          </tr>
        </thead>
        <tbody id="products-table-body" class="divide-y divide-stone-100">
          <tr>
            <td colspan="6" class="px-4 py-8 text-center text-stone-400">Cargando productos de tu tostaduría...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- MODAL DE CREAR / EDITAR PRODUCTO -->
    <div id="modal-product" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-stone-200 pb-3">
          <h3 class="text-base font-bold text-stone-900" id="modal-product-title">Nuevo Café</h3>
          <button type="button" id="btn-close-product-modal" class="text-stone-400 hover:text-stone-600 font-bold text-lg">✕</button>
        </div>

        <form id="form-product" class="space-y-3 overflow-y-auto pr-1 flex-1 text-xs">
          <input type="hidden" id="prod-id" value="" />

          <div>
            <label class="block font-semibold text-stone-700 mb-1">Nombre del Café *</label>
            <input type="text" id="prod-name" required placeholder="Ej. Colombia Huila San Agustín 250g" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">País de Origen</label>
              <input type="text" id="prod-origin" placeholder="Ej. Colombia, Etiopía" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Finca / Productor</label>
              <input type="text" id="prod-farm" placeholder="Ej. Finca El Paraíso" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Variedad</label>
              <input type="text" id="prod-variety" placeholder="Ej. Geisha, Caturra" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Proceso</label>
              <input type="text" id="prod-process" placeholder="Ej. Lavado, Natural" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Nivel de Tueste</label>
              <input type="text" id="prod-roast" placeholder="Ej. Medio, Claro" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Precio CLP ($) *</label>
              <input type="number" id="prod-price" required min="100" step="10" placeholder="Ej. 11990" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Formato Gramos (g) *</label>
              <input type="number" id="prod-grams" required min="50" step="50" value="250" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-stone-700 mb-1">URL de Imagen</label>
            <input type="url" id="prod-image" placeholder="https://..." class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
          </div>

          <div>
            <label class="block font-semibold text-stone-700 mb-1">URL de Ficha en Tienda</label>
            <input type="url" id="prod-url" placeholder="https://mitostaduria.cl/productos/..." class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Puntaje SCA (0 - 100)</label>
              <input type="number" id="prod-sca" step="0.25" min="70" max="100" placeholder="Ej. 86.5" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
            <div>
              <label class="block font-semibold text-stone-700 mb-1">Notas de Cata (separadas por coma)</label>
              <input type="text" id="prod-notes" placeholder="Ej. Jazmín, Durazno, Miel" class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block font-semibold text-stone-700 mb-1">Descripción</label>
            <textarea id="prod-description" rows="2" placeholder="Notas de cata y descripción..." class="w-full rounded-lg border border-stone-300 px-3 py-1.5 focus:border-emerald-600 focus:outline-none"></textarea>
          </div>

          <div class="flex items-center gap-4 pt-2">
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="prod-active" checked class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
              <span class="font-semibold text-stone-700">Producto Activo</span>
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer">
              <input type="checkbox" id="prod-hidden" class="h-4 w-4 rounded border-stone-300 text-rose-600 focus:ring-rose-500" />
              <span class="font-semibold text-rose-700">Ocultar del Catálogo Público</span>
            </label>
          </div>

          <div class="flex items-center justify-end gap-2 pt-4 border-t border-stone-200">
            <button type="button" id="btn-cancel-product" class="rounded-xl border border-stone-300 px-4 py-2 text-stone-700 font-bold hover:bg-stone-50">Cancelar</button>
            <button type="submit" id="btn-save-product" class="rounded-xl bg-emerald-700 px-5 py-2 font-bold text-white hover:bg-emerald-800">Guardar Café</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL DE GESTIÓN Y MODERACIÓN DE NOTAS DE CATA -->
    <div id="modal-notes" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-stone-200 pb-3">
          <div>
            <h3 class="text-base font-bold text-stone-900" id="modal-notes-title">Notas de Cata</h3>
            <p class="text-[11px] text-stone-500" id="modal-notes-subtitle">Modera notas sugeridas por el extractor o añade notas personalizadas.</p>
          </div>
          <button type="button" id="btn-close-notes-modal" class="text-stone-400 hover:text-stone-600 font-bold text-lg">✕</button>
        </div>

        <!-- LISTADO DE NOTAS -->
        <div class="flex-1 overflow-y-auto space-y-2 pr-1 max-h-[340px]" id="notes-list-container">
          <p class="text-xs text-stone-400 text-center py-4">Cargando notas...</p>
        </div>

        <!-- AGREGAR NUEVA NOTA -->
        <form id="form-add-note" class="pt-3 border-t border-stone-200 space-y-2">
          <label class="block text-xs font-semibold text-stone-700">Añadir nueva nota a este café</label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="input-new-note" 
              required 
              placeholder="Ej. Maracuyá, Vainilla, Panela" 
              class="flex-1 rounded-xl border border-stone-300 px-3 py-1.5 text-xs focus:border-amber-600 focus:outline-none" 
            />
            <button 
              type="submit" 
              id="btn-submit-add-note" 
              class="rounded-xl bg-amber-700 hover:bg-amber-800 text-white font-bold text-xs px-4 py-1.5 shadow-2xs transition"
            >
              + Agregar
            </button>
          </div>
        </form>

        <div class="flex justify-end pt-2 border-t border-stone-100">
          <button type="button" id="btn-close-notes-footer" class="rounded-xl border border-stone-300 px-4 py-1.5 text-xs text-stone-700 font-bold hover:bg-stone-50">Cerrar</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function initStoreProducts() {
      const token = localStorage.getItem('store_admin_token');
      if (!token) {
        window.location.replace('/admin-tienda/login');
        return;
      }

      const mainEl = document.querySelector('body[data-api-base]');
      let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
      if (!API_BASE) {
        API_BASE = `http://${window.location.hostname}:8000`;
      } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      const tbody = document.getElementById('products-table-body');
      const searchInput = document.getElementById('search-input');
      const filterVis = document.getElementById('filter-visibility');
      const modal = document.getElementById('modal-product');
      const form = document.getElementById('form-product');
      const modalNotes = document.getElementById('modal-notes');
      const notesContainer = document.getElementById('notes-list-container');
      const formAddNote = document.getElementById('form-add-note');
      const inputNewNote = document.getElementById('input-new-note');
      let cachedProducts = [];
      let currentProductForNotes = null;

      function openModal(prod = null) {
        document.getElementById('modal-product-title').textContent = prod ? `Editar: ${prod.nombre}` : 'Nuevo Café';
        document.getElementById('prod-id').value = prod ? prod.id : '';
        document.getElementById('prod-name').value = prod ? prod.nombre : '';
        document.getElementById('prod-origin').value = prod ? (prod.origen || '') : '';
        document.getElementById('prod-farm').value = prod ? (prod.finca || '') : '';
        document.getElementById('prod-variety').value = prod ? (prod.variedad || '') : '';
        document.getElementById('prod-process').value = prod ? (prod.proceso || '') : '';
        document.getElementById('prod-roast').value = prod ? (prod.tueste || '') : '';
        document.getElementById('prod-image').value = prod ? (prod.imagen || '') : '';
        document.getElementById('prod-url').value = prod ? (prod.url_detalle || '') : '';
        document.getElementById('prod-description').value = prod ? (prod.descripcion || '') : '';
        document.getElementById('prod-sca').value = prod && prod.sca_score ? prod.sca_score : '';
        document.getElementById('prod-notes').value = prod && prod.notas_cata && prod.notas_cata.length ? prod.notas_cata.join(', ') : '';
        document.getElementById('prod-active').checked = prod ? prod.activo : true;
        document.getElementById('prod-hidden').checked = prod ? prod.oculto_catalogo : false;

        const firstVar = prod && prod.variantes && prod.variantes[0] ? prod.variantes[0] : null;
        document.getElementById('prod-price').value = firstVar ? firstVar.precio_clp : 9990;
        document.getElementById('prod-grams').value = firstVar ? firstVar.formato_gramos : 250;

        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }

      function closeModal() {
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }

      function openNotesModal(prod) {
        currentProductForNotes = prod;
        const titleEl = document.getElementById('modal-notes-title');
        if (titleEl) titleEl.textContent = `Notas de Cata: ${prod.nombre}`;
        if (inputNewNote) inputNewNote.value = '';
        if (modalNotes) {
          modalNotes.classList.remove('hidden');
          modalNotes.classList.add('flex');
        }
        loadNotes(prod.id);
      }

      function closeNotesModal() {
        if (modalNotes) {
          modalNotes.classList.add('hidden');
          modalNotes.classList.remove('flex');
        }
        currentProductForNotes = null;
      }

      async function loadNotes(prodId) {
        if (!notesContainer) return;
        notesContainer.innerHTML = '<p class="text-xs text-stone-400 text-center py-4">Cargando notas...</p>';

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/productos/${prodId}/notas`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (!res.ok) throw new Error('Error al cargar notas.');
          const data = await res.json();
          renderNotes(data.notas || []);
        } catch (err) {
          notesContainer.innerHTML = `<p class="text-xs text-rose-600 text-center py-4 font-semibold">${err.message}</p>`;
        }
      }

      function renderNotes(notas) {
        if (!notesContainer) return;
        if (!notas.length) {
          notesContainer.innerHTML = '<p class="text-xs text-stone-400 text-center py-4">No hay notas de cata registradas aún para este café.</p>';
          return;
        }

        notesContainer.innerHTML = notas.map((n) => {
          const estado = n.estado || 'confirmada';
          const badgeEstado = estado === 'confirmada'
            ? '<span class="rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5">✓ Confirmada</span>'
            : estado === 'sugerida'
            ? '<span class="rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5">⚠️ Sugerida</span>'
            : '<span class="rounded-full bg-stone-200 text-stone-600 text-[10px] font-bold px-2 py-0.5 line-through">Descartada</span>';

          const badgeRueda = n.es_fuera_de_rueda
            ? '<span class="rounded-full bg-purple-100 text-purple-800 text-[10px] font-bold px-2 py-0.5" title="No figura en el léxico estricto SCA">Fuera Rueda SCA</span>'
            : '';

          return `
            <div class="flex items-center justify-between p-3 rounded-xl border border-stone-200 bg-stone-50/70 hover:bg-stone-50 transition gap-2">
              <div class="flex items-center gap-2 flex-wrap min-w-0">
                <span class="font-bold text-stone-900 text-xs">${n.nombre}</span>
                ${n.macro_familia ? `<span class="text-[10px] text-stone-500 font-semibold bg-stone-100 px-1.5 py-0.5 rounded">(${n.macro_familia})</span>` : ''}
                ${badgeEstado}
                ${badgeRueda}
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                ${estado !== 'confirmada' ? `
                  <button type="button" class="btn-confirm-note rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-[11px] font-bold px-2.5 py-1 transition shadow-2xs" data-id="${n.id}">
                    ✓ Confirmar
                  </button>
                ` : ''}
                ${estado !== 'descartada' ? `
                  <button type="button" class="btn-discard-note rounded-lg border border-stone-300 hover:bg-rose-50 hover:text-rose-700 text-stone-600 text-[11px] font-bold px-2 py-1 transition" data-id="${n.id}">
                    ✕ Descartar
                  </button>
                ` : ''}
              </div>
            </div>
          `;
        }).join('');

        notesContainer.querySelectorAll('.btn-confirm-note').forEach((b) => {
          b.addEventListener('click', async () => {
            const noteId = parseInt(b.getAttribute('data-id'), 10);
            await changeNoteStatus('confirmar', noteId);
          });
        });

        notesContainer.querySelectorAll('.btn-discard-note').forEach((b) => {
          b.addEventListener('click', async () => {
            const noteId = parseInt(b.getAttribute('data-id'), 10);
            await changeNoteStatus('descartar', noteId);
          });
        });
      }

      async function changeNoteStatus(action, noteId) {
        if (!currentProductForNotes) return;
        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/productos/${currentProductForNotes.id}/notas/${action}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ nota_id: noteId }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.detail || `Error al ${action} nota`);
            return;
          }
          await loadNotes(currentProductForNotes.id);
          loadProducts(); // Refrescar catálogo en segundo plano
        } catch (err) {
          alert(`Error: ${err.message}`);
        }
      }

      formAddNote?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentProductForNotes || !inputNewNote) return;
        const nota = inputNewNote.value.trim();
        if (!nota) return;

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/productos/${currentProductForNotes.id}/notas`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ nota, es_fuera_de_rueda: false }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            alert(err.detail || 'Error al agregar nota');
            return;
          }
          inputNewNote.value = '';
          await loadNotes(currentProductForNotes.id);
          loadProducts();
        } catch (err) {
          alert(`Error: ${err.message}`);
        }
      });

      document.getElementById('btn-new-product')?.addEventListener('click', () => openModal());
      document.getElementById('btn-close-product-modal')?.addEventListener('click', closeModal);
      document.getElementById('btn-cancel-product')?.addEventListener('click', closeModal);
      document.getElementById('btn-close-notes-modal')?.addEventListener('click', closeNotesModal);
      document.getElementById('btn-close-notes-footer')?.addEventListener('click', closeNotesModal);

      async function loadProducts() {
        const q = (searchInput?.value || '').trim();
        const vis = filterVis?.value;
        const params = new URLSearchParams();
        if (q) params.set('q', q);
        if (vis !== '') params.set('oculto', vis);

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/productos?${params.toString()}`, {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.status === 401 || res.status === 403) {
            localStorage.removeItem('store_admin_token');
            window.location.replace('/admin-tienda/login');
            return;
          }
          if (!res.ok) throw new Error('Error al obtener productos.');

          const data = await res.json();
          cachedProducts = data.productos || [];
          renderProducts(cachedProducts);
        } catch (err) {
          if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-rose-600 font-bold">${err.message}</td></tr>`;
        }
      }

      function renderProducts(products) {
        if (!tbody) return;
        if (!products.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-stone-400">No se encontraron cafés registrados para tu tienda.</td></tr>';
          return;
        }

        tbody.innerHTML = products.map((p) => {
          const v = p.variantes && p.variantes[0] ? p.variantes[0] : null;
          const precio = v ? `$${v.precio_clp.toLocaleString('es-CL')}` : 'S/P';
          const gramos = v ? `${v.formato_gramos}g` : '250g';
          const precioKg = v ? `$${Math.round(v.precio_por_kilo).toLocaleString('es-CL')}/kg` : '';

          return `
            <tr class="hover:bg-stone-50/70 transition border-b border-stone-100">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <img src="${p.imagen || '/images/producto-referencial.jpg'}" alt="${p.nombre}" onerror="this.onerror=null; this.src='/images/producto-referencial.jpg';" class="h-10 w-10 rounded-lg object-contain bg-[#F4F3ED] border border-stone-200" />
                  <div>
                    <a href="${p.url_detalle}" target="_blank" rel="noopener noreferrer" class="font-bold text-stone-900 hover:text-emerald-700 transition">
                      ${p.nombre}
                    </a>
                    <span class="block text-[10px] text-stone-400">ID: #${p.id}</span>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 text-stone-600">
                <div class="font-semibold text-stone-800">${p.origen || 'No especificado'}</div>
                <div class="text-[10px] text-stone-400">${p.finca || ''}</div>
              </td>
              <td class="px-4 py-3 text-stone-600">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span>${p.proceso || 'Sin proceso'}</span>
                  ${p.sca_score ? `<span class="rounded bg-amber-100 text-amber-900 font-extrabold px-1.5 py-0.2 text-[10px]">SCA ${p.sca_score}</span>` : ''}
                </div>
                <div class="text-[10px] text-stone-400">${p.tueste ? 'Tueste ' + p.tueste : ''}</div>
                ${p.notas_cata && p.notas_cata.length ? `<div class="text-[10px] text-stone-500 italic truncate max-w-[180px]">${p.notas_cata.join(', ')}</div>` : ''}
              </td>
              <td class="px-4 py-3">
                <span class="font-bold text-stone-900">${precio}</span>
                <span class="text-stone-500 font-semibold text-[11px]"> (${gramos})</span>
                <span class="block text-[10px] text-emerald-700 font-semibold">${precioKg}</span>
              </td>
              <td class="px-4 py-3 text-center">
                ${p.oculto_catalogo
                  ? '<span class="rounded-full bg-rose-100 px-2 py-0.5 text-[10px] font-bold text-rose-800">Oculto</span>'
                  : '<span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800">Visible</span>'}
              </td>
              <td class="px-4 py-3 text-center">
                <div class="flex items-center justify-center gap-1.5">
                  <button
                    type="button"
                    class="btn-edit-prod font-bold text-stone-700 hover:text-stone-900 px-2 py-1 text-xs transition"
                    data-id="${p.id}"
                  >
                    ✏️ Editar
                  </button>
                  <button
                    type="button"
                    class="btn-notes-prod font-bold text-amber-800 bg-amber-50 hover:bg-amber-100 border border-amber-200/80 rounded-lg px-2 py-1 text-xs transition"
                    data-id="${p.id}"
                    title="Moderar y gestionar notas de cata"
                  >
                    🏷️ Notas
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');

        document.querySelectorAll('.btn-edit-prod').forEach((b) => {
          b.addEventListener('click', () => {
            const id = parseInt(b.getAttribute('data-id'), 10);
            const found = cachedProducts.find((x) => x.id === id);
            if (found) openModal(found);
          });
        });

        document.querySelectorAll('.btn-notes-prod').forEach((b) => {
          b.addEventListener('click', () => {
            const id = parseInt(b.getAttribute('data-id'), 10);
            const found = cachedProducts.find((x) => x.id === id);
            if (found) openNotesModal(found);
          });
        });
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('prod-id')?.value;
        const name = document.getElementById('prod-name')?.value;
        const origin = document.getElementById('prod-origin')?.value;
        const farm = document.getElementById('prod-farm')?.value;
        const variety = document.getElementById('prod-variety')?.value;
        const process = document.getElementById('prod-process')?.value;
        const roast = document.getElementById('prod-roast')?.value;
        const image = document.getElementById('prod-image')?.value;
        const url = document.getElementById('prod-url')?.value;
        const desc = document.getElementById('prod-description')?.value;
        const scaRaw = document.getElementById('prod-sca')?.value;
        const sca = scaRaw ? parseFloat(scaRaw) : null;
        const notesRaw = document.getElementById('prod-notes')?.value;
        const notes = notesRaw ? notesRaw.split(',').map(s => s.trim()).filter(Boolean) : [];
        const price = parseInt(document.getElementById('prod-price')?.value, 10);
        const grams = parseInt(document.getElementById('prod-grams')?.value, 10);
        const active = document.getElementById('prod-active')?.checked;
        const hidden = document.getElementById('prod-hidden')?.checked;

        const payload = {
          nombre: name,
          url_detalle: url || null,
          imagen: image || null,
          descripcion: desc || null,
          origen: origin || null,
          finca: farm || null,
          variedad: variety || null,
          proceso: process || null,
          tueste: roast || null,
          sca_score: sca,
          notas_cata: notes,
          activo: active,
          oculto_catalogo: hidden,
          variantes: [
            {
              formato_gramos: grams,
              precio_clp: price,
              opcion: `${grams}g`,
              disponible: active,
            }
          ]
        };

        const endpoint = id ? `${API_BASE}/api/v1/admin/tienda/productos/${id}` : `${API_BASE}/api/v1/admin/tienda/productos`;
        const method = id ? 'PUT' : 'POST';

        try {
          const res = await fetch(endpoint, {
            method,
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload),
          });
          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            alert(errData.detail || 'Error al guardar producto');
            return;
          }
          closeModal();
          loadProducts();
        } catch (err) {
          alert(`Error: ${err.message}`);
        }
      });

      searchInput?.addEventListener('input', () => loadProducts());
      filterVis?.addEventListener('change', () => loadProducts());

      loadProducts();
    })();
  </script>
</StoreAdminLayout>
