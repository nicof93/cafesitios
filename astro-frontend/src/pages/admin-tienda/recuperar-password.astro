---
import { Environment } from '../../core/infrastructure/config/Environment';
import '../../styles/global.css';

const apiBase = Environment.getApiBaseUrl();
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-stone-900">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Recuperar Contraseña | Cafésitios Admin</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>☕</text></svg>">
</head>
<body class="h-full text-stone-100 antialiased font-sans bg-stone-900 flex items-center justify-center p-4">

  <div class="w-full max-w-md space-y-6">
    <!-- Header Brand -->
    <div class="text-center space-y-2">
      <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-700 text-white font-black text-2xl shadow-lg">
        ☕
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Recuperar Contraseña</h1>
      <p class="text-xs text-stone-400">Te enviaremos un enlace seguro para restablecer el acceso a tu tostaduría.</p>
    </div>

    <!-- Card Principal -->
    <div class="rounded-2xl border border-stone-800 bg-stone-850/90 p-6 sm:p-8 shadow-xl backdrop-blur-md space-y-5">
      <div id="alert-error" class="hidden rounded-xl border border-rose-500/30 bg-rose-950/60 p-3 text-xs text-rose-300"></div>
      
      <div id="alert-success" class="hidden rounded-xl border border-emerald-500/30 bg-emerald-950/60 p-4 text-xs text-emerald-300 space-y-2">
        <div class="flex items-center gap-2 font-bold text-sm text-emerald-200">
          <span>✉️</span>
          <span>¡Correo enviado!</span>
        </div>
        <p class="leading-relaxed">
          Si el correo ingresado corresponde a un administrador registrado, recibirás un enlace de recuperación válido por 2 horas. Revisa también tu carpeta de spam o correo no deseado.
        </p>
      </div>

      <form id="form-recovery" class="space-y-4">
        <div>
          <label for="input-email" class="block text-xs font-semibold text-stone-300 mb-1">
            Correo Electrónico de Administrador
          </label>
          <input
            type="email"
            id="input-email"
            required
            placeholder="admin@mitostaduria.cl"
            class="w-full rounded-xl border border-stone-700 bg-stone-900/90 px-3.5 py-2.5 text-xs text-white placeholder-stone-500 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500"
          />
        </div>

        <button
          type="submit"
          id="btn-submit"
          class="w-full rounded-xl bg-emerald-700 hover:bg-emerald-600 px-4 py-2.5 text-xs font-bold text-white transition shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-50"
        >
          Enviar Enlace de Recuperación
        </button>
      </form>

      <div class="border-t border-stone-800 pt-4 text-center">
        <a href="/admin-tienda/login" class="text-xs font-bold text-emerald-400 hover:text-emerald-300 transition">
          ← Volver al inicio de sesión
        </a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ apiBase }}>
    (function initPasswordRecovery() {
      const form = document.getElementById('form-recovery');
      const inputEmail = document.getElementById('input-email');
      const btnSubmit = document.getElementById('btn-submit');
      const alertError = document.getElementById('alert-error');
      const alertSuccess = document.getElementById('alert-success');

      let API_BASE = apiBase || `http://${window.location.hostname}:8000`;
      if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
        API_BASE = API_BASE.replace('localhost', '127.0.0.1');
      } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
        API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
      }

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        alertError.classList.add('hidden');
        alertSuccess.classList.add('hidden');

        const email = inputEmail?.value.trim();
        if (!email) return;

        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.textContent = 'Enviando instrucciones...';
        }

        try {
          const res = await fetch(`${API_BASE}/api/v1/admin/tienda/auth/solicitar-recuperacion`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });

          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            throw new Error(data.detail || 'Ocurrió un error al procesar la solicitud.');
          }

          alertSuccess.classList.remove('hidden');
          form.classList.add('hidden');
        } catch (err) {
          alertError.textContent = err.message || 'Error de red o conexión al servidor.';
          alertError.classList.remove('hidden');
        } finally {
          if (btnSubmit) {
            btnSubmit.disabled = false;
            btnSubmit.textContent = 'Enviar Enlace de Recuperación';
          }
        }
      });
    })();
  </script>
</body>
</html>
