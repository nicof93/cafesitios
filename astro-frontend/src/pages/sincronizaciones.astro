---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Environment } from '../core/infrastructure/config/Environment';
import {
  GetSyncAnalyticsUseCase,
  type MarketAnalyticsDTO,
  type PaginatedSyncHistoryDTO,
  type SyncCurrentSummaryDTO,
} from '../core/application/GetSyncAnalytics';

if (!Environment.isAnalyticsEnabled(Astro.url)) {
  return Astro.redirect('/');
}

const syncUseCase = new GetSyncAnalyticsUseCase();

let summary: SyncCurrentSummaryDTO = {
  fecha_ultima_sincronizacion: null,
  ultima_sincronizacion: null,
  estado: 'OK',
  total_nuevos: 0,
  total_subieron_precio: 0,
  total_bajaron_precio: 0,
  total_cambios_precio: 0,
  porcentaje_variacion_global: 0,
  ahorro_total_clp: 0,
  porcentaje_ahorro_promedio: 0,
  total_ofertas_monitoreadas: 0,
  total_productos_catalogados: 0,
  productos_nuevos: [],
  cambios_precio: [],
};

let history: PaginatedSyncHistoryDTO = {
  page: 1,
  page_size: 10,
  total_items: 0,
  total_pages: 1,
  items: [],
};

let market: MarketAnalyticsDTO = {
  precio_promedio_kilo: 0,
  precio_minimo_kilo: 0,
  precio_maximo_kilo: 0,
  precio_promedio_bolsa_clp: 0,
  total_variantes_analizadas: 0,
  total_tiendas_activas: 0,
  tienda_mejor_descuento: {
    nombre: null,
    descuento_promedio_porcentaje: 0,
    total_ofertas_descuento: 0,
    precio_promedio_kilo: 0,
    cantidad_productos: 0,
  },
  tiendas_mas_competitivas: [],
  distribucion_tueste: [],
  distribucion_proceso: [],
};

try {
  const [resSummary, resHistory, resMarket] = await Promise.allSettled([
    syncUseCase.getCurrentSummary(),
    syncUseCase.getHistory(1, 10),
    syncUseCase.getMarketAnalytics(),
  ]);
  if (resSummary.status === 'fulfilled' && resSummary.value) summary = resSummary.value;
  if (resHistory.status === 'fulfilled' && resHistory.value) history = resHistory.value;
  if (resMarket.status === 'fulfilled' && resMarket.value) market = resMarket.value;
} catch (error) {
  console.error('Error en SSR de sincronizaciones:', error);
}

const clp = new Intl.NumberFormat('es-CL', {
  style: 'currency',
  currency: 'CLP',
  maximumFractionDigits: 0,
});

function formatCLP(val: number | undefined | null): string {
  return clp.format(Math.round(Number(val) || 0));
}

function formatReadableSpanishDate(iso?: string | null): string {
  if (!iso) return 'Sin sincronizaciones registradas';
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return String(iso);
  const months = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
  ];
  const day = String(date.getDate()).padStart(2, '0');
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  const hours = String(date.getHours()).padStart(2, '0');
  const minutes = String(date.getMinutes()).padStart(2, '0');
  return `${day} de ${month} de ${year} - ${hours}:${minutes} hrs`;
}

const fechaSyncRaw = summary.fecha_ultima_sincronizacion || summary.ultima_sincronizacion || '';
const fechaSyncLegible = formatReadableSpanishDate(fechaSyncRaw);
const isOk = (summary.estado || 'OK').toUpperCase() === 'OK';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Reporte de Sincronización y Analítica | Cafesitios',
  description: 'Consulta el estado de sincronización en tiempo real, variaciones de precio, nuevos cafés de especialidad y analítica de mercado por kilo ($/kg) en Chile.',
  url: 'https://cafesitios.cl/sincronizaciones',
};
---

<BaseLayout
  title="Reporte de Sincronización y Analítica | Cafesitios - Monitoreo de Precios en Chile"
  description="Consulta el estado de sincronización en tiempo real, variaciones de precio, nuevos cafés de especialidad y analítica de mercado por kilo ($/kg) en Chile."
  canonicalUrl="https://cafesitios.cl/sincronizaciones"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <style>
      .table-wrapper {
        overflow: auto;
        max-inline-size: 100%;
        max-block-size: min(560px, 80vh);
        container-type: inline-size;
      }

      .sync-data-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        --label-1: "Producto";
        --label-2: "Tienda";
        --label-3: "Formato";
        --label-4: "Precio Anterior";
        --label-5: "Precio Actual";
        --label-6: "Variación ($/kg y total)";
      }

      .sync-history-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        --label-1: "Corrida";
        --label-2: "Fecha";
        --label-3: "Hora";
        --label-4: "Duración";
        --label-5: "Estado";
        --label-6: "Conteos (Nuevos / Act. / Cambios)";
      }

      .sync-data-table thead,
      .sync-history-table thead {
        position: sticky;
        inset-block-start: 0;
        z-index: 1;
      }

      .sync-data-table tbody th,
      .sync-history-table tbody th {
        position: sticky;
        inset-inline-start: 0;
        background: #ffffff;
      }

      @container (width < 600px) {
        .sync-data-table,
        .sync-data-table thead,
        .sync-data-table tbody,
        .sync-data-table tr,
        .sync-data-table th,
        .sync-data-table td,
        .sync-history-table,
        .sync-history-table thead,
        .sync-history-table tbody,
        .sync-history-table tr,
        .sync-history-table th,
        .sync-history-table td {
          display: block;
        }

        .sync-data-table thead,
        .sync-history-table thead {
          display: none;
        }

        .sync-data-table tbody tr,
        .sync-history-table tbody tr {
          margin-block-end: 1rem;
          border: 1px solid #e7e5e4;
          border-radius: 0.75rem;
          overflow: hidden;
          background: #ffffff;
        }

        .sync-data-table tbody th,
        .sync-history-table tbody th {
          position: sticky;
          inset-block-start: 0;
          z-index: 2;
          background: #f5f5f4;
          border-bottom: 1px solid #e7e5e4;
        }

        .sync-data-table td,
        .sync-history-table td {
          display: flex;
          justify-content: space-between;
          align-items: center;
          gap: 0.75rem;
          text-align: right;
        }

        .sync-data-table td:nth-child(2)::before,
        .sync-history-table td:nth-child(2)::before {
          content: var(--label-2) ": " / var(--label-2);
          font-weight: 600;
          color: #57534e;
          text-align: left;
        }
        .sync-data-table td:nth-child(3)::before,
        .sync-history-table td:nth-child(3)::before {
          content: var(--label-3) ": " / var(--label-3);
          font-weight: 600;
          color: #57534e;
          text-align: left;
        }
        .sync-data-table td:nth-child(4)::before,
        .sync-history-table td:nth-child(4)::before {
          content: var(--label-4) ": " / var(--label-4);
          font-weight: 600;
          color: #57534e;
          text-align: left;
        }
        .sync-data-table td:nth-child(5)::before,
        .sync-history-table td:nth-child(5)::before {
          content: var(--label-5) ": " / var(--label-5);
          font-weight: 600;
          color: #57534e;
          text-align: left;
        }
        .sync-data-table td:nth-child(6)::before,
        .sync-history-table td:nth-child(6)::before {
          content: var(--label-6) ": " / var(--label-6);
          font-weight: 600;
          color: #57534e;
          text-align: left;
        }
      }
    </style>
  </Fragment>

  <div class="space-y-8" id="sync-analytics-root" data-fecha-sync={fechaSyncRaw}>
    <!-- BREADCRUMB -->
    <nav aria-label="Breadcrumbs" class="flex items-center gap-2 text-xs text-stone-500">
      <a href="/" class="hover:text-emerald-800 transition">Inicio</a>
      <span class="text-stone-300" aria-hidden="true">/</span>
      <span aria-current="page" class="font-semibold text-stone-800">Reporte de Sincronización y Analítica</span>
    </nav>

    <!-- CABECERA DE ESTADO Y TIMESTAMP -->
    <section aria-labelledby="sync-page-heading" class="rounded-3xl border border-stone-200/80 bg-white p-6 sm:p-8 shadow-2xs">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-2.5">
            <span
              id="sync-status-badge"
              class={`inline-flex items-center gap-2 rounded-full border px-3.5 py-1 text-xs font-bold ${
                isOk
                  ? 'border-emerald-200 bg-emerald-50 text-emerald-800'
                  : 'border-rose-200 bg-rose-50 text-rose-800'
              }`}
            >
              <span
                id="sync-status-dot"
                class={`h-2 w-2 rounded-full ${isOk ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500'}`}
              ></span>
              <span id="sync-status-text">{isOk ? 'Sincronizado' : 'Con Errores'}</span>
            </span>
            <span
              id="global-variation-pill"
              class="inline-flex items-center rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs font-semibold text-stone-600"
            >
              Variación global: {summary.porcentaje_variacion_global > 0 ? `+${summary.porcentaje_variacion_global}` : summary.porcentaje_variacion_global}%
            </span>
          </div>

          <h1 id="sync-page-heading" class="text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">
            Reporte de Sincronización y Analítica de Café de Especialidad
          </h1>
          <p class="text-xs sm:text-sm text-stone-500 max-w-3xl">
            Monitoreo en tiempo real de cambios de precio por kilo ($/kg), nuevos cafés ingresados al catálogo y desempeño del mercado en Chile.
          </p>
        </div>

        <div class="rounded-2xl border border-stone-200/80 bg-[#FCFBF7] px-5 py-4 lg:text-right shrink-0">
          <p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Última corrida exitosa</p>
          <p id="sync-timestamp-display" class="mt-1 text-sm sm:text-base font-bold text-stone-900">
            {fechaSyncLegible}
          </p>
        </div>
      </div>
    </section>

    <!-- TARJETAS RESUMEN (KPI CARDS) -->
    <section aria-labelledby="kpi-heading">
      <h2 id="kpi-heading" class="sr-only">Indicadores clave de sincronización</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- KPI 1: Productos Nuevos -->
        <article
          data-target-tab="novedades"
          class="kpi-interactive-card cursor-pointer rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs transition hover:-translate-y-0.5 hover:border-emerald-300"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-400">Productos Nuevos</p>
              <p id="kpi-nuevos-count" class="mt-2 text-3xl font-extrabold text-stone-900">{summary.total_nuevos}</p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-50 text-lg" aria-hidden="true">🆕</span>
          </div>
          <div class="mt-3 text-xs">
            <span id="kpi-nuevos-breakdown" class="inline-block rounded-full border border-sky-100 bg-sky-50 px-2.5 py-0.5 font-medium text-sky-800">
              Ver desglose de novedades →
            </span>
          </div>
        </article>

        <!-- KPI 2: Bajadas de Precio -->
        <article
          data-target-tab="variaciones"
          data-filter-type="BAJO"
          class="kpi-interactive-card cursor-pointer rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs transition hover:-translate-y-0.5 hover:border-emerald-300"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-400">Bajadas de Precio</p>
              <p id="kpi-bajadas-count" class="mt-2 text-3xl font-extrabold text-emerald-700">{summary.total_bajaron_precio}</p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-lg" aria-hidden="true">📉</span>
          </div>
          <div class="mt-3 text-xs">
            <span id="kpi-bajadas-ahorro" class="inline-block rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 font-semibold text-emerald-800">
              {summary.ahorro_total_clp > 0
                ? `Ahorro: ${formatCLP(summary.ahorro_total_clp)} (-${summary.porcentaje_ahorro_promedio}%)`
                : 'Ahorro: $0 CLP (0%)'}
            </span>
          </div>
        </article>

        <!-- KPI 3: Subidas de Precio -->
        <article
          data-target-tab="variaciones"
          data-filter-type="SUBIO"
          class="kpi-interactive-card cursor-pointer rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs transition hover:-translate-y-0.5 hover:border-rose-300"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-400">Subidas de Precio</p>
              <p id="kpi-subidas-count" class="mt-2 text-3xl font-extrabold text-rose-700">{summary.total_subieron_precio}</p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-lg" aria-hidden="true">📈</span>
          </div>
          <div class="mt-3 text-xs">
            <span id="kpi-subidas-alerta" class="inline-block rounded-full border border-rose-200 bg-rose-50 px-2.5 py-0.5 font-semibold text-rose-800">
              {summary.total_subieron_precio > 0
                ? `⚠️ ${summary.total_subieron_precio} alzas detectadas`
                : 'Sin alertas de alza'}
            </span>
          </div>
        </article>

        <!-- KPI 4: Total Ofertas Monitoreadas -->
        <article
          data-target-tab="historial"
          class="kpi-interactive-card cursor-pointer rounded-2xl border border-stone-200/80 bg-white p-5 shadow-2xs transition hover:-translate-y-0.5 hover:border-stone-300"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-stone-400">Total Ofertas Monitoreadas</p>
              <p id="kpi-ofertas-count" class="mt-2 text-3xl font-extrabold text-stone-900">{summary.total_ofertas_monitoreadas}</p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-lg" aria-hidden="true">☕</span>
          </div>
          <div class="mt-3 text-xs">
            <span id="kpi-productos-total" class="inline-block rounded-full bg-stone-100 px-2.5 py-0.5 font-medium text-stone-600">
              {summary.total_productos_catalogados} productos catalogados
            </span>
          </div>
        </article>
      </div>
    </section>

    <!-- CONTENIDO PRINCIPAL: TABS DE AUDITORÍA + ASIDE DE ANALÍTICA -->
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_380px] gap-8 items-start">
      <section aria-labelledby="audit-tabs-heading" class="rounded-3xl border border-stone-200/80 bg-white p-5 sm:p-6 shadow-2xs">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-stone-200 pb-4">
          <div>
            <h2 id="audit-tabs-heading" class="text-lg font-extrabold text-stone-900">Detalle de Auditoría de Catálogo</h2>
            <p class="text-xs text-stone-500">Variaciones de precio, novedades del catálogo e historial de corridas.</p>
          </div>

          <div role="tablist" aria-label="Secciones de auditoría" class="inline-flex flex-wrap rounded-2xl bg-stone-100 p-1 gap-1">
            <button
              type="button"
              role="tab"
              id="tab-btn-variaciones"
              aria-selected="true"
              aria-controls="panel-variaciones"
              data-tab="variaciones"
              class="sync-tab-btn rounded-xl bg-white px-3.5 py-2 text-xs font-bold text-stone-900 shadow-2xs transition"
            >
              Variaciones de Precio <span id="badge-count-variaciones" class="ml-1 rounded-full bg-stone-200 px-1.5 py-0.5 text-[10px]">{summary.cambios_precio.length}</span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-btn-novedades"
              aria-selected="false"
              aria-controls="panel-novedades"
              data-tab="novedades"
              class="sync-tab-btn rounded-xl px-3.5 py-2 text-xs font-bold text-stone-600 hover:text-stone-900 transition"
            >
              Novedades <span id="badge-count-novedades" class="ml-1 rounded-full bg-stone-200 px-1.5 py-0.5 text-[10px]">{summary.productos_nuevos.length}</span>
            </button>
            <button
              type="button"
              role="tab"
              id="tab-btn-historial"
              aria-selected="false"
              aria-controls="panel-historial"
              data-tab="historial"
              class="sync-tab-btn rounded-xl px-3.5 py-2 text-xs font-bold text-stone-600 hover:text-stone-900 transition"
            >
              Historial <span id="badge-count-historial" class="ml-1 rounded-full bg-stone-200 px-1.5 py-0.5 text-[10px]">{history.total_items}</span>
            </button>
          </div>
        </div>

        <!-- PANEL 1: VARIACIONES DE PRECIO -->
        <div id="panel-variaciones" role="tabpanel" aria-labelledby="tab-btn-variaciones" class="mt-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="inline-flex rounded-xl border border-stone-200 bg-stone-50 p-1 gap-1" role="group" aria-label="Filtrar variaciones">
              <button type="button" data-change-filter="ALL" class="filter-change-btn rounded-lg bg-stone-900 px-3 py-1 text-xs font-semibold text-white">
                Todos
              </button>
              <button type="button" data-change-filter="BAJO" class="filter-change-btn rounded-lg px-3 py-1 text-xs font-semibold text-emerald-800 hover:bg-emerald-50">
                📉 Solo Bajas
              </button>
              <button type="button" data-change-filter="SUBIO" class="filter-change-btn rounded-lg px-3 py-1 text-xs font-semibold text-rose-800 hover:bg-rose-50">
                📈 Solo Alzas
              </button>
            </div>

            <div class="relative w-full sm:w-64">
              <input
                type="search"
                id="search-price-changes"
                placeholder="Filtrar por café o tienda..."
                aria-label="Filtrar variaciones de precio"
                class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-1.5 text-xs text-stone-700 placeholder-stone-400 focus:bg-white focus:border-emerald-600 focus:outline-none"
              />
            </div>
          </div>

          <div class="table-wrapper rounded-2xl border border-stone-200/80">
            <table class="sync-data-table text-left text-xs">
              <thead class="bg-stone-100/95 text-[11px] font-bold uppercase tracking-wider text-stone-500">
                <tr>
                  <th scope="col" class="px-4 py-3">Producto</th>
                  <th scope="col" class="px-4 py-3">Tienda</th>
                  <th scope="col" class="px-4 py-3">Formato</th>
                  <th scope="col" class="px-4 py-3 text-right">Precio Anterior</th>
                  <th scope="col" class="px-4 py-3 text-right">Precio Actual</th>
                  <th scope="col" class="px-4 py-3 text-right">Variación ($/kg y total)</th>
                </tr>
              </thead>
              <tbody id="price-changes-tbody" class="divide-y divide-stone-200/70">
                {summary.cambios_precio.length === 0 ? (
                  <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-xs text-stone-400">
                      No se registraron variaciones de precio en la última sincronización.
                    </td>
                  </tr>
                ) : (
                  summary.cambios_precio.map((item) => {
                    const isDrop = item.tipo_cambio === 'BAJO';
                    const rowTone = isDrop ? 'bg-emerald-50/40 hover:bg-emerald-50/80' : 'bg-rose-50/40 hover:bg-rose-50/80';
                    const badgeTone = isDrop
                      ? 'border-emerald-200 bg-emerald-100/90 text-emerald-900'
                      : 'border-rose-200 bg-rose-100/90 text-rose-900';
                    const sign = item.diferencia_clp > 0 ? '+' : '';
                    const pctSign = item.porcentaje_variacion > 0 ? '+' : '';
                    const kiloSign = item.diferencia_kilo_clp > 0 ? '+' : '';
                    return (
                      <tr
                        class={`${rowTone} transition price-change-row`}
                        data-tipo={item.tipo_cambio}
                        data-search={`${item.nombre} ${item.tienda}`.toLowerCase()}
                      >
                        <th scope="row" class="px-4 py-3 font-bold text-stone-900">
                          <div class="flex items-center gap-2">
                            <a href={`/product/${item.id}`} class="hover:text-emerald-800 hover:underline" title="Ver ficha técnica en Cafesitios">
                              {item.nombre}
                            </a>
                            {item.url_detalle && (
                              <a 
                                href={item.url_detalle} 
                                target="_blank" 
                                rel="noopener noreferrer" 
                                class="text-stone-400 hover:text-emerald-700 text-xs shrink-0 transition" 
                                title="Saltar a la tienda oficial de origen"
                              >
                                ↗
                              </a>
                            )}
                          </div>
                        </th>
                        <td class="px-4 py-3 text-stone-600 font-medium">{item.tienda}</td>
                        <td class="px-4 py-3 text-stone-500">{item.formato || `${item.formato_gramos}g`}</td>
                        <td class="px-4 py-3 text-right text-stone-400 line-through">{formatCLP(item.precio_anterior)}</td>
                        <td class="px-4 py-3 text-right font-bold text-stone-900">{formatCLP(item.precio_nuevo)}</td>
                        <td class="px-4 py-3 text-right">
                          <div class="inline-flex flex-col items-end gap-0.5">
                            <span class={`inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${badgeTone}`}>
                              <span aria-hidden="true">{isDrop ? '📉' : '📈'}</span>
                              <span>{sign}{formatCLP(item.diferencia_clp)} ({pctSign}{item.porcentaje_variacion}%)</span>
                            </span>
                            <span class="text-[10px] text-stone-500">
                              {kiloSign}{formatCLP(item.diferencia_kilo_clp)}/kg (Actual: {formatCLP(item.precio_kilo_nuevo)}/kg)
                            </span>
                          </div>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- PANEL 2: NOVEDADES -->
        <div id="panel-novedades" role="tabpanel" aria-labelledby="tab-btn-novedades" class="hidden mt-5 space-y-4">
          <div id="new-products-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {summary.productos_nuevos.length === 0 ? (
              <div class="col-span-full rounded-2xl border border-stone-200 bg-stone-50 p-8 text-center text-xs text-stone-400">
                No se detectaron productos nuevos en la última corrida de sincronización.
              </div>
            ) : (
              summary.productos_nuevos.map((prod) => (
                <article class="flex flex-col justify-between rounded-2xl border border-stone-200/90 bg-[#FCFBF7] p-4 shadow-2xs transition hover:border-emerald-300">
                  <div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-800">{prod.tienda}</span>
                      <span class="inline-flex items-center gap-1 rounded-full border border-sky-200 bg-sky-50 px-2.5 py-0.5 text-[10px] font-bold text-sky-900">
                        🆕 Nuevo
                      </span>
                    </div>
                    <h3 class="mt-1.5 text-sm font-bold text-stone-900">
                      <a href={`/product/${prod.id}`} class="hover:text-emerald-800 hover:underline" title="Ver ficha técnica en Cafesitios">
                        {prod.nombre}
                      </a>
                    </h3>
                    <div class="mt-2 flex flex-wrap gap-1.5 text-[11px] text-stone-600">
                      {prod.origen && <span class="rounded-md bg-white border border-stone-200 px-2 py-0.5">🌍 {prod.origen}</span>}
                      {prod.proceso && <span class="rounded-md bg-white border border-stone-200 px-2 py-0.5">⚙️ {prod.proceso}</span>}
                      {prod.tueste && <span class="rounded-md bg-white border border-stone-200 px-2 py-0.5">🔥 {prod.tueste}</span>}
                      <span class="rounded-md bg-white border border-stone-200 px-2 py-0.5">⚖️ {prod.formato || `${prod.formato_gramos}g`}</span>
                    </div>
                  </div>
                  <div>
                    <div class="mt-4 flex items-baseline justify-between border-t border-stone-200/70 pt-3">
                      <div>
                        <span class="text-xs text-stone-400">Precio bolsa:</span>
                        <span class="ml-1 text-sm font-extrabold text-stone-900">{formatCLP(prod.precio_clp)}</span>
                      </div>
                      <span class="text-xs font-bold text-emerald-800">{formatCLP(prod.precio_por_kilo)} / kg</span>
                    </div>
                    <div class="mt-3 flex items-center justify-between gap-2 border-t border-stone-100 pt-2.5 text-xs">
                      <a 
                        href={`/product/${prod.id}`} 
                        class="inline-flex items-center gap-1.5 font-bold text-emerald-800 hover:text-emerald-950 bg-emerald-50 hover:bg-emerald-100/90 border border-emerald-200/60 px-2.5 py-1 rounded-lg transition"
                        title="Ver detalles en Cafesitios"
                      >
                        <span>☕ Ver en Catálogo</span>
                      </a>
                      {prod.url_detalle && (
                        <a 
                          href={prod.url_detalle} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center gap-1 font-medium text-stone-500 hover:text-stone-800 hover:underline px-1 py-0.5"
                          title="Saltar a la tienda oficial de origen"
                        >
                          <span>Tienda origen</span>
                          <span class="text-[10px]">↗</span>
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))
            )}
          </div>
        </div>

        <!-- PANEL 3: HISTORIAL DE SINCRONIZACIONES -->
        <div id="panel-historial" role="tabpanel" aria-labelledby="tab-btn-historial" class="hidden mt-5 space-y-4">
          <div class="table-wrapper rounded-2xl border border-stone-200/80">
            <table class="sync-history-table text-left text-xs">
              <thead class="bg-stone-100/95 text-[11px] font-bold uppercase tracking-wider text-stone-500">
                <tr>
                  <th scope="col" class="px-4 py-3">Corrida</th>
                  <th scope="col" class="px-4 py-3">Fecha</th>
                  <th scope="col" class="px-4 py-3">Hora</th>
                  <th scope="col" class="px-4 py-3">Duración</th>
                  <th scope="col" class="px-4 py-3">Estado</th>
                  <th scope="col" class="px-4 py-3 text-right">Resultado (Nuevos / Act. / Cambios)</th>
                </tr>
              </thead>
              <tbody id="sync-history-tbody" class="divide-y divide-stone-200/70">
                {history.items.length === 0 ? (
                  <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-xs text-stone-400">
                      Aún no hay corridas registradas en el historial.
                    </td>
                  </tr>
                ) : (
                  history.items.map((log) => {
                    const logOk = (log.estado || '').toUpperCase() === 'OK';
                    return (
                      <tr class="hover:bg-stone-50 transition">
                        <th scope="row" class="px-4 py-3 font-bold text-stone-900">#{log.id}</th>
                        <td class="px-4 py-3 text-stone-700">{log.fecha}</td>
                        <td class="px-4 py-3 text-stone-500 font-mono">{log.hora} hrs</td>
                        <td class="px-4 py-3 text-stone-600">{log.duracion_estimada}</td>
                        <td class="px-4 py-3">
                          <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-[11px] font-bold ${logOk ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : 'border-rose-200 bg-rose-50 text-rose-800'}`}>
                            {log.estado}
                          </span>
                          {log.mensaje_error && <p class="mt-1 text-[10px] text-rose-600">{log.mensaje_error}</p>}
                        </td>
                        <td class="px-4 py-3 text-right font-medium text-stone-700">
                          <span class="inline-block rounded-md bg-sky-50 px-2 py-0.5 text-sky-900">🆕 {log.productos_nuevos}</span>
                          <span class="inline-block rounded-md bg-stone-100 px-2 py-0.5 text-stone-700 ml-1">🔄 {log.productos_actualizados}</span>
                          <span class="inline-block rounded-md bg-amber-50 px-2 py-0.5 text-amber-900 ml-1">🏷️ {log.productos_con_cambio_precio}</span>
                        </td>
                      </tr>
                    );
                  })
                )}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- BLOQUE ANALÍTICO ADICIONAL -->
      <aside aria-labelledby="market-analytics-heading" class="space-y-6">
        <section class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-2xs space-y-5">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-700">Inteligencia de Mercado</span>
            <h2 id="market-analytics-heading" class="mt-0.5 text-lg font-extrabold text-stone-900">
              Referencia de Precios ($/kg)
            </h2>
          </div>

          <div class="rounded-2xl bg-emerald-950 p-5 text-white">
            <p class="text-xs font-medium text-emerald-200">Precio Promedio General por Kilo</p>
            <p id="market-avg-kilo" class="mt-1 text-3xl font-extrabold tracking-tight">
              {formatCLP(market.precio_promedio_kilo)} / kg
            </p>
            <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-emerald-800/80 pt-3 text-[11px] text-emerald-100">
              <span>Mín: {formatCLP(market.precio_minimo_kilo)}/kg</span>
              <span>Máx: {formatCLP(market.precio_maximo_kilo)}/kg</span>
              <span>Bolsa prom: {formatCLP(market.precio_promedio_bolsa_clp)}</span>
            </div>
          </div>

          <div class="rounded-2xl border border-amber-200/80 bg-amber-50/60 p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-amber-800">🏆 Tienda con Mejor Descuento Promedio</p>
            <p id="market-best-discount-store" class="mt-1 text-base font-extrabold text-stone-900">
              {market.tienda_mejor_descuento?.nombre || 'Sin ofertas activas'}
            </p>
            <p id="market-best-discount-meta" class="mt-0.5 text-xs text-stone-600">
              {market.tienda_mejor_descuento?.descuento_promedio_porcentaje > 0
                ? `Descuento promedio: ${market.tienda_mejor_descuento.descuento_promedio_porcentaje}% (${market.tienda_mejor_descuento.total_ofertas_descuento} ofertas)`
                : `Promedio por kilo: ${formatCLP(market.tienda_mejor_descuento?.precio_promedio_kilo)}/kg`}
            </p>
          </div>

          <div class="space-y-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-stone-400">Tiendas más competitivas ($/kg)</h3>
            <div id="market-competitive-stores" class="space-y-2">
              {market.tiendas_mas_competitivas.slice(0, 5).map((st, idx) => (
                <div class="flex items-center justify-between rounded-xl border border-stone-200/80 bg-[#FCFBF7] px-3.5 py-2.5 text-xs">
                  <div class="flex items-center gap-2">
                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-stone-200 text-[10px] font-bold text-stone-700">
                      {idx + 1}
                    </span>
                    <div>
                      <p class="font-bold text-stone-900">{st.nombre}</p>
                      <p class="text-[10px] text-stone-500">{st.cantidad_productos} cafés activos</p>
                    </div>
                  </div>
                  <div class="text-right">
                    <p class="font-extrabold text-emerald-800">{formatCLP(st.precio_promedio_kilo)}/kg</p>
                    {st.descuento_promedio_porcentaje > 0 && (
                      <p class="text-[10px] font-semibold text-amber-700">-{st.descuento_promedio_porcentaje}% dto.</p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- DISTRIBUCIÓN POR PROCESO Y TUESTE -->
        <section aria-labelledby="distribution-heading" class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-2xs space-y-5">
          <h2 id="distribution-heading" class="text-base font-extrabold text-stone-900">
            Distribución por Proceso y Tueste
          </h2>

          <div class="space-y-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-stone-400">Por Proceso de Beneficio</h3>
            <div class="space-y-2.5">
              {market.distribucion_proceso.slice(0, 6).map((item) => (
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-stone-800">{item.categoria}</span>
                    <span class="text-stone-500">{item.cantidad} ({item.porcentaje}%) &bull; {formatCLP(item.precio_promedio_kilo)}/kg</span>
                  </div>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-stone-100">
                    <div class="h-full rounded-full bg-emerald-700" style={`width: ${Math.min(100, Math.max(4, item.porcentaje))}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="border-t border-stone-200 pt-4 space-y-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-stone-400">Por Nivel de Tueste</h3>
            <div class="space-y-2.5">
              {market.distribucion_tueste.slice(0, 6).map((item) => (
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-stone-800">{item.categoria}</span>
                    <span class="text-stone-500">{item.cantidad} ({item.porcentaje}%) &bull; {formatCLP(item.precio_promedio_kilo)}/kg</span>
                  </div>
                  <div class="h-2 w-full overflow-hidden rounded-full bg-stone-100">
                    <div class="h-full rounded-full bg-emerald-700" style={`width: ${Math.min(100, Math.max(4, item.porcentaje))}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const root = document.getElementById('sync-analytics-root');
    const fechaSync = root ? root.getAttribute('data-fecha-sync') : '';

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'ver_reporte_sincronizacion',
      fecha_sync: fechaSync || new Date().toISOString()
    });

    function activateTab(tabName) {
      ['variaciones', 'novedades', 'historial'].forEach((name) => {
        const btn = document.getElementById('tab-btn-' + name);
        const panel = document.getElementById('panel-' + name);
        const isActive = name === tabName;
        if (btn) {
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          btn.className = isActive
            ? 'sync-tab-btn rounded-xl bg-white px-3.5 py-2 text-xs font-bold text-stone-900 shadow-2xs transition'
            : 'sync-tab-btn rounded-xl px-3.5 py-2 text-xs font-bold text-stone-600 hover:text-stone-900 transition';
        }
        if (panel) {
          panel.classList.toggle('hidden', !isActive);
        }
      });
    }

    let currentFilter = 'ALL';
    let currentSearch = '';

    function filterPriceRows() {
      const rows = document.querySelectorAll('.price-change-row');
      rows.forEach((row) => {
        const tipo = row.getAttribute('data-tipo') || '';
        const text = row.getAttribute('data-search') || '';
        const matchesType = currentFilter === 'ALL' || tipo === currentFilter;
        const matchesSearch = !currentSearch || text.includes(currentSearch);
        row.style.display = matchesType && matchesSearch ? '' : 'none';
      });
    }

    document.querySelectorAll('.sync-tab-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        activateTab(btn.getAttribute('data-tab'));
      });
    });

    document.querySelectorAll('.kpi-interactive-card').forEach((card) => {
      card.addEventListener('click', () => {
        const targetTab = card.getAttribute('data-target-tab');
        const filterType = card.getAttribute('data-filter-type');
        if (targetTab) activateTab(targetTab);
        if (filterType) {
          currentFilter = filterType;
          filterPriceRows();
        }
      });
    });

    document.querySelectorAll('.filter-change-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.getAttribute('data-change-filter') || 'ALL';
        document.querySelectorAll('.filter-change-btn').forEach((b) => {
          b.className = b === btn
            ? 'filter-change-btn rounded-lg bg-stone-900 px-3 py-1 text-xs font-semibold text-white'
            : 'filter-change-btn rounded-lg px-3 py-1 text-xs font-semibold text-stone-700 hover:bg-stone-200/60';
        });
        filterPriceRows();
      });
    });

    const searchInput = document.getElementById('search-price-changes');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = (e.target.value || '').toLowerCase().trim();
        filterPriceRows();
      });
    }
  })();

  if (typeof window !== 'undefined') {
    const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || window.location.hostname.endsWith('.local');
    if (!isLocalhost) {
      window.location.replace('/');
    }
  }
</script>
