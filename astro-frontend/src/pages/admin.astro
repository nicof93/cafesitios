---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Environment } from '../core/infrastructure/config/Environment';

if (!Environment.isLocalAdminEnabled(Astro.url)) {
  return Astro.redirect('/');
}

const apiBaseUrl = Environment.getApiBaseUrl();
---

<BaseLayout 
  title="Panel de Administración Local | Cafesitios"
  description="Gestión local de tostadurías, sucursales, prueba de drivers de catálogos y moderación de productos no-café."
  canonicalUrl="http://localhost:3000/admin"
  noindex={true}
>
  <main class="min-h-screen bg-stone-50/60 pb-20 pt-8" data-api-base={apiBaseUrl}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- BREADCRUMB / RETORNO RÁPIDO Y ACCESO A ADMIN GENERAL -->
      <nav class="mb-4 flex flex-wrap items-center justify-between gap-3 text-xs text-stone-500" aria-label="Ruta de navegación">
        <div class="flex items-center gap-2">
          <a href="/" class="hover:text-emerald-800 transition flex items-center gap-1 font-medium">
            <span>←</span>
            <span>Volver al Catálogo</span>
          </a>
          <span class="text-stone-300">/</span>
          <span class="font-semibold text-stone-800">Admin Local</span>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="/admin-tienda/dashboard" 
            class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-900 shadow-2xs hover:bg-emerald-100 transition focus:outline-none focus:ring-2 focus:ring-emerald-600"
            title="Ir al Portal de Administración General de Tiendas (Multi-Inquilino)"
          >
            <span>🏪</span>
            <span>Administración General de Tiendas</span>
            <span aria-hidden="true">➔</span>
          </a>
        </div>
      </nav>

      <!-- CABECERA -->
      <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-stone-200 pb-6">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-0.5 text-xs font-semibold text-amber-900 border border-amber-300">
              <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
              Entorno Local Exclusivo (Localhost)
            </span>
          </div>
          <h1 class="mt-2 text-2xl sm:text-3xl font-extrabold tracking-tight text-stone-900">
            Administración de Tiendas y Moderación
          </h1>
          <p class="mt-1 text-sm text-stone-600 max-w-2xl">
            Registra tostadurías, valida la legibilidad de catálogos con sus drivers nativos, exporta configuraciones para Supabase/producción y modera productos no-café (poleras, imanes, relojes).
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <a
            href="/admin-tienda/dashboard"
            class="inline-flex items-center gap-1.5 rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-xs font-bold text-stone-800 shadow-xs hover:bg-stone-50 hover:border-stone-400 transition focus:outline-none focus:ring-2 focus:ring-stone-400"
            title="Ir a la Administración General de Tiendas (Portal Multi-Inquilino)"
          >
            <span>🏪</span>
            <span>Admin General Tiendas</span>
            <span class="text-stone-400">➔</span>
          </a>
          <button
            type="button"
            id="btn-sync-unsynced"
            class="inline-flex items-center gap-1.5 rounded-xl border border-amber-300 bg-amber-50 px-3.5 py-2 text-xs font-bold text-amber-900 shadow-xs hover:bg-amber-100 transition focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-50 disabled:pointer-events-none"
            title="Sincronizar tiendas sin catálogo o pendientes"
          >
            <span>⚡</span>
            <span>Sincronizar Pendientes</span>
            <span id="badge-unsynced-count" class="rounded-full bg-amber-200 px-1.5 py-0.2 text-[10px] font-bold text-amber-900 ml-0.5">0</span>
          </button>
          <button
            type="button"
            id="btn-sync-all"
            class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-300 bg-emerald-50 px-3.5 py-2 text-xs font-bold text-emerald-900 shadow-xs hover:bg-emerald-100 transition focus:outline-none focus:ring-2 focus:ring-emerald-500 disabled:opacity-50"
            title="Iniciar sincronización masiva de todas las tiendas activas"
          >
            <span>🔄</span>
            <span>Sincronización Masiva</span>
          </button>
          <button
            type="button"
            id="btn-export-stores"
            class="inline-flex items-center gap-2 rounded-xl bg-stone-900 px-4 py-2 text-xs font-bold text-white shadow-xs hover:bg-stone-800 transition focus:outline-none focus:ring-2 focus:ring-stone-600"
          >
            <span>📦</span>
            <span>Exportar Tiendas (JSON / SQL)</span>
          </button>
        </div>
      </div>

      <!-- TABS NAVEGACIÓN -->
      <div class="mb-8 flex items-center justify-between border-b border-stone-200">
        <div class="flex">
          <button
            type="button"
            id="tab-btn-stores"
            class="tab-btn active border-b-2 border-emerald-700 pb-3 px-4 text-sm font-bold text-emerald-900 flex items-center gap-2"
          >
            <span>🏪</span>
            <span>Tostadurías y Sucursales</span>
          </button>
          <button
            type="button"
            id="tab-btn-moderation"
            class="tab-btn border-b-2 border-transparent pb-3 px-4 text-sm font-semibold text-stone-500 hover:text-stone-900 flex items-center gap-2 transition"
          >
            <span>🛡️</span>
            <span>Moderación de Catálogo (Ocultar No-Cafés)</span>
            <span id="badge-total-suspected" class="rounded-full bg-rose-100 text-rose-800 px-2 py-0.5 text-[10px] font-bold">0</span>
          </button>
        </div>
        <div class="hidden sm:block pb-2">
          <a
            href="/admin-tienda/dashboard"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-800 hover:text-emerald-950 hover:underline transition"
            title="Ir al Portal de Administración General de Tiendas (Multi-Inquilino)"
          >
            <span>Ir a Portal General de Tiendas ➔</span>
          </a>
        </div>
      </div>

      <!-- TAB 1: GESTIÓN DE TIENDAS Y TEST DE CATÁLOGO -->
      <div id="tab-content-stores" class="space-y-8">
        
        <!-- FORMULARIO DE INGRESO -->
        <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 shadow-xs">
          <h2 class="text-lg font-bold text-stone-900 flex items-center gap-2">
            <span>➕</span>
            <span id="form-title">Registrar Nueva Tostaduría / Tienda</span>
          </h2>
          <p class="mt-1 text-xs text-stone-500">
            Ingresa los datos del ecommerce y sus sucursales físicas. Puedes probar la lectura del catálogo en vivo antes de guardar.
          </p>

          <form id="form-store" class="mt-6 space-y-6">
            <input type="hidden" id="store-id" value="" />

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <label for="store-name" class="block text-xs font-bold text-stone-700">Nombre de la Tienda *</label>
                <input
                  type="text"
                  id="store-name"
                  required
                  placeholder="Ej. Tostaduría Singular"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                />
              </div>

              <div>
                <label for="store-platform" class="block text-xs font-bold text-stone-700">Plataforma Ecommerce *</label>
                <select
                  id="store-platform"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                >
                  <option value="woocommerce">WooCommerce (Store API / Products)</option>
                  <option value="shopify">Shopify (products.json)</option>
                  <option value="auto">Detección Automática</option>
                  <option value="desconocida">Otra / Personalizada</option>
                </select>
              </div>

              <div class="sm:col-span-2 lg:col-span-1">
                <label for="store-url" class="block text-xs font-bold text-stone-700">URL del Catálogo *</label>
                <input
                  type="url"
                  id="store-url"
                  required
                  placeholder="https://tienda.cl/collections/cafe o https://tienda.cl/tienda"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                />
                <p class="mt-1 text-[11px] text-stone-400">El sitio oficial raíz (sin paths) se extraerá automáticamente.</p>
              </div>

              <div>
                <label for="store-address" class="block text-xs font-bold text-stone-700">Dirección Principal</label>
                <input
                  type="text"
                  id="store-address"
                  placeholder="Ej. Av. Providencia 1234"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                />
              </div>

              <div>
                <label for="store-comuna" class="block text-xs font-bold text-stone-700">Comuna Principal</label>
                <input
                  type="text"
                  id="store-comuna"
                  placeholder="Ej. Providencia, Santiago"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                />
              </div>

              <div>
                <label for="store-admin-email" class="block text-xs font-bold text-stone-700">Email Administrador de Tienda</label>
                <input
                  type="email"
                  id="store-admin-email"
                  placeholder="admin@tostaduria.cl (para login multi-inquilino)"
                  class="mt-1.5 block w-full rounded-xl border border-stone-300 px-3.5 py-2 text-sm text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600"
                />
                <p class="mt-1 text-[11px] text-stone-400">Permite al encargado ingresar al portal /admin-tienda.</p>
              </div>

              <div class="flex items-center gap-4 pt-6">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="store-active" checked class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500" />
                  <span class="text-xs font-semibold text-stone-700">Tienda Activa en Scraping</span>
                </label>
              </div>
            </div>

            <!-- GESTOR DINÁMICO DE SUCURSALES -->
            <div class="rounded-xl border border-stone-200 bg-stone-50/70 p-4">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-stone-700">Sucursales Físicas de la Tienda</h3>
                  <p class="text-[11px] text-stone-500">Agrega locales para el cálculo de cercanía y catálogo físico.</p>
                </div>
                <button
                  type="button"
                  id="btn-add-branch"
                  class="inline-flex items-center gap-1 rounded-lg bg-stone-200 px-2.5 py-1 text-xs font-semibold text-stone-800 hover:bg-stone-300 transition"
                >
                  <span>+</span>
                  <span>Agregar Sucursal</span>
                </button>
              </div>

              <div id="branches-list" class="mt-3 space-y-2">
                <!-- Se inyectan filas de sucursales dinámicamente -->
              </div>
            </div>

            <!-- BOTONES DE ACCIÓN: TEST Y GUARDAR -->
            <div class="flex flex-wrap items-center justify-between gap-4 border-t border-stone-100 pt-5">
              <div class="flex flex-wrap items-center gap-4">
                <button
                  type="button"
                  id="btn-test-catalog"
                  class="inline-flex items-center gap-2 rounded-xl border border-emerald-300 bg-emerald-50/80 px-4 py-2 text-xs font-bold text-emerald-900 hover:bg-emerald-100 transition focus:outline-none focus:ring-2 focus:ring-emerald-500"
                >
                  <span>🔍</span>
                  <span>Probar Catálogo (Obtener 1er Producto)</span>
                </button>
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-stone-700 cursor-pointer select-none">
                  <input
                    type="checkbox"
                    id="store-sync-immediate"
                    checked
                    class="h-4 w-4 rounded border-stone-300 text-emerald-600 focus:ring-emerald-500"
                  />
                  <span>Sincronizar catálogo inmediatamente tras guardar</span>
                </label>
              </div>

              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="btn-reset-form"
                  class="rounded-xl border border-stone-300 px-4 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 transition"
                >
                  Cancelar / Limpiar
                </button>
                <button
                  type="submit"
                  id="btn-submit-store"
                  class="rounded-xl bg-emerald-700 px-5 py-2 text-xs font-bold text-white shadow-sm hover:bg-emerald-800 transition focus:outline-none focus:ring-2 focus:ring-emerald-600"
                >
                  Guardar Tostaduría
                </button>
              </div>
            </div>
          </form>

          <!-- RESULTADO EN VIVO DE LA PRUEBA DE CATÁLOGO -->
          <div id="catalog-test-result" class="mt-6 hidden">
            <!-- Inyectado por JS -->
          </div>
        </div>

        <!-- LISTADO DE TIENDAS REGISTRADAS -->
        <div class="rounded-2xl border border-stone-200 bg-white p-6 sm:p-8 shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
            <div>
              <h2 class="text-lg font-bold text-stone-900 flex items-center gap-2">
                <span>📋</span>
                <span>Tostadurías Registradas en Base de Datos</span>
              </h2>
              <p class="text-xs text-stone-500">Tiendas activas e inactivas configuradas en el sistema.</p>
            </div>
            <div class="flex items-center gap-2">
              <span id="stores-synced-badge" class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">0 Sincronizadas</span>
              <span id="stores-count-badge" class="rounded-full bg-stone-100 px-2.5 py-0.5 text-xs font-semibold text-stone-700">0 Tiendas</span>
            </div>
          </div>

          <!-- BUSCADOR DE TIENDAS Y FILTROS -->
          <div class="mb-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-stone-50 p-3 rounded-xl border border-stone-200">
            <div class="relative w-full sm:max-w-md">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-stone-400">🔍</span>
              <input
                type="text"
                id="store-search-input"
                placeholder="Buscar tostaduría por nombre, plataforma, URL o comuna..."
                class="block w-full rounded-lg border border-stone-300 pl-9 pr-8 py-2 text-xs text-stone-900 focus:border-emerald-600 focus:outline-none focus:ring-1 focus:ring-emerald-600 bg-white"
              />
              <button
                type="button"
                id="btn-clear-store-search"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 hidden text-xs font-bold"
                title="Limpiar búsqueda"
              >✕</button>
            </div>
            <div class="flex items-center justify-between sm:justify-end gap-3 text-xs text-stone-600">
              <span id="stores-search-count" class="font-semibold text-stone-700">Mostrando 0 tiendas</span>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs text-stone-600">
              <thead class="bg-stone-100 text-stone-800 font-bold uppercase tracking-wider">
                <tr>
                  <th class="px-4 py-3">Tienda</th>
                  <th class="px-4 py-3">Plataforma</th>
                  <th class="px-4 py-3">Sitio Oficial / Catálogo</th>
                  <th class="px-4 py-3">Comuna / Dirección</th>
                  <th class="px-4 py-3 text-center">Sucursales</th>
                  <th class="px-4 py-3 text-center">Productos / Sincronización</th>
                  <th class="px-4 py-3 text-center">Acciones</th>
                </tr>
              </thead>
              <tbody id="stores-table-body" class="divide-y divide-stone-100 font-medium">
                <tr>
                  <td colspan="7" class="py-8 text-center text-stone-400">Cargando tiendas...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 2: MODERACIÓN DE CATÁLOGO (OCULTAR NO-CAFÉS) -->
      <div id="tab-content-moderation" class="hidden space-y-8">
        
        <!-- KPIS Y RESUMEN DE MODERACIÓN -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-rose-200 bg-rose-50/50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-rose-800">Sospechosos No-Café</p>
            <p id="kpi-suspected" class="mt-2 text-3xl font-extrabold text-rose-900">0</p>
            <p class="mt-1 text-[11px] text-rose-700">Poleras, imanes, relojes, tazas y accesorios detectados.</p>
          </div>
          <div class="rounded-2xl border border-amber-200 bg-amber-50/50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-800">Ocultos del Catálogo</p>
            <p id="kpi-hidden" class="mt-2 text-3xl font-extrabold text-amber-900">0</p>
            <p class="mt-1 text-[11px] text-amber-700">Productos deshabilitados para no aparecer en comparador ni filtros.</p>
          </div>
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/50 p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-emerald-800">Cafés Legítimos Visibles</p>
            <p id="kpi-visible" class="mt-2 text-3xl font-extrabold text-emerald-900">0</p>
            <p class="mt-1 text-[11px] text-emerald-700">Productos de especialidad activos en la vista pública.</p>
          </div>
        </div>

        <!-- FILTROS Y ACCIÓN MASIVA -->
        <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-xs">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
            
            <div class="flex flex-wrap items-center gap-3">
              <div class="flex rounded-xl bg-stone-100 p-1 text-xs font-semibold">
                <button type="button" class="mod-filter-btn active rounded-lg bg-stone-900 px-3 py-1.5 text-white" data-mode="suspected">
                  Sospechosos No-Café
                </button>
                <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="hidden">
                  Ocultos
                </button>
                <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="visible">
                  Visibles
                </button>
                <button type="button" class="mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900" data-mode="all">
                  Todos
                </button>
              </div>

              <select
                id="mod-store-filter"
                class="rounded-xl border border-stone-300 px-3 py-1.5 text-xs text-stone-800 focus:border-emerald-600 focus:outline-none"
              >
                <option value="">Todas las tiendas</option>
              </select>

              <input
                type="text"
                id="mod-search-input"
                placeholder="Buscar por nombre..."
                class="rounded-xl border border-stone-300 px-3.5 py-1.5 text-xs text-stone-800 focus:border-emerald-600 focus:outline-none"
              />
            </div>

            <button
              type="button"
              id="btn-bulk-hide-suspected"
              class="inline-flex items-center gap-1.5 rounded-xl bg-rose-600 px-4 py-2 text-xs font-bold text-white hover:bg-rose-700 transition shadow-xs"
            >
              <span>🚫</span>
              <span>Ocultar Todos los Sospechosos Filtrados</span>
            </button>
          </div>

          <!-- TABLA DE PRODUCTOS PARA MODERACIÓN -->
          <div class="mt-6 overflow-x-auto">
            <table class="w-full text-left text-xs text-stone-600">
              <thead class="bg-stone-100 text-stone-800 font-bold uppercase tracking-wider">
                <tr>
                  <th class="px-4 py-3">Producto</th>
                  <th class="px-4 py-3">Tienda</th>
                  <th class="px-4 py-3">Precio / Kilo</th>
                  <th class="px-4 py-3">Motivo de Sospecha</th>
                  <th class="px-4 py-3 text-center">Estado</th>
                  <th class="px-4 py-3 text-center">Acción</th>
                </tr>
              </thead>
              <tbody id="moderation-table-body" class="divide-y divide-stone-100 font-medium">
                <tr>
                  <td colspan="6" class="py-8 text-center text-stone-400">Cargando productos de moderación...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>

    <!-- MODAL DE EXPORTACIÓN (JSON / SQL) -->
    <div id="modal-export" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-3xl rounded-2xl bg-white p-6 sm:p-8 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-stone-200 pb-4">
          <div>
            <h3 class="text-base font-bold text-stone-900">Exportar Tiendas y Sucursales a Producción</h3>
            <p class="text-xs text-stone-500">Ejecuta el script SQL en el Editor SQL de Supabase o importa el JSON.</p>
          </div>
          <button type="button" id="btn-close-export-modal" class="text-stone-400 hover:text-stone-600 text-lg font-bold">✕</button>
        </div>

        <div class="flex items-center gap-2 border-b border-stone-200 pb-2 text-xs font-semibold">
          <button type="button" id="tab-export-sql" class="export-tab active text-emerald-800 border-b-2 border-emerald-700 pb-1">SQL Script (Supabase)</button>
          <button type="button" id="tab-export-json" class="export-tab text-stone-500 pb-1 hover:text-stone-900">JSON Completo</button>
        </div>

        <textarea
          id="export-content-area"
          readonly
          rows="14"
          class="w-full rounded-xl border border-stone-300 bg-stone-900 p-4 font-mono text-xs text-emerald-400 focus:outline-none"
        ></textarea>

        <div class="flex items-center justify-between pt-2">
          <span id="export-summary-text" class="text-xs text-stone-500">0 tiendas exportadas</span>
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="btn-copy-export"
              class="rounded-xl border border-stone-300 bg-white px-4 py-2 text-xs font-bold text-stone-800 hover:bg-stone-50 transition"
            >
              📋 Copiar al Portapapeles
            </button>
            <button
              type="button"
              id="btn-download-export"
              class="rounded-xl bg-emerald-700 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-800 transition"
            >
              💾 Descargar Archivo
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL DE RESULTADOS DE SINCRONIZACIÓN -->
    <div id="modal-sync-results" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-xs p-4">
      <div class="w-full max-w-2xl rounded-2xl bg-white p-6 sm:p-8 shadow-2xl space-y-4 max-h-[90vh] flex flex-col">
        <div class="flex items-center justify-between border-b border-stone-200 pb-4">
          <div>
            <h3 class="text-base font-bold text-stone-900" id="sync-modal-title">Resultado de Sincronización</h3>
            <p class="text-xs text-stone-500" id="sync-modal-subtitle">Detalle de procesamiento de catálogos</p>
          </div>
          <button type="button" id="btn-close-sync-modal" class="text-stone-400 hover:text-stone-600 text-lg font-bold">✕</button>
        </div>

        <div id="sync-modal-summary" class="p-4 rounded-xl bg-stone-50 border border-stone-200 text-xs text-stone-700">
          <!-- Summary injected by JS -->
        </div>

        <div class="overflow-y-auto flex-1 divide-y divide-stone-100 border border-stone-200 rounded-xl" id="sync-modal-list">
          <!-- Store items injected by JS -->
        </div>

        <div class="flex items-center justify-end pt-2">
          <button
            type="button"
            id="btn-confirm-sync-modal"
            class="rounded-xl bg-stone-900 px-5 py-2 text-xs font-bold text-white hover:bg-stone-800 transition"
          >
            Entendido
          </button>
        </div>
      </div>
    </div>

  </main>
</BaseLayout>

<script>
  (function initAdminPage() {
    const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || window.location.hostname.endsWith('.local');
    if (!isLocalhost) {
      window.location.replace('/');
      return;
    }

    const mainEl = document.querySelector('main[data-api-base]');
    let API_BASE = mainEl ? (mainEl.getAttribute('data-api-base') || '').trim() : '';
    if (!API_BASE) {
      API_BASE = `http://${window.location.hostname}:8000`;
    } else if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
      API_BASE = API_BASE.replace('localhost', '127.0.0.1');
    } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
      API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
    }

    // --- Tab Switching ---
    const tabBtnStores = document.getElementById('tab-btn-stores');
    const tabBtnModeration = document.getElementById('tab-btn-moderation');
    const tabContentStores = document.getElementById('tab-content-stores');
    const tabContentModeration = document.getElementById('tab-content-moderation');

    function switchTab(activeTab) {
      if (activeTab === 'stores') {
        tabBtnStores?.classList.add('border-emerald-700', 'text-emerald-900');
        tabBtnStores?.classList.remove('border-transparent', 'text-stone-500');
        tabBtnModeration?.classList.remove('border-emerald-700', 'text-emerald-900');
        tabBtnModeration?.classList.add('border-transparent', 'text-stone-500');
        tabContentStores?.classList.remove('hidden');
        tabContentModeration?.classList.add('hidden');
      } else {
        tabBtnModeration?.classList.add('border-emerald-700', 'text-emerald-900');
        tabBtnModeration?.classList.remove('border-transparent', 'text-stone-500');
        tabBtnStores?.classList.remove('border-emerald-700', 'text-emerald-900');
        tabBtnStores?.classList.add('border-transparent', 'text-stone-500');
        tabContentModeration?.classList.remove('hidden');
        tabContentStores?.classList.add('hidden');
        loadModerationProducts();
      }
    }

    tabBtnStores?.addEventListener('click', () => switchTab('stores'));
    tabBtnModeration?.addEventListener('click', () => switchTab('moderation'));

    // --- Gestión Dinámica de Sucursales en Formulario ---
    const branchesContainer = document.getElementById('branches-list');
    const btnAddBranch = document.getElementById('btn-add-branch');

    function createBranchRow(branch = {}) {
      const row = document.createElement('div');
      row.className = 'branch-row grid grid-cols-1 sm:grid-cols-4 gap-2 bg-white p-2.5 rounded-lg border border-stone-200 text-xs items-center';
      row.innerHTML = `
        <input type="text" class="branch-name rounded-lg border border-stone-300 px-2.5 py-1 text-xs" placeholder="Nombre (ej. Sucursal Tobalaba)" value="${branch.nombre || ''}" required />
        <input type="text" class="branch-address rounded-lg border border-stone-300 px-2.5 py-1 text-xs" placeholder="Dirección" value="${branch.direccion || ''}" />
        <input type="text" class="branch-comuna rounded-lg border border-stone-300 px-2.5 py-1 text-xs" placeholder="Comuna" value="${branch.comuna || ''}" />
        <div class="flex items-center justify-between gap-2">
          <label class="inline-flex items-center gap-1 text-[11px] text-stone-600">
            <input type="checkbox" class="branch-active" ${branch.activo !== false ? 'checked' : ''} /> Activa
          </label>
          <button type="button" class="btn-remove-branch text-rose-600 hover:text-rose-800 font-bold px-1.5">✕</button>
        </div>
      `;
      row.querySelector('.btn-remove-branch')?.addEventListener('click', () => row.remove());
      branchesContainer?.appendChild(row);
    }

    btnAddBranch?.addEventListener('click', () => createBranchRow());

    // --- Estado de Tiendas y Filtro de Búsqueda ---
    let cachedStores = [];
    const storeSearchInput = document.getElementById('store-search-input');
    const btnClearStoreSearch = document.getElementById('btn-clear-store-search');
    const storesSearchCount = document.getElementById('stores-search-count');
    const btnSyncUnsynced = document.getElementById('btn-sync-unsynced');
    const btnSyncAll = document.getElementById('btn-sync-all');
    const badgeUnsyncedCount = document.getElementById('badge-unsynced-count');
    const modalSyncResults = document.getElementById('modal-sync-results');

    function filterAndRenderStores() {
      const term = (storeSearchInput?.value || '').toLowerCase().trim();
      if (btnClearStoreSearch) {
        btnClearStoreSearch.classList.toggle('hidden', !term);
      }

      const filtered = cachedStores.filter((s) => {
        if (!term) return true;
        const name = (s.nombre || '').toLowerCase();
        const plat = (s.plataforma || '').toLowerCase();
        const url = (s.url_catalogo || s.url_base || '').toLowerCase();
        const site = (s.sitio_oficial || '').toLowerCase();
        const comuna = (s.comuna || '').toLowerCase();
        const address = (s.direccion || '').toLowerCase();
        const adminEmail = (s.email_administrador || '').toLowerCase();
        return (
          name.includes(term) ||
          plat.includes(term) ||
          url.includes(term) ||
          site.includes(term) ||
          comuna.includes(term) ||
          address.includes(term) ||
          adminEmail.includes(term)
        );
      });

      if (storesSearchCount) {
        storesSearchCount.textContent = `Mostrando ${filtered.length} de ${cachedStores.length} tostadurías`;
      }
      renderStoresTable(filtered);
    }

    storeSearchInput?.addEventListener('input', () => filterAndRenderStores());
    btnClearStoreSearch?.addEventListener('click', () => {
      if (storeSearchInput) storeSearchInput.value = '';
      filterAndRenderStores();
    });

    function renderStoresTable(stores) {
      const tbody = document.getElementById('stores-table-body');
      if (!tbody) return;

      if (!stores || stores.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="py-8 text-center text-stone-400">No se encontraron tiendas bajo el criterio de búsqueda.</td></tr>';
        return;
      }

      tbody.innerHTML = stores.map((store) => `
        <tr class="hover:bg-stone-50/60 transition border-b border-stone-100">
          <td class="px-4 py-3">
            <div class="font-bold text-stone-900">${store.nombre}</div>
            ${!store.activo ? '<span class="inline-block rounded-md bg-stone-200 text-stone-600 px-1.5 py-0.2 text-[10px] font-semibold">Inactiva</span>' : ''}
            ${store.email_administrador
              ? `<div class="text-[11px] text-stone-500 flex items-center gap-1 mt-0.5" title="Usuario administrador asignado a esta tostaduría">
                  <span>👤</span>
                  <span class="font-mono text-emerald-800 font-semibold truncate max-w-[180px]">${store.email_administrador}</span>
                </div>`
              : `<div class="text-[10px] text-amber-700/80 flex items-center gap-1 mt-0.5" title="Sin usuario administrador asignado">
                  <span>⚠️</span>
                  <span>Sin admin asignado</span>
                </div>`
            }
          </td>
          <td class="px-4 py-3">
            <span class="rounded-md bg-stone-100 px-2 py-0.5 text-[11px] font-semibold uppercase text-stone-700">${store.plataforma}</span>
          </td>
          <td class="px-4 py-3">
            <div class="flex flex-col gap-0.5">
              <a href="${store.sitio_oficial || store.url_base}" target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline font-semibold flex items-center gap-1">
                <span>🌐 Sitio Oficial</span>
                <span class="text-[10px] text-stone-400 font-normal">(${store.sitio_oficial || 'N/A'})</span>
              </a>
              <a href="${store.url_catalogo || store.url_base}" target="_blank" rel="noopener noreferrer" class="text-[11px] text-stone-500 hover:underline truncate max-w-[220px]">
                🛒 Catálogo: ${store.url_catalogo || store.url_base}
              </a>
            </div>
          </td>
          <td class="px-4 py-3 text-stone-600">${store.comuna || store.direccion || 'Sin dirección'}</td>
          <td class="px-4 py-3 text-center">
            <span class="rounded-full bg-stone-100 px-2 py-0.5 text-[11px] font-bold text-stone-700">${store.sucursales ? store.sucursales.length : 0}</span>
          </td>
          <td class="px-4 py-3 text-center">
            <div class="font-bold text-emerald-800">${store.cantidad_productos_visibles || 0} visibles</div>
            ${store.cantidad_productos_ocultos ? `<div class="text-[10px] text-rose-600 font-semibold">(${store.cantidad_productos_ocultos} ocultos)</div>` : ''}
            <div class="mt-1">
              ${store.es_pendiente_sincronizacion
                ? `<span class="inline-flex items-center gap-1 rounded-full bg-amber-100 text-amber-900 px-2 py-0.5 text-[10px] font-bold" title="${store.estado_sincronizacion === 'fallido' ? 'Último intento falló' : 'Sin sincronizar aún'}">⏳ Pendiente</span>`
                : `<span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 text-emerald-900 px-2 py-0.5 text-[10px] font-bold" title="${store.ultima_sincronizacion ? 'Sincronizado: ' + store.ultima_sincronizacion : ''}">✅ Sincronizada</span>`
              }
            </div>
          </td>
          <td class="px-4 py-3 text-center">
            <div class="flex items-center justify-center gap-2">
              <button
                type="button"
                class="btn-sync-single-store inline-flex items-center gap-1 rounded-lg border border-emerald-300 bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-900 hover:bg-emerald-100 transition shadow-xs"
                data-id="${store.id}"
                data-name="${store.nombre}"
                title="Sincronizar ahora el catálogo de esta tienda"
              >
                <span>🔄</span>
                <span>Sincronizar</span>
              </button>
              <button
                type="button"
                class="btn-edit-store text-stone-600 hover:text-stone-900 font-bold px-2 py-1 text-xs transition"
                data-store='${JSON.stringify(store).replace(/'/g, "&#39;")}'
              >
                ✏️ Editar
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      // Enlazar botones de edición
      document.querySelectorAll('.btn-edit-store').forEach((btn) => {
        btn.addEventListener('click', () => {
          const raw = btn.getAttribute('data-store');
          if (!raw) return;
          const storeData = JSON.parse(raw);
          populateForm(storeData);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      // Enlazar botones de sincronización individual
      document.querySelectorAll('.btn-sync-single-store').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          const name = btn.getAttribute('data-name') || 'Tienda';
          await syncStoreById(id, name, btn);
        });
      });
    }

    // --- Modal de Resultados de Sincronización ---
    function showSyncResultsModal(title, subtitle, summaryHtml, detailsList = []) {
      const modal = document.getElementById('modal-sync-results');
      const titleEl = document.getElementById('sync-modal-title');
      const subtitleEl = document.getElementById('sync-modal-subtitle');
      const summaryEl = document.getElementById('sync-modal-summary');
      const listEl = document.getElementById('sync-modal-list');

      if (titleEl) titleEl.textContent = title;
      if (subtitleEl) subtitleEl.textContent = subtitle;
      if (summaryEl) summaryEl.innerHTML = summaryHtml;

      if (listEl) {
        if (!detailsList || detailsList.length === 0) {
          listEl.innerHTML = '<div class="p-4 text-center text-xs text-stone-400">Sin detalles adicionales.</div>';
        } else {
          listEl.innerHTML = detailsList.map((item) => {
            const isOk = item.exito !== undefined ? Boolean(item.exito) : (item.estado === 'exitoso');
            return `
            <div class="p-3 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2 hover:bg-stone-50">
              <div class="space-y-0.5">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-stone-900">${item.nombre || item.tienda_nombre || 'Tienda'}</span>
                  ${isOk
                    ? '<span class="rounded bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.2 text-[10px]">OK</span>'
                    : '<span class="rounded bg-rose-100 text-rose-800 font-bold px-1.5 py-0.2 text-[10px]">FALLÓ</span>'
                  }
                </div>
                <div class="text-[11px] text-stone-500">${item.mensaje}</div>
                ${item.error ? `<div class="text-[10px] text-rose-600 font-mono mt-0.5">${item.error}</div>` : ''}
              </div>
              <div class="flex sm:flex-col items-end gap-1 text-[11px] text-stone-600">
                <span class="font-semibold text-emerald-800">+${item.productos_nuevos || 0} nuevos / ~${item.productos_actualizados || 0} act.</span>
                <span class="text-stone-400 font-mono text-[10px]">${item.duracion_segundos || 0}s</span>
              </div>
            </div>
          `;
          }).join('');
        }
      }

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeSyncResultsModal() {
      const modal = document.getElementById('modal-sync-results');
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    document.getElementById('btn-close-sync-modal')?.addEventListener('click', closeSyncResultsModal);
    document.getElementById('btn-confirm-sync-modal')?.addEventListener('click', closeSyncResultsModal);

    // --- Sincronización de Tienda Individual ---
    async function syncStoreById(id, name, btnElement = null) {
      if (!id) return;
      const originalHtml = btnElement ? btnElement.innerHTML : '';
      if (btnElement) {
        btnElement.disabled = true;
        btnElement.innerHTML = '<span>⏳</span><span>Sincronizando...</span>';
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/stores/${id}/sync`, {
          method: 'POST',
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al sincronizar tostaduría`);
        }
        const data = await res.json();
        const isSuccess = Boolean(data.exito || data.estado === 'exitoso');

        const summaryHtml = `
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm ${isSuccess ? 'text-emerald-800' : 'text-rose-800'}">
                ${isSuccess ? '✅ Catálogo Sincronizado con Éxito' : '❌ Sincronización con Errores'}
              </span>
              <span class="text-xs font-mono text-stone-500">${data.duracion_segundos}s</span>
            </div>
            <p class="text-xs text-stone-700">${data.mensaje}</p>
            <div class="flex flex-wrap gap-3 pt-2 text-[11px] font-semibold text-stone-700 border-t border-stone-200 mt-2">
              <span class="text-emerald-700">🌱 ${data.productos_nuevos || 0} nuevos</span>
              <span class="text-sky-700">🔄 ${data.productos_actualizados || 0} actualizados</span>
              <span class="text-stone-500">📦 ${data.productos_encontrados ?? data.total_productos ?? 0} encontrados</span>
            </div>
          </div>
        `;

        showSyncResultsModal(
          `Sincronización: ${name}`,
          `Catálogo de ${name} procesado`,
          summaryHtml,
          [data]
        );

        await loadStores();
      } catch (err) {
        alert(`Error al sincronizar tostaduría ${name}: ${err.message}`);
      } finally {
        if (btnElement) {
          btnElement.disabled = false;
          btnElement.innerHTML = originalHtml;
        }
      }
    }

    // --- Sincronizar Tiendas Pendientes ---
    async function syncUnsyncedStores() {
      if (!confirm('¿Deseas iniciar la sincronización de todas las tiendas pendientes (sin catálogo o con fallos previos)?')) {
        return;
      }
      if (btnSyncUnsynced) {
        btnSyncUnsynced.disabled = true;
        btnSyncUnsynced.innerHTML = '<span>⏳</span><span>Sincronizando pendientes...</span>';
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/sync/unsynced`, {
          method: 'POST',
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al sincronizar pendientes`);
        }
        const data = await res.json();

        const summaryHtml = `
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-stone-900">
                ⚡ Sincronización de Pendientes Finalizada
              </span>
              <span class="text-xs font-mono text-stone-500">${data.duracion_segundos}s</span>
            </div>
            <p class="text-xs text-stone-700">${data.mensaje}</p>
            <div class="flex flex-wrap gap-3 pt-2 text-[11px] font-semibold text-stone-700 border-t border-stone-200 mt-2">
              <span class="text-emerald-700">✅ ${data.tiendas_exitosas} exitosas</span>
              <span class="${data.tiendas_fallidas ? 'text-rose-600' : 'text-stone-400'}">❌ ${data.tiendas_fallidas} fallidas</span>
              <span class="text-stone-700">🌱 ${data.total_productos_nuevos} productos nuevos</span>
              <span class="text-stone-700">🔄 ${data.total_productos_actualizados} actualizados</span>
            </div>
          </div>
        `;

        showSyncResultsModal(
          'Sincronización de Tiendas Pendientes',
          `Procesadas ${data.total_tiendas} tostadurías`,
          summaryHtml,
          data.detalles || []
        );

        await loadStores();
      } catch (err) {
        alert(`Error: ${err.message}`);
      } finally {
        if (btnSyncUnsynced) {
          btnSyncUnsynced.disabled = false;
          btnSyncUnsynced.innerHTML = `<span>⚡</span><span>Sincronizar Pendientes (<span id="badge-unsynced-count">${cachedStores.filter((s) => s.es_pendiente_sincronizacion).length}</span>)</span>`;
        }
      }
    }

    // --- Sincronización Masiva de Todas las Tiendas ---
    async function syncAllStores() {
      if (!confirm('¿Deseas iniciar una sincronización masiva de TODAS las tiendas activas en el sistema? Este proceso recorrerá todos los catálogos y puede tomar varios minutos.')) {
        return;
      }
      if (btnSyncAll) {
        btnSyncAll.disabled = true;
        btnSyncAll.innerHTML = '<span>⏳</span><span>Sincronización Masiva en curso...</span>';
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/sync/all`, {
          method: 'POST',
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} en sincronización masiva`);
        }
        const data = await res.json();

        const summaryHtml = `
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-sm text-stone-900">
                🔄 Sincronización Masiva Completada
              </span>
              <span class="text-xs font-mono text-stone-500">${data.duracion_segundos}s</span>
            </div>
            <p class="text-xs text-stone-700">${data.mensaje}</p>
            <div class="flex flex-wrap gap-3 pt-2 text-[11px] font-semibold text-stone-700 border-t border-stone-200 mt-2">
              <span class="text-emerald-700">✅ ${data.tiendas_exitosas} tiendas exitosas</span>
              <span class="${data.tiendas_fallidas ? 'text-rose-600' : 'text-stone-400'}">❌ ${data.tiendas_fallidas} fallidas</span>
              <span class="text-stone-700">📦 ${data.total_productos_sincronizados} productos revisados</span>
              <span class="text-emerald-700">🌱 ${data.total_productos_nuevos} nuevos</span>
              <span class="text-sky-700">🔄 ${data.total_productos_actualizados} actualizados</span>
            </div>
          </div>
        `;

        showSyncResultsModal(
          'Sincronización Masiva de Catálogos',
          `Se procesaron ${data.total_tiendas} tostadurías activas`,
          summaryHtml,
          data.detalles || []
        );

        await loadStores();
      } catch (err) {
        alert(`Error en sincronización masiva: ${err.message}`);
      } finally {
        if (btnSyncAll) {
          btnSyncAll.disabled = false;
          btnSyncAll.innerHTML = '<span>🔄</span><span>Sincronización Masiva</span>';
        }
      }
    }

    btnSyncUnsynced?.addEventListener('click', syncUnsyncedStores);
    btnSyncAll?.addEventListener('click', syncAllStores);

    // --- Cargar Tiendas Registradas ---
    async function loadStores() {
      const tbody = document.getElementById('stores-table-body');
      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/stores`);
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al cargar tiendas`);
        }
        const data = await res.json();
        cachedStores = data.tiendas || [];

        const badge = document.getElementById('stores-count-badge');
        if (badge) badge.textContent = `${data.total_tiendas} Tiendas`;

        const syncedBadge = document.getElementById('stores-synced-badge');
        if (syncedBadge) syncedBadge.textContent = `${data.total_sincronizadas || 0} Sincronizadas`;

        const currentBadgeUnsynced = document.getElementById('badge-unsynced-count');
        if (currentBadgeUnsynced) {
          currentBadgeUnsynced.textContent = `${data.total_pendientes || 0}`;
        }
        if (btnSyncUnsynced) {
          btnSyncUnsynced.disabled = !data.total_pendientes;
        }

        // Llenar selector de tiendas en moderación
        const modStoreFilter = document.getElementById('mod-store-filter');
        if (modStoreFilter) {
          const currentVal = modStoreFilter.value;
          modStoreFilter.innerHTML = '<option value="">Todas las tiendas</option>' + 
            cachedStores.map((t) => `<option value="${t.nombre}">${t.nombre}</option>`).join('');
          modStoreFilter.value = currentVal;
        }

        filterAndRenderStores();
      } catch (err) {
        if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-rose-600">Error: ${err.message}</td></tr>`;
      }
    }

    function populateForm(store) {
      document.getElementById('form-title').textContent = `Editar Tostaduría: ${store.nombre}`;
      document.getElementById('store-id').value = store.id || '';
      document.getElementById('store-name').value = store.nombre || '';
      document.getElementById('store-platform').value = store.plataforma || 'woocommerce';
      document.getElementById('store-url').value = store.url_catalogo || store.url_base || '';
      document.getElementById('store-address').value = store.direccion || '';
      document.getElementById('store-comuna').value = store.comuna || '';
      document.getElementById('store-admin-email').value = store.email_administrador || '';
      document.getElementById('store-active').checked = store.activo !== false;

      if (branchesContainer) branchesContainer.innerHTML = '';
      if (store.sucursales && store.sucursales.length > 0) {
        store.sucursales.forEach((b) => createBranchRow(b));
      }
    }

    // --- Reset Formulario ---
    document.getElementById('btn-reset-form')?.addEventListener('click', () => {
      document.getElementById('form-title').textContent = 'Registrar Nueva Tostaduría / Tienda';
      document.getElementById('store-id').value = '';
      document.getElementById('store-name').value = '';
      document.getElementById('store-platform').value = 'woocommerce';
      document.getElementById('store-url').value = '';
      document.getElementById('store-address').value = '';
      document.getElementById('store-comuna').value = '';
      document.getElementById('store-admin-email').value = '';
      document.getElementById('store-active').checked = true;
      if (branchesContainer) branchesContainer.innerHTML = '';
      const testResultBox = document.getElementById('catalog-test-result');
      if (testResultBox) testResultBox.classList.add('hidden');
    });

    // --- Probar Catálogo con Driver Nativo ---
    const btnTestCatalog = document.getElementById('btn-test-catalog');
    btnTestCatalog?.addEventListener('click', async () => {
      const name = document.getElementById('store-name')?.value || 'Tienda de Prueba';
      const url = document.getElementById('store-url')?.value;
      const platform = document.getElementById('store-platform')?.value || 'auto';
      const resultBox = document.getElementById('catalog-test-result');

      if (!url) {
        alert('Por favor ingresa la URL del catálogo para probar.');
        document.getElementById('store-url')?.focus();
        return;
      }

      btnTestCatalog.disabled = true;
      btnTestCatalog.innerHTML = '<span>⏳</span><span>Probando catálogo con driver...</span>';
      if (resultBox) {
        resultBox.classList.remove('hidden');
        resultBox.innerHTML = '<div class="p-4 rounded-xl bg-stone-100 text-xs text-stone-600 animate-pulse">Consultando catálogo y extrayendo primer producto devuelto por el driver...</div>';
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/stores/test-catalog`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre: name, url_catalogo: url, plataforma: platform }),
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          const errMsg = errData.detail || errData.mensaje || `Error HTTP ${res.status}: ${res.statusText}`;
          resultBox.innerHTML = `
            <div class="rounded-xl border border-rose-300 bg-rose-50/70 p-5 space-y-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-200 px-3 py-0.5 text-xs font-bold text-rose-900">
                ❌ Error del servidor (${res.status})
              </span>
              <p class="text-xs font-semibold text-rose-800">${errMsg}</p>
            </div>
          `;
          return;
        }
        const data = await res.json();

        if (data.legible && data.primer_producto) {
          const p = data.primer_producto;
          resultBox.innerHTML = `
            <div class="rounded-xl border border-emerald-300 bg-emerald-50/70 p-5 space-y-3">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-200 px-3 py-0.5 text-xs font-bold text-emerald-900">
                  ✅ Catálogo Legible (${data.plataforma_detectada.toUpperCase()})
                </span>
                <span class="text-xs font-bold text-emerald-800">${data.total_productos_detectados} productos encontrados</span>
              </div>
              <p class="text-xs text-stone-700">${data.mensaje}</p>

              <!-- Tarjeta de Primer Producto -->
              <div class="mt-3 flex flex-col sm:flex-row items-start sm:items-center gap-4 rounded-xl bg-white p-4 border border-emerald-200 shadow-xs">
                ${p.imagen ? `<img src="${p.imagen}" alt="${p.nombre}" referrerpolicy="no-referrer" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';" class="h-20 w-20 rounded-lg object-contain bg-[#F4F3ED] border border-stone-200 p-1" />` : ''}
                <div class="flex-1 space-y-1">
                  <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-700">Primer Producto Devuelto</span>
                  <h4 class="text-sm font-bold text-stone-900">${p.nombre}</h4>
                  <div class="flex flex-wrap items-center gap-2 text-xs text-stone-600">
                    <span class="font-bold text-emerald-900">$${p.precio_clp.toLocaleString('es-CL')} CLP</span>
                    <span>•</span>
                    <span>${p.formato_gramos}g</span>
                    <span>•</span>
                    <span class="text-stone-500">$${p.precio_por_kilo.toLocaleString('es-CL')}/kg</span>
                    ${p.proceso ? `<span>• Proceso: ${p.proceso}</span>` : ''}
                  </div>
                  ${p.notas_cata && p.notas_cata.length ? `<div class="flex flex-wrap gap-1 pt-1">${p.notas_cata.map((n) => {
                    const label = typeof n === 'object' && n !== null ? (n.nombre || n.descriptor || JSON.stringify(n)) : String(n);
                    return `<span class="rounded bg-stone-100 px-1.5 py-0.5 text-[10px] font-semibold text-stone-600">${label}</span>`;
                  }).join('')}</div>` : ''}
                  ${p.es_sospechoso_no_cafe ? `<span class="inline-block mt-1 rounded bg-rose-100 px-2 py-0.5 text-[10px] font-bold text-rose-800">⚠️ Posible No-Café: ${p.motivo_sospecha}</span>` : ''}
                </div>
              </div>
            </div>
          `;
        } else {
          resultBox.innerHTML = `
            <div class="rounded-xl border border-rose-300 bg-rose-50/70 p-5 space-y-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-200 px-3 py-0.5 text-xs font-bold text-rose-900">
                ❌ No fue posible leer el catálogo
              </span>
              <p class="text-xs font-semibold text-rose-800">${data.mensaje || 'Error al conectar'}</p>
              ${data.error_detalle ? `<pre class="mt-2 text-[11px] text-rose-700 bg-white/70 p-2.5 rounded-lg overflow-x-auto">${data.error_detalle}</pre>` : ''}
            </div>
          `;
        }
      } catch (err) {
        resultBox.innerHTML = `<div class="p-4 rounded-xl bg-rose-100 text-xs text-rose-800 font-bold">Error al ejecutar prueba: ${err.message}</div>`;
      } finally {
        btnTestCatalog.disabled = false;
        btnTestCatalog.innerHTML = '<span>🔍</span><span>Probar Catálogo (Obtener 1er Producto)</span>';
      }
    });

    // --- Guardar Tostaduría ---
    document.getElementById('form-store')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const storeId = document.getElementById('store-id')?.value;
      const name = document.getElementById('store-name')?.value;
      const platform = document.getElementById('store-platform')?.value;
      const url = document.getElementById('store-url')?.value;
      const address = document.getElementById('store-address')?.value;
      const comuna = document.getElementById('store-comuna')?.value;
      const adminEmail = document.getElementById('store-admin-email')?.value?.trim();
      const active = document.getElementById('store-active')?.checked;
      const syncImmediate = document.getElementById('store-sync-immediate')?.checked;

      const branches = [];
      document.querySelectorAll('.branch-row').forEach((row) => {
        const bName = row.querySelector('.branch-name')?.value;
        if (bName && bName.trim()) {
          branches.push({
            nombre: bName.trim(),
            direccion: row.querySelector('.branch-address')?.value || null,
            comuna: row.querySelector('.branch-comuna')?.value || null,
            activo: row.querySelector('.branch-active')?.checked !== false,
          });
        }
      });

      const payload = {
        nombre: name,
        url_catalogo: url,
        plataforma: platform,
        direccion: address || null,
        comuna: comuna || null,
        email_administrador: adminEmail || null,
        activo: active,
        sucursales: branches,
      };

      try {
        const endpoint = storeId ? `${API_BASE}/api/v1/admin/stores/${storeId}` : `${API_BASE}/api/v1/admin/stores`;
        const method = storeId ? 'PUT' : 'POST';
        const res = await fetch(endpoint, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al guardar la tostaduría`);
        }
        const savedStore = await res.json();
        document.getElementById('btn-reset-form')?.click();
        await loadStores();

        if (syncImmediate && savedStore && savedStore.id) {
          await syncStoreById(savedStore.id, savedStore.nombre);
        } else {
          alert('Tostaduría y sucursales guardadas con éxito.');
        }
      } catch (err) {
        alert(`Error: ${err.message}`);
      }
    });

    // --- Modal de Exportación ---
    let exportData = null;
    const modalExport = document.getElementById('modal-export');
    const exportContentArea = document.getElementById('export-content-area');
    const tabExportSql = document.getElementById('tab-export-sql');
    const tabExportJson = document.getElementById('tab-export-json');

    document.getElementById('btn-export-stores')?.addEventListener('click', async () => {
      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/stores/export`);
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al exportar tiendas`);
        }
        exportData = await res.json();

        document.getElementById('export-summary-text').textContent = 
          `${exportData.total_tiendas} tostadurías y ${exportData.total_sucursales} sucursales listas para producción`;
        exportContentArea.value = exportData.sql_script;
        modalExport.classList.remove('hidden');
        modalExport.classList.add('flex');
      } catch (err) {
        alert(`Error al exportar: ${err.message}`);
      }
    });

    document.getElementById('btn-close-export-modal')?.addEventListener('click', () => {
      modalExport.classList.add('hidden');
      modalExport.classList.remove('flex');
    });

    tabExportSql?.addEventListener('click', () => {
      tabExportSql.classList.add('text-emerald-800', 'border-b-2', 'border-emerald-700');
      tabExportSql.classList.remove('text-stone-500');
      tabExportJson.classList.remove('text-emerald-800', 'border-b-2', 'border-emerald-700');
      tabExportJson.classList.add('text-stone-500');
      if (exportData) exportContentArea.value = exportData.sql_script;
    });

    tabExportJson?.addEventListener('click', () => {
      tabExportJson.classList.add('text-emerald-800', 'border-b-2', 'border-emerald-700');
      tabExportJson.classList.remove('text-stone-500');
      tabExportSql.classList.remove('text-emerald-800', 'border-b-2', 'border-emerald-700');
      tabExportSql.classList.add('text-stone-500');
      if (exportData) exportContentArea.value = JSON.stringify(exportData.tiendas, null, 2);
    });

    document.getElementById('btn-copy-export')?.addEventListener('click', () => {
      if (exportContentArea) {
        navigator.clipboard.writeText(exportContentArea.value);
        alert('Copiado al portapapeles.');
      }
    });

    document.getElementById('btn-download-export')?.addEventListener('click', () => {
      if (!exportData) return;
      const isSql = tabExportSql?.classList.contains('text-emerald-800');
      const filename = isSql ? 'tiendas_produccion.sql' : 'tiendas_produccion.json';
      const content = isSql ? exportData.sql_script : JSON.stringify(exportData.tiendas, null, 2);
      const blob = new Blob([content], { type: isSql ? 'text/sql' : 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      a.click();
    });

    // --- TAB 2: MODERACIÓN DE PRODUCTOS NO-CAFÉ ---
    let currentModMode = 'suspected';
    let currentModStore = '';
    let currentModSearch = '';
    let cachedModerationItems = [];

    async function loadModerationProducts() {
      const tbody = document.getElementById('moderation-table-body');
      try {
        const params = new URLSearchParams({
          mode: currentModMode,
          limit: '300',
        });
        if (currentModStore) params.set('store_name', currentModStore);
        if (currentModSearch) params.set('q', currentModSearch);

        const res = await fetch(`${API_BASE}/api/v1/admin/products/moderation?${params.toString()}`);
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al cargar productos de moderación`);
        }
        const data = await res.json();
        cachedModerationItems = data.items || [];

        // Actualizar KPIs
        document.getElementById('kpi-suspected').textContent = data.total_sospechosos || 0;
        document.getElementById('kpi-hidden').textContent = data.total_ocultos || 0;
        document.getElementById('kpi-visible').textContent = data.total_visibles_cafe || 0;
        document.getElementById('badge-total-suspected').textContent = data.total_sospechosos || 0;

        if (!cachedModerationItems.length) {
          tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-stone-400">No se encontraron productos bajo el criterio seleccionado.</td></tr>';
          return;
        }

        tbody.innerHTML = cachedModerationItems.map((item) => `
          <tr class="hover:bg-stone-50/60 transition ${item.oculto_catalogo ? 'bg-stone-50/80 opacity-70' : ''}">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">
                ${item.imagen ? `<img src="${item.imagen}" alt="${item.nombre}" class="h-10 w-10 rounded-lg object-cover border border-stone-200" />` : '<div class="h-10 w-10 rounded-lg bg-stone-200 flex items-center justify-center text-xs">☕</div>'}
                <div>
                  <a href="${item.url_detalle}" target="_blank" rel="noopener noreferrer" class="font-bold text-stone-900 hover:text-emerald-700 transition">
                    ${item.nombre}
                  </a>
                  <span class="block text-[11px] text-stone-400">ID: #${item.id}</span>
                </div>
              </div>
            </td>
            <td class="px-4 py-3 font-semibold text-stone-700">${item.tienda}</td>
            <td class="px-4 py-3">
              <span class="font-bold text-stone-900">$${item.precio_clp.toLocaleString('es-CL')}</span>
              <span class="block text-[10px] text-stone-400">$${item.precio_por_kilo.toLocaleString('es-CL')}/kg</span>
            </td>
            <td class="px-4 py-3">
              ${item.es_sospechoso 
                ? `<span class="rounded-md bg-rose-100 px-2 py-0.5 text-[11px] font-bold text-rose-800">${item.motivo_sospecha || 'Posible no-café'}</span>`
                : '<span class="text-[11px] text-stone-400">Sin sospecha</span>'}
            </td>
            <td class="px-4 py-3 text-center">
              ${item.oculto_catalogo
                ? '<span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-[10px] font-bold text-rose-900">Oculto</span>'
                : '<span class="rounded-full bg-emerald-100 px-2.5 py-0.5 text-[10px] font-bold text-emerald-900">Visible</span>'}
            </td>
            <td class="px-4 py-3 text-center">
              <button
                type="button"
                class="btn-toggle-visibility rounded-lg px-3 py-1.5 text-xs font-bold transition ${item.oculto_catalogo ? 'bg-emerald-100 text-emerald-800 hover:bg-emerald-200' : 'bg-rose-100 text-rose-800 hover:bg-rose-200'}"
                data-id="${item.id}"
                data-current="${item.oculto_catalogo}"
              >
                ${item.oculto_catalogo ? '👁️ Restaurar' : '🚫 Ocultar'}
              </button>
            </td>
          </tr>
        `).join('');

        // Enlazar botones toggle
        document.querySelectorAll('.btn-toggle-visibility').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const current = btn.getAttribute('data-current') === 'true';
            btn.disabled = true;
            try {
              const patchRes = await fetch(`${API_BASE}/api/v1/admin/products/${id}/visibility`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ oculto_catalogo: !current }),
              });
              if (!patchRes.ok) {
                const errData = await patchRes.json().catch(() => ({}));
                throw new Error(errData.detail || `Error HTTP ${patchRes.status} al actualizar visibilidad`);
              }
              loadModerationProducts();
              loadStores();
            } catch (err) {
              alert(`Error: ${err.message}`);
              btn.disabled = false;
            }
          });
        });

      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-rose-600">Error: ${err.message}</td></tr>`;
      }
    }

    // Botones de filtro de moderación
    document.querySelectorAll('.mod-filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mod-filter-btn').forEach((b) => {
          b.className = b === btn
            ? 'mod-filter-btn active rounded-lg bg-stone-900 px-3 py-1.5 text-white'
            : 'mod-filter-btn rounded-lg px-3 py-1.5 text-stone-700 hover:text-stone-900';
        });
        currentModMode = btn.getAttribute('data-mode') || 'suspected';
        loadModerationProducts();
      });
    });

    document.getElementById('mod-store-filter')?.addEventListener('change', (e) => {
      currentModStore = e.target.value;
      loadModerationProducts();
    });

    document.getElementById('mod-search-input')?.addEventListener('input', (e) => {
      currentModSearch = (e.target.value || '').trim();
      loadModerationProducts();
    });

    // Ocultar masivamente los productos sospechosos visibles
    document.getElementById('btn-bulk-hide-suspected')?.addEventListener('click', async () => {
      const suspectedVisibleIds = cachedModerationItems
        .filter((i) => i.es_sospechoso && !i.oculto_catalogo)
        .map((i) => i.id);

      if (!suspectedVisibleIds.length) {
        alert('No hay productos sospechosos visibles en este listado para ocultar.');
        return;
      }

      if (!confirm(`¿Deseas ocultar ${suspectedVisibleIds.length} productos sospechosos del catálogo general?`)) {
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/api/v1/admin/products/bulk-visibility`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product_ids: suspectedVisibleIds, oculto_catalogo: true }),
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.detail || `Error HTTP ${res.status} al ocultar en lote`);
        }
        alert(`${suspectedVisibleIds.length} productos ocultados del catálogo.`);
        loadModerationProducts();
        loadStores();
      } catch (err) {
        alert(`Error: ${err.message}`);
      }
    });

    // Cargar tiendas al inicio
    loadStores();
  })();
</script>
