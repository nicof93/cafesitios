---

<!-- CU-03: BARRA FLOTANTE DE COMPARACIÓN -->
<div 
  id="compare-bar" 
  class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-40 bg-stone-900/95 backdrop-blur text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-4 border border-stone-700 transition-all duration-300"
>
  <span class="flex items-center gap-1.5 text-xs font-medium">
    <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
    <span id="compare-bar-count">0 seleccionados</span>
  </span>
  <button 
    type="button" 
    id="btn-trigger-compare-modal"
    class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-3.5 py-1.5 rounded-xl transition shadow"
  >
    Comparar cafés
  </button>
  <button 
    type="button" 
    id="btn-clear-compare"
    class="text-xs text-stone-400 hover:text-white transition"
  >
    Limpiar
  </button>
</div>

<!-- CU-03: MODAL SIDE-BY-SIDE -->
<dialog 
  id="compare-dialog" 
  class="fixed inset-0 z-50 m-auto w-[95%] max-w-5xl rounded-3xl bg-white p-6 shadow-2xl border border-stone-200 backdrop:bg-stone-950/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between pb-4 border-b border-stone-200">
    <div>
      <h3 class="text-lg font-bold text-slate-900">Comparativa Side-by-Side</h3>
      <p class="text-xs text-slate-500">Compara hasta 4 cafés ordenados por conveniencia por kilo (RN-03)</p>
    </div>
    <button 
      type="button" 
      id="btn-close-compare-dialog"
      class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1 rounded-lg"
    >
      ✕
    </button>
  </div>
  
  <div id="compare-dialog-content" class="mt-4 overflow-x-auto min-h-[220px] flex items-center justify-center">
    <span class="text-xs text-slate-400">Cargando comparativa...</span>
  </div>
</dialog>

<script>
  import { CompareProductsUseCase } from '../../core/application/CompareProducts';
  import { AnalyticsTracker } from '../../core/infrastructure/analytics/AnalyticsTracker';

  const compareUseCase = new CompareProductsUseCase();
  const selectedCompareIds = new Set<number>();

  const bar = document.getElementById('compare-bar');
  const countLabel = document.getElementById('compare-bar-count');
  const triggerBtn = document.getElementById('btn-trigger-compare-modal');
  const clearBtn = document.getElementById('btn-clear-compare');
  const dialog = document.getElementById('compare-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('btn-close-compare-dialog');
  const content = document.getElementById('compare-dialog-content');

  function updateBar() {
    if (!bar || !countLabel) return;
    if (selectedCompareIds.size > 0) {
      bar.classList.remove('hidden');
      countLabel.textContent = `${selectedCompareIds.size} café${selectedCompareIds.size > 1 ? 's' : ''} (máx 4)`;
    } else {
      bar.classList.add('hidden');
    }
  }

  // Escuchar eventos globales de toggle de comparación desde las tarjetas de producto
  window.addEventListener('cafesitios:toggle-compare', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    const { id, checked, name } = detail;

    if (checked) {
      if (selectedCompareIds.size >= 4) {
        alert('Puedes comparar un máximo de 4 cafés a la vez.');
        // Desmarcar checkbox
        const cb = document.querySelector(`.compare-cb[data-id="${id}"]`) as HTMLInputElement | null;
        if (cb) cb.checked = false;
        return;
      }
      selectedCompareIds.add(Number(id));
      AnalyticsTracker.trackAddToCompare(Number(id), name);
    } else {
      selectedCompareIds.delete(Number(id));
      AnalyticsTracker.trackRemoveFromCompare(Number(id));
    }
    updateBar();
  });

  clearBtn?.addEventListener('click', () => {
    selectedCompareIds.clear();
    document.querySelectorAll('.compare-cb').forEach(el => {
      (el as HTMLInputElement).checked = false;
    });
    updateBar();
  });

  triggerBtn?.addEventListener('click', async () => {
    if (selectedCompareIds.size === 0 || !dialog || !content) return;
    dialog.showModal();
    content.innerHTML = '<span class="text-xs text-slate-400">Cargando comparativa...</span>';

    try {
      const ids = Array.from(selectedCompareIds);
      const result = await compareUseCase.execute(ids);
      const productos = result.productos;

      if (productos.length === 0) {
        content.innerHTML = '<p class="text-xs text-slate-500">No se encontraron cafés para comparar.</p>';
        return;
      }

      // Menor precio por kilo
      const minKilo = Math.min(
        ...productos.map(p => p.getBestVariant(true)?.precio_por_kilo || p.getBestVariant(false)?.precio_por_kilo || Infinity)
      );

      let html = `<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-${Math.min(productos.length, 4)} gap-4 w-full">`;
      productos.forEach(p => {
        const v = p.getBestVariant(true) || p.getBestVariant(false);
        const esGanador = v && v.precio_por_kilo === minKilo;
        html += `
          <div class="rounded-2xl border ${esGanador ? 'border-emerald-500 ring-2 ring-emerald-100 bg-emerald-50/20' : 'border-stone-200 bg-white'} p-4 flex flex-col justify-between">
            <div class="space-y-3">
              ${esGanador ? '<span class="inline-block bg-emerald-600 text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full mb-1">⭐ Mejor precio / kg</span>' : ''}
              <img src="${p.imagen}" alt="${p.nombre}" referrerpolicy="no-referrer" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1559056199-641a0ac8b55e?q=80&w=400&auto=format&fit=crop';" class="w-full h-32 object-contain bg-[#F7F6F0] rounded-xl p-2">
              <span class="inline-block bg-white border border-stone-200 text-slate-600 text-[10px] font-bold px-2 py-0.5 rounded-full">${p.tienda}</span>
              <h4 class="font-bold text-xs text-slate-900 line-clamp-2">${p.nombre}</h4>
              
              <div class="border-t border-stone-100 pt-2 space-y-1">
                <p class="text-[10px] uppercase font-bold text-slate-400">Precio / kg</p>
                <p class="text-base font-extrabold ${esGanador ? 'text-emerald-700' : 'text-slate-800'}">
                  $${(v?.precio_por_kilo || 0).toLocaleString('es-CL')}/kg
                  ${v?.es_estimado ? '<span class="ml-1 text-[9px] font-bold text-amber-700 bg-amber-100 px-1 py-0.5 rounded">Estimado</span>' : ''}
                </p>
                <p class="text-xs font-semibold text-slate-600">Total: $${(v?.precio_clp || 0).toLocaleString('es-CL')} (${v?.formato_gramos || 250}g)</p>
                ${p.origen ? `<p class="text-[10px] text-slate-500">🌍 Origen: ${p.origen}</p>` : ''}
                ${p.proceso ? `<p class="text-[10px] text-slate-500">⚙️ Proceso: ${p.proceso}</p>` : ''}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-stone-100">
              <a 
                href="${p.url_detalle}" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="block w-full bg-slate-900 hover:bg-black text-white text-center font-bold text-xs py-2 rounded-xl transition"
              >
                Ir a la tienda ↗
              </a>
            </div>
          </div>
        `;
      });
      html += `</div>`;
      content.innerHTML = html;

      AnalyticsTracker.trackCompareViewed(productos.length, ids);
    } catch {
      content.innerHTML = '<p class="text-xs text-red-500">Error al cargar la comparativa.</p>';
    }
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

