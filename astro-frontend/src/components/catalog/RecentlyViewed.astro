<!-- CU-10: VISTOS RECIENTEMENTE (FIFO LOCALSTORAGE) -->
<section id="recently-viewed-panel" class="hidden bg-white rounded-2xl border border-stone-200/80 p-5 shadow-2xs">
  <div class="flex items-center justify-between gap-3 mb-3 border-b border-stone-100 pb-2.5">
    <h2 class="text-xs font-bold uppercase tracking-wider text-stone-400 flex items-center gap-1.5">
      <span>🕒</span>
      <span>Vistos Recientemente</span>
    </h2>
    <button 
      type="button" 
      id="btn-clear-recently-viewed"
      class="text-[11px] font-medium text-stone-400 hover:text-stone-700 transition"
    >
      Borrar
    </button>
  </div>
  <div id="recently-viewed-items" class="space-y-2"></div>
</section>

<script>
  import { LocalStorageAdapter } from '../../core/infrastructure/storage/LocalStorageAdapter';

  const panel = document.getElementById('recently-viewed-panel');
  const itemsContainer = document.getElementById('recently-viewed-items');
  const clearBtn = document.getElementById('btn-clear-recently-viewed');

  function renderRecentlyViewed() {
    const items = LocalStorageAdapter.getRecentlyViewed();
    if (!panel || !itemsContainer) return;

    if (items.length === 0) {
      panel.classList.add('hidden');
      return;
    }

    panel.classList.remove('hidden');
    itemsContainer.innerHTML = items.map(prod => `
      <a href="/product/${prod.id}" class="group flex items-center gap-2.5 p-2 rounded-xl hover:bg-stone-50 transition border border-stone-100/80">
        <img src="${prod.imagen || '/images/producto-referencial.jpg'}" alt="${prod.nombre}" referrerpolicy="no-referrer" onerror="this.onerror=null; this.src='/images/producto-referencial.jpg';" class="w-10 h-10 object-contain rounded-lg bg-[#F4F3ED] flex-shrink-0 p-0.5">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold text-stone-800 truncate group-hover:text-emerald-800 transition">${prod.nombre}</p>
          <p class="text-[10px] text-stone-400">${prod.tienda} &bull; <strong class="text-emerald-800 font-bold">$${(prod.precio || 0).toLocaleString('es-CL')}</strong></p>
        </div>
      </a>
    `).join('');
  }

  clearBtn?.addEventListener('click', () => {
    LocalStorageAdapter.clearRecentlyViewed();
    renderRecentlyViewed();
  });

  // Render inicial al cargar
  renderRecentlyViewed();
</script>
