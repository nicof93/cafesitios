---
// SlideOverDrawer.astro - Componente Reutilizable de Panel Lateral Deslizable desde la Derecha
// Principio UX: Cero popups centrales intrusivos; edición fluida con contexto preservado.

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  icon?: string;
  maxWidth?: string; // 'max-w-md', 'max-w-lg', 'max-w-xl', 'max-w-2xl'
  backdropId?: string;
}

const {
  id,
  title,
  subtitle = "",
  icon = "📋",
  maxWidth = "max-w-lg lg:max-w-xl",
  backdropId = `${id}-backdrop`
} = Astro.props;
---

<!-- BACKDROP CON BLUR TENUE -->
<div
  id={backdropId}
  class="fixed inset-0 z-40 bg-stone-950/40 backdrop-blur-xs transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- PANEL LATERAL DESLIZABLE (SLIDE-OVER DRAWER) -->
<aside
  id={id}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  class={`fixed inset-y-0 right-0 z-50 w-full ${maxWidth} bg-white shadow-2xl flex flex-col transform transition-transform duration-300 ease-in-out translate-x-full border-l border-stone-200`}
>
  <!-- Cabecera Fija del Drawer -->
  <div class="flex items-center justify-between px-6 py-4 border-b border-stone-200 bg-[#FCFBF7]/90 backdrop-blur-md shrink-0">
    <div class="flex items-center gap-3 min-w-0 pr-2">
      {icon && (
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-stone-100 text-stone-800 text-lg border border-stone-200/80 shadow-2xs">
          {icon}
        </span>
      )}
      <div class="min-w-0">
        <h3 id={`${id}-title`} class="text-sm sm:text-base font-black text-stone-900 tracking-tight m-0 truncate">
          {title}
        </h3>
        {subtitle && (
          <p id={`${id}-subtitle`} class="text-[11px] text-stone-500 m-0 truncate mt-0.5">
            {subtitle}
          </p>
        )}
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="header-actions" />
      <button
        type="button"
        id={`${id}-close-btn`}
        class="h-8 w-8 inline-flex items-center justify-center rounded-xl text-stone-400 hover:text-stone-800 hover:bg-stone-100 transition text-base font-bold"
        aria-label="Cerrar panel lateral"
        title="Cerrar panel (Esc)"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Cuerpo Scrolleable con Scroll Independiente -->
  <div class="flex-1 overflow-y-auto p-6 space-y-4 text-xs text-stone-700">
    <slot />
  </div>

  <!-- Pie Fijo de Acciones -->
  {Astro.slots.has('footer') && (
    <div class="px-6 py-3.5 border-t border-stone-200 bg-stone-50/90 backdrop-blur-xs flex items-center justify-end gap-2.5 shrink-0">
      <slot name="footer" />
    </div>
  )}
</aside>

