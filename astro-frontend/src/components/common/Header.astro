---
import { Environment } from "../../core/infrastructure/config/Environment";

interface Props {
  lastSync?: string;
}

const { lastSync = "Al día" } = Astro.props;
const showAnalytics = Environment.isAnalyticsEnabled(Astro.url);
const showLocalAdmin = Environment.isLocalAdminEnabled(Astro.url);
---

<header class="sticky top-0 z-30 border-b border-stone-200/70 bg-[#FCFBF7]/90 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2.5 sm:px-6">
    
    <!-- LOGOTIPO Y MARCA (Enlace a inicio restableciendo filtros) -->
    <a 
      href="/" 
      class="group flex items-center gap-2.5 transition duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg py-1 px-1.5 -ml-1.5"
      title="Volver al catálogo principal"
    >
      <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-700 text-white text-xs font-bold shadow-sm transition group-hover:bg-emerald-800">
        ☕
      </span>
      <div class="flex items-baseline gap-1.5">
        <span class="text-base font-bold tracking-tight text-stone-900 group-hover:text-emerald-900 transition">
          Cafesitios
        </span>
        <span class="hidden md:inline-block text-[11px] font-medium text-stone-400">
          Especialidad Chile
        </span>
      </div>
    </a>

    <!-- NAVEGACIÓN Y ACCIONES GLOBALES -->
    <nav class="flex items-center gap-1 sm:gap-2 text-xs font-medium text-stone-600" aria-label="Navegación principal">
      <a 
        href="/catalog" 
        class="rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      >
        Catálogo
      </a>
      
      <a 
        href="/stores" 
        class="rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      >
        Todas las Tiendas
      </a>

      <button 
        type="button" 
        id="btn-open-quiz"
        class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-emerald-800 hover:bg-emerald-50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      >
        <span aria-hidden="true">✨</span>
        <span>Quiz de Sabor</span>
      </button>

      <a 
        href="/bitacora" 
        id="btn-open-recipes"
        class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 hover:text-stone-900 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
        title="Abrir Bitácora Barista de Recetas"
      >
        <span aria-hidden="true">📖</span>
        <span class="hidden sm:inline">Bitácora</span>
      </a>

      {showLocalAdmin && (
        <a 
          href="/admin" 
          class="local-admin-nav hidden inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-amber-800 bg-amber-50 hover:bg-amber-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-600 font-semibold"
          title="Panel Administrativo Local (Tiendas, Sucursales y Moderación)"
        >
          <span aria-hidden="true">⚙️</span>
          <span class="hidden sm:inline">Admin Local</span>
        </a>
      )}

      {showAnalytics && (
        <a 
          href="/sincronizaciones" 
          class="local-analytics-nav hidden inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          title="Reporte de Sincronización y Analítica"
        >
          <span aria-hidden="true">📊</span>
          <span class="hidden sm:inline">Sincronización</span>
        </a>
      )}

      <!-- PILL DISCRETO DE SINCRONIZACIÓN -->
      {showAnalytics && (
        <a 
          href="/sincronizaciones"
          class="local-analytics-nav hidden lg:inline-flex items-center gap-1.5 rounded-full border border-stone-200/80 bg-white/80 hover:border-emerald-300 hover:bg-emerald-50/60 px-2.5 py-1 text-[10px] font-medium text-stone-500 hover:text-emerald-800 shadow-2xs ml-1 transition"
          title="Ver Reporte de Sincronización y Analítica"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="header-sync-time" class="truncate max-w-[130px]">{lastSync}</span>
        </a>
      )}
    </nav>

  </div>
</header>

<script>
  // Verificación estricta en el cliente para ocultar navegación local si se accede fuera de localhost
  (function enforceLocalhostNav() {
    const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || window.location.hostname.endsWith('.local');
    if (isLocalhost) {
      document.querySelectorAll('.local-admin-nav, .local-analytics-nav').forEach((el) => {
        el.classList.remove('hidden');
      });
    } else {
      document.querySelectorAll('.local-admin-nav, .local-analytics-nav').forEach((el) => {
        el.remove();
      });
    }
  })();
</script>
