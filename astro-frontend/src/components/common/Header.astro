---
import { Environment } from "../../core/infrastructure/config/Environment";

interface Props {
  lastSync?: string;
}

const { lastSync = "Al día" } = Astro.props;
const showAnalytics = Environment.isAnalyticsEnabled(Astro.url);
const showLocalAdmin = Environment.isLocalAdminEnabled(Astro.url);
const showGuides = Environment.isGuidesEnabled();
const showCalibrator = Environment.isCalibratorEnabled();
const showMyRecipes = Environment.isMyRecipesEnabled();
const showFlavorQuiz = Environment.isFlavorQuizEnabled();
const showWhatsAppOrders = Environment.isWhatsAppOrdersEnabled();
---

<header class="sticky top-0 z-30 border-b border-stone-200/70 bg-[#FCFBF7]/90 backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2.5 sm:px-6">
    
    <!-- LOGOTIPO Y MARCA (Enlace a inicio restableciendo filtros) -->
    <a 
      href="/" 
      class="group flex items-center gap-2.5 transition duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg py-1 px-1.5 -ml-1.5"
      title="Volver al catálogo principal"
    >
      <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-700 text-white text-xs font-bold shadow-sm transition group-hover:bg-emerald-800">
        ☕
      </span>
      <div class="flex items-baseline gap-1.5">
        <span class="text-base font-bold tracking-tight text-stone-900 group-hover:text-emerald-900 transition">
          Cafesitios
        </span>
        <span class="hidden md:inline-block text-[11px] font-medium text-stone-400">
          Especialidad Chile
        </span>
      </div>
    </a>

    <!-- NAVEGACIÓN Y ACCIONES GLOBALES -->
    <nav class="flex items-center gap-1 sm:gap-2 text-xs font-medium text-stone-600" aria-label="Navegación principal">
      <a 
        href="/catalogo" 
        class="rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      >
        Catálogo
      </a>
      
      <a 
        href="/tiendas" 
        class="rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
      >
        Todas las Tiendas
      </a>

      {showFlavorQuiz && (
        <button 
          type="button" 
          id="btn-open-quiz"
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-emerald-800 hover:bg-emerald-50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
        >
          <span aria-hidden="true">✨</span>
          <span>Quiz de Sabor</span>
        </button>
      )}

      {showMyRecipes && (
        <a 
          href="/mis-recetas" 
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          title="Mis Recetas y Registro de Extracciones Barista"
        >
          <span aria-hidden="true">📖</span>
          <span class="hidden sm:inline">Mis recetas</span>
        </a>
      )}

      {showCalibrator && (
        <a 
          href="/calibrador" 
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-stone-700 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          title="Calibrador Sensorial de Café 2D (Dial-in Assistant)"
        >
          <span aria-hidden="true">🎯</span>
          <span class="hidden sm:inline">Calibrador</span>
        </a>
      )}

      {showGuides && (
        <a 
          href="/recetas" 
          class="inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 hover:text-emerald-800 hover:bg-stone-200/50 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          title="Guías de Preparación de Café de Especialidad"
        >
          <span aria-hidden="true">☕</span>
          <span class="hidden sm:inline">Guías</span>
        </a>
      )}

      {showLocalAdmin && (
        <a 
          href="http://localhost:4322/plataforma/" 
          class="local-admin-nav hidden inline-flex items-center gap-1 rounded-lg px-2.5 py-1.5 text-emerald-800 bg-emerald-50 hover:bg-emerald-100 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 font-semibold"
          title="Abrir Plataforma de Administración y Bitácora Local"
        >
          <span aria-hidden="true">⚙️</span>
          <span class="hidden sm:inline">Plataforma Admin</span>
        </a>
      )}

      {showWhatsAppOrders && (
      <!-- BOTÓN CARRITO / PEDIDO -->
      <button
        type="button"
        data-open-cart="true"
        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 font-bold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
        title="Ver preparador de pedidos por WhatsApp"
      >
        <span>🛍️</span>
        <span class="hidden sm:inline">Mi Pedido</span>
      </button>
      )}
    </nav>

  </div>
</header>

<script>
  // Verificación estricta en el cliente para ocultar navegación local si se accede fuera de localhost
  (function enforceLocalhostNav() {
    const isLocalhost = ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname) || window.location.hostname.endsWith('.local');
    if (isLocalhost) {
      document.querySelectorAll('.local-admin-nav, .local-analytics-nav').forEach((el) => {
        el.classList.remove('hidden');
      });
    } else {
      document.querySelectorAll('.local-admin-nav, .local-analytics-nav').forEach((el) => {
        el.remove();
      });
    }
  })();
</script>
