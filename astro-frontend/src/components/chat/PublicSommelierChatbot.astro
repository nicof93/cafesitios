---
// PublicSommelierChatbot.astro - Asistente y Sommelier Virtual para el Sitio Público
import { Environment } from '../../core/infrastructure/config/Environment';

const apiBase = Environment.getApiBaseUrl();
---

<div id="sommelier-widget-root" class="fixed bottom-6 left-6 z-40">
  <!-- Botón Flotante de Activación -->
  <button
    type="button"
    id="btn-open-sommelier"
    class="flex items-center gap-2.5 rounded-full bg-gradient-to-r from-emerald-800 to-teal-850 hover:from-emerald-700 hover:to-teal-800 text-white px-4 py-3 shadow-xl transition-all duration-200 hover:scale-105 border border-emerald-500/40 group focus:outline-none focus:ring-4 focus:ring-emerald-500/30"
    title="Sommelier Virtual de Café"
    aria-label="Abrir recomendador de café"
  >
    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-600/80 text-white text-base font-bold shadow-inner group-hover:rotate-12 transition-transform">
      ☕
    </span>
    <span class="text-xs font-bold tracking-wide pr-1">
      ¿Qué café elegir?
    </span>
    <span class="flex h-2 w-2 rounded-full bg-emerald-300 animate-pulse"></span>
  </button>

  <!-- Ventana Modal / Chatbot del Sommelier -->
  <div
    id="sommelier-modal"
    class="hidden fixed bottom-6 left-6 w-[94vw] sm:w-[420px] max-h-[85vh] h-[640px] bg-white rounded-3xl border border-stone-200 shadow-2xl flex-col overflow-hidden z-50 animate-in fade-in zoom-in-95 duration-200"
    role="dialog"
    aria-labelledby="sommelier-title"
  >
    <!-- Header -->
    <div class="px-5 py-4 bg-gradient-to-r from-emerald-900 via-emerald-850 to-stone-900 text-white flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-700/80 border border-emerald-500/40 text-lg shadow-sm">
          ☕
        </div>
        <div>
          <h3 id="sommelier-title" class="text-sm font-black text-white m-0 tracking-tight">Sommelier Digital</h3>
          <p class="text-[11px] text-emerald-300 m-0">Encuentra tu café ideal en 60 segundos</p>
        </div>
      </div>
      <button
        type="button"
        id="btn-close-sommelier"
        class="h-8 w-8 inline-flex items-center justify-center rounded-xl bg-emerald-950/60 hover:bg-emerald-950 text-emerald-200 hover:text-white transition text-xs font-bold border border-emerald-700/50"
        aria-label="Cerrar sommelier"
      >
        ✕
      </button>
    </div>

    <!-- Área de Conversación y Pasos -->
    <div id="sommelier-conversation" class="flex-1 overflow-y-auto p-4 space-y-4 bg-stone-50/70 text-xs">
      <!-- Saludo Inicial -->
      <div class="flex items-start gap-2.5">
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold text-xs">
          ☕
        </div>
        <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-stone-200 shadow-2xs space-y-1.5 max-w-[85%] text-stone-800">
          <p class="font-medium leading-relaxed">
            ¡Hola! Soy tu <strong>Sommelier de Café</strong> en Cafésitios. Conozco todos los granos activos de las tostadurías de Chile.
          </p>
          <p class="text-stone-600 font-semibold">
            ¿En qué método piensas preparar tu café?
          </p>
        </div>
      </div>

      <!-- Opciones Paso 1: Método -->
      <div id="step-1-methods" class="flex flex-wrap gap-1.5 pl-9">
        <button type="button" class="btn-step-method px-3 py-1.5 rounded-full bg-white hover:bg-emerald-50 border border-stone-300 hover:border-emerald-500 text-stone-800 font-bold text-xs transition shadow-2xs" data-method="espresso">
          ☕ Espresso
        </button>
        <button type="button" class="btn-step-method px-3 py-1.5 rounded-full bg-white hover:bg-emerald-50 border border-stone-300 hover:border-emerald-500 text-stone-800 font-bold text-xs transition shadow-2xs" data-method="filtrado">
          💧 Filtrado / V60
        </button>
        <button type="button" class="btn-step-method px-3 py-1.5 rounded-full bg-white hover:bg-emerald-50 border border-stone-300 hover:border-emerald-500 text-stone-800 font-bold text-xs transition shadow-2xs" data-method="prensa">
          🫖 Prensa Francesa
        </button>
        <button type="button" class="btn-step-method px-3 py-1.5 rounded-full bg-white hover:bg-emerald-50 border border-stone-300 hover:border-emerald-500 text-stone-800 font-bold text-xs transition shadow-2xs" data-method="aeropress">
          ⚡ Aeropress / Moka
        </button>
        <button type="button" class="btn-step-method px-3 py-1.5 rounded-full bg-white hover:bg-emerald-50 border border-stone-300 hover:border-emerald-500 text-stone-800 font-bold text-xs transition shadow-2xs" data-method="coldbrew">
          🧊 Cold Brew
        </button>
      </div>

      <!-- Contenedor dinámico para pasos subsiguientes y recomendaciones -->
      <div id="sommelier-dynamic-flow" class="space-y-4"></div>
    </div>

    <!-- Footer con Botón de Reinicio -->
    <div class="p-3 bg-white border-t border-stone-200 shrink-0 flex items-center justify-between text-xs">
      <span class="text-[11px] text-stone-400">Recomendador inteligente de Cafésitios</span>
      <button
        type="button"
        id="btn-restart-sommelier"
        class="text-stone-500 hover:text-emerald-700 font-bold transition text-xs inline-flex items-center gap-1"
      >
        <span>🔄</span> Empezar de nuevo
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ apiBase }}>
  (function initPublicSommelier() {
    const btnOpen = document.getElementById('btn-open-sommelier');
    const btnClose = document.getElementById('btn-close-sommelier');
    const modal = document.getElementById('sommelier-modal');
    const dynamicFlow = document.getElementById('sommelier-dynamic-flow');
    const btnRestart = document.getElementById('btn-restart-sommelier');
    const messages = document.getElementById('sommelier-conversation');

    let API_BASE = apiBase || `http://${window.location.hostname}:8000`;
    if (API_BASE.includes('localhost') && window.location.hostname === '127.0.0.1') {
      API_BASE = API_BASE.replace('localhost', '127.0.0.1');
    } else if (API_BASE.includes('127.0.0.1') && window.location.hostname === 'localhost') {
      API_BASE = API_BASE.replace('127.0.0.1', 'localhost');
    }

    let state = {
      method: null,
      profile: null,
      preference: null,
    };

    function toggleModal(open) {
      if (open) {
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
      } else {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
      }
    }

    btnOpen?.addEventListener('click', () => toggleModal(true));
    btnClose?.addEventListener('click', () => toggleModal(false));

    function appendUserMsg(text) {
      const u = document.createElement('div');
      u.className = 'flex items-start justify-end gap-2.5';
      u.innerHTML = `
        <div class="bg-emerald-800 text-white p-3 rounded-2xl rounded-tr-none shadow-2xs max-w-[85%] text-xs font-semibold">
          ${text}
        </div>
      `;
      dynamicFlow?.appendChild(u);
      messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    }

    function appendBotMsg(html) {
      const b = document.createElement('div');
      b.className = 'flex items-start gap-2.5 animate-in fade-in duration-200';
      b.innerHTML = `
        <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold text-xs">
          ☕
        </div>
        <div class="bg-white p-3.5 rounded-2xl rounded-tl-none border border-stone-200 shadow-2xs space-y-2 max-w-[88%] text-stone-800 text-xs">
          ${html}
        </div>
      `;
      dynamicFlow?.appendChild(b);
      messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    }

    // Paso 1: Selección de Método
    document.querySelectorAll('.btn-step-method').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.method = btn.getAttribute('data-method');
        appendUserMsg(btn.textContent.trim());

        // Desactivar botones de paso 1
        document.querySelectorAll('.btn-step-method').forEach(b => b.classList.add('opacity-40', 'pointer-events-none'));

        // Mostrar Paso 2
        setTimeout(() => {
          appendBotMsg(`
            <p class="font-medium">Excelente elección para <strong>${btn.textContent.trim()}</strong>. Ahora, ¿qué perfil de notas te atrae más?</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              <button type="button" class="btn-step-profile px-2.5 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 font-bold text-xs" data-profile="frutal">
                🍓 Frutal & Cítrico
              </button>
              <button type="button" class="btn-step-profile px-2.5 py-1.5 rounded-full bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-900 font-bold text-xs" data-profile="chocolate">
                🍫 Chocolate & Nueces
              </button>
              <button type="button" class="btn-step-profile px-2.5 py-1.5 rounded-full bg-purple-50 hover:bg-purple-100 border border-purple-200 text-purple-900 font-bold text-xs" data-profile="floral">
                🌸 Floral & Exótico
              </button>
              <button type="button" class="btn-step-profile px-2.5 py-1.5 rounded-full bg-stone-100 hover:bg-stone-200 border border-stone-300 text-stone-800 font-bold text-xs" data-profile="dulce">
                🍯 Dulce & Caramelo
              </button>
            </div>
          `);

          attachStep2Listeners();
        }, 200);
      });
    });

    // Paso 2: Selección de Perfil de Notas
    function attachStep2Listeners() {
      document.querySelectorAll('.btn-step-profile').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.profile = btn.getAttribute('data-profile');
          appendUserMsg(btn.textContent.trim());

          document.querySelectorAll('.btn-step-profile').forEach(b => b.classList.add('opacity-40', 'pointer-events-none'));

          // Mostrar Paso 3: Preferencia de presupuesto
          setTimeout(() => {
            appendBotMsg(`
              <p class="font-medium">¡Buenísimo gusto! Por último, ¿algún criterio de presupuesto o despacho?</p>
              <div class="flex flex-wrap gap-1.5 pt-1">
                <button type="button" class="btn-step-pref px-2.5 py-1.5 rounded-full bg-stone-100 hover:bg-stone-200 border border-stone-300 text-stone-800 font-bold text-xs" data-pref="budget">
                  💰 Menos de $15.000
                </button>
                <button type="button" class="btn-step-pref px-2.5 py-1.5 rounded-full bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-900 font-bold text-xs" data-pref="microlote">
                  💎 Microlote / SCA 85+
                </button>
                <button type="button" class="btn-step-pref px-2.5 py-1.5 rounded-full bg-stone-100 hover:bg-stone-200 border border-stone-300 text-stone-800 font-bold text-xs" data-pref="todos">
                  ✨ Los más destacados
                </button>
              </div>
            `);

            attachStep3Listeners();
          }, 200);
        });
      });
    }

    // Paso 3 y Fetch de Recomendaciones
    function attachStep3Listeners() {
      document.querySelectorAll('.btn-step-pref').forEach((btn) => {
        btn.addEventListener('click', async () => {
          state.preference = btn.getAttribute('data-pref');
          appendUserMsg(btn.textContent.trim());

          document.querySelectorAll('.btn-step-pref').forEach(b => b.classList.add('opacity-40', 'pointer-events-none'));

          appendBotMsg(`
            <div class="flex items-center gap-2 text-stone-600">
              <span class="animate-spin text-base">⏳</span>
              <span>Consultando tostadurías activas y buscando tus cafés ideales...</span>
            </div>
          `);

          try {
            const queryParams = new URLSearchParams({
              limit: '24',
              category: 'cafe',
            });
            if (state.preference === 'budget') {
              queryParams.set('max_price', '15000');
            }

            const res = await fetch(`${API_BASE}/api/v1/productos?${queryParams.toString()}`);
            if (!res.ok) throw new Error('Error al consultar catálogo.');
            const data = await res.json();
            const prods = data.productos || [];

            // Filtrado heurístico por perfil sensorial
            const matches = prods.filter(p => {
              const notesStr = (p.notas_cata || []).join(' ').toLowerCase();
              if (state.profile === 'frutal') return notesStr.includes('frut') || notesStr.includes('cítric') || notesStr.includes('mora') || notesStr.includes('arándano') || notesStr.includes('durazno');
              if (state.profile === 'chocolate') return notesStr.includes('choc') || notesStr.includes('cacao') || notesStr.includes('nuez') || notesStr.includes('avellana');
              if (state.profile === 'floral') return notesStr.includes('flor') || notesStr.includes('jazm') || notesStr.includes('té') || notesStr.includes('bergamota');
              if (state.profile === 'dulce') return notesStr.includes('caramel') || notesStr.includes('miel') || notesStr.includes('chancaca') || notesStr.includes('panela');
              return true;
            });

            const topPicks = matches.length >= 2 ? matches.slice(0, 3) : prods.slice(0, 3);

            setTimeout(() => {
              // Eliminar el mensaje de carga
              const lastLoading = dynamicFlow.lastElementChild;
              if (lastLoading) dynamicFlow.removeChild(lastLoading);

              if (!topPicks.length) {
                appendBotMsg(`
                  <p>No encontré cafés exactos con esa combinación ahora mismo, pero puedes explorar nuestro <a href="/catalogo" class="text-emerald-700 font-bold underline">Catálogo Completo</a> con más de 20 tostadurías.</p>
                `);
                return;
              }

              appendBotMsg(`
                <p class="font-bold text-stone-900">¡Aquí tienes mis recomendaciones perfectas para ti!</p>
                <div class="space-y-3 pt-1">
                  ${topPicks.map(p => {
                    const firstVar = p.variantes && p.variantes[0] ? p.variantes[0] : null;
                    const precio = firstVar ? `$${firstVar.precio_clp.toLocaleString('es-CL')}` : 'Consultar';
                    const gramos = firstVar ? `${firstVar.formato_gramos}g` : '250g';
                    const imgUrl = (p.imagen && p.imagen.startsWith('/static/')) ? `${API_BASE}${p.imagen}` : (p.imagen || '/images/producto-referencial.jpg');

                    return `
                      <div class="p-3 rounded-2xl border border-stone-200 bg-stone-50/60 hover:bg-stone-50 transition flex items-center gap-3">
                        <img src="${imgUrl}" alt="${p.nombre}" onerror="this.onerror=null; this.src='/images/producto-referencial.jpg';" class="h-12 w-12 rounded-xl object-contain bg-white border border-stone-200 shrink-0 p-1" />
                        <div class="flex-1 min-w-0">
                          <span class="text-[10px] text-emerald-800 font-extrabold uppercase tracking-wider block">${p.tienda}</span>
                          <h4 class="font-bold text-stone-900 text-xs truncate">${p.nombre}</h4>
                          <div class="flex items-center gap-2 mt-0.5">
                            <span class="font-extrabold text-stone-900 text-xs">${precio}</span>
                            <span class="text-[10px] text-stone-400">(${gramos})</span>
                          </div>
                        </div>
                        <a href="/producto/${p.id}" class="rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-[11px] px-3 py-1.5 transition shadow-2xs shrink-0">
                          Ver ➔
                        </a>
                      </div>
                    `;
                  }).join('')}
                </div>
                <div class="pt-2 text-center border-t border-stone-100">
                  <a href="/catalogo" class="text-emerald-700 font-bold text-xs hover:underline">
                    Ver todos los cafés en el catálogo ↗
                  </a>
                </div>
              `);
            }, 350);
          } catch (err) {
            appendBotMsg(`<p class="text-rose-600">Hubo un problema al cargar cafés. Intenta nuevamente.</p>`);
          }
        });
      });
    }

    btnRestart?.addEventListener('click', () => {
      dynamicFlow.innerHTML = '';
      document.querySelectorAll('.btn-step-method').forEach(b => b.classList.remove('opacity-40', 'pointer-events-none'));
      state = { method: null, profile: null, preference: null };
    });
  })();
</script>
