---
---

<!-- CU-08: BITÁCORA DE RECETAS LOCAL-FIRST -->
<dialog 
  id="recipes-dialog"
  class="fixed inset-0 z-50 m-auto w-[95%] max-w-2xl rounded-3xl bg-white p-6 sm:p-8 shadow-2xl border border-stone-200 backdrop:bg-stone-950/60 backdrop:backdrop-blur-sm"
>
  <div class="flex items-center justify-between pb-4 border-b border-stone-200">
    <div class="flex items-center gap-2">
      <span class="text-xl">📖</span>
      <div>
        <h3 class="text-base font-bold text-slate-900">Bitácora de Recetas Local-First</h3>
        <p class="text-xs text-slate-500">Tus extracciones guardadas directamente en este dispositivo</p>
      </div>
    </div>
    <button 
      type="button" 
      id="btn-close-recipes-dialog"
      class="text-slate-400 hover:text-slate-700 text-lg font-bold p-1 rounded-lg"
    >
      ✕
    </button>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <span class="text-xs font-semibold text-slate-700" id="recipes-counter">0 recetas</span>
    <button 
      type="button" 
      id="btn-sync-recipes-cloud"
      class="inline-flex items-center gap-1.5 rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 hover:bg-sky-100 transition"
      title="Respalda tus recetas en la nube"
    >
      ☁️ Sincronizar en la Nube
    </button>
  </div>

  <!-- FORMULARIO NUEVA RECETA -->
  <form id="new-recipe-form" class="mt-4 rounded-2xl border border-stone-200 bg-stone-50/70 p-4 space-y-3">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <div>
        <label for="input-rec-cafe" class="block font-bold text-slate-500 mb-1">Nombre o Café</label>
        <input id="input-rec-cafe" type="text" required placeholder="Ej. Geisha Lavado" class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
      </div>
      <div>
        <label for="select-rec-metodo" class="block font-bold text-slate-500 mb-1">Método</label>
        <select id="select-rec-metodo" required class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
          <option value="V60">V60</option>
          <option value="Aeropress">Aeropress</option>
          <option value="Espresso">Espresso</option>
          <option value="Chemex">Chemex</option>
          <option value="French Press">Prensa Francesa</option>
          <option value="Moka">Moka</option>
          <option value="Cold Brew">Cold Brew</option>
        </select>
      </div>
      <div>
        <label for="input-rec-gramos-cafe" class="block font-bold text-slate-500 mb-1">Café (gramos)</label>
        <input id="input-rec-gramos-cafe" type="number" step="0.1" min="1" required placeholder="15" class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
      </div>
      <div>
        <label for="input-rec-gramos-agua" class="block font-bold text-slate-500 mb-1">Agua (gramos/ml)</label>
        <input id="input-rec-gramos-agua" type="number" step="1" min="10" required placeholder="250" class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
      </div>
      <div>
        <label for="input-rec-molienda" class="block font-bold text-slate-500 mb-1">Molienda</label>
        <input id="input-rec-molienda" type="text" placeholder="Media-fina (18 clics)" class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
      </div>
      <div>
        <label for="input-rec-tiempo" class="block font-bold text-slate-500 mb-1">Tiempo (min:seg)</label>
        <input id="input-rec-tiempo" type="text" placeholder="2:45 min" class="w-full bg-white border border-stone-200 rounded-xl px-3 py-2 text-xs">
      </div>
    </div>
    <div>
      <label for="textarea-rec-notas" class="block text-xs font-bold text-slate-500 mb-1">Notas de cata / resultado</label>
      <textarea id="textarea-rec-notas" rows="2" placeholder="Notas florales, acidez cítrica brillante..." class="w-full bg-white border border-stone-200 rounded-xl p-2.5 text-xs"></textarea>
    </div>

    <!-- SECCIÓN ADICIONAL OPCIONAL: PLANILLA DE CATACIÓN Q-GRADER (10 INDICADORES SCA) -->
    <details id="details-sca-cupping" class="group rounded-2xl border border-amber-200/80 bg-amber-50/40 p-3.5 text-xs transition">
      <summary class="font-bold text-amber-900 cursor-pointer flex items-center justify-between list-none select-none">
        <span class="flex items-center gap-1.5">
          <span>🏆</span>
          <span>Planilla de Catación Q-Grader SCA (Opcional - 10 Indicadores)</span>
        </span>
        <span class="text-[10px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full border border-amber-300 font-bold group-open:hidden">+ Calificar Atributos</span>
        <span class="text-[10px] text-amber-700 hidden group-open:inline">▲ Ocultar</span>
      </summary>
      
      <div class="mt-3 pt-3 border-t border-amber-200/60 space-y-3">
        <p class="text-[11px] text-amber-900/80 leading-relaxed">
          Califica cada indicador de 1 a 10 (estándar SCA de Q-Graders). La suma de los 10 puntos calculará la calificación oficial de especialidad (máx. 100 pts).
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 text-[10px]">
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">1. Fragancia/Aroma</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-aroma" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">2. Sabor</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-sabor" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">3. Retrogusto</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-retrogusto" placeholder="8.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">4. Acidez</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-acidez" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">5. Cuerpo</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-cuerpo" placeholder="8.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">6. Balance</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-balance" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">7. Uniformidad</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-uniformidad" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">8. Taza Limpia</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-taza-limpia" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">9. Dulzor</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-dulzor" placeholder="10.0" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
          <div>
            <label class="block font-bold text-stone-600 mb-0.5">10. Global Q-Grader</label>
            <input type="number" min="1" max="10" step="0.25" id="input-sca-global" placeholder="8.5" class="input-sca-attr w-full bg-white border border-stone-200 rounded-lg p-1.5 text-center font-bold text-xs">
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-amber-200/60">
          <span class="text-xs font-semibold text-amber-900">Puntaje Total SCA Calculado:</span>
          <span id="label-sca-total" class="font-extrabold text-amber-900 bg-amber-100 border border-amber-300 px-3 py-1 rounded-lg text-xs shadow-2xs">
            Sin calificar
          </span>
        </div>
      </div>
    </details>

    <div class="flex justify-between items-center pt-1">
      <div class="flex items-center gap-1 text-xs">
        <label for="select-rec-calificacion" class="font-bold text-slate-500">Nota:</label>
        <select id="select-rec-calificacion" class="bg-white border border-stone-200 rounded-lg px-2 py-1 text-xs font-bold text-amber-600">
          <option value="5">⭐⭐⭐⭐⭐ (5)</option>
          <option value="4">⭐⭐⭐⭐ (4)</option>
          <option value="3">⭐⭐⭐ (3)</option>
          <option value="2">⭐⭐ (2)</option>
          <option value="1">⭐ (1)</option>
        </select>
      </div>
      <button type="submit" class="bg-emerald-800 hover:bg-emerald-900 text-white font-semibold text-xs px-4 py-2 rounded-xl transition shadow-2xs">
        + Guardar Receta
      </button>
    </div>
  </form>

  <!-- LISTADO DE RECETAS -->
  <div id="recipes-items-list" class="mt-4 max-h-60 overflow-y-auto space-y-2.5 pr-1"></div>
</dialog>

<script>
  import { ManageRecipesUseCase } from '../../core/application/ManageRecipes';
  import { AnalyticsTracker } from '../../core/infrastructure/analytics/AnalyticsTracker';

  const recipesUseCase = new ManageRecipesUseCase();
  const dialog = document.getElementById('recipes-dialog') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('btn-close-recipes-dialog');
  const form = document.getElementById('new-recipe-form') as HTMLFormElement | null;
  const listContainer = document.getElementById('recipes-items-list');
  const counterLabel = document.getElementById('recipes-counter');
  const syncBtn = document.getElementById('btn-sync-recipes-cloud');
  const labelScaTotal = document.getElementById('label-sca-total');

  function calculateScaTotal(): number | null {
    const inputs = document.querySelectorAll('.input-sca-attr') as NodeListOf<HTMLInputElement>;
    let sum = 0;
    let count = 0;
    inputs.forEach(inp => {
      const val = parseFloat(inp.value);
      if (!isNaN(val) && val > 0) {
        sum += val;
        count++;
      }
    });

    if (count > 0 && labelScaTotal) {
      labelScaTotal.textContent = `★ ${sum.toFixed(2)} / 100 pts SCA (${count}/10 atributos)`;
      return parseFloat(sum.toFixed(2));
    } else if (labelScaTotal) {
      labelScaTotal.textContent = 'Sin calificar';
    }
    return null;
  }

  document.querySelectorAll('.input-sca-attr').forEach(inp => {
    inp.addEventListener('input', calculateScaTotal);
  });

  function renderRecipes() {
    const recipes = recipesUseCase.getLocalRecipes();
    if (counterLabel) {
      counterLabel.textContent = `${recipes.length} receta${recipes.length === 1 ? '' : 's'}`;
    }

    if (!listContainer) return;

    if (recipes.length === 0) {
      listContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">Aún no has guardado recetas. ¡Agrega tu primera extracción arriba!</p>';
      return;
    }

    listContainer.innerHTML = recipes.map(r => `
      <div class="p-3.5 rounded-xl border border-stone-200 bg-white shadow-2xs text-xs space-y-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="font-bold text-slate-900">${r.cafe}</span>
            ${r.puntuacion_sca_total ? `
              <span class="bg-amber-100 text-amber-900 text-[10px] font-extrabold px-2 py-0.5 rounded-md border border-amber-300">
                ★ ${r.puntuacion_sca_total} SCA
              </span>
            ` : ''}
          </div>
          <span class="text-amber-500 font-bold">${'⭐'.repeat(r.calificacion)}</span>
        </div>
        <div class="flex flex-wrap gap-2 text-[11px] text-slate-500">
          <span class="bg-stone-100 px-2 py-0.5 rounded font-medium">${r.metodo}</span>
          <span>${r.gramos_cafe}g café / ${r.gramos_agua}g agua (${r.getRatio()})</span>
          ${r.molienda ? `<span>&bull; ${r.molienda}</span>` : ''}
          ${r.tiempo ? `<span>&bull; ${r.tiempo}</span>` : ''}
        </div>
        ${r.notas ? `<p class="text-[11px] text-slate-600 italic bg-stone-50 p-2 rounded-lg border border-stone-100">"${r.notas}"</p>` : ''}
      </div>
    `).join('');
  }

  document.getElementById('btn-open-recipes')?.addEventListener('click', () => {
    renderRecipes();
    dialog?.showModal();
  });

  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const cafe = (document.getElementById('input-rec-cafe') as HTMLInputElement).value.trim();
    const metodo = (document.getElementById('select-rec-metodo') as HTMLSelectElement).value;
    const gramosCafe = parseFloat((document.getElementById('input-rec-gramos-cafe') as HTMLInputElement).value);
    const gramosAgua = parseFloat((document.getElementById('input-rec-gramos-agua') as HTMLInputElement).value);
    const molienda = (document.getElementById('input-rec-molienda') as HTMLInputElement).value.trim();
    const tiempo = (document.getElementById('input-rec-tiempo') as HTMLInputElement).value.trim();
    const calificacion = parseInt((document.getElementById('select-rec-calificacion') as HTMLSelectElement).value, 10);
    const notas = (document.getElementById('textarea-rec-notas') as HTMLTextAreaElement).value.trim();

    // Recolectar atributos SCA
    const scaAroma = parseFloat((document.getElementById('input-sca-aroma') as HTMLInputElement)?.value);
    const scaSabor = parseFloat((document.getElementById('input-sca-sabor') as HTMLInputElement)?.value);
    const scaRetro = parseFloat((document.getElementById('input-sca-retrogusto') as HTMLInputElement)?.value);
    const scaAcidez = parseFloat((document.getElementById('input-sca-acidez') as HTMLInputElement)?.value);
    const scaCuerpo = parseFloat((document.getElementById('input-sca-cuerpo') as HTMLInputElement)?.value);
    const scaBalance = parseFloat((document.getElementById('input-sca-balance') as HTMLInputElement)?.value);
    const scaUniformidad = parseFloat((document.getElementById('input-sca-uniformidad') as HTMLInputElement)?.value);
    const scaTazaLimpia = parseFloat((document.getElementById('input-sca-taza-limpia') as HTMLInputElement)?.value);
    const scaDulzor = parseFloat((document.getElementById('input-sca-dulzor') as HTMLInputElement)?.value);
    const scaGlobal = parseFloat((document.getElementById('input-sca-global') as HTMLInputElement)?.value);

    const catacionSca: Record<string, number> = {};
    if (!isNaN(scaAroma)) catacionSca['fragancia_aroma'] = scaAroma;
    if (!isNaN(scaSabor)) catacionSca['sabor'] = scaSabor;
    if (!isNaN(scaRetro)) catacionSca['retrogusto'] = scaRetro;
    if (!isNaN(scaAcidez)) catacionSca['acidez'] = scaAcidez;
    if (!isNaN(scaCuerpo)) catacionSca['cuerpo'] = scaCuerpo;
    if (!isNaN(scaBalance)) catacionSca['balance'] = scaBalance;
    if (!isNaN(scaUniformidad)) catacionSca['uniformidad'] = scaUniformidad;
    if (!isNaN(scaTazaLimpia)) catacionSca['taza_limpia'] = scaTazaLimpia;
    if (!isNaN(scaDulzor)) catacionSca['dulzor'] = scaDulzor;
    if (!isNaN(scaGlobal)) catacionSca['puntaje_global'] = scaGlobal;

    const puntuacionScaTotal = calculateScaTotal();

    recipesUseCase.saveLocalRecipe({
      id: `rec-${Date.now()}`,
      cafe,
      metodo,
      gramos_cafe: gramosCafe,
      gramos_agua: gramosAgua,
      molienda,
      tiempo,
      calificacion,
      notas,
      catacion_sca: Object.keys(catacionSca).length > 0 ? catacionSca : undefined,
      puntuacion_sca_total: puntuacionScaTotal || undefined,
      fecha: new Date().toISOString()
    });

    form.reset();
    if (labelScaTotal) labelScaTotal.textContent = 'Sin calificar';
    renderRecipes();
    AnalyticsTracker.trackRecipeSaved(metodo, cafe, calificacion);
  });

  syncBtn?.addEventListener('click', async () => {
    try {
      const res = await recipesUseCase.syncToCloud();
      if (res.success) {
        alert('☁️ ' + res.message);
        AnalyticsTracker.trackRecipeCloudSynced(res.count);
      } else {
        alert(res.message);
      }
    } catch {
      alert('Modo sin conexión: Tus recetas siguen guardadas en este dispositivo.');
    }
  });
</script>

