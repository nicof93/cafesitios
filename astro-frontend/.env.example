# URL de la API Backend (Client-side y Server-side)
PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://localhost:8000

# Analítica Web
PUBLIC_GTM_ID=
PUBLIC_GA_MEASUREMENT_ID=

# Feature Flags (Lanzamiento gradual de funcionalidades)
# Valor por defecto: true. Para deshabilitar una página o módulo, definir en 'false' o '0'
PUBLIC_ENABLE_RECIPES=true
PUBLIC_ENABLE_CALIBRATOR=true
PUBLIC_ENABLE_MY_RECIPES=true
PUBLIC_ENABLE_FLAVOR_QUIZ=true


